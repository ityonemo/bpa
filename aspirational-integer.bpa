// aspirational-integer.bpa — ℤ CONSTRUCTED from ℕ, not axiomatized.
//
// EXPERIMENT (not part of std/). The standard library's std/integer.bpa posits ℤ
// as a fresh axiomatic theory. Here we instead BUILD ℤ from Peano ℕ as the classic
// quotient (ℕ×ℕ)/~ — the integers as differences of naturals, [a,b] ↦ "a − b",
// with (a,b) ~ (c,d) ⟺ a+d = b+c.
//
// bpa has no product/tuple sort, so we render a class representative by a
// DIFFERENCE CONSTRUCTOR `diff(a, b): Int` (read: a − b), and make the quotient
// relation THE equality on Int, via the axiom
//     diff(a,b) = diff(c,d)  ⟺  add(a,d) = add(b,c).
// Every integer is a difference of naturals (surjectivity). The ring operations
// are defined on representatives; well-definedness is automatic because the axiom
// already IS the equality. From these + Peano's arithmetic, everything about ℤ is
// DERIVED — no ℤ axioms, no distinctness patch.
//
// The plan: construct ℤ and nonneg-ℤ here, `model peano` from nonneg-ℤ (inheriting
// upward/half-induction for free), derive full bidirectional induction, then
// `model ring` to inherit the whole ring corpus.

import peano <<< "std/peano.bpa"

// -- ℕ vocabulary this construction rests on --------------------------------

sort Nat = peano.Nat
const NZERO = peano.ZERO
const NONE = peano.ONE
func nsucc = peano.succ
func nadd = peano.add
func nmul = peano.mul
axiom naddZeroLeft = peano.addZeroLeft
theorem naddZeroRight = peano.addZeroRight
theorem naddCommutative = peano.addIsCommutative
theorem naddAssociative = peano.addIsAssociative
theorem naddCancelLeft = peano.addCancelLeft
theorem naddLeftSwap = peano.addLeftSwap
theorem nmulCommutative = peano.mulIsCommutative
theorem nmulAssociative = peano.mulIsAssociative
theorem nmulAddDistribLeft = peano.mulAddDistribLeft
theorem nmulAddDistribRight = peano.mulAddDistribRight

// -- the carrier: ℤ as differences of naturals ------------------------------

sort Int

// the class representative: diff(a, b) is the integer "a − b".
func diff(a: Nat, b: Nat): Int

// THE quotient relation, as equality on Int:  a − b = c − d  ⟺  a + d = b + c.
// (bpa has no `iff`; the biconditional is the intro/elim pair, as divides is.)
axiom diffEqIntro: forall a, b, c, d: Nat; nadd(a, d) = nadd(b, c) -> diff(a, b) = diff(c, d)
axiom diffEqElim: forall a, b, c, d: Nat; diff(a, b) = diff(c, d) -> nadd(a, d) = nadd(b, c)

// every integer is a difference of two naturals.
axiom diffSurjective: forall z: Int; exists a: Nat; exists b: Nat; z = diff(a, b)

// -- distinguished elements + operations, defined on representatives ---------

const ZERO: Int
const ONE: Int
axiom zeroIsDiff: ZERO = diff(NZERO, NZERO)
axiom oneIsDiff: ONE = diff(NONE, NZERO)

// (a−b) + (c−d) = (a+c) − (b+d)
func add(x: Int, y: Int): Int
axiom addDiff: forall a, b, c, d: Nat;
  add(diff(a, b), diff(c, d)) = diff(nadd(a, c), nadd(b, d))

// −(a−b) = (b−a)
func neg(x: Int): Int
axiom negDiff: forall a, b: Nat; neg(diff(a, b)) = diff(b, a)

// (a−b)·(c−d) = (ac+bd) − (ad+bc)
func mul(x: Int, y: Int): Int
axiom mulDiff: forall a, b, c, d: Nat;
  mul(diff(a, b), diff(c, d)) = diff(nadd(nmul(a, c), nmul(b, d)), nadd(nmul(a, d), nmul(b, c)))

// -- first sanity theorems: the reflexive collapse and a distinctness fact ---

// diff(a, a) = ZERO for every a — every "n − n" is zero.
theorem diffSelfIsZero: forall a: Nat; diff(a, a) = ZERO
proof
  @generalize-a |
    fix a: Nat {
      @zero-unfolds |
        ZERO = diff(NZERO, NZERO)
        [by axiom zeroIsDiff]
      @zero-diff-is-zero |
        diff(NZERO, NZERO) = ZERO
        [by symmetry zero-unfolds]
      @quotient-intro |
        forall p, q, r, s: Nat; nadd(p, s) = nadd(q, r) -> diff(p, q) = diff(r, s)
        [by axiom diffEqIntro]
      @diff-a-a-if-sums |
        nadd(a, NZERO) = nadd(a, NZERO) -> diff(a, a) = diff(NZERO, NZERO)
        [by forall_elim(a, a, NZERO, NZERO) quotient-intro]
      @sums-reflexive |
        nadd(a, NZERO) = nadd(a, NZERO)
        [by reflexivity]
      @diff-a-a-is-zero-diff |
        diff(a, a) = diff(NZERO, NZERO)
        [by modus_ponens diff-a-a-if-sums sums-reflexive]
      @conclusion-diff-self |
        diff(a, a) = ZERO
        [by rewrite zero-diff-is-zero diff-a-a-is-zero-diff]
    }
  @conclusion |
    forall a: Nat; diff(a, a) = ZERO
    [by forall_intro generalize-a]
qed

// -- ring laws, DERIVED from Peano through the representatives ---------------

// addition on ℤ is commutative: reduce to ℕ commutativity on each component.
// x + y = (a−b) + (c−d) = (a+c) − (b+d);  y + x = (c+a) − (d+b);  the reps agree
// componentwise (a+c=c+a, b+d=d+b), so the two integers are equal.
theorem addIsCommutative: forall x, y: Int; add(x, y) = add(y, x)
proof
  @generalize-x |
    fix x: Int {
      @generalize-y |
        fix y: Int {
          @x-is-a-difference |
            exists a: Nat; exists b: Nat; x = diff(a, b)
            [by forall_elim(x) x-surjective]
          @x-surjective |
            forall z: Int; exists a: Nat; exists b: Nat; z = diff(a, b)
            [by axiom diffSurjective]
          @with-x-reps |
            unpack a: Nat from x-is-a-difference {
              @x-is-diff-a |
                exists b: Nat; x = diff(a, b)
                [by hypothesis with-x-reps]
              @with-x-rep-b |
                unpack b: Nat from x-is-diff-a {
                  @x-is-diff |
                    x = diff(a, b)
                    [by hypothesis with-x-rep-b]
                  @y-is-a-difference |
                    exists c: Nat; exists d: Nat; y = diff(c, d)
                    [by forall_elim(y) x-surjective]
                  @with-y-reps |
                    unpack c: Nat from y-is-a-difference {
                      @y-is-diff-c |
                        exists d: Nat; y = diff(c, d)
                        [by hypothesis with-y-reps]
                      @with-y-rep-d |
                        unpack d: Nat from y-is-diff-c {
                          @y-is-diff |
                            y = diff(c, d)
                            [by hypothesis with-y-rep-d]
                          // both sums, on representatives.
                          @add-diff-rule |
                            forall p, q, r, s: Nat; add(diff(p, q), diff(r, s)) = diff(nadd(p, r), nadd(q, s))
                            [by axiom addDiff]
                          @x-plus-y-on-reps |
                            add(diff(a, b), diff(c, d)) = diff(nadd(a, c), nadd(b, d))
                            [by forall_elim(a, b, c, d) add-diff-rule]
                          @y-plus-x-on-reps |
                            add(diff(c, d), diff(a, b)) = diff(nadd(c, a), nadd(d, b))
                            [by forall_elim(c, d, a, b) add-diff-rule]
                          // the two representative-sums agree componentwise.
                          @commute-rule |
                            forall p, q: Nat; nadd(p, q) = nadd(q, p)
                            [by theorem naddCommutative]
                          @a-plus-c-commutes |
                            nadd(a, c) = nadd(c, a)
                            [by forall_elim(a, c) commute-rule]
                          @b-plus-d-commutes |
                            nadd(b, d) = nadd(d, b)
                            [by forall_elim(b, d) commute-rule]
                          @first-component-agrees |
                            diff(nadd(a, c), nadd(b, d)) = diff(nadd(c, a), nadd(b, d))
                            [by rewrite a-plus-c-commutes diff-reflexive]
                          @diff-reflexive |
                            diff(nadd(a, c), nadd(b, d)) = diff(nadd(a, c), nadd(b, d))
                            [by reflexivity]
                          @both-components-agree |
                            diff(nadd(a, c), nadd(b, d)) = diff(nadd(c, a), nadd(d, b))
                            [by rewrite b-plus-d-commutes first-component-agrees]
                          // chain: add(x,y) = diff(a+c,b+d) = diff(c+a,d+b) = add(y,x).
                          @x-plus-y-is-reps |
                            add(x, y) = diff(nadd(a, c), nadd(b, d))
                            [by rewrite x-is-diff x-plus-y-via-y]
                          @x-plus-y-via-y |
                            add(x, diff(c, d)) = diff(nadd(a, c), nadd(b, d))
                            [by rewrite y-is-diff x-plus-y-restated]
                          @x-plus-y-restated |
                            add(diff(a, b), diff(c, d)) = diff(nadd(a, c), nadd(b, d))
                            [by rewrite x-is-diff x-plus-y-on-reps]
                          @y-plus-x-is-reps |
                            add(y, x) = diff(nadd(c, a), nadd(d, b))
                            [by rewrite x-is-diff y-plus-x-via-y]
                          @y-plus-x-via-y |
                            add(y, diff(a, b)) = diff(nadd(c, a), nadd(d, b))
                            [by rewrite y-is-diff y-plus-x-on-reps]
                          @x-plus-y-equals-mid |
                            add(x, y) = diff(nadd(c, a), nadd(d, b))
                            [by rewrite both-components-agree x-plus-y-is-reps]
                          @conclusion-commute |
                            add(x, y) = add(y, x)
                            [by rewrite y-plus-x-is-reps x-plus-y-equals-mid]
                        }
                    }
                }
            }
        }
    }
  @conclusion |
    forall x, y: Int; add(x, y) = add(y, x)
    [by forall_intro generalize-x]
qed
