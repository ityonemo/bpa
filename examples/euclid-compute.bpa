// Euclid's algorithm, RUN on concrete numbers: gcd(9, 6) = 3.
//
// The abstract correctness of gcd lives in std/peano-gcd.bpa; examples/euclid.bpa
// shows the consumer-facing correctness theorems. This file does the other
// thing a user wants — actually *compute* a gcd — by unfolding the recursion:
//
//   gcd(9, 6) = gcd(6, mod(9,6)) = gcd(6, 3)
//             = gcd(3, mod(6,3)) = gcd(3, 0)
//             = 3
//
// The only non-trivial steps are the two `mod` facts (mod(9,6)=3, mod(6,3)=0),
// each discharged in one line by `modIntro` (remainder uniqueness): exhibit the
// quotient and remainder, check b*q + r = a and r < b. Everything is pure —
// there is no built-in evaluator reducing mod(9,6) to 3; each numeric fact is
// an ordinary kernel-checked derivation. Closed-form arithmetic (9 = 6*1+3,
// etc.) is ground by `simplify` with the peano recursion axioms.

import peano <<< "std/peano.bpa"
import ordering <<< "std/peano-ordering.bpa"
import division <<< "std/peano-division.bpa"
import gcd <<< "std/peano-gcd.bpa"

// -- vocabulary -------------------------------------------------------------

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add
func mul = peano.mul
pred less_than = ordering.less_than
func mod = division.mod
func gcd_of = gcd.gcd

// recursion axioms used to grind closed numerals; the gcd equations; and
// modIntro, the remainder-uniqueness lemma that makes each mod fact a
// one-liner. The `r < b` guard on each mod fact is a ground order goal, so
// `arithmetic(ordering)` discharges it in one line.
axiom mulSuccLeft = peano.mulSuccLeft
axiom mulZeroLeft = peano.mulZeroLeft
axiom addSuccLeft = peano.addSuccLeft
axiom addZeroLeft = peano.addZeroLeft
axiom succNotZero = peano.succNotZero
axiom gcdZero = gcd.gcdZero
axiom gcdStep = gcd.gcdStep
theorem modIntro = division.modIntro

// -- numerals (succ-towers, named for readability) --------------------------

define ONE = succ(ZERO)
define TWO = succ(ONE)
define THREE = succ(TWO)
define FOUR = succ(THREE)
define FIVE = succ(FOUR)
define SIX = succ(FIVE)
define NINE = succ(succ(succ(SIX)))

// -- nonzero divisors: needed to discharge the div/mod guard obligations that
// the mod(_, SIX) / mod(_, THREE) statements below owe at declaration time.
// (Statement-level obligations match against prior theorems, not proof steps.)

theorem sixNotZero: SIX != ZERO
proof
  @successors-are-never-zero |
    forall a: Nat; succ(a) != ZERO
    [by axiom succNotZero]
  @conclusion |
    SIX != ZERO
    [by forall_elim(FIVE) successors-are-never-zero]
qed

theorem threeNotZero: THREE != ZERO
proof
  @successors-are-never-zero |
    forall a: Nat; succ(a) != ZERO
    [by axiom succNotZero]
  @conclusion |
    THREE != ZERO
    [by forall_elim(TWO) successors-are-never-zero]
qed

// -- the two mod facts: mod(9,6) = 3 and mod(6,3) = 0 -----------------------

// mod(9, 6) = 3, because 6*1 + 3 = 9 and 3 < 6.
theorem modNineSix: mod(NINE, SIX) = THREE
proof
  @six-is-nonzero |
    SIX != ZERO
    [by theorem sixNotZero]
  @three-is-below-six |
    less_than(THREE, SIX)
    [by arithmetic(ordering)]
  @six-times-one-plus-three-is-nine |
    add(mul(SIX, ONE), THREE) = NINE
    [by simplify mulSuccLeft mulZeroLeft addSuccLeft addZeroLeft]
  @remainder-is-unique |
    forall a, b, q, r: Nat; b != ZERO -> less_than(r, b) -> add(mul(b, q), r) = a -> mod(a, b) = r
    [by theorem modIntro]
  @remainder-is-determined-nine-six |
    SIX != ZERO -> less_than(THREE, SIX) -> add(mul(SIX, ONE), THREE) = NINE -> mod(NINE, SIX) = THREE
    [by forall_elim(NINE, SIX, ONE, THREE) remainder-is-unique]
  @conclusion |
    mod(NINE, SIX) = THREE
    [by tautology remainder-is-determined-nine-six six-is-nonzero three-is-below-six six-times-one-plus-three-is-nine]
qed

// mod(6, 3) = 0, because 3*2 + 0 = 6 and 0 < 3.
theorem modSixThree: mod(SIX, THREE) = ZERO
proof
  @three-is-nonzero |
    THREE != ZERO
    [by theorem threeNotZero]
  @zero-is-below-three |
    less_than(ZERO, THREE)
    [by arithmetic(ordering)]
  @three-times-two-is-six |
    add(mul(THREE, TWO), ZERO) = SIX
    [by simplify mulSuccLeft mulZeroLeft addSuccLeft addZeroLeft]
  @remainder-is-unique |
    forall a, b, q, r: Nat; b != ZERO -> less_than(r, b) -> add(mul(b, q), r) = a -> mod(a, b) = r
    [by theorem modIntro]
  @remainder-is-determined-six-three |
    THREE != ZERO -> less_than(ZERO, THREE) -> add(mul(THREE, TWO), ZERO) = SIX -> mod(SIX, THREE) = ZERO
    [by forall_elim(SIX, THREE, TWO, ZERO) remainder-is-unique]
  @conclusion |
    mod(SIX, THREE) = ZERO
    [by tautology remainder-is-determined-six-three three-is-nonzero zero-is-below-three three-times-two-is-six]
qed

// -- unfold the recursion: gcd(9, 6) = 3 ------------------------------------

theorem gcdNineSix: gcd_of(NINE, SIX) = THREE
proof
  @six-is-nonzero |
    SIX != ZERO
    [by theorem sixNotZero]
  @three-is-nonzero |
    THREE != ZERO
    [by theorem threeNotZero]
  @gcd-recurses-on-mod |
    forall a, b: Nat; b != ZERO -> gcd_of(a, b) = gcd_of(b, mod(a, b))
    [by axiom gcdStep]
  @gcd-nine-six-recurses-if-nonzero |
    SIX != ZERO -> gcd_of(NINE, SIX) = gcd_of(SIX, mod(NINE, SIX))
    [by forall_elim(NINE, SIX) gcd-recurses-on-mod]
  @gcd-nine-six-recurses |
    gcd_of(NINE, SIX) = gcd_of(SIX, mod(NINE, SIX))
    [by modus_ponens gcd-nine-six-recurses-if-nonzero six-is-nonzero]
  @mod-nine-six-is-three |
    mod(NINE, SIX) = THREE
    [by theorem modNineSix]
  @gcd-nine-six-is-gcd-six-three |
    gcd_of(NINE, SIX) = gcd_of(SIX, THREE)
    [by rewrite mod-nine-six-is-three gcd-nine-six-recurses]
  @gcd-six-three-recurses-if-nonzero |
    THREE != ZERO -> gcd_of(SIX, THREE) = gcd_of(THREE, mod(SIX, THREE))
    [by forall_elim(SIX, THREE) gcd-recurses-on-mod]
  @gcd-six-three-recurses |
    gcd_of(SIX, THREE) = gcd_of(THREE, mod(SIX, THREE))
    [by modus_ponens gcd-six-three-recurses-if-nonzero three-is-nonzero]
  @mod-six-three-is-zero |
    mod(SIX, THREE) = ZERO
    [by theorem modSixThree]
  @gcd-six-three-is-gcd-three-zero |
    gcd_of(SIX, THREE) = gcd_of(THREE, ZERO)
    [by rewrite mod-six-three-is-zero gcd-six-three-recurses]
  @gcd-with-zero-is-itself |
    forall a: Nat; gcd_of(a, ZERO) = a
    [by axiom gcdZero]
  @gcd-three-zero-is-three |
    gcd_of(THREE, ZERO) = THREE
    [by forall_elim(THREE) gcd-with-zero-is-itself]
  @gcd-nine-six-is-gcd-three-zero |
    gcd_of(NINE, SIX) = gcd_of(THREE, ZERO)
    [by rewrite gcd-six-three-is-gcd-three-zero gcd-nine-six-is-gcd-six-three]
  @conclusion |
    gcd_of(NINE, SIX) = THREE
    [by rewrite gcd-three-zero-is-three gcd-nine-six-is-gcd-three-zero]
qed
