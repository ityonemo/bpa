// examples/sqrt2.bpa — the irrationality of √2, stated over ℕ.
//
// bpa is over the naturals (no reals), so "√2 is irrational" is phrased as a
// fact about naturals: no fraction in lowest terms squares to 2. Concretely,
// there is no coprime pair (p, q) with p² = 2q².
//
//   theorem sqrtTwoIrrational:
//     forall p, q; gcd(p, q) = ONE -> p·p != 2·(q·q)
//
// Proof (by contradiction): assume p² = 2q². Then 2 | p², so 2 | p (the parity
// crux `evenSquareEven`); write p = 2k. Substituting and cancelling a 2 gives
// q² = 2k², so 2 | q. Now 2 divides both p and q, hence 2 | gcd(p, q) = 1 — but
// nothing but 1 divides 1 (`twoNotDivideOne`). Contradiction.
//
// Everything is PURE — no oracle. The nonlinear algebra is `polynomial(peano)`;
// the cancellation is `mulCancelLeft`; the parity is `std/peano-parity.bpa`.

import peano <<< "std/peano.bpa"
import ordering <<< "std/peano-ordering.bpa"
import division <<< "std/peano-division.bpa"
import gcd <<< "std/peano-gcd.bpa"
import parity <<< "std/peano-parity.bpa"

sort Nat = peano.Nat
const ZERO = peano.ZERO
const ONE = peano.ONE
func succ = peano.succ
func add = peano.add
func mul = peano.mul
func gcd_of = gcd.gcd
pred divides = division.divides

axiom dividesIntro = division.dividesIntro
axiom dividesElim = division.dividesElim
axiom succNotZero = peano.succNotZero
axiom oneIsSuccZero = peano.oneIsSuccZero
axiom addSuccLeft = peano.addSuccLeft
theorem mulCancelLeft = ordering.mulCancelLeft
theorem gcdGreatest = gcd.gcdGreatest
theorem evenSquareEven = parity.evenSquareEven
theorem twoNotDivideOne = parity.twoNotDivideOne

// TWO must match parity's definition (add(ONE, ONE)) so evenSquareEven,
// twoNotDivideOne and the polynomial algebra all line up on the same term.
define TWO = add(ONE, ONE)

theorem sqrtTwoIrrational: forall p, q: Nat; gcd_of(p, q) = ONE -> mul(p, p) != mul(TWO, mul(q, q))
proof
  @generalize-p |
    fix p: Nat {
      @generalize-q |
        fix q: Nat {
          @given-coprime |
            assume gcd_of(p, q) = ONE {
              @coprime |
                gcd_of(p, q) = ONE
                [by hypothesis given-coprime]
              @suppose-square |
                assume mul(p, p) = mul(TWO, mul(q, q)) {
                  @square-eq |
                    mul(p, p) = mul(TWO, mul(q, q))
                    [by hypothesis suppose-square]

          // 2 | p²  (witness q²)
                  @intro |
                    forall d, n, k: Nat; n = mul(d, k) -> divides(d, n)
                    [by axiom dividesIntro]
                  @intro-psq |
                    mul(p, p) = mul(TWO, mul(q, q)) -> divides(TWO, mul(p, p))
                    [by forall_elim(TWO, mul(p, p), mul(q, q)) intro]
                  @two-div-psq |
                    divides(TWO, mul(p, p))
                    [by modus_ponens intro-psq square-eq]

          // 2 | p
                  @sq-even-thm |
                    forall n: Nat; divides(TWO, mul(n, n)) -> divides(TWO, n)
                    [by theorem evenSquareEven]
                  @sq-even-at-p |
                    divides(TWO, mul(p, p)) -> divides(TWO, p)
                    [by forall_elim(p) sq-even-thm]
                  @two-div-p |
                    divides(TWO, p)
                    [by modus_ponens sq-even-at-p two-div-psq]

          // p = 2k
                  @elim |
                    forall d, n: Nat; divides(d, n) -> exists k: Nat; n = mul(d, k)
                    [by axiom dividesElim]
                  @elim-at-p |
                    divides(TWO, p) -> exists k: Nat; p = mul(TWO, k)
                    [by forall_elim(TWO, p) elim]
                  @p-even-exists |
                    exists k: Nat; p = mul(TWO, k)
                    [by modus_ponens elim-at-p two-div-p]
                  @with-k |
                    unpack k: Nat from p-even-exists {
                      @p-is-2k |
                        p = mul(TWO, k)
                        [by hypothesis with-k]

            // substitute p = 2k into p² = 2q²
                      @sq-refl |
                        mul(p, p) = mul(p, p)
                        [by reflexivity]
                      @sq-1 |
                        mul(p, p) = mul(mul(TWO, k), p)
                        [by rewrite p-is-2k sq-refl]
                      @sq-2 |
                        mul(p, p) = mul(mul(TWO, k), mul(TWO, k))
                        [by rewrite p-is-2k sq-1]

            // (2k)² = 2·(2·k²)
                      @expand |
                        mul(mul(TWO, k), mul(TWO, k)) = mul(TWO, mul(TWO, mul(k, k)))
                        [by polynomial(peano)]
                      @lhs-expanded |
                        mul(p, p) = mul(TWO, mul(TWO, mul(k, k)))
                        [by rewrite expand sq-2]
            // so 2·(2k²) = 2q²
                      @two-two-ksq-eq-two-qsq |
                        mul(TWO, mul(TWO, mul(k, k))) = mul(TWO, mul(q, q))
                        [by rewrite lhs-expanded square-eq]

            // cancel the left 2:  2k² = q²  (TWO = 1+1 = succ(1) != 0)
                      @two-as-succ |
                        add(ONE, ONE) = succ(add(ZERO, ONE))
                        [by simplify addSuccLeft oneIsSuccZero]
                      @succ-as-two |
                        succ(add(ZERO, ONE)) = add(ONE, ONE)
                        [by symmetry two-as-succ]
                      @succ-not-zero |
                        forall a: Nat; succ(a) != ZERO
                        [by axiom succNotZero]
                      @succ-form-not-zero |
                        succ(add(ZERO, ONE)) != ZERO
                        [by forall_elim(add(ZERO, ONE)) succ-not-zero]
                      @two-nonzero |
                        TWO != ZERO
                        [by rewrite succ-as-two succ-form-not-zero]
                      @cancel |
                        forall c, a, b: Nat; c != ZERO -> mul(c, a) = mul(c, b) -> a = b
                        [by theorem mulCancelLeft]
                      @cancel-at |
                        TWO != ZERO -> mul(TWO, mul(TWO, mul(k, k))) = mul(TWO, mul(q, q)) -> mul(TWO, mul(k, k)) = mul(q, q)
                        [by forall_elim(TWO, mul(TWO, mul(k, k)), mul(q, q)) cancel]
                      @cancel-1 |
                        mul(TWO, mul(TWO, mul(k, k))) = mul(TWO, mul(q, q)) -> mul(TWO, mul(k, k)) = mul(q, q)
                        [by modus_ponens cancel-at two-nonzero]
                      @two-ksq-eq-qsq |
                        mul(TWO, mul(k, k)) = mul(q, q)
                        [by modus_ponens cancel-1 two-two-ksq-eq-two-qsq]
                      @qsq-eq-two-ksq |
                        mul(q, q) = mul(TWO, mul(k, k))
                        [by symmetry two-ksq-eq-qsq]

            // 2 | q²  (witness k²), then 2 | q
                      @intro-qsq |
                        mul(q, q) = mul(TWO, mul(k, k)) -> divides(TWO, mul(q, q))
                        [by forall_elim(TWO, mul(q, q), mul(k, k)) intro]
                      @two-div-qsq |
                        divides(TWO, mul(q, q))
                        [by modus_ponens intro-qsq qsq-eq-two-ksq]
                      @sq-even-at-q |
                        divides(TWO, mul(q, q)) -> divides(TWO, q)
                        [by forall_elim(q) sq-even-thm]
                      @two-div-q |
                        divides(TWO, q)
                        [by modus_ponens sq-even-at-q two-div-qsq]

            // 2 | gcd(p, q) = 1
                      @greatest |
                        forall b, a, d: Nat; divides(d, a) -> divides(d, b) -> divides(d, gcd_of(a, b))
                        [by theorem gcdGreatest]
                      @greatest-at |
                        divides(TWO, p) -> divides(TWO, q) -> divides(TWO, gcd_of(p, q))
                        [by forall_elim(q, p, TWO) greatest]
                      @g1 |
                        divides(TWO, q) -> divides(TWO, gcd_of(p, q))
                        [by modus_ponens greatest-at two-div-p]
                      @two-div-gcd |
                        divides(TWO, gcd_of(p, q))
                        [by modus_ponens g1 two-div-q]
                      @two-div-one |
                        divides(TWO, ONE)
                        [by rewrite coprime two-div-gcd]

            // but 2 does not divide 1
                      @not-two-div-one |
                        not divides(TWO, ONE)
                        [by theorem twoNotDivideOne]
                      @contradiction |
                        mul(p, p) != mul(TWO, mul(q, q))
                        [by absurd two-div-one not-two-div-one]
                    }
                  @square-impossible |
                    mul(p, p) != mul(TWO, mul(q, q))
                    [by exists_elim with-k]
                }
              @conclusion-p-squared-is-not-twice-q-squared |
                mul(p, p) != mul(TWO, mul(q, q))
                [by not_intro suppose-square square-eq square-impossible]
            }
          @discharge-coprime |
            gcd_of(p, q) = ONE -> mul(p, p) != mul(TWO, mul(q, q))
            [by implies_intro given-coprime]
        }
      @discharge-q |
        forall q: Nat; gcd_of(p, q) = ONE -> mul(p, p) != mul(TWO, mul(q, q))
        [by forall_intro generalize-q]
    }
  @conclusion |
    forall p, q: Nat; gcd_of(p, q) = ONE -> mul(p, p) != mul(TWO, mul(q, q))
    [by forall_intro generalize-p]
qed
