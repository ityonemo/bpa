// LEVEL 1 build target (model-parameters branch) — the TWO-LAYER STACK.
// NORTH STAR: check as Level 1 comes together; each error is the next missing piece.
// Pairs with aspirational-subgroup.bpa (the standalone, group-independent subgroup
// theory). Delete both before merge.
//
// THE DESIGN (settled): a concrete subgroup `inH` of a group `Grp`.
//  1. HSubGroup models the (standalone) subgroup theory onto inH — reifying its
//     group-shaped vocabulary + criteria onto the concrete membership predicate.
//  2. HGroup says "inH is a group" by routing each `group.X` obligation THROUGH
//     HSubGroup via the `@`-projection MAPPING VALUE: `group.X: HSubGroup@subgroup.X`.
//     This is the inverted dependency made explicit and walkable.
//  3. A group theorem then transfers onto the subgroup through HGroup.

import group <<< "std/group.bpa"
import subgroup <<< "aspirational-subgroup.bpa"

// the ambient GROUP, reified into this file.
sort Grp = group.Grp
const E = group.E
func op = group.op
func inverse = group.inverse

// a concrete subgroup membership predicate over Grp + its predicated carrier.
pred inH(g: Grp)
sort H = Grp where inH

// its criteria, asserted here (a concrete subgroup would PROVE these).
axiom hHasIdentity: inH(E)
axiom hClosedOp: forall a, b: Grp; inH(a) -> inH(b) -> inH(op(a, b))
axiom hClosedInverse: forall a: Grp; inH(a) -> inH(inverse(a))

// ── LAYER 1: HSubGroup — inH IS a subgroup (models the subgroup theory). ──────
// The subgroup theory's carrier `Sub` maps to the guarded H; its group-shaped
// primitives to Grp's; its criteria to inH's.
model HSubGroup {
  subgroup.Grp: Grp
  subgroup.Sub: H
  subgroup.op: op
  subgroup.inverse: inverse
  subgroup.E: E
  subgroup.inSubgroup: inH
  subgroup.subgroupHasIdentity: hHasIdentity
  subgroup.subgroupClosedOp: hClosedOp
  subgroup.subgroupClosedInverse: hClosedInverse
  // the subgroup theory's abstract PARENT group IS the real group:
  subgroup.grpAssoc: group.opAssoc
  subgroup.grpIdentityLeft: group.opIdentityLeft
  subgroup.grpIdentityRight: group.opIdentityRight
  subgroup.grpInverseLeft: group.opInverseLeft
  subgroup.grpInverseRight: group.opInverseRight
}

// ── LAYER 2: HGroup — inH IS a group, routing each group.X THROUGH HSubGroup. ─
model HGroup {
  group.Grp: H
  group.op: op
  group.inverse: inverse
  group.E: E
  group.opAssoc: HSubGroup@subgroup.opAssoc
  group.opIdentityLeft: HSubGroup@subgroup.opIdentityLeft
  group.opIdentityRight: HSubGroup@subgroup.opIdentityRight
  group.opInverseLeft: HSubGroup@subgroup.opInverseLeft
  group.opInverseRight: HSubGroup@subgroup.opInverseRight
}

// ── the payoff: a GROUP theorem transferred onto the subgroup through HGroup. ─
theorem hIdentityUnique: forall x: H; (forall g: H; op(x, g) = g) -> x = E
proof
  @conclusion |
    forall x: H; (forall g: H; op(x, g) = g) -> x = E
    [by model(HGroup) group.identityUnique]
qed
