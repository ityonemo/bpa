// std/divisibility.bpa — the abstract theory of DIVISIBILITY over a carrier with
// a multiplication (and an addition, for the sum law). `divides(d, n)` means
// "d divides n", i.e. n is a multiple of d: ∃k; n = d·k.
//
// This is a reusable abstract theory: any concrete structure with a `mul`
// (associative, with a right identity ONE) and an `add` (left-distributing over
// mul) is a model of it, and inherits the basic divisibility facts — reflexivity,
// closure under multiplication, and closure under addition of common divisors —
// via `model`, instead of re-proving them. Both ℕ (std/peano-division.bpa) and ℤ
// (std/integer-divides.bpa) model this.
//
// The multiplicative facts the proofs rely on (`mulOneRight`, `mulIsAssociative`,
// `mulAddDistribLeft`) are stated here as axioms — the OBLIGATIONS a model
// discharges by mapping them to its carrier's proven versions.

sort Dividable
const ONE: Dividable
func mul(a: Dividable, b: Dividable): Dividable
func add(a: Dividable, b: Dividable): Dividable

pred divides(d: Dividable, n: Dividable)
axiom dividesIntro: forall n, d, k: Dividable; n = mul(d, k) -> divides(d, n)
axiom dividesElim: forall d, n: Dividable; divides(d, n) -> exists k: Dividable; n = mul(d, k)

// the multiplicative structure the divisibility proofs rely on (obligations).
axiom mulOneRight: forall n: Dividable; mul(n, ONE) = n
axiom mulIsAssociative: forall a, b, c: Dividable; mul(mul(a, b), c) = mul(a, mul(b, c))
axiom mulAddDistribLeft: forall a, b, c: Dividable; mul(a, add(b, c)) = add(mul(a, b), mul(a, c))

// -- basic divisibility facts -----------------------------------------------

// d | d, witnessed by 1: d = d·1.
theorem dividesRefl: forall d: Dividable; divides(d, d)
proof
  @generalize-d |
    fix d: Dividable {
      @mul-one |
        forall n: Dividable; mul(n, ONE) = n
        [by axiom mulOneRight]
      @d-is-d-times-one |
        mul(d, ONE) = d
        [by forall_elim(d) mul-one]
      @d-eq |
        d = mul(d, ONE)
        [by symmetry d-is-d-times-one]
      @intro |
        forall n, a, k: Dividable; n = mul(a, k) -> divides(a, n)
        [by axiom dividesIntro]
      @intro-at |
        d = mul(d, ONE) -> divides(d, d)
        [by forall_elim(d, d, ONE) intro]
      @conclusion-divides |
        divides(d, d)
        [by modus_ponens intro-at d-eq]
    }
  @conclusion |
    forall d: Dividable; divides(d, d)
    [by forall_intro generalize-d]
qed

// d | a  =>  d | a·c: if a = d·k, then a·c = (d·k)·c = d·(k·c), so d divides a·c.
// Unpack the quotient k from d | a, reassociate the triple product with
// mulIsAssociative, then repackage via dividesIntro with witness k·c.
theorem dividesMul: forall d, a, c: Dividable; divides(d, a) -> divides(d, mul(a, c))
proof
  @generalize-d |
    fix d: Dividable {
      @generalize-a |
        fix a: Dividable {
          @generalize-c |
            fix c: Dividable {
              @given-d-divides-a |
                assume divides(d, a) {
                  @d-divides-a |
                    divides(d, a)
                    [by hypothesis given-d-divides-a]
                  @divisor-yields-witness |
                    forall dd, n: Dividable; divides(dd, n) -> exists k: Dividable; n = mul(dd, k)
                    [by axiom dividesElim]
                  @a-is-d-multiple-if-d-divides |
                    divides(d, a) -> exists k: Dividable; a = mul(d, k)
                    [by forall_elim(d, a) divisor-yields-witness]
                  @a-is-d-multiple |
                    exists k: Dividable; a = mul(d, k)
                    [by modus_ponens a-is-d-multiple-if-d-divides d-divides-a]
                  @with-quotient-k |
                    unpack k: Dividable from a-is-d-multiple {
                      @a-equals-d-times-k |
                        a = mul(d, k)
                        [by hypothesis with-quotient-k]
                      @product-refl |
                        mul(a, c) = mul(a, c)
                        [by reflexivity]
                      @product-with-a-expanded |
                        mul(a, c) = mul(mul(d, k), c)
                        [by rewrite a-equals-d-times-k product-refl]
                      @mul-associative |
                        forall x, y, z: Dividable; mul(mul(x, y), z) = mul(x, mul(y, z))
                        [by axiom mulIsAssociative]
                      @product-reassociates |
                        mul(mul(d, k), c) = mul(d, mul(k, c))
                        [by forall_elim(d, k, c) mul-associative]
                      @product-is-d-multiple |
                        mul(a, c) = mul(d, mul(k, c))
                        [by rewrite product-reassociates product-with-a-expanded]
                      @multiple-divides |
                        forall n, dd, j: Dividable; n = mul(dd, j) -> divides(dd, n)
                        [by axiom dividesIntro]
                      @witness-yields-d-divides-product |
                        mul(a, c) = mul(d, mul(k, c)) -> divides(d, mul(a, c))
                        [by forall_elim(mul(a, c), d, mul(k, c)) multiple-divides]
                      @d-divides-product-under-witness |
                        divides(d, mul(a, c))
                        [by modus_ponens witness-yields-d-divides-product product-is-d-multiple]
                    }
                  @d-divides-product |
                    divides(d, mul(a, c))
                    [by exists_elim with-quotient-k]
                }
              @d-divides-a-implies-d-divides-product |
                divides(d, a) -> divides(d, mul(a, c))
                [by implies_intro given-d-divides-a]
            }
          @discharge-c |
            forall c: Dividable; divides(d, a) -> divides(d, mul(a, c))
            [by forall_intro generalize-c]
        }
      @discharge-a |
        forall a, c: Dividable; divides(d, a) -> divides(d, mul(a, c))
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall d, a, c: Dividable; divides(d, a) -> divides(d, mul(a, c))
    [by forall_intro generalize-d]
qed

// d | a  and  d | b  =>  d | a+b: if a = d·j and b = d·k, then a+b = d·(j+k) by
// left-distributivity, so d divides a+b. Unpack both quotients, collect the sum
// with mulAddDistribLeft, then repackage via dividesIntro with witness j+k.
theorem dividesAdd: forall d, a, b: Dividable; divides(d, a) -> divides(d, b) -> divides(d, add(a, b))
proof
  @generalize-d |
    fix d: Dividable {
      @generalize-a |
        fix a: Dividable {
          @generalize-b |
            fix b: Dividable {
              @given-d-divides-a |
                assume divides(d, a) {
                  @given-d-divides-b |
                    assume divides(d, b) {
                      @d-divides-a |
                        divides(d, a)
                        [by hypothesis given-d-divides-a]
                      @d-divides-b |
                        divides(d, b)
                        [by hypothesis given-d-divides-b]
                      @divisor-yields-witness |
                        forall dd, n: Dividable; divides(dd, n) -> exists k: Dividable; n = mul(dd, k)
                        [by axiom dividesElim]
                      @a-is-d-multiple-if-d-divides |
                        divides(d, a) -> exists k: Dividable; a = mul(d, k)
                        [by forall_elim(d, a) divisor-yields-witness]
                      @a-is-d-multiple |
                        exists k: Dividable; a = mul(d, k)
                        [by modus_ponens a-is-d-multiple-if-d-divides d-divides-a]
                      @b-is-d-multiple-if-d-divides |
                        divides(d, b) -> exists k: Dividable; b = mul(d, k)
                        [by forall_elim(d, b) divisor-yields-witness]
                      @b-is-d-multiple |
                        exists k: Dividable; b = mul(d, k)
                        [by modus_ponens b-is-d-multiple-if-d-divides d-divides-b]
                      @with-quotient-j |
                        unpack j: Dividable from a-is-d-multiple {
                          @a-equals-d-times-j |
                            a = mul(d, j)
                            [by hypothesis with-quotient-j]
                          @with-quotient-k |
                            unpack k: Dividable from b-is-d-multiple {
                              @b-equals-d-times-k |
                                b = mul(d, k)
                                [by hypothesis with-quotient-k]
                              @distribute-over-sum |
                                forall x, y, z: Dividable; mul(x, add(y, z)) = add(mul(x, y), mul(x, z))
                                [by axiom mulAddDistribLeft]
                              @sum-of-multiples-distributes |
                                mul(d, add(j, k)) = add(mul(d, j), mul(d, k))
                                [by forall_elim(d, j, k) distribute-over-sum]
                              @sum-of-products-collects |
                                add(mul(d, j), mul(d, k)) = mul(d, add(j, k))
                                [by symmetry sum-of-multiples-distributes]
                              @d-times-j-is-a |
                                mul(d, j) = a
                                [by symmetry a-equals-d-times-j]
                              @d-times-k-is-b |
                                mul(d, k) = b
                                [by symmetry b-equals-d-times-k]
                              @a-plus-multiple-is-d-multiple |
                                add(a, mul(d, k)) = mul(d, add(j, k))
                                [by rewrite d-times-j-is-a sum-of-products-collects]
                              @sum-is-d-multiple |
                                add(a, b) = mul(d, add(j, k))
                                [by rewrite d-times-k-is-b a-plus-multiple-is-d-multiple]
                              @multiple-divides |
                                forall n, dd, q: Dividable; n = mul(dd, q) -> divides(dd, n)
                                [by axiom dividesIntro]
                              @witness-yields-d-divides-sum |
                                add(a, b) = mul(d, add(j, k)) -> divides(d, add(a, b))
                                [by forall_elim(add(a, b), d, add(j, k)) multiple-divides]
                              @d-divides-sum-under-witness |
                                divides(d, add(a, b))
                                [by modus_ponens witness-yields-d-divides-sum sum-is-d-multiple]
                            }
                          @d-divides-sum-after-k |
                            divides(d, add(a, b))
                            [by exists_elim with-quotient-k]
                        }
                      @d-divides-sum |
                        divides(d, add(a, b))
                        [by exists_elim with-quotient-j]
                    }
                  @d-divides-b-implies-d-divides-sum |
                    divides(d, b) -> divides(d, add(a, b))
                    [by implies_intro given-d-divides-b]
                }
              @common-divisor-divides-sum |
                divides(d, a) -> divides(d, b) -> divides(d, add(a, b))
                [by implies_intro given-d-divides-a]
            }
          @discharge-b |
            forall b: Dividable; divides(d, a) -> divides(d, b) -> divides(d, add(a, b))
            [by forall_intro generalize-b]
        }
      @discharge-a |
        forall a, b: Dividable; divides(d, a) -> divides(d, b) -> divides(d, add(a, b))
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall d, a, b: Dividable; divides(d, a) -> divides(d, b) -> divides(d, add(a, b))
    [by forall_intro generalize-d]
qed
