// std/equivalence.bpa — the bridge between relations and sets for Chapter 1
// §1.2.3: the equivalence CLASS of an element as a Set.
//
// Sets (std/set.bpa) and relations (std/relation.bpa) both range over the SAME
// shared element carrier (std/element.bpa) — so they COMPOSE, and this file
// imports BOTH rather than re-declaring anything. A class is then a Set of the
// elements the relation relates, via a class constructor:
//
//   classOf(x) : Set   with   member(y, classOf(x)) <-> related(y, x)
//
// i.e. classOf(x) = [x] = { y : y ~ x }. With this one axiom the tractable heart
// of the equivalence/partition theorem — classes are nonempty, [x]=[y] iff x~y,
// and any two classes are equal or disjoint — becomes provable by extensionality
// over the membership/relation axioms. Because the relation is the SAME
// std/relation.bpa relation, its theorems (reflexive/symmetric/transitive
// projections, etc.) apply here directly.

import element <<< "std/element.bpa"
import set <<< "std/set.bpa"
import relation <<< "std/relation.bpa"

sort Universe = set.Universe
sort Set = set.Set

// re-exported set vocabulary
const emptyset = set.emptyset
func union = set.union
func intersection = set.intersection
pred member = set.member
axiom unionMember = set.unionMember
axiom intersectionMember = set.intersectionMember
axiom emptysetMember = set.emptysetMember
axiom extensionality = set.extensionality

// re-exported relation vocabulary (the SAME relation as std/relation.bpa)
pred related = relation.related
pred reflexive = relation.reflexive
pred symmetric = relation.symmetric
pred transitive = relation.transitive
pred equivalence = relation.equivalence
axiom reflexiveDef = relation.reflexiveDef
axiom symmetricDef = relation.symmetricDef
axiom transitiveDef = relation.transitiveDef
axiom equivalenceDef = relation.equivalenceDef

// -- equivalence classes as sets --------------------------------------------

// the class constructor: classOf(x) = [x] = { y : y ~ x }.
func classOf(x: Universe): Set

// y is in the class of x exactly when y ~ x. (Universe = Element = the shared
// carrier, so `member(y, ·)` and `related(y, x)` speak of the same y.)
axiom classMember: forall x: Universe; forall y: Universe;
  (member(y, classOf(x)) -> related(y, x))
  and (related(y, x) -> member(y, classOf(x)))
