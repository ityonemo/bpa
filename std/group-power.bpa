// std/group-power.bpa — group powers g^n over a Nat exponent, layered on top
// of std/group.bpa (the pure abstract group theory) and std/peano.bpa (the
// naturals). This is the group analogue of std/integer-ring.bpa's layering
// over std/integer.bpa: the primitive theory stays untouched, and the power
// function plus its exponent laws are defined and proved here.
//
// pow(g, n) is g composed with itself n times (g^0 = E, g^(n+1) = g^n · g).
// The foundational law is powAdd: g^(m+n) = g^m · g^n, proved by induction on
// the exponent n with g and m fixed.

import group <<< "std/group.bpa"
import peano <<< "std/peano.bpa"

// -- the group structure ----------------------------------------------------

sort Grp = group.Grp
const E = group.E
func op = group.op
func inverse = group.inverse
axiom opAssoc = group.opAssoc
theorem opIdentityRight = group.opIdentityRight

// -- the natural-number exponents -------------------------------------------

sort Nat = peano.Nat
const ZERO = peano.ZERO
func succ = peano.succ
func add = peano.add
axiom induction = peano.induction
theorem addZeroRight = peano.addZeroRight
theorem addSuccRight = peano.addSuccRight

// -- group powers -----------------------------------------------------------

func pow(g: Grp, n: Nat): Grp
axiom powZero: forall g: Grp; pow(g, ZERO) = E
axiom powSucc: forall g: Grp; forall n: Nat; pow(g, succ(n)) = op(pow(g, n), g)

// The exponent law g^(m+n) = g^m · g^n, by induction on n (g, m fixed).
// base n=0: both sides collapse to g^m (add(m,0)=m; g^0=E cancels on the
// right). step: add(m, succ k) = succ(add(m,k)), unfold pow twice and reassoc
// so the inductive hypothesis g^(m+k) = g^m·g^k lands.
theorem powAdd: forall g: Grp; forall m, n: Nat; pow(g, add(m, n)) = op(pow(g, m), pow(g, n))
proof
  @generalize-g |
    fix g: Grp {
      @generalize-m |
        fix m: Nat {
          // base case: add(m, ZERO) = m, and op(pow(g, m), pow(g, ZERO))
          // collapses to pow(g, m) via powZero + opIdentityRight.
          @add-m-zero |
            add(m, ZERO) = m
            [by specialize addZeroRight(m)]
          @pow-g-zero-is-identity |
            pow(g, ZERO) = E
            [by specialize powZero(g)]
          @op-with-identity |
            op(pow(g, m), E) = pow(g, m)
            [by specialize opIdentityRight(pow(g, m))]
          // pow(g, add(m, ZERO)) = pow(g, m) = op(pow(g, m), E) = op(pow(g, m), pow(g, ZERO))
          @base-case |
            pow(g, add(m, ZERO)) = op(pow(g, m), pow(g, ZERO))
            [by chain add-m-zero op-with-identity pow-g-zero-is-identity]

          // inductive step: assume g^(m+k) = g^m·g^k, show it for succ(k).
          @induction-step |
            fix k: Nat {
              @given-inductive-hypothesis |
                assume pow(g, add(m, k)) = op(pow(g, m), pow(g, k)) {
                  @inductive-hypothesis |
                    pow(g, add(m, k)) = op(pow(g, m), pow(g, k))
                    [by hypothesis given-inductive-hypothesis]

                  @pow-at-successor |
                    forall a: Grp; forall n: Nat; pow(a, succ(n)) = op(pow(a, n), a)
                    [by axiom powSucc]
                  // the exponent add(m, succ k) unfolds to succ(add(m, k)).
                  @exponent-unfolds |
                    add(m, succ(k)) = succ(add(m, k))
                    [by specialize addSuccRight(m, k)]

                  // unfold pow at succ(add(m, k)).
                  @lhs-unfolds |
                    pow(g, succ(add(m, k))) = op(pow(g, add(m, k)), g)
                    [by forall_elim(g, add(m, k)) pow-at-successor]

                  // reassociate op(op(g^m, g^k), g) = op(g^m, op(g^k, g)).
                  @reassociates |
                    op(op(pow(g, m), pow(g, k)), g) = op(pow(g, m), op(pow(g, k), g))
                    [by specialize opAssoc(pow(g, m), pow(g, k), g)]

                  // fold op(g^k, g) back into g^(succ k) via powSucc.
                  @right-factor-unfolds |
                    pow(g, succ(k)) = op(pow(g, k), g)
                    [by forall_elim(g, k) pow-at-successor]

                  // pow(g, add(m, succ k)) = pow(g, succ(add(m, k))) = op(g^(m+k), g)
                  //   = op(op(g^m, g^k), g) = op(g^m, op(g^k, g)) = op(g^m, g^(succ k))
                  @succ-case |
                    pow(g, add(m, succ(k))) = op(pow(g, m), pow(g, succ(k)))
                    [by chain exponent-unfolds lhs-unfolds inductive-hypothesis reassociates right-factor-unfolds]
                }
              @induction-step-at-k |
                pow(g, add(m, k)) = op(pow(g, m), pow(g, k)) -> pow(g, add(m, succ(k))) = op(pow(g, m), pow(g, succ(k)))
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-for-all-k |
            forall k: Nat; pow(g, add(m, k)) = op(pow(g, m), pow(g, k)) -> pow(g, add(m, succ(k))) = op(pow(g, m), pow(g, succ(k)))
            [by forall_intro induction-step]

          @powers-add-over-m-and-all-n |
            forall n: Nat; pow(g, add(m, n)) = op(pow(g, m), pow(g, n))
            [by instantiate induction((fun k: Nat => pow(g, add(m, k)) = op(pow(g, m), pow(g, k)))) base-case induction-step-for-all-k]
        }
      @discharge-m |
        forall m, n: Nat; pow(g, add(m, n)) = op(pow(g, m), pow(g, n))
        [by forall_intro generalize-m]
    }
  @conclusion |
    forall g: Grp; forall m, n: Nat; pow(g, add(m, n)) = op(pow(g, m), pow(g, n))
    [by forall_intro generalize-g]
qed
