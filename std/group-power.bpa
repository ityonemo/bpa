// std/group-power.bpa — integer powers g^n over a ℤ exponent, layered on top of
// std/group.bpa (the pure abstract group theory) and std/integer.bpa (the
// integers). This is the group analogue of std/integer-ring.bpa's layering over
// std/integer.bpa: the primitive group theory stays untouched, and the power
// function plus its exponent laws are defined and proved here.
//
// The EXPONENT is an integer, not a group element — g^n for n ∈ ℤ, where a
// NEGATIVE exponent means repeated multiplication by the inverse. So the power
// is ℤ-recursive in BOTH directions: g^0 = E, g^(n+1) = g^n · g (step up by g),
// g^(n−1) = g^n · g⁻¹ (step down by the inverse). Judson defines it piecewise
// over ℕ (g^n = n copies of g, g^{−n} = n copies of g⁻¹); this single two-sided
// ℤ-recursive function is the equivalent, and it is what the laws — stated for
// all m, n ∈ ℤ — quantify over. The laws are proved by bidirectional integer
// induction (base + successor step + predecessor step).

import group <<< "std/group.bpa"
import integer <<< "std/integer.bpa"

// -- the group structure ----------------------------------------------------

sort Grp = group.Grp
const E = group.E
func op = group.op
func inverse = group.inverse
axiom opAssoc = group.opAssoc
axiom opIdentityLeft = group.opIdentityLeft
theorem opIdentityRight = group.opIdentityRight
theorem opInverseRight = group.opInverseRight
theorem inverseUnique = group.inverseUnique
theorem invProduct = group.invProduct

// -- the integer exponents --------------------------------------------------

sort Int = integer.Int
const ZERO = integer.ZERO
func succ = integer.succ
func prev = integer.prev
func add = integer.add
func mul = integer.mul
func neg = integer.neg
theorem induction = integer.induction
theorem addZeroRight = integer.addZeroRight
theorem addSuccRight = integer.addSuccRight
theorem addPrevRight = integer.addPrevRight
theorem addNegRight = integer.addNegRight
theorem mulZeroRight = integer.mulZeroRight
theorem mulSuccRight = integer.mulSuccRight
theorem mulPrevRight = integer.mulPrevRight

// -- group powers over a ℤ exponent -----------------------------------------

func power(g: Grp, n: Int): Grp
axiom powerZero: forall g: Grp; power(g, ZERO) = E
axiom powerSucc: forall g: Grp; forall n: Int; power(g, succ(n)) = op(power(g, n), g)
axiom powerPrev: forall g: Grp; forall n: Int; power(g, prev(n)) = op(power(g, n), inverse(g))

// -- sanity: g^1 = g -------------------------------------------------------
// ONE = succ(ZERO), so g^1 = g^(succ 0) = op(g^0, g) = op(E, g) = g.
theorem powerOne: forall g: Grp; power(g, succ(ZERO)) = g
proof
  @generalize-g |
    fix g: Grp {
      @power-succ-zero |
        power(g, succ(ZERO)) = op(power(g, ZERO), g)
        [by specialize powerSucc(g, ZERO)]
      @power-zero-is-identity |
        power(g, ZERO) = E
        [by specialize powerZero(g)]
      @identity-left |
        op(E, g) = g
        [by specialize opIdentityLeft(g)]
      // g^(succ 0) = op(g^0, g) = op(E, g) = g. chain folds g^0 → E (congruence)
      // and then op(E, g) → g.
      @conclusion-power-one |
        power(g, succ(ZERO)) = g
        [by chain power-succ-zero power-zero-is-identity identity-left]
    }
  @conclusion |
    forall g: Grp; power(g, succ(ZERO)) = g
    [by forall_intro generalize-g]
qed

// -- Law (1): g^(m+n) = g^m · g^n -------------------------------------------
// Bidirectional induction on n (g, m fixed). base n=0: add(m,0)=m and g^0=E
// cancels on the right. succ step: add(m, succ k) = succ(add(m,k)); unfold power
// twice and reassociate so the IH g^(m+k)=g^m·g^k lands. prev step: add(m, prev
// k) = prev(add(m,k)); unfold power via powerPrev twice and reassociate the same
// way, with inverse(g) as the trailing factor.
theorem powerAdd: forall g: Grp; forall m, n: Int; op(power(g, m), power(g, n)) = power(g, add(m, n))
proof
  @generalize-g |
    fix g: Grp {
      @generalize-m |
        fix m: Int {
          // base case n = ZERO.
          @add-m-zero |
            add(m, ZERO) = m
            [by specialize addZeroRight(m)]
          @power-zero |
            power(g, ZERO) = E
            [by specialize powerZero(g)]
          @op-with-identity |
            op(power(g, m), E) = power(g, m)
            [by specialize opIdentityRight(power(g, m))]
          // op(g^m, g^0) = op(g^m, E) = g^m = g^(m+0).
          @base-lhs-collapses |
            op(power(g, m), power(g, ZERO)) = power(g, m)
            [by chain power-zero op-with-identity]
          @add-m-zero-flipped |
            m = add(m, ZERO)
            [by symmetry add-m-zero]
          @base-case |
            op(power(g, m), power(g, ZERO)) = power(g, add(m, ZERO))
            [by chain base-lhs-collapses add-m-zero-flipped]

          // reusable recursion facts.
          @power-at-successor |
            forall a: Grp; forall n: Int; power(a, succ(n)) = op(power(a, n), a)
            [by axiom powerSucc]
          @power-at-predecessor |
            forall a: Grp; forall n: Int; power(a, prev(n)) = op(power(a, n), inverse(a))
            [by axiom powerPrev]

          // -- successor step: from n=k to n=succ(k) ---------------------------
          @successor-step |
            fix k: Int {
              @given-ih-succ |
                assume op(power(g, m), power(g, k)) = power(g, add(m, k)) {
                  @ih-succ |
                    op(power(g, m), power(g, k)) = power(g, add(m, k))
                    [by hypothesis given-ih-succ]
                  @exponent-succ |
                    add(m, succ(k)) = succ(add(m, k))
                    [by specialize addSuccRight(m, k)]
                  // g^(m + succ k) = g^(succ(m+k)) = op(g^(m+k), g).
                  @rhs-unfolds |
                    power(g, succ(add(m, k))) = op(power(g, add(m, k)), g)
                    [by forall_elim(g, add(m, k)) power-at-successor]
                  // g^(succ k) = op(g^k, g).
                  @right-factor |
                    power(g, succ(k)) = op(power(g, k), g)
                    [by forall_elim(g, k) power-at-successor]
                  // op(g^m, g^(succ k)) = op(g^m, op(g^k, g)) = op(op(g^m, g^k), g)
                  //   = op(g^(m+k), g) = g^(succ(m+k)) = g^(m + succ k).
                  @reassociates |
                    op(power(g, m), op(power(g, k), g)) = op(op(power(g, m), power(g, k)), g)
                    [by symmetry op-assoc-succ]
                  @op-assoc-succ |
                    op(op(power(g, m), power(g, k)), g) = op(power(g, m), op(power(g, k), g))
                    [by specialize opAssoc(power(g, m), power(g, k), g)]
                  @lhs-expands |
                    op(power(g, m), power(g, succ(k))) = op(power(g, m), op(power(g, k), g))
                    [by rewrite right-factor op-refl-succ]
                  @op-refl-succ |
                    op(power(g, m), power(g, succ(k))) = op(power(g, m), power(g, succ(k)))
                    [by reflexivity]
                  @conclusion-succ |
                    op(power(g, m), power(g, succ(k))) = power(g, add(m, succ(k)))
                    [by chain lhs-expands reassociates ih-succ rhs-unfolds exponent-succ]
                }
              @ih-implies-succ |
                op(power(g, m), power(g, k)) = power(g, add(m, k)) -> op(power(g, m), power(g, succ(k))) = power(g, add(m, succ(k)))
                [by implies_intro given-ih-succ]
            }
          @successor-step-all-k |
            forall k: Int; op(power(g, m), power(g, k)) = power(g, add(m, k)) -> op(power(g, m), power(g, succ(k))) = power(g, add(m, succ(k)))
            [by forall_intro successor-step]

          // -- predecessor step: from n=k to n=prev(k) ------------------------
          @predecessor-step |
            fix k: Int {
              @given-ih-prev |
                assume op(power(g, m), power(g, k)) = power(g, add(m, k)) {
                  @ih-prev |
                    op(power(g, m), power(g, k)) = power(g, add(m, k))
                    [by hypothesis given-ih-prev]
                  @exponent-prev |
                    add(m, prev(k)) = prev(add(m, k))
                    [by specialize addPrevRight(m, k)]
                  // g^(m + prev k) = g^(prev(m+k)) = op(g^(m+k), g⁻¹).
                  @rhs-unfolds |
                    power(g, prev(add(m, k))) = op(power(g, add(m, k)), inverse(g))
                    [by forall_elim(g, add(m, k)) power-at-predecessor]
                  // g^(prev k) = op(g^k, g⁻¹).
                  @right-factor |
                    power(g, prev(k)) = op(power(g, k), inverse(g))
                    [by forall_elim(g, k) power-at-predecessor]
                  @op-assoc-prev |
                    op(op(power(g, m), power(g, k)), inverse(g)) = op(power(g, m), op(power(g, k), inverse(g)))
                    [by specialize opAssoc(power(g, m), power(g, k), inverse(g))]
                  @reassociates |
                    op(power(g, m), op(power(g, k), inverse(g))) = op(op(power(g, m), power(g, k)), inverse(g))
                    [by symmetry op-assoc-prev]
                  @lhs-expands |
                    op(power(g, m), power(g, prev(k))) = op(power(g, m), op(power(g, k), inverse(g)))
                    [by rewrite right-factor op-refl-prev]
                  @op-refl-prev |
                    op(power(g, m), power(g, prev(k))) = op(power(g, m), power(g, prev(k)))
                    [by reflexivity]
                  @conclusion-prev |
                    op(power(g, m), power(g, prev(k))) = power(g, add(m, prev(k)))
                    [by chain lhs-expands reassociates ih-prev rhs-unfolds exponent-prev]
                }
              @ih-implies-prev |
                op(power(g, m), power(g, k)) = power(g, add(m, k)) -> op(power(g, m), power(g, prev(k))) = power(g, add(m, prev(k)))
                [by implies_intro given-ih-prev]
            }
          @predecessor-step-all-k |
            forall k: Int; op(power(g, m), power(g, k)) = power(g, add(m, k)) -> op(power(g, m), power(g, prev(k))) = power(g, add(m, prev(k)))
            [by forall_intro predecessor-step]

          @powers-add-over-all-n |
            forall n: Int; op(power(g, m), power(g, n)) = power(g, add(m, n))
            [by instantiate induction((fun n: Int => op(power(g, m), power(g, n)) = power(g, add(m, n)))) base-case successor-step-all-k predecessor-step-all-k]
        }
      @discharge-m |
        forall m, n: Int; op(power(g, m), power(g, n)) = power(g, add(m, n))
        [by forall_intro generalize-m]
    }
  @conclusion |
    forall g: Grp; forall m, n: Int; op(power(g, m), power(g, n)) = power(g, add(m, n))
    [by forall_intro generalize-g]
qed

// -- helper: g^(−m) is the inverse of g^m -----------------------------------
// From powerAdd: op(g^m, g^(−m)) = g^(m + (−m)) = g^0 = E, so g^(−m) is a right
// inverse of g^m, hence equals inverse(g^m) by inverseUnique. (Avoids a direct
// induction, which would trip on non-commutativity of g^{−1}·g^{−k}.)
theorem powerNegInverse: forall g: Grp; forall m: Int; power(g, neg(m)) = inverse(power(g, m))
proof
  @generalize-g |
    fix g: Grp {
      @generalize-m |
        fix m: Int {
          @powers-add |
            op(power(g, m), power(g, neg(m))) = power(g, add(m, neg(m)))
            [by specialize powerAdd(g, m, neg(m))]
          @exponent-cancels |
            add(m, neg(m)) = ZERO
            [by specialize addNegRight(m)]
          @power-zero |
            power(g, ZERO) = E
            [by specialize powerZero(g)]
          // op(g^m, g^(−m)) = g^(m + (−m)) = g^0 = E.
          @product-is-identity |
            op(power(g, m), power(g, neg(m))) = E
            [by chain powers-add exponent-cancels power-zero]
          @conclusion-neg-inverse |
            power(g, neg(m)) = inverse(power(g, m))
            [by specialize inverseUnique(power(g, m), power(g, neg(m))) product-is-identity]
        }
      @discharge-m |
        forall m: Int; power(g, neg(m)) = inverse(power(g, m))
        [by forall_intro generalize-m]
    }
  @conclusion |
    forall g: Grp; forall m: Int; power(g, neg(m)) = inverse(power(g, m))
    [by forall_intro generalize-g]
qed

// -- Law (2): (g^m)^n = g^(mn) ----------------------------------------------
// Induction on n (g, m fixed), using powerAdd for the step. base n=0: both sides
// E (mul(m,0)=0). succ: (g^m)^(succ k) = op((g^m)^k, g^m) = op(g^(mk), g^m) =
// g^(mk+m) = g^(m·succ k) via mulSuccRight. prev: (g^m)^(prev k) = op((g^m)^k,
// inverse(g^m)) = op(g^(mk), g^(−m)) [powerNegInverse] = g^(mk + (−m)) =
// g^(m·prev k) via mulPrevRight.
theorem powerMul: forall g: Grp; forall m, n: Int; power(power(g, m), n) = power(g, mul(m, n))
proof
  @generalize-g |
    fix g: Grp {
      @generalize-m |
        fix m: Int {
          // base n = ZERO: (g^m)^0 = E = g^0 = g^(m·0).
          @gm-power-zero |
            power(power(g, m), ZERO) = E
            [by specialize powerZero(power(g, m))]
          @g-power-zero |
            power(g, ZERO) = E
            [by specialize powerZero(g)]
          @mul-m-zero |
            mul(m, ZERO) = ZERO
            [by specialize mulZeroRight(m)]
          @g-power-mul-m-zero |
            power(g, mul(m, ZERO)) = E
            [by chain mul-m-zero g-power-zero]
          @e-is-g-power-mul-m-zero |
            E = power(g, mul(m, ZERO))
            [by symmetry g-power-mul-m-zero]
          @base-case |
            power(power(g, m), ZERO) = power(g, mul(m, ZERO))
            [by chain gm-power-zero e-is-g-power-mul-m-zero]

          @gm-at-successor |
            forall n: Int; power(power(g, m), succ(n)) = op(power(power(g, m), n), power(g, m))
            [by forall_elim(power(g, m)) power-at-successor-generic]
          @power-at-successor-generic |
            forall a: Grp; forall n: Int; power(a, succ(n)) = op(power(a, n), a)
            [by axiom powerSucc]
          @gm-at-predecessor |
            forall n: Int; power(power(g, m), prev(n)) = op(power(power(g, m), n), inverse(power(g, m)))
            [by forall_elim(power(g, m)) power-at-predecessor-generic]
          @power-at-predecessor-generic |
            forall a: Grp; forall n: Int; power(a, prev(n)) = op(power(a, n), inverse(a))
            [by axiom powerPrev]

          // -- successor step ------------------------------------------------
          @successor-step |
            fix k: Int {
              @given-ih-succ |
                assume power(power(g, m), k) = power(g, mul(m, k)) {
                  @ih-succ |
                    power(power(g, m), k) = power(g, mul(m, k))
                    [by hypothesis given-ih-succ]
                  // (g^m)^(succ k) = op((g^m)^k, g^m) = op(g^(mk), g^m).
                  @lhs-unfolds |
                    power(power(g, m), succ(k)) = op(power(power(g, m), k), power(g, m))
                    [by forall_elim(k) gm-at-successor]
                  @fold-ih |
                    op(power(power(g, m), k), power(g, m)) = op(power(g, mul(m, k)), power(g, m))
                    [by rewrite ih-succ gm-succ-refl]
                  @gm-succ-refl |
                    op(power(power(g, m), k), power(g, m)) = op(power(power(g, m), k), power(g, m))
                    [by reflexivity]
                  // op(g^(mk), g^m) = g^(mk + m).
                  @powers-combine |
                    op(power(g, mul(m, k)), power(g, m)) = power(g, add(mul(m, k), m))
                    [by specialize powerAdd(g, mul(m, k), m)]
                  // mul(m, succ k) = add(mul(m,k), m).
                  @mul-succ |
                    mul(m, succ(k)) = add(mul(m, k), m)
                    [by specialize mulSuccRight(m, k)]
                  @mul-succ-flipped |
                    add(mul(m, k), m) = mul(m, succ(k))
                    [by symmetry mul-succ]
                  @exponent-succ |
                    power(g, add(mul(m, k), m)) = power(g, mul(m, succ(k)))
                    [by rewrite mul-succ-flipped exponent-succ-refl]
                  @exponent-succ-refl |
                    power(g, add(mul(m, k), m)) = power(g, add(mul(m, k), m))
                    [by reflexivity]
                  @conclusion-succ |
                    power(power(g, m), succ(k)) = power(g, mul(m, succ(k)))
                    [by chain lhs-unfolds fold-ih powers-combine exponent-succ]
                }
              @ih-implies-succ |
                power(power(g, m), k) = power(g, mul(m, k)) -> power(power(g, m), succ(k)) = power(g, mul(m, succ(k)))
                [by implies_intro given-ih-succ]
            }
          @successor-step-all-k |
            forall k: Int; power(power(g, m), k) = power(g, mul(m, k)) -> power(power(g, m), succ(k)) = power(g, mul(m, succ(k)))
            [by forall_intro successor-step]

          // -- predecessor step ----------------------------------------------
          @predecessor-step |
            fix k: Int {
              @given-ih-prev |
                assume power(power(g, m), k) = power(g, mul(m, k)) {
                  @ih-prev |
                    power(power(g, m), k) = power(g, mul(m, k))
                    [by hypothesis given-ih-prev]
                  // (g^m)^(prev k) = op((g^m)^k, inverse(g^m)) = op(g^(mk), g^(−m)).
                  @lhs-unfolds |
                    power(power(g, m), prev(k)) = op(power(power(g, m), k), inverse(power(g, m)))
                    [by forall_elim(k) gm-at-predecessor]
                  @neg-inverse |
                    power(g, neg(m)) = inverse(power(g, m))
                    [by specialize powerNegInverse(g, m)]
                  @inverse-as-neg-power |
                    inverse(power(g, m)) = power(g, neg(m))
                    [by symmetry neg-inverse]
                  @fold-ih |
                    op(power(power(g, m), k), inverse(power(g, m))) = op(power(g, mul(m, k)), power(g, neg(m)))
                    [by chain ih-prev inverse-as-neg-power]
                  // op(g^(mk), g^(−m)) = g^(mk + (−m)).
                  @powers-combine |
                    op(power(g, mul(m, k)), power(g, neg(m))) = power(g, add(mul(m, k), neg(m)))
                    [by specialize powerAdd(g, mul(m, k), neg(m))]
                  // mul(m, prev k) = add(mul(m,k), neg m).
                  @mul-prev |
                    mul(m, prev(k)) = add(mul(m, k), neg(m))
                    [by specialize mulPrevRight(m, k)]
                  @mul-prev-flipped |
                    add(mul(m, k), neg(m)) = mul(m, prev(k))
                    [by symmetry mul-prev]
                  @exponent-prev |
                    power(g, add(mul(m, k), neg(m))) = power(g, mul(m, prev(k)))
                    [by rewrite mul-prev-flipped exponent-prev-refl]
                  @exponent-prev-refl |
                    power(g, add(mul(m, k), neg(m))) = power(g, add(mul(m, k), neg(m)))
                    [by reflexivity]
                  @conclusion-prev |
                    power(power(g, m), prev(k)) = power(g, mul(m, prev(k)))
                    [by chain lhs-unfolds fold-ih powers-combine exponent-prev]
                }
              @ih-implies-prev |
                power(power(g, m), k) = power(g, mul(m, k)) -> power(power(g, m), prev(k)) = power(g, mul(m, prev(k)))
                [by implies_intro given-ih-prev]
            }
          @predecessor-step-all-k |
            forall k: Int; power(power(g, m), k) = power(g, mul(m, k)) -> power(power(g, m), prev(k)) = power(g, mul(m, prev(k)))
            [by forall_intro predecessor-step]

          @powers-mul-over-all-n |
            forall n: Int; power(power(g, m), n) = power(g, mul(m, n))
            [by instantiate induction((fun n: Int => power(power(g, m), n) = power(g, mul(m, n)))) base-case successor-step-all-k predecessor-step-all-k]
        }
      @discharge-m |
        forall m, n: Int; power(power(g, m), n) = power(g, mul(m, n))
        [by forall_intro generalize-m]
    }
  @conclusion |
    forall g: Grp; forall m, n: Int; power(power(g, m), n) = power(g, mul(m, n))
    [by forall_intro generalize-g]
qed
