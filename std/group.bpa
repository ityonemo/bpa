// std/group.bpa — the theory of a GROUP: a set with an associative operation, a
// two-sided identity, and two-sided inverses, plus the elementary properties
// proved from those axioms.
//
// This is a reusable abstract theory (like std/peano). It is driven ENTIRELY by
// its own cited axioms — proofs use `[by assoc(opAssoc)]`,
// `[by rewrite opIdentityLeft ...]`, etc., naming these axioms explicitly. Do NOT
// invoke `polynomial`/`arithmetic` here: those tactics presume a
// commutative-semiring `add`/`mul`, which a (possibly non-abelian) group's `op`
// is not.

sort Grp
const E: Grp
func op(a: Grp, b: Grp): Grp
func inverse(a: Grp): Grp

// A group's three axioms (the identity and inverse laws are two-sided).
axiom opAssoc: forall a, b, c: Grp; op(op(a, b), c) = op(a, op(b, c))
axiom opIdentityLeft: forall a: Grp; op(E, a) = a
axiom opIdentityRight: forall a: Grp; op(a, E) = a
axiom opInverseLeft: forall a: Grp; op(inverse(a), a) = E
axiom opInverseRight: forall a: Grp; op(a, inverse(a)) = E

// Commutativity is OPT-IN, not a group axiom: a theorem is "abelian" precisely
// when its proof CITES `opCommutative` — its mere presence taints nothing, since
// axioms are opt-in via import/alias and provenance is per-proof. General group
// theorems (invProduct, cancelLeft, …) never cite it and stay valid for all
// groups; abelian-specific results cite it. A consumer modeling an abelian
// structure (e.g. Int under +) aliases/discharges `opCommutative` too; a
// non-abelian one simply never touches it.
axiom opCommutative: forall a, b: Grp; op(a, b) = op(b, a)

// -- basic properties -----------------------------------------------------
// The elementary group theorems proved from the axioms above.

theorem identityUnique: forall x: Grp; (forall g: Grp; op(x, g) = g) -> x = E
proof
  @generalize-x |
    fix x: Grp {
      @given-x-is-left-identity |
        assume forall g: Grp; op(x, g) = g {
          @x-left-id |
            forall g: Grp; op(x, g) = g
            [by hypothesis given-x-is-left-identity]
          @x-times-E-is-E |
            op(x, E) = E
            [by forall_elim(E) x-left-id]
          @id-right |
            forall a: Grp; op(a, E) = a
            [by axiom opIdentityRight]
          @x-times-E-is-x |
            op(x, E) = x
            [by forall_elim(x) id-right]
          @x-is-E |
            x = E
            [by rewrite x-times-E-is-x x-times-E-is-E]
        }
      @discharge |
        (forall g: Grp; op(x, g) = g) -> x = E
        [by implies_intro given-x-is-left-identity]
    }
  @conclusion |
    forall x: Grp; (forall g: Grp; op(x, g) = g) -> x = E
    [by forall_intro generalize-x]
qed
theorem inverseUnique: forall a, b: Grp; op(a, b) = E -> b = inverse(a)
proof
  @generalize-a |
    fix a: Grp {
      @generalize-b |
        fix b: Grp {
          @given-b-is-right-inverse-of-a |
            assume op(a, b) = E {
              @ab-is-E |
                op(a, b) = E
                [by hypothesis given-b-is-right-inverse-of-a]
              @id-left |
                forall g: Grp; op(E, g) = g
                [by axiom opIdentityLeft]
              @b-eq |
                op(E, b) = b
                [by forall_elim(b) id-left]
              @b-is-eb |
                b = op(E, b)
                [by symmetry b-eq]
              @inv-left |
                forall g: Grp; op(inverse(g), g) = E
                [by axiom opInverseLeft]
              @inva-a-is-E |
                op(inverse(a), a) = E
                [by forall_elim(a) inv-left]
              @E-is-inva-a |
                E = op(inverse(a), a)
                [by symmetry inva-a-is-E]
              @b-is-inva-a-b |
                b = op(op(inverse(a), a), b)
                [by rewrite E-is-inva-a b-is-eb]
              @assoc-step |
                op(op(inverse(a), a), b) = op(inverse(a), op(a, b))
                [by assoc(opAssoc)]
              @b-is-inva-ab |
                b = op(inverse(a), op(a, b))
                [by rewrite assoc-step b-is-inva-a-b]
              @b-is-inva-E |
                b = op(inverse(a), E)
                [by rewrite ab-is-E b-is-inva-ab]
              @id-right |
                forall g: Grp; op(g, E) = g
                [by axiom opIdentityRight]
              @inva-E-is-inva |
                op(inverse(a), E) = inverse(a)
                [by forall_elim(inverse(a)) id-right]
              @b-is-inva |
                b = inverse(a)
                [by rewrite inva-E-is-inva b-is-inva-E]
            }
          @discharge |
            op(a, b) = E -> b = inverse(a)
            [by implies_intro given-b-is-right-inverse-of-a]
        }
      @discharge-b |
        forall b: Grp; op(a, b) = E -> b = inverse(a)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Grp; op(a, b) = E -> b = inverse(a)
    [by forall_intro generalize-a]
qed
theorem invProduct: forall a, b: Grp; inverse(op(a, b)) = op(inverse(b), inverse(a))
proof
  @generalize-a |
    fix a: Grp {
      @generalize-b |
        fix b: Grp {
          @rearrange |
            op(op(a, b), op(inverse(b), inverse(a))) = op(a, op(op(b, inverse(b)), inverse(a)))
            [by assoc(opAssoc)]
          @b-invb |
            forall g: Grp; op(g, inverse(g)) = E
            [by axiom opInverseRight]
          @b-invb-is-E |
            op(b, inverse(b)) = E
            [by forall_elim(b) b-invb]
          @after-bb |
            op(op(a, b), op(inverse(b), inverse(a))) = op(a, op(E, inverse(a)))
            [by rewrite b-invb-is-E rearrange]
          @id-left |
            forall g: Grp; op(E, g) = g
            [by axiom opIdentityLeft]
          @E-inva |
            op(E, inverse(a)) = inverse(a)
            [by forall_elim(inverse(a)) id-left]
          @after-einva |
            op(op(a, b), op(inverse(b), inverse(a))) = op(a, inverse(a))
            [by rewrite E-inva after-bb]
          @a-inva |
            op(a, inverse(a)) = E
            [by forall_elim(a) b-invb]
          @product-is-E |
            op(op(a, b), op(inverse(b), inverse(a))) = E
            [by rewrite a-inva after-einva]
          @inv-unique |
            forall x, y: Grp; op(x, y) = E -> y = inverse(x)
            [by theorem inverseUnique]
          @inverse-unique-at-product |
            op(op(a, b), op(inverse(b), inverse(a))) = E -> op(inverse(b), inverse(a)) = inverse(op(a, b))
            [by forall_elim(op(a, b), op(inverse(b), inverse(a))) inv-unique]
          @product-of-inverses-is-inverse |
            op(inverse(b), inverse(a)) = inverse(op(a, b))
            [by modus_ponens inverse-unique-at-product product-is-E]
          @inverse-of-product-is-inverses-swapped |
            inverse(op(a, b)) = op(inverse(b), inverse(a))
            [by symmetry product-of-inverses-is-inverse]
        }
      @discharge-b |
        forall b: Grp; inverse(op(a, b)) = op(inverse(b), inverse(a))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Grp; inverse(op(a, b)) = op(inverse(b), inverse(a))
    [by forall_intro generalize-a]
qed
theorem invInvolution: forall a: Grp; inverse(inverse(a)) = a
proof
  @generalize-a |
    fix a: Grp {
      @inv-left |
        forall g: Grp; op(inverse(g), g) = E
        [by axiom opInverseLeft]
      @inva-a-is-E |
        op(inverse(a), a) = E
        [by forall_elim(a) inv-left]
      @inv-unique |
        forall x, y: Grp; op(x, y) = E -> y = inverse(x)
        [by theorem inverseUnique]
      @inverse-unique-at-inva-a |
        op(inverse(a), a) = E -> a = inverse(inverse(a))
        [by forall_elim(inverse(a), a) inv-unique]
      @a-is-invinva |
        a = inverse(inverse(a))
        [by modus_ponens inverse-unique-at-inva-a inva-a-is-E]
      @invinva-is-a |
        inverse(inverse(a)) = a
        [by symmetry a-is-invinva]
    }
  @conclusion |
    forall a: Grp; inverse(inverse(a)) = a
    [by forall_intro generalize-a]
qed
theorem solutionExists: forall b, a: Grp; op(op(b, inverse(a)), a) = b
proof
  @generalize-b |
    fix b: Grp {
      @generalize-a |
        fix a: Grp {
          @assoc-step |
            op(op(b, inverse(a)), a) = op(b, op(inverse(a), a))
            [by assoc(opAssoc)]
          @inv-left |
            forall g: Grp; op(inverse(g), g) = E
            [by axiom opInverseLeft]
          @inva-a |
            op(inverse(a), a) = E
            [by forall_elim(a) inv-left]
          @with-E |
            op(op(b, inverse(a)), a) = op(b, E)
            [by rewrite inva-a assoc-step]
          @id-right |
            forall g: Grp; op(g, E) = g
            [by axiom opIdentityRight]
          @b-times-identity-is-b |
            op(b, E) = b
            [by forall_elim(b) id-right]
          @product-with-inverse-cancels-to-b |
            op(op(b, inverse(a)), a) = b
            [by rewrite b-times-identity-is-b with-E]
        }
      @discharge-a |
        forall a: Grp; op(op(b, inverse(a)), a) = b
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall b, a: Grp; op(op(b, inverse(a)), a) = b
    [by forall_intro generalize-b]
qed
theorem solutionUnique: forall x, a, b, y: Grp;
  op(x, a) = b -> op(y, a) = b -> x = y
proof
  @generalize-x |
    fix x: Grp {
      @generalize-a |
        fix a: Grp {
          @generalize-b |
            fix b: Grp {
              @generalize-y |
                fix y: Grp {
                  @given-x |
                    assume op(x, a) = b {
                      @given-y |
                        assume op(y, a) = b {
                          @xa-b |
                            op(x, a) = b
                            [by hypothesis given-x]
                          @ya-b |
                            op(y, a) = b
                            [by hypothesis given-y]
                          @b-ya |
                            b = op(y, a)
                            [by symmetry ya-b]
                          @xa-ya |
                            op(x, a) = op(y, a)
                            [by rewrite b-ya xa-b]
                          // uniqueness = right-multiply by inverse(a) and simplify
                          // each side via z·(a·a⁻¹) = z·E = z (the standard
                          // x = a⁻¹ax argument, here on the right).
                          @xa-refl |
                            op(op(x, a), inverse(a)) = op(op(x, a), inverse(a))
                            [by reflexivity]
                          @right-multiply-by-inva |
                            op(op(x, a), inverse(a)) = op(op(y, a), inverse(a))
                            [by rewrite xa-ya xa-refl]
                          @assoc-x |
                            op(op(x, a), inverse(a)) = op(x, op(a, inverse(a)))
                            [by assoc(opAssoc)]
                          @a-inva |
                            forall g: Grp; op(g, inverse(g)) = E
                            [by axiom opInverseRight]
                          @a-inva-is-E |
                            op(a, inverse(a)) = E
                            [by forall_elim(a) a-inva]
                          @assoc-x-E |
                            op(op(x, a), inverse(a)) = op(x, E)
                            [by rewrite a-inva-is-E assoc-x]
                          @id-right |
                            forall g: Grp; op(g, E) = g
                            [by axiom opIdentityRight]
                          @x-E-is-x |
                            op(x, E) = x
                            [by forall_elim(x) id-right]
                          @lhs-is-x |
                            op(op(x, a), inverse(a)) = x
                            [by rewrite x-E-is-x assoc-x-E]
                          @assoc-y |
                            op(op(y, a), inverse(a)) = op(y, op(a, inverse(a)))
                            [by assoc(opAssoc)]
                          @assoc-y-E |
                            op(op(y, a), inverse(a)) = op(y, E)
                            [by rewrite a-inva-is-E assoc-y]
                          @y-E-is-y |
                            op(y, E) = y
                            [by forall_elim(y) id-right]
                          @rhs-is-y |
                            op(op(y, a), inverse(a)) = y
                            [by rewrite y-E-is-y assoc-y-E]
                          @x-is-mult |
                            x = op(op(x, a), inverse(a))
                            [by symmetry lhs-is-x]
                          @x-equals-y-side-product |
                            x = op(op(y, a), inverse(a))
                            [by rewrite right-multiply-by-inva x-is-mult]
                          @x-is-y |
                            x = y
                            [by rewrite rhs-is-y x-equals-y-side-product]
                        }
                      @disch-y |
                        op(y, a) = b -> x = y
                        [by implies_intro given-y]
                    }
                  @disch-x |
                    op(x, a) = b -> op(y, a) = b -> x = y
                    [by implies_intro given-x]
                }
              @discharge-y |
                forall y: Grp; op(x, a) = b -> op(y, a) = b -> x = y
                [by forall_intro generalize-y]
            }
          @discharge-b |
            forall b, y: Grp; op(x, a) = b -> op(y, a) = b -> x = y
            [by forall_intro generalize-b]
        }
      @discharge-a |
        forall a, b, y: Grp; op(x, a) = b -> op(y, a) = b -> x = y
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall x, a, b, y: Grp; op(x, a) = b -> op(y, a) = b -> x = y
    [by forall_intro generalize-x]
qed
theorem cancelRight: forall b, a, c: Grp; op(b, a) = op(c, a) -> b = c
proof
  @generalize-b |
    fix b: Grp {
      @generalize-a |
        fix a: Grp {
          @generalize-c |
            fix c: Grp {
              @given-right-products-equal |
                assume op(b, a) = op(c, a) {
                  @right-products-equal |
                    op(b, a) = op(c, a)
                    [by hypothesis given-right-products-equal]
                  @right-product-with-inverse-refl |
                    op(op(b, a), inverse(a)) = op(op(b, a), inverse(a))
                    [by reflexivity]
                  @right-multiply-by-inva |
                    op(op(b, a), inverse(a)) = op(op(c, a), inverse(a))
                    [by rewrite right-products-equal right-product-with-inverse-refl]
                  @reassociate-around-b |
                    op(op(b, a), inverse(a)) = op(b, op(a, inverse(a)))
                    [by assoc(opAssoc)]
                  @a-inva |
                    forall g: Grp; op(g, inverse(g)) = E
                    [by axiom opInverseRight]
                  @a-inva-is-E |
                    op(a, inverse(a)) = E
                    [by forall_elim(a) a-inva]
                  @assoc-b-E |
                    op(op(b, a), inverse(a)) = op(b, E)
                    [by rewrite a-inva-is-E reassociate-around-b]
                  @id-right |
                    forall g: Grp; op(g, E) = g
                    [by axiom opIdentityRight]
                  @b-E-is-b |
                    op(b, E) = b
                    [by forall_elim(b) id-right]
                  @lhs-is-b |
                    op(op(b, a), inverse(a)) = b
                    [by rewrite b-E-is-b assoc-b-E]
                  @reassociate-around-c |
                    op(op(c, a), inverse(a)) = op(c, op(a, inverse(a)))
                    [by assoc(opAssoc)]
                  @assoc-c-E |
                    op(op(c, a), inverse(a)) = op(c, E)
                    [by rewrite a-inva-is-E reassociate-around-c]
                  @c-E-is-c |
                    op(c, E) = c
                    [by forall_elim(c) id-right]
                  @rhs-is-c |
                    op(op(c, a), inverse(a)) = c
                    [by rewrite c-E-is-c assoc-c-E]
                  @b-is-mult |
                    b = op(op(b, a), inverse(a))
                    [by symmetry lhs-is-b]
                  @b-equals-c-side-product |
                    b = op(op(c, a), inverse(a))
                    [by rewrite right-multiply-by-inva b-is-mult]
                  @b-is-c |
                    b = c
                    [by rewrite rhs-is-c b-equals-c-side-product]
                }
              @discharge |
                op(b, a) = op(c, a) -> b = c
                [by implies_intro given-right-products-equal]
            }
          @discharge-c |
            forall c: Grp; op(b, a) = op(c, a) -> b = c
            [by forall_intro generalize-c]
        }
      @discharge-a |
        forall a, c: Grp; op(b, a) = op(c, a) -> b = c
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall b, a, c: Grp; op(b, a) = op(c, a) -> b = c
    [by forall_intro generalize-b]
qed
theorem cancelLeft: forall a, b, c: Grp; op(a, b) = op(a, c) -> b = c
proof
  @generalize-a |
    fix a: Grp {
      @generalize-b |
        fix b: Grp {
          @generalize-c |
            fix c: Grp {
              @given-left-products-equal |
                assume op(a, b) = op(a, c) {
                  @left-products-equal |
                    op(a, b) = op(a, c)
                    [by hypothesis given-left-products-equal]
                  @left-product-with-inverse-refl |
                    op(inverse(a), op(a, b)) = op(inverse(a), op(a, b))
                    [by reflexivity]
                  @left-multiply-by-inva |
                    op(inverse(a), op(a, b)) = op(inverse(a), op(a, c))
                    [by rewrite left-products-equal left-product-with-inverse-refl]
                  @reassociate-around-b |
                    op(op(inverse(a), a), b) = op(inverse(a), op(a, b))
                    [by assoc(opAssoc)]
                  @inv-left |
                    forall g: Grp; op(inverse(g), g) = E
                    [by axiom opInverseLeft]
                  @inva-a-is-E |
                    op(inverse(a), a) = E
                    [by forall_elim(a) inv-left]
                  @lhs1 |
                    op(E, b) = op(inverse(a), op(a, b))
                    [by rewrite inva-a-is-E reassociate-around-b]
                  @id-left |
                    forall g: Grp; op(E, g) = g
                    [by axiom opIdentityLeft]
                  @E-b-is-b |
                    op(E, b) = b
                    [by forall_elim(b) id-left]
                  @b-is-lhs |
                    b = op(inverse(a), op(a, b))
                    [by rewrite E-b-is-b lhs1]
                  @b-equals-c-side-product |
                    b = op(inverse(a), op(a, c))
                    [by rewrite left-multiply-by-inva b-is-lhs]
                  @reassociate-around-c |
                    op(op(inverse(a), a), c) = op(inverse(a), op(a, c))
                    [by assoc(opAssoc)]
                  @rhs1 |
                    op(E, c) = op(inverse(a), op(a, c))
                    [by rewrite inva-a-is-E reassociate-around-c]
                  @E-c-is-c |
                    op(E, c) = c
                    [by forall_elim(c) id-left]
                  @c-equals-c-side-product |
                    c = op(inverse(a), op(a, c))
                    [by rewrite E-c-is-c rhs1]
                  @rhs-is-c |
                    op(inverse(a), op(a, c)) = c
                    [by symmetry c-equals-c-side-product]
                  @b-is-c |
                    b = c
                    [by rewrite rhs-is-c b-equals-c-side-product]
                }
              @discharge |
                op(a, b) = op(a, c) -> b = c
                [by implies_intro given-left-products-equal]
            }
          @discharge-c |
            forall c: Grp; op(a, b) = op(a, c) -> b = c
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c: Grp; op(a, b) = op(a, c) -> b = c
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: Grp; op(a, b) = op(a, c) -> b = c
    [by forall_intro generalize-a]
qed
theorem selfInverse: (forall a: Grp; op(a, a) = E) -> forall a: Grp; inverse(a) = a
proof
  @given-every-square-is-identity |
    assume forall a: Grp; op(a, a) = E {
      @every-square-is-identity |
        forall a: Grp; op(a, a) = E
        [by hypothesis given-every-square-is-identity]
      @generalize-a |
        fix a: Grp {
          @aa-is-E |
            op(a, a) = E
            [by forall_elim(a) every-square-is-identity]
          @inv-unique |
            forall x, y: Grp; op(x, y) = E -> y = inverse(x)
            [by theorem inverseUnique]
          @inverse-unique-at-a-a |
            op(a, a) = E -> a = inverse(a)
            [by forall_elim(a, a) inv-unique]
          @a-is-inva |
            a = inverse(a)
            [by modus_ponens inverse-unique-at-a-a aa-is-E]
          @inva-is-a |
            inverse(a) = a
            [by symmetry a-is-inva]
        }
      @every-element-is-its-own-inverse-for-all-a |
        forall a: Grp; inverse(a) = a
        [by forall_intro generalize-a]
    }
  @conclusion |
    (forall a: Grp; op(a, a) = E) -> forall a: Grp; inverse(a) = a
    [by implies_intro given-every-square-is-identity]
qed

theorem squareIdImpliesAbelian:
  (forall a: Grp; op(a, a) = E) -> forall x, y: Grp; op(x, y) = op(y, x)
proof
  @given-every-square-is-identity |
    assume forall a: Grp; op(a, a) = E {
      @every-square-is-identity |
        forall a: Grp; op(a, a) = E
        [by hypothesis given-every-square-is-identity]
      @self-inv-thm |
        (forall a: Grp; op(a, a) = E) -> forall a: Grp; inverse(a) = a
        [by theorem selfInverse]
      @self-inv |
        forall a: Grp; inverse(a) = a
        [by modus_ponens self-inv-thm every-square-is-identity]
      @generalize-x |
        fix x: Grp {
          @generalize-y |
            fix y: Grp {
              @inv-prod-thm |
                forall a, b: Grp; inverse(op(a, b)) = op(inverse(b), inverse(a))
                [by theorem invProduct]
              @inv-xy |
                inverse(op(x, y)) = op(inverse(y), inverse(x))
                [by forall_elim(x, y) inv-prod-thm]
              @inv-x |
                inverse(x) = x
                [by forall_elim(x) self-inv]
              @inv-y |
                inverse(y) = y
                [by forall_elim(y) self-inv]
              @inv-xy-self |
                inverse(op(x, y)) = op(x, y)
                [by forall_elim(op(x, y)) self-inv]
              @inv-of-xy-equals-y-inv-x |
                inverse(op(x, y)) = op(y, inverse(x))
                [by rewrite inv-y inv-xy]
              @inv-of-xy-equals-y-x |
                inverse(op(x, y)) = op(y, x)
                [by rewrite inv-x inv-of-xy-equals-y-inv-x]
              @xy-is-inv |
                op(x, y) = inverse(op(x, y))
                [by symmetry inv-xy-self]
              @xy-is-yx |
                op(x, y) = op(y, x)
                [by rewrite inv-of-xy-equals-y-x xy-is-inv]
            }
          @discharge-y |
            forall y: Grp; op(x, y) = op(y, x)
            [by forall_intro generalize-y]
        }
      @commutes-for-all-x |
        forall x, y: Grp; op(x, y) = op(y, x)
        [by forall_intro generalize-x]
    }
  @conclusion |
    (forall a: Grp; op(a, a) = E) -> forall x, y: Grp; op(x, y) = op(y, x)
    [by implies_intro given-every-square-is-identity]
qed
