// std/integer-ring-model.bpa — ℤ as a thin model of the abstract ring theory.
//
// The integers are a ring: `model IntegerRing = Int` discharges std/ring.bpa's
// nine axioms from ℤ's own facts, and the ring corpus (the elementary negation
// results) TRANSFERS to ℤ instead of being re-derived. This
// exercises the THREE-LEVEL model chain ℤ → ring → group: ring's proofs
// themselves transfer group theorems (invInvolution, inverseUnique) through ring's
// AdditiveGroup model, and those materialize again into ℤ here.

import integer <<< "std/integer.bpa"
import ring_algebra <<< "std/integer-ring.bpa"
import ring <<< "std/ring.bpa"

sort Int = integer.Int
const ZERO = integer.ZERO
const ONE = integer.ONE
func add = integer.add
func mul = integer.mul
func neg = integer.neg

// the discharge facts (ℤ's own axioms + integer-ring theorems). ring's RIGHT
// identity/inverse laws (addZeroRight, addNegRight) are DERIVED theorems, so the
// IntegerRing model need not discharge them — it maps ring's axioms only.
axiom addZeroLeft = ring_algebra.addZeroLeft
theorem addIsAssociative = ring_algebra.addIsAssociative
theorem addIsCommutative = ring_algebra.addIsCommutative
theorem addNegLeft = ring_algebra.addNegLeft
theorem mulIsAssociative = ring_algebra.mulIsAssociative
theorem mulAddDistribLeft = ring_algebra.mulAddDistribLeft
theorem mulAddDistribRight = ring_algebra.mulAddDistribRight

// ℤ is a ring: discharge ring's nine axioms.
model IntegerRing {
  ring.Ring: Int
  ring.ZERO: ZERO
  ring.ONE: ONE
  ring.add: add
  ring.mul: mul
  ring.neg: neg
  ring.addAssoc: addIsAssociative
  ring.addZeroLeft: addZeroLeft
  ring.addNegLeft: addNegLeft
  ring.addCommutative: addIsCommutative
  ring.mulAssoc: mulIsAssociative
  ring.mulDistributesLeftOverAdd: mulAddDistribLeft
  ring.mulDistributesRightOverAdd: mulAddDistribRight
}

// transferred: (-a)·(-b) = a·b for integers — new to ℤ, and the deepest transfer
// (its ring proof transitively uses the additive-group invInvolution).
theorem negMulNeg: forall a, b: Int; mul(neg(a), neg(b)) = mul(a, b)
proof
  @conclusion |
    forall a, b: Int; mul(neg(a), neg(b)) = mul(a, b)
    [by model(IntegerRing) ring.negMulNeg]
qed
