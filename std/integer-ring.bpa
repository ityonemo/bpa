// std/integer-ring.bpa — the ring algebra of ℤ, PROVEN from std/integer.bpa's
// axioms (recursion on the LEFT in both directions + bidirectional induction).
//
// The integer axioms recurse add/mul on the LEFT argument; the RIGHT-recursion
// mirror lemmas (addSuccRight, addPrevRight, mulSuccRight, ...) are the
// bootstrap, proved by bidirectional induction, and everything else
// (commutativity, associativity, the additive inverse law `n + (-n) = 0`,
// distributivity) follows. This is the ℤ analogue of the Peano algebra in
// std/peano.bpa.

import integer <<< "std/integer.bpa"

sort Int = integer.Int
const ZERO = integer.ZERO
const ONE = integer.ONE
func succ = integer.succ
func prev = integer.prev
func add = integer.add
func mul = integer.mul
func neg = integer.neg
axiom prevSucc = integer.prevSucc
axiom succPrev = integer.succPrev
axiom oneIsSuccZero = integer.oneIsSuccZero
axiom addZeroLeft = integer.addZeroLeft
axiom addSuccLeft = integer.addSuccLeft
axiom addPrevLeft = integer.addPrevLeft
axiom negZero = integer.negZero
axiom negSucc = integer.negSucc
axiom negPrev = integer.negPrev
axiom mulZeroLeft = integer.mulZeroLeft
axiom mulSuccLeft = integer.mulSuccLeft
axiom mulPrevLeft = integer.mulPrevLeft
axiom induction = integer.induction

// -- addition: right identity + right recursion (the bootstrap) --------------
// The mirror of the LEFT recursion axioms in std/integer.bpa: each right-
// recursion equation is proved by bidirectional induction on the recursing
// (second) argument, using the left axioms.

// add(n, ZERO) = n, by bidirectional induction on n. Each case unfolds the
// left recursion and folds the inductive hypothesis — a job for `simplify`.
theorem addZeroRight: forall n: Int; add(n, ZERO) = n
proof
  @base |
    add(ZERO, ZERO) = ZERO
    [by simplify addZeroLeft]
  @generalize-succ |
    fix k: Int {
      @given-inductive-hypothesis |
        assume add(k, ZERO) = k {
          @inductive-hypothesis |
            add(k, ZERO) = k
            [by hypothesis given-inductive-hypothesis]
          @succ-case |
            add(succ(k), ZERO) = succ(k)
            [by simplify addSuccLeft inductive-hypothesis]
        }
      @discharge-succ |
        add(k, ZERO) = k -> add(succ(k), ZERO) = succ(k)
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-succ |
    forall k: Int; add(k, ZERO) = k -> add(succ(k), ZERO) = succ(k)
    [by forall_intro generalize-succ]
  @generalize-prev |
    fix k: Int {
      @given-inductive-hypothesis |
        assume add(k, ZERO) = k {
          @inductive-hypothesis |
            add(k, ZERO) = k
            [by hypothesis given-inductive-hypothesis]
          @prev-case |
            add(prev(k), ZERO) = prev(k)
            [by simplify addPrevLeft inductive-hypothesis]
        }
      @discharge-prev |
        add(k, ZERO) = k -> add(prev(k), ZERO) = prev(k)
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-prev |
    forall k: Int; add(k, ZERO) = k -> add(prev(k), ZERO) = prev(k)
    [by forall_intro generalize-prev]
  @conclusion |
    forall n: Int; add(n, ZERO) = n
    [by instantiate induction((fun m: Int => add(m, ZERO) = m)) base induction-step-succ induction-step-prev]
qed

// add(a, succ(b)) = succ(add(a, b)), by bidirectional induction on a — the
// right-successor recursion, bootstrapped from the left-recursion axioms. The
// mirror of the addSuccLeft proof (arguments of every add swapped).
theorem addSuccRight: forall a, b: Int; add(a, succ(b)) = succ(add(a, b))
proof
  @generalize-b |
    fix b: Int {
      @base |
        add(ZERO, succ(b)) = succ(add(ZERO, b))
        [by simplify addZeroLeft]
      @generalize-succ |
        fix a: Int {
          @given-inductive-hypothesis |
            assume add(a, succ(b)) = succ(add(a, b)) {
              @inductive-hypothesis |
                add(a, succ(b)) = succ(add(a, b))
                [by hypothesis given-inductive-hypothesis]
              @succ-case |
                add(succ(a), succ(b)) = succ(add(succ(a), b))
                [by simplify addSuccLeft inductive-hypothesis]
            }
          @discharge-succ |
            add(a, succ(b)) = succ(add(a, b)) -> add(succ(a), succ(b)) = succ(add(succ(a), b))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-succ |
        forall a: Int; add(a, succ(b)) = succ(add(a, b)) -> add(succ(a), succ(b)) = succ(add(succ(a), b))
        [by forall_intro generalize-succ]
      @generalize-prev |
        fix a: Int {
          @given-inductive-hypothesis |
            assume add(a, succ(b)) = succ(add(a, b)) {
              @inductive-hypothesis |
                add(a, succ(b)) = succ(add(a, b))
                [by hypothesis given-inductive-hypothesis]
              @prev-case |
                add(prev(a), succ(b)) = succ(add(prev(a), b))
                [by simplify addPrevLeft inductive-hypothesis prevSucc succPrev]
            }
          @discharge-prev |
            add(a, succ(b)) = succ(add(a, b)) -> add(prev(a), succ(b)) = succ(add(prev(a), b))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-prev |
        forall a: Int; add(a, succ(b)) = succ(add(a, b)) -> add(prev(a), succ(b)) = succ(add(prev(a), b))
        [by forall_intro generalize-prev]
      @conclusion-for-b |
        forall a: Int; add(a, succ(b)) = succ(add(a, b))
        [by instantiate induction((fun m: Int => add(m, succ(b)) = succ(add(m, b)))) base induction-step-succ induction-step-prev]
    }
  @swapped |
    forall b, a: Int; add(a, succ(b)) = succ(add(a, b))
    [by forall_intro generalize-b]
  // swap the two leading universals into first-appearance (a, b) order.
  @reorder-a |
    fix a: Int {
      @reorder-b |
        fix b: Int {
          @at-a-b |
            add(a, succ(b)) = succ(add(a, b))
            [by forall_elim(b, a) swapped]
        }
      @discharge-reorder-b |
        forall b: Int; add(a, succ(b)) = succ(add(a, b))
        [by forall_intro reorder-b]
    }
  @conclusion |
    forall a, b: Int; add(a, succ(b)) = succ(add(a, b))
    [by forall_intro reorder-a]
qed

// add(a, prev(b)) = prev(add(a, b)), by bidirectional induction on a — the
// mirror of addPrevLeft (right-predecessor recursion, arguments swapped).
theorem addPrevRight: forall a, b: Int; add(a, prev(b)) = prev(add(a, b))
proof
  @generalize-b |
    fix b: Int {
      @base |
        add(ZERO, prev(b)) = prev(add(ZERO, b))
        [by simplify addZeroLeft]
      @generalize-succ |
        fix a: Int {
          @given-inductive-hypothesis |
            assume add(a, prev(b)) = prev(add(a, b)) {
              @inductive-hypothesis |
                add(a, prev(b)) = prev(add(a, b))
                [by hypothesis given-inductive-hypothesis]
              @succ-case |
                add(succ(a), prev(b)) = prev(add(succ(a), b))
                [by simplify addSuccLeft inductive-hypothesis succPrev prevSucc]
            }
          @discharge-succ |
            add(a, prev(b)) = prev(add(a, b)) -> add(succ(a), prev(b)) = prev(add(succ(a), b))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-succ |
        forall a: Int; add(a, prev(b)) = prev(add(a, b)) -> add(succ(a), prev(b)) = prev(add(succ(a), b))
        [by forall_intro generalize-succ]
      @generalize-prev |
        fix a: Int {
          @given-inductive-hypothesis |
            assume add(a, prev(b)) = prev(add(a, b)) {
              @inductive-hypothesis |
                add(a, prev(b)) = prev(add(a, b))
                [by hypothesis given-inductive-hypothesis]
              @prev-case |
                add(prev(a), prev(b)) = prev(add(prev(a), b))
                [by simplify addPrevLeft inductive-hypothesis]
            }
          @discharge-prev |
            add(a, prev(b)) = prev(add(a, b)) -> add(prev(a), prev(b)) = prev(add(prev(a), b))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-prev |
        forall a: Int; add(a, prev(b)) = prev(add(a, b)) -> add(prev(a), prev(b)) = prev(add(prev(a), b))
        [by forall_intro generalize-prev]
      @conclusion-for-b |
        forall a: Int; add(a, prev(b)) = prev(add(a, b))
        [by instantiate induction((fun m: Int => add(m, prev(b)) = prev(add(m, b)))) base induction-step-succ induction-step-prev]
    }
  @swapped |
    forall b, a: Int; add(a, prev(b)) = prev(add(a, b))
    [by forall_intro generalize-b]
  // swap the two leading universals into first-appearance (a, b) order.
  @reorder-a |
    fix a: Int {
      @reorder-b |
        fix b: Int {
          @at-a-b |
            add(a, prev(b)) = prev(add(a, b))
            [by forall_elim(b, a) swapped]
        }
      @discharge-reorder-b |
        forall b: Int; add(a, prev(b)) = prev(add(a, b))
        [by forall_intro reorder-b]
    }
  @conclusion |
    forall a, b: Int; add(a, prev(b)) = prev(add(a, b))
    [by forall_intro reorder-a]
qed

// add(a, b) = add(b, a), by bidirectional induction on b (with a fixed): the
// base uses the two zero-identity laws, and each step turns the right-recursion
// axiom on one side into the left-recursion lemma on the other.
theorem addIsCommutative: forall a, b: Int; add(a, b) = add(b, a)
proof
  @generalize-a |
    fix a: Int {
      @add-zero-right |
        forall x: Int; add(x, ZERO) = x
        [by theorem addZeroRight]
      @add-zero-left |
        forall n: Int; add(ZERO, n) = n
        [by axiom addZeroLeft]
      @lhs-at-zero |
        add(a, ZERO) = a
        [by forall_elim(a) add-zero-right]
      @rhs-at-zero |
        add(ZERO, a) = a
        [by forall_elim(a) add-zero-left]
      @rhs-at-zero-flipped |
        a = add(ZERO, a)
        [by symmetry rhs-at-zero]
      @base |
        add(a, ZERO) = add(ZERO, a)
        [by rewrite rhs-at-zero-flipped lhs-at-zero]
      @add-succ-right |
        forall x, y: Int; add(x, succ(y)) = succ(add(x, y))
        [by theorem addSuccRight]
      @add-succ-left |
        forall x, y: Int; add(succ(x), y) = succ(add(x, y))
        [by axiom addSuccLeft]
      @add-prev-right |
        forall x, y: Int; add(x, prev(y)) = prev(add(x, y))
        [by theorem addPrevRight]
      @add-prev-left |
        forall x, y: Int; add(prev(x), y) = prev(add(x, y))
        [by axiom addPrevLeft]
      @generalize-succ |
        fix b: Int {
          @given-inductive-hypothesis |
            assume add(a, b) = add(b, a) {
              @inductive-hypothesis |
                add(a, b) = add(b, a)
                [by hypothesis given-inductive-hypothesis]
              @lhs-unfold |
                add(a, succ(b)) = succ(add(a, b))
                [by forall_elim(a, b) add-succ-right]
              @lhs-with-ih |
                add(a, succ(b)) = succ(add(b, a))
                [by rewrite inductive-hypothesis lhs-unfold]
              @rhs-unfold |
                add(succ(b), a) = succ(add(b, a))
                [by forall_elim(b, a) add-succ-left]
              @rhs-unfold-flipped |
                succ(add(b, a)) = add(succ(b), a)
                [by symmetry rhs-unfold]
              @succ-case |
                add(a, succ(b)) = add(succ(b), a)
                [by rewrite rhs-unfold-flipped lhs-with-ih]
            }
          @discharge-succ |
            add(a, b) = add(b, a) -> add(a, succ(b)) = add(succ(b), a)
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-succ |
        forall b: Int; add(a, b) = add(b, a) -> add(a, succ(b)) = add(succ(b), a)
        [by forall_intro generalize-succ]
      @generalize-prev |
        fix b: Int {
          @given-inductive-hypothesis |
            assume add(a, b) = add(b, a) {
              @inductive-hypothesis |
                add(a, b) = add(b, a)
                [by hypothesis given-inductive-hypothesis]
              @lhs-unfold |
                add(a, prev(b)) = prev(add(a, b))
                [by forall_elim(a, b) add-prev-right]
              @lhs-with-ih |
                add(a, prev(b)) = prev(add(b, a))
                [by rewrite inductive-hypothesis lhs-unfold]
              @rhs-unfold |
                add(prev(b), a) = prev(add(b, a))
                [by forall_elim(b, a) add-prev-left]
              @rhs-unfold-flipped |
                prev(add(b, a)) = add(prev(b), a)
                [by symmetry rhs-unfold]
              @prev-case |
                add(a, prev(b)) = add(prev(b), a)
                [by rewrite rhs-unfold-flipped lhs-with-ih]
            }
          @discharge-prev |
            add(a, b) = add(b, a) -> add(a, prev(b)) = add(prev(b), a)
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-prev |
        forall b: Int; add(a, b) = add(b, a) -> add(a, prev(b)) = add(prev(b), a)
        [by forall_intro generalize-prev]
      @conclusion-for-a |
        forall b: Int; add(a, b) = add(b, a)
        [by instantiate induction((fun m: Int => add(a, m) = add(m, a))) base induction-step-succ induction-step-prev]
    }
  @conclusion |
    forall a, b: Int; add(a, b) = add(b, a)
    [by forall_intro generalize-a]
qed

// add(add(a, b), c) = add(a, add(b, c)), by bidirectional induction on c (with
// a and b fixed): the recursion axioms peel the outermost succ/prev off both
// sides down to the inductive hypothesis.
theorem addIsAssociative: forall a, b, c: Int; add(add(a, b), c) = add(a, add(b, c))
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @add-zero |
            forall x: Int; add(x, ZERO) = x
            [by theorem addZeroRight]
          @add-succ |
            forall x, y: Int; add(x, succ(y)) = succ(add(x, y))
            [by theorem addSuccRight]
          @add-prev |
            forall x, y: Int; add(x, prev(y)) = prev(add(x, y))
            [by theorem addPrevRight]
          @lhs-at-zero |
            add(add(a, b), ZERO) = add(a, b)
            [by forall_elim(add(a, b)) add-zero]
          @inner-at-zero |
            add(b, ZERO) = b
            [by forall_elim(b) add-zero]
          @base-rhs-refl |
            add(a, add(b, ZERO)) = add(a, add(b, ZERO))
            [by reflexivity]
          @rhs-at-zero |
            add(a, b) = add(a, add(b, ZERO))
            [by rewrite inner-at-zero base-rhs-refl]
          @base |
            add(add(a, b), ZERO) = add(a, add(b, ZERO))
            [by rewrite rhs-at-zero lhs-at-zero]
          @generalize-succ |
            fix c: Int {
              @given-inductive-hypothesis |
                assume add(add(a, b), c) = add(a, add(b, c)) {
                  @inductive-hypothesis |
                    add(add(a, b), c) = add(a, add(b, c))
                    [by hypothesis given-inductive-hypothesis]
                  @lhs-unfold |
                    add(add(a, b), succ(c)) = succ(add(add(a, b), c))
                    [by forall_elim(add(a, b), c) add-succ]
                  @lhs-with-ih |
                    add(add(a, b), succ(c)) = succ(add(a, add(b, c)))
                    [by rewrite inductive-hypothesis lhs-unfold]
                  @inner-unfold |
                    add(b, succ(c)) = succ(add(b, c))
                    [by forall_elim(b, c) add-succ]
                  @rhs-refl |
                    add(a, add(b, succ(c))) = add(a, add(b, succ(c)))
                    [by reflexivity]
                  @rhs-inner |
                    add(a, add(b, succ(c))) = add(a, succ(add(b, c)))
                    [by rewrite inner-unfold rhs-refl]
                  @outer-unfold |
                    add(a, succ(add(b, c))) = succ(add(a, add(b, c)))
                    [by forall_elim(a, add(b, c)) add-succ]
                  @rhs-is |
                    add(a, add(b, succ(c))) = succ(add(a, add(b, c)))
                    [by rewrite outer-unfold rhs-inner]
                  @rhs-is-flipped |
                    succ(add(a, add(b, c))) = add(a, add(b, succ(c)))
                    [by symmetry rhs-is]
                  @succ-case |
                    add(add(a, b), succ(c)) = add(a, add(b, succ(c)))
                    [by rewrite rhs-is-flipped lhs-with-ih]
                }
              @discharge-succ |
                add(add(a, b), c) = add(a, add(b, c)) -> add(add(a, b), succ(c)) = add(a, add(b, succ(c)))
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-succ |
            forall c: Int; add(add(a, b), c) = add(a, add(b, c)) -> add(add(a, b), succ(c)) = add(a, add(b, succ(c)))
            [by forall_intro generalize-succ]
          @generalize-prev |
            fix c: Int {
              @given-inductive-hypothesis |
                assume add(add(a, b), c) = add(a, add(b, c)) {
                  @inductive-hypothesis |
                    add(add(a, b), c) = add(a, add(b, c))
                    [by hypothesis given-inductive-hypothesis]
                  @lhs-unfold |
                    add(add(a, b), prev(c)) = prev(add(add(a, b), c))
                    [by forall_elim(add(a, b), c) add-prev]
                  @lhs-with-ih |
                    add(add(a, b), prev(c)) = prev(add(a, add(b, c)))
                    [by rewrite inductive-hypothesis lhs-unfold]
                  @inner-unfold |
                    add(b, prev(c)) = prev(add(b, c))
                    [by forall_elim(b, c) add-prev]
                  @rhs-refl |
                    add(a, add(b, prev(c))) = add(a, add(b, prev(c)))
                    [by reflexivity]
                  @rhs-inner |
                    add(a, add(b, prev(c))) = add(a, prev(add(b, c)))
                    [by rewrite inner-unfold rhs-refl]
                  @outer-unfold |
                    add(a, prev(add(b, c))) = prev(add(a, add(b, c)))
                    [by forall_elim(a, add(b, c)) add-prev]
                  @rhs-is |
                    add(a, add(b, prev(c))) = prev(add(a, add(b, c)))
                    [by rewrite outer-unfold rhs-inner]
                  @rhs-is-flipped |
                    prev(add(a, add(b, c))) = add(a, add(b, prev(c)))
                    [by symmetry rhs-is]
                  @prev-case |
                    add(add(a, b), prev(c)) = add(a, add(b, prev(c)))
                    [by rewrite rhs-is-flipped lhs-with-ih]
                }
              @discharge-prev |
                add(add(a, b), c) = add(a, add(b, c)) -> add(add(a, b), prev(c)) = add(a, add(b, prev(c)))
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-prev |
            forall c: Int; add(add(a, b), c) = add(a, add(b, c)) -> add(add(a, b), prev(c)) = add(a, add(b, prev(c)))
            [by forall_intro generalize-prev]
          @conclusion-for-b |
            forall c: Int; add(add(a, b), c) = add(a, add(b, c))
            [by instantiate induction((fun m: Int => add(add(a, b), m) = add(a, add(b, m)))) base induction-step-succ induction-step-prev]
        }
      @conclusion-for-a |
        forall b, c: Int; add(add(a, b), c) = add(a, add(b, c))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: Int; add(add(a, b), c) = add(a, add(b, c))
    [by forall_intro generalize-a]
qed

// add(n, neg(n)) = ZERO — the additive inverse law, the defining property that
// makes ℤ a ring (not just a monoid). By bidirectional induction on n: each
// step opens neg on one side and cancels a succ against a prev to fall back on
// the inductive hypothesis.
theorem addNegRight: forall n: Int; add(n, neg(n)) = ZERO
proof
  @base |
    add(ZERO, neg(ZERO)) = ZERO
    [by simplify negZero addZeroRight]
  @generalize-succ |
    fix k: Int {
      @given-inductive-hypothesis |
        assume add(k, neg(k)) = ZERO {
          @inductive-hypothesis |
            add(k, neg(k)) = ZERO
            [by hypothesis given-inductive-hypothesis]
          // open neg(succ k), pull the recursion out both sides, cancel prev/succ.
          @succ-case |
            add(succ(k), neg(succ(k))) = ZERO
            [by simplify negSucc addPrevRight addSuccLeft prevSucc inductive-hypothesis]
        }
      @discharge-succ |
        add(k, neg(k)) = ZERO -> add(succ(k), neg(succ(k))) = ZERO
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-succ |
    forall k: Int; add(k, neg(k)) = ZERO -> add(succ(k), neg(succ(k))) = ZERO
    [by forall_intro generalize-succ]
  @generalize-prev |
    fix k: Int {
      @given-inductive-hypothesis |
        assume add(k, neg(k)) = ZERO {
          @inductive-hypothesis |
            add(k, neg(k)) = ZERO
            [by hypothesis given-inductive-hypothesis]
          @prev-case |
            add(prev(k), neg(prev(k))) = ZERO
            [by simplify negPrev addSuccRight addPrevLeft succPrev inductive-hypothesis]
        }
      @discharge-prev |
        add(k, neg(k)) = ZERO -> add(prev(k), neg(prev(k))) = ZERO
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-prev |
    forall k: Int; add(k, neg(k)) = ZERO -> add(prev(k), neg(prev(k))) = ZERO
    [by forall_intro generalize-prev]
  @conclusion |
    forall n: Int; add(n, neg(n)) = ZERO
    [by instantiate induction((fun m: Int => add(m, neg(m)) = ZERO)) base induction-step-succ induction-step-prev]
qed

// mul(n, ZERO) = ZERO, by bidirectional induction on n: multiplication
// recurses on the LEFT, so this right-zero law needs its own induction (the
// mirror of the mulZeroLeft axiom).
theorem mulZeroRight: forall n: Int; mul(n, ZERO) = ZERO
proof
  @base |
    mul(ZERO, ZERO) = ZERO
    [by simplify mulZeroLeft]
  @generalize-succ |
    fix k: Int {
      @given-inductive-hypothesis |
        assume mul(k, ZERO) = ZERO {
          @inductive-hypothesis |
            mul(k, ZERO) = ZERO
            [by hypothesis given-inductive-hypothesis]
          @succ-case |
            mul(succ(k), ZERO) = ZERO
            [by simplify mulSuccLeft inductive-hypothesis addZeroLeft]
        }
      @discharge-succ |
        mul(k, ZERO) = ZERO -> mul(succ(k), ZERO) = ZERO
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-succ |
    forall k: Int; mul(k, ZERO) = ZERO -> mul(succ(k), ZERO) = ZERO
    [by forall_intro generalize-succ]
  @generalize-prev |
    fix k: Int {
      @given-inductive-hypothesis |
        assume mul(k, ZERO) = ZERO {
          @inductive-hypothesis |
            mul(k, ZERO) = ZERO
            [by hypothesis given-inductive-hypothesis]
          @prev-case |
            mul(prev(k), ZERO) = ZERO
            [by simplify mulPrevLeft inductive-hypothesis negZero addZeroLeft]
        }
      @discharge-prev |
        mul(k, ZERO) = ZERO -> mul(prev(k), ZERO) = ZERO
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-prev |
    forall k: Int; mul(k, ZERO) = ZERO -> mul(prev(k), ZERO) = ZERO
    [by forall_intro generalize-prev]
  @conclusion |
    forall n: Int; mul(n, ZERO) = ZERO
    [by instantiate induction((fun m: Int => mul(m, ZERO) = ZERO)) base induction-step-succ induction-step-prev]
qed

// mul(a, succ(b)) = add(mul(a, b), a) and mul(a, prev(b)) = add(mul(a, b), neg(a))
// — the RIGHT recursion of multiplication, mirrors of the mulSuccLeft/mulPrevLeft
// axioms, by bidirectional induction on a. The inductive steps reassociate and
// commute the extra summand (a on succ, neg(a) on prev) with addIsAssociative and
// addIsCommutative.
theorem mulSuccRight: forall a, b: Int; mul(a, succ(b)) = add(mul(a, b), a)
proof
  @generalize-b |
    fix b: Int {
      @mul-zero-left |
        forall x: Int; mul(ZERO, x) = ZERO
        [by axiom mulZeroLeft]
      @add-zero-left |
        forall x: Int; add(ZERO, x) = x
        [by axiom addZeroLeft]
      @mul-succ-left |
        forall x, y: Int; mul(succ(x), y) = add(mul(x, y), y)
        [by axiom mulSuccLeft]
      @mul-prev-left |
        forall x, y: Int; mul(prev(x), y) = add(mul(x, y), neg(y))
        [by axiom mulPrevLeft]
      @add-succ-left |
        forall x, y: Int; add(succ(x), y) = succ(add(x, y))
        [by axiom addSuccLeft]
      @add-prev-left |
        forall x, y: Int; add(prev(x), y) = prev(add(x, y))
        [by axiom addPrevLeft]
      @add-prev-right |
        forall x, y: Int; add(x, prev(y)) = prev(add(x, y))
        [by theorem addPrevRight]
      @add-associative |
        forall x, y, z: Int; add(add(x, y), z) = add(x, add(y, z))
        [by theorem addIsAssociative]
      @add-commutative |
        forall x, y: Int; add(x, y) = add(y, x)
        [by theorem addIsCommutative]
      @neg-succ |
        forall n: Int; neg(succ(n)) = prev(neg(n))
        [by axiom negSucc]
      @neg-prev |
        forall n: Int; neg(prev(n)) = succ(neg(n))
        [by axiom negPrev]
      // base case: both sides are ZERO.
      @lhs-at-zero |
        mul(ZERO, succ(b)) = ZERO
        [by forall_elim(succ(b)) mul-zero-left]
      @inner-at-zero |
        mul(ZERO, b) = ZERO
        [by forall_elim(b) mul-zero-left]
      @base-rhs-refl |
        add(mul(ZERO, b), ZERO) = add(mul(ZERO, b), ZERO)
        [by reflexivity]
      @rhs-inner-zero |
        add(mul(ZERO, b), ZERO) = add(ZERO, ZERO)
        [by rewrite inner-at-zero base-rhs-refl]
      @add-zero-zero |
        add(ZERO, ZERO) = ZERO
        [by forall_elim(ZERO) add-zero-left]
      @rhs-at-zero |
        add(mul(ZERO, b), ZERO) = ZERO
        [by rewrite add-zero-zero rhs-inner-zero]
      @rhs-at-zero-flipped |
        ZERO = add(mul(ZERO, b), ZERO)
        [by symmetry rhs-at-zero]
      @base-case |
        mul(ZERO, succ(b)) = add(mul(ZERO, b), ZERO)
        [by rewrite rhs-at-zero-flipped lhs-at-zero]
      // inductive step (successor):
      @generalize-succ |
        fix a: Int {
          @given-inductive-hypothesis |
            assume mul(a, succ(b)) = add(mul(a, b), a) {
              @inductive-hypothesis |
                mul(a, succ(b)) = add(mul(a, b), a)
                [by hypothesis given-inductive-hypothesis]
              @lhs-unfold |
                mul(succ(a), succ(b)) = add(mul(a, succ(b)), succ(b))
                [by forall_elim(a, succ(b)) mul-succ-left]
              @lhs-with-ih |
                mul(succ(a), succ(b)) = add(add(mul(a, b), a), succ(b))
                [by rewrite inductive-hypothesis lhs-unfold]
              @lhs-reassociated |
                add(add(mul(a, b), a), succ(b)) = add(mul(a, b), add(a, succ(b)))
                [by forall_elim(mul(a, b), a, succ(b)) add-associative]
              @lhs-assoc |
                mul(succ(a), succ(b)) = add(mul(a, b), add(a, succ(b)))
                [by rewrite lhs-reassociated lhs-with-ih]
              @a-comm-succ-b |
                add(a, succ(b)) = add(succ(b), a)
                [by forall_elim(a, succ(b)) add-commutative]
              @lhs-inner-refl |
                add(mul(a, b), add(a, succ(b))) = add(mul(a, b), add(a, succ(b)))
                [by reflexivity]
              @lhs-inner-commuted |
                add(mul(a, b), add(a, succ(b))) = add(mul(a, b), add(succ(b), a))
                [by rewrite a-comm-succ-b lhs-inner-refl]
              @lhs-comm |
                mul(succ(a), succ(b)) = add(mul(a, b), add(succ(b), a))
                [by rewrite lhs-inner-commuted lhs-assoc]
              @succ-b-a |
                add(succ(b), a) = succ(add(b, a))
                [by forall_elim(b, a) add-succ-left]
              @lhs-inner-succ |
                mul(succ(a), succ(b)) = add(mul(a, b), succ(add(b, a)))
                [by rewrite succ-b-a lhs-comm]
              @b-a-comm |
                add(b, a) = add(a, b)
                [by forall_elim(b, a) add-commutative]
              @lhs-inner-refl2 |
                add(mul(a, b), succ(add(b, a))) = add(mul(a, b), succ(add(b, a)))
                [by reflexivity]
              @lhs-inner-commuted2 |
                add(mul(a, b), succ(add(b, a))) = add(mul(a, b), succ(add(a, b)))
                [by rewrite b-a-comm lhs-inner-refl2]
              @lhs-normal |
                mul(succ(a), succ(b)) = add(mul(a, b), succ(add(a, b)))
                [by rewrite lhs-inner-commuted2 lhs-inner-succ]
              @rhs-unfold |
                mul(succ(a), b) = add(mul(a, b), b)
                [by forall_elim(a, b) mul-succ-left]
              @rhs-refl |
                add(mul(succ(a), b), succ(a)) = add(mul(succ(a), b), succ(a))
                [by reflexivity]
              @rhs-with-mul |
                add(mul(succ(a), b), succ(a)) = add(add(mul(a, b), b), succ(a))
                [by rewrite rhs-unfold rhs-refl]
              @rhs-reassociated |
                add(add(mul(a, b), b), succ(a)) = add(mul(a, b), add(b, succ(a)))
                [by forall_elim(mul(a, b), b, succ(a)) add-associative]
              @rhs-assoc |
                add(mul(succ(a), b), succ(a)) = add(mul(a, b), add(b, succ(a)))
                [by rewrite rhs-reassociated rhs-with-mul]
              @b-succ-a |
                add(b, succ(a)) = add(succ(a), b)
                [by forall_elim(b, succ(a)) add-commutative]
              @rhs-inner-refl |
                add(mul(a, b), add(b, succ(a))) = add(mul(a, b), add(b, succ(a)))
                [by reflexivity]
              @rhs-inner-commuted |
                add(mul(a, b), add(b, succ(a))) = add(mul(a, b), add(succ(a), b))
                [by rewrite b-succ-a rhs-inner-refl]
              @rhs-comm |
                add(mul(succ(a), b), succ(a)) = add(mul(a, b), add(succ(a), b))
                [by rewrite rhs-inner-commuted rhs-assoc]
              @succ-a-b |
                add(succ(a), b) = succ(add(a, b))
                [by forall_elim(a, b) add-succ-left]
              @rhs-normal |
                add(mul(succ(a), b), succ(a)) = add(mul(a, b), succ(add(a, b)))
                [by rewrite succ-a-b rhs-comm]
              @rhs-normal-flipped |
                add(mul(a, b), succ(add(a, b))) = add(mul(succ(a), b), succ(a))
                [by symmetry rhs-normal]
              @succ-case |
                mul(succ(a), succ(b)) = add(mul(succ(a), b), succ(a))
                [by rewrite rhs-normal-flipped lhs-normal]
            }
          @discharge-succ |
            mul(a, succ(b)) = add(mul(a, b), a) -> mul(succ(a), succ(b)) = add(mul(succ(a), b), succ(a))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-succ |
        forall a: Int; mul(a, succ(b)) = add(mul(a, b), a) -> mul(succ(a), succ(b)) = add(mul(succ(a), b), succ(a))
        [by forall_intro generalize-succ]
      // inductive step (predecessor):
      @generalize-prev |
        fix a: Int {
          @given-inductive-hypothesis |
            assume mul(a, succ(b)) = add(mul(a, b), a) {
              @inductive-hypothesis |
                mul(a, succ(b)) = add(mul(a, b), a)
                [by hypothesis given-inductive-hypothesis]
              @lhs-unfold |
                mul(prev(a), succ(b)) = add(mul(a, succ(b)), neg(succ(b)))
                [by forall_elim(a, succ(b)) mul-prev-left]
              @lhs-with-ih |
                mul(prev(a), succ(b)) = add(add(mul(a, b), a), neg(succ(b)))
                [by rewrite inductive-hypothesis lhs-unfold]
              @open-neg-succ |
                neg(succ(b)) = prev(neg(b))
                [by forall_elim(b) neg-succ]
              @lhs-neg-opened |
                mul(prev(a), succ(b)) = add(add(mul(a, b), a), prev(neg(b)))
                [by rewrite open-neg-succ lhs-with-ih]
              @lhs-reassociated |
                add(add(mul(a, b), a), prev(neg(b))) = add(mul(a, b), add(a, prev(neg(b))))
                [by forall_elim(mul(a, b), a, prev(neg(b))) add-associative]
              @lhs-assoc |
                mul(prev(a), succ(b)) = add(mul(a, b), add(a, prev(neg(b))))
                [by rewrite lhs-reassociated lhs-neg-opened]
              @a-comm-prev-neg-b |
                add(a, prev(neg(b))) = add(prev(neg(b)), a)
                [by forall_elim(a, prev(neg(b))) add-commutative]
              @lhs-inner-refl |
                add(mul(a, b), add(a, prev(neg(b)))) = add(mul(a, b), add(a, prev(neg(b))))
                [by reflexivity]
              @lhs-inner-commuted |
                add(mul(a, b), add(a, prev(neg(b)))) = add(mul(a, b), add(prev(neg(b)), a))
                [by rewrite a-comm-prev-neg-b lhs-inner-refl]
              @lhs-comm |
                mul(prev(a), succ(b)) = add(mul(a, b), add(prev(neg(b)), a))
                [by rewrite lhs-inner-commuted lhs-assoc]
              @prev-neg-b-a |
                add(prev(neg(b)), a) = prev(add(neg(b), a))
                [by forall_elim(neg(b), a) add-prev-left]
              @lhs-inner-prev |
                mul(prev(a), succ(b)) = add(mul(a, b), prev(add(neg(b), a)))
                [by rewrite prev-neg-b-a lhs-comm]
              @neg-b-a-comm |
                add(neg(b), a) = add(a, neg(b))
                [by forall_elim(neg(b), a) add-commutative]
              @lhs-inner-refl2 |
                add(mul(a, b), prev(add(neg(b), a))) = add(mul(a, b), prev(add(neg(b), a)))
                [by reflexivity]
              @lhs-inner-commuted2 |
                add(mul(a, b), prev(add(neg(b), a))) = add(mul(a, b), prev(add(a, neg(b))))
                [by rewrite neg-b-a-comm lhs-inner-refl2]
              @lhs-normal |
                mul(prev(a), succ(b)) = add(mul(a, b), prev(add(a, neg(b))))
                [by rewrite lhs-inner-commuted2 lhs-inner-prev]
              @rhs-unfold |
                mul(prev(a), b) = add(mul(a, b), neg(b))
                [by forall_elim(a, b) mul-prev-left]
              @rhs-refl |
                add(mul(prev(a), b), prev(a)) = add(mul(prev(a), b), prev(a))
                [by reflexivity]
              @rhs-with-mul |
                add(mul(prev(a), b), prev(a)) = add(add(mul(a, b), neg(b)), prev(a))
                [by rewrite rhs-unfold rhs-refl]
              @rhs-reassociated |
                add(add(mul(a, b), neg(b)), prev(a)) = add(mul(a, b), add(neg(b), prev(a)))
                [by forall_elim(mul(a, b), neg(b), prev(a)) add-associative]
              @rhs-assoc |
                add(mul(prev(a), b), prev(a)) = add(mul(a, b), add(neg(b), prev(a)))
                [by rewrite rhs-reassociated rhs-with-mul]
              @neg-b-prev-a |
                add(neg(b), prev(a)) = prev(add(neg(b), a))
                [by forall_elim(neg(b), a) add-prev-right]
              @rhs-inner-prev |
                add(mul(prev(a), b), prev(a)) = add(mul(a, b), prev(add(neg(b), a)))
                [by rewrite neg-b-prev-a rhs-assoc]
              @neg-b-a-comm-rhs |
                add(neg(b), a) = add(a, neg(b))
                [by forall_elim(neg(b), a) add-commutative]
              @rhs-inner-refl |
                add(mul(a, b), prev(add(neg(b), a))) = add(mul(a, b), prev(add(neg(b), a)))
                [by reflexivity]
              @rhs-inner-commuted |
                add(mul(a, b), prev(add(neg(b), a))) = add(mul(a, b), prev(add(a, neg(b))))
                [by rewrite neg-b-a-comm-rhs rhs-inner-refl]
              @rhs-normal |
                add(mul(prev(a), b), prev(a)) = add(mul(a, b), prev(add(a, neg(b))))
                [by rewrite rhs-inner-commuted rhs-inner-prev]
              @rhs-normal-flipped |
                add(mul(a, b), prev(add(a, neg(b)))) = add(mul(prev(a), b), prev(a))
                [by symmetry rhs-normal]
              @prev-case |
                mul(prev(a), succ(b)) = add(mul(prev(a), b), prev(a))
                [by rewrite rhs-normal-flipped lhs-normal]
            }
          @discharge-prev |
            mul(a, succ(b)) = add(mul(a, b), a) -> mul(prev(a), succ(b)) = add(mul(prev(a), b), prev(a))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-prev |
        forall a: Int; mul(a, succ(b)) = add(mul(a, b), a) -> mul(prev(a), succ(b)) = add(mul(prev(a), b), prev(a))
        [by forall_intro generalize-prev]
      @conclusion-for-b |
        forall a: Int; mul(a, succ(b)) = add(mul(a, b), a)
        [by instantiate induction((fun m: Int => mul(m, succ(b)) = add(mul(m, b), m))) base-case induction-step-succ induction-step-prev]
    }
  @swapped-binders |
    forall b, a: Int; mul(a, succ(b)) = add(mul(a, b), a)
    [by forall_intro generalize-b]
  @generalize-a |
    fix a: Int {
      @generalize-b-inner |
        fix b: Int {
          @at-a-b |
            mul(a, succ(b)) = add(mul(a, b), a)
            [by forall_elim(b, a) swapped-binders]
        }
      @discharge-b |
        forall b: Int; mul(a, succ(b)) = add(mul(a, b), a)
        [by forall_intro generalize-b-inner]
    }
  @conclusion |
    forall a, b: Int; mul(a, succ(b)) = add(mul(a, b), a)
    [by forall_intro generalize-a]
qed

theorem mulPrevRight: forall a, b: Int; mul(a, prev(b)) = add(mul(a, b), neg(a))
proof
  @generalize-b |
    fix b: Int {
      @mul-zero-left |
        forall x: Int; mul(ZERO, x) = ZERO
        [by axiom mulZeroLeft]
      @add-zero-left |
        forall x: Int; add(ZERO, x) = x
        [by axiom addZeroLeft]
      @mul-succ-left |
        forall x, y: Int; mul(succ(x), y) = add(mul(x, y), y)
        [by axiom mulSuccLeft]
      @mul-prev-left |
        forall x, y: Int; mul(prev(x), y) = add(mul(x, y), neg(y))
        [by axiom mulPrevLeft]
      @add-succ-right |
        forall x, y: Int; add(x, succ(y)) = succ(add(x, y))
        [by theorem addSuccRight]
      @add-prev-right |
        forall x, y: Int; add(x, prev(y)) = prev(add(x, y))
        [by theorem addPrevRight]
      @add-associative |
        forall x, y, z: Int; add(add(x, y), z) = add(x, add(y, z))
        [by theorem addIsAssociative]
      @add-commutative |
        forall x, y: Int; add(x, y) = add(y, x)
        [by theorem addIsCommutative]
      @neg-zero |
        neg(ZERO) = ZERO
        [by axiom negZero]
      @neg-succ |
        forall n: Int; neg(succ(n)) = prev(neg(n))
        [by axiom negSucc]
      @neg-prev |
        forall n: Int; neg(prev(n)) = succ(neg(n))
        [by axiom negPrev]
      // base case: both sides are ZERO.
      @lhs-at-zero |
        mul(ZERO, prev(b)) = ZERO
        [by forall_elim(prev(b)) mul-zero-left]
      @inner-at-zero |
        mul(ZERO, b) = ZERO
        [by forall_elim(b) mul-zero-left]
      @base-rhs-refl |
        add(mul(ZERO, b), neg(ZERO)) = add(mul(ZERO, b), neg(ZERO))
        [by reflexivity]
      @rhs-inner-mul-zero |
        add(mul(ZERO, b), neg(ZERO)) = add(ZERO, neg(ZERO))
        [by rewrite inner-at-zero base-rhs-refl]
      @rhs-neg-zero |
        add(mul(ZERO, b), neg(ZERO)) = add(ZERO, ZERO)
        [by rewrite neg-zero rhs-inner-mul-zero]
      @add-zero-zero |
        add(ZERO, ZERO) = ZERO
        [by forall_elim(ZERO) add-zero-left]
      @rhs-at-zero |
        add(mul(ZERO, b), neg(ZERO)) = ZERO
        [by rewrite add-zero-zero rhs-neg-zero]
      @rhs-at-zero-flipped |
        ZERO = add(mul(ZERO, b), neg(ZERO))
        [by symmetry rhs-at-zero]
      @base-case |
        mul(ZERO, prev(b)) = add(mul(ZERO, b), neg(ZERO))
        [by rewrite rhs-at-zero-flipped lhs-at-zero]
      // inductive step (successor):
      @generalize-succ |
        fix a: Int {
          @given-inductive-hypothesis |
            assume mul(a, prev(b)) = add(mul(a, b), neg(a)) {
              @inductive-hypothesis |
                mul(a, prev(b)) = add(mul(a, b), neg(a))
                [by hypothesis given-inductive-hypothesis]
              @lhs-unfold |
                mul(succ(a), prev(b)) = add(mul(a, prev(b)), prev(b))
                [by forall_elim(a, prev(b)) mul-succ-left]
              @lhs-with-ih |
                mul(succ(a), prev(b)) = add(add(mul(a, b), neg(a)), prev(b))
                [by rewrite inductive-hypothesis lhs-unfold]
              @lhs-reassociated |
                add(add(mul(a, b), neg(a)), prev(b)) = add(mul(a, b), add(neg(a), prev(b)))
                [by forall_elim(mul(a, b), neg(a), prev(b)) add-associative]
              @lhs-assoc |
                mul(succ(a), prev(b)) = add(mul(a, b), add(neg(a), prev(b)))
                [by rewrite lhs-reassociated lhs-with-ih]
              @neg-a-prev-b |
                add(neg(a), prev(b)) = prev(add(neg(a), b))
                [by forall_elim(neg(a), b) add-prev-right]
              @lhs-normal |
                mul(succ(a), prev(b)) = add(mul(a, b), prev(add(neg(a), b)))
                [by rewrite neg-a-prev-b lhs-assoc]
              @rhs-unfold |
                mul(succ(a), b) = add(mul(a, b), b)
                [by forall_elim(a, b) mul-succ-left]
              @rhs-refl |
                add(mul(succ(a), b), neg(succ(a))) = add(mul(succ(a), b), neg(succ(a)))
                [by reflexivity]
              @rhs-with-mul |
                add(mul(succ(a), b), neg(succ(a))) = add(add(mul(a, b), b), neg(succ(a)))
                [by rewrite rhs-unfold rhs-refl]
              @open-neg-succ |
                neg(succ(a)) = prev(neg(a))
                [by forall_elim(a) neg-succ]
              @rhs-neg-opened |
                add(mul(succ(a), b), neg(succ(a))) = add(add(mul(a, b), b), prev(neg(a)))
                [by rewrite open-neg-succ rhs-with-mul]
              @rhs-reassociated |
                add(add(mul(a, b), b), prev(neg(a))) = add(mul(a, b), add(b, prev(neg(a))))
                [by forall_elim(mul(a, b), b, prev(neg(a))) add-associative]
              @rhs-assoc |
                add(mul(succ(a), b), neg(succ(a))) = add(mul(a, b), add(b, prev(neg(a))))
                [by rewrite rhs-reassociated rhs-neg-opened]
              @b-prev-neg-a |
                add(b, prev(neg(a))) = prev(add(b, neg(a)))
                [by forall_elim(b, neg(a)) add-prev-right]
              @rhs-inner-prev |
                add(mul(succ(a), b), neg(succ(a))) = add(mul(a, b), prev(add(b, neg(a))))
                [by rewrite b-prev-neg-a rhs-assoc]
              @b-neg-a-comm |
                add(b, neg(a)) = add(neg(a), b)
                [by forall_elim(b, neg(a)) add-commutative]
              @rhs-inner-refl |
                add(mul(a, b), prev(add(b, neg(a)))) = add(mul(a, b), prev(add(b, neg(a))))
                [by reflexivity]
              @rhs-inner-commuted |
                add(mul(a, b), prev(add(b, neg(a)))) = add(mul(a, b), prev(add(neg(a), b)))
                [by rewrite b-neg-a-comm rhs-inner-refl]
              @rhs-normal |
                add(mul(succ(a), b), neg(succ(a))) = add(mul(a, b), prev(add(neg(a), b)))
                [by rewrite rhs-inner-commuted rhs-inner-prev]
              @rhs-normal-flipped |
                add(mul(a, b), prev(add(neg(a), b))) = add(mul(succ(a), b), neg(succ(a)))
                [by symmetry rhs-normal]
              @succ-case |
                mul(succ(a), prev(b)) = add(mul(succ(a), b), neg(succ(a)))
                [by rewrite rhs-normal-flipped lhs-normal]
            }
          @discharge-succ |
            mul(a, prev(b)) = add(mul(a, b), neg(a)) -> mul(succ(a), prev(b)) = add(mul(succ(a), b), neg(succ(a)))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-succ |
        forall a: Int; mul(a, prev(b)) = add(mul(a, b), neg(a)) -> mul(succ(a), prev(b)) = add(mul(succ(a), b), neg(succ(a)))
        [by forall_intro generalize-succ]
      // inductive step (predecessor):
      @generalize-prev |
        fix a: Int {
          @given-inductive-hypothesis |
            assume mul(a, prev(b)) = add(mul(a, b), neg(a)) {
              @inductive-hypothesis |
                mul(a, prev(b)) = add(mul(a, b), neg(a))
                [by hypothesis given-inductive-hypothesis]
              @lhs-unfold |
                mul(prev(a), prev(b)) = add(mul(a, prev(b)), neg(prev(b)))
                [by forall_elim(a, prev(b)) mul-prev-left]
              @lhs-with-ih |
                mul(prev(a), prev(b)) = add(add(mul(a, b), neg(a)), neg(prev(b)))
                [by rewrite inductive-hypothesis lhs-unfold]
              @lhs-reassociated |
                add(add(mul(a, b), neg(a)), neg(prev(b))) = add(mul(a, b), add(neg(a), neg(prev(b))))
                [by forall_elim(mul(a, b), neg(a), neg(prev(b))) add-associative]
              @lhs-assoc |
                mul(prev(a), prev(b)) = add(mul(a, b), add(neg(a), neg(prev(b))))
                [by rewrite lhs-reassociated lhs-with-ih]
              @open-neg-prev-b |
                neg(prev(b)) = succ(neg(b))
                [by forall_elim(b) neg-prev]
              @lhs-inner-refl |
                add(mul(a, b), add(neg(a), neg(prev(b)))) = add(mul(a, b), add(neg(a), neg(prev(b))))
                [by reflexivity]
              @lhs-neg-opened |
                add(mul(a, b), add(neg(a), neg(prev(b)))) = add(mul(a, b), add(neg(a), succ(neg(b))))
                [by rewrite open-neg-prev-b lhs-inner-refl]
              @lhs-neg-normal |
                mul(prev(a), prev(b)) = add(mul(a, b), add(neg(a), succ(neg(b))))
                [by rewrite lhs-neg-opened lhs-assoc]
              @neg-a-succ-neg-b |
                add(neg(a), succ(neg(b))) = succ(add(neg(a), neg(b)))
                [by forall_elim(neg(a), neg(b)) add-succ-right]
              @lhs-normal |
                mul(prev(a), prev(b)) = add(mul(a, b), succ(add(neg(a), neg(b))))
                [by rewrite neg-a-succ-neg-b lhs-neg-normal]
              @rhs-unfold |
                mul(prev(a), b) = add(mul(a, b), neg(b))
                [by forall_elim(a, b) mul-prev-left]
              @rhs-refl |
                add(mul(prev(a), b), neg(prev(a))) = add(mul(prev(a), b), neg(prev(a)))
                [by reflexivity]
              @rhs-with-mul |
                add(mul(prev(a), b), neg(prev(a))) = add(add(mul(a, b), neg(b)), neg(prev(a)))
                [by rewrite rhs-unfold rhs-refl]
              @open-neg-prev-a |
                neg(prev(a)) = succ(neg(a))
                [by forall_elim(a) neg-prev]
              @rhs-neg-opened |
                add(mul(prev(a), b), neg(prev(a))) = add(add(mul(a, b), neg(b)), succ(neg(a)))
                [by rewrite open-neg-prev-a rhs-with-mul]
              @rhs-reassociated |
                add(add(mul(a, b), neg(b)), succ(neg(a))) = add(mul(a, b), add(neg(b), succ(neg(a))))
                [by forall_elim(mul(a, b), neg(b), succ(neg(a))) add-associative]
              @rhs-assoc |
                add(mul(prev(a), b), neg(prev(a))) = add(mul(a, b), add(neg(b), succ(neg(a))))
                [by rewrite rhs-reassociated rhs-neg-opened]
              @neg-b-succ-neg-a |
                add(neg(b), succ(neg(a))) = succ(add(neg(b), neg(a)))
                [by forall_elim(neg(b), neg(a)) add-succ-right]
              @rhs-inner-succ |
                add(mul(prev(a), b), neg(prev(a))) = add(mul(a, b), succ(add(neg(b), neg(a))))
                [by rewrite neg-b-succ-neg-a rhs-assoc]
              @neg-b-neg-a-comm |
                add(neg(b), neg(a)) = add(neg(a), neg(b))
                [by forall_elim(neg(b), neg(a)) add-commutative]
              @rhs-inner-refl |
                add(mul(a, b), succ(add(neg(b), neg(a)))) = add(mul(a, b), succ(add(neg(b), neg(a))))
                [by reflexivity]
              @rhs-inner-commuted |
                add(mul(a, b), succ(add(neg(b), neg(a)))) = add(mul(a, b), succ(add(neg(a), neg(b))))
                [by rewrite neg-b-neg-a-comm rhs-inner-refl]
              @rhs-normal |
                add(mul(prev(a), b), neg(prev(a))) = add(mul(a, b), succ(add(neg(a), neg(b))))
                [by rewrite rhs-inner-commuted rhs-inner-succ]
              @rhs-normal-flipped |
                add(mul(a, b), succ(add(neg(a), neg(b)))) = add(mul(prev(a), b), neg(prev(a)))
                [by symmetry rhs-normal]
              @prev-case |
                mul(prev(a), prev(b)) = add(mul(prev(a), b), neg(prev(a)))
                [by rewrite rhs-normal-flipped lhs-normal]
            }
          @discharge-prev |
            mul(a, prev(b)) = add(mul(a, b), neg(a)) -> mul(prev(a), prev(b)) = add(mul(prev(a), b), neg(prev(a)))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-prev |
        forall a: Int; mul(a, prev(b)) = add(mul(a, b), neg(a)) -> mul(prev(a), prev(b)) = add(mul(prev(a), b), neg(prev(a)))
        [by forall_intro generalize-prev]
      @conclusion-for-b |
        forall a: Int; mul(a, prev(b)) = add(mul(a, b), neg(a))
        [by instantiate induction((fun m: Int => mul(m, prev(b)) = add(mul(m, b), neg(m)))) base-case induction-step-succ induction-step-prev]
    }
  @swapped-binders |
    forall b, a: Int; mul(a, prev(b)) = add(mul(a, b), neg(a))
    [by forall_intro generalize-b]
  @generalize-a |
    fix a: Int {
      @generalize-b-inner |
        fix b: Int {
          @at-a-b |
            mul(a, prev(b)) = add(mul(a, b), neg(a))
            [by forall_elim(b, a) swapped-binders]
        }
      @discharge-b |
        forall b: Int; mul(a, prev(b)) = add(mul(a, b), neg(a))
        [by forall_intro generalize-b-inner]
    }
  @conclusion |
    forall a, b: Int; mul(a, prev(b)) = add(mul(a, b), neg(a))
    [by forall_intro generalize-a]
qed

// mul(n, ONE) = n — the right-identity law. No induction: unfold ONE to
// succ(ZERO), apply the mulSuccRight recursion once, and clean up with the two
// zero laws — the whole chain is a `simplify` normalization.
theorem mulOneRight: forall n: Int; mul(n, ONE) = n
proof
  @generalize-n |
    fix n: Int {
      @conclusion-for-n |
        mul(n, ONE) = n
        [by simplify oneIsSuccZero mulSuccRight mulZeroRight addZeroLeft]
    }
  @conclusion |
    forall n: Int; mul(n, ONE) = n
    [by forall_intro generalize-n]
qed

// mul(succ(a), b) = add(mul(a, b), b) — the left-successor recursion of
// multiplication (mirror of mulSuccRight), by bidirectional induction on b. The
// inductive steps reassociate/commute the two extra summands into agreement,
// so they lean on addIsAssociative and addIsCommutative.
// mul(a, add(b, c)) = add(mul(a, b), mul(a, c)) — left-distributivity of mul
// over add, by bidirectional induction on c (with a and b fixed). The base uses
// the two zero laws; each step peels the recursion off both sides and
// reassociates the extra summand (a on succ, neg(a) on prev) with add-associative.
theorem mulAddDistribLeft: forall a, b, c: Int; mul(a, add(b, c)) = add(mul(a, b), mul(a, c))
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @add-zero |
            forall x: Int; add(x, ZERO) = x
            [by theorem addZeroRight]
          @add-succ |
            forall x, y: Int; add(x, succ(y)) = succ(add(x, y))
            [by theorem addSuccRight]
          @add-prev |
            forall x, y: Int; add(x, prev(y)) = prev(add(x, y))
            [by theorem addPrevRight]
          @mul-zero-right |
            forall x: Int; mul(x, ZERO) = ZERO
            [by theorem mulZeroRight]
          @mul-succ-right |
            forall x, y: Int; mul(x, succ(y)) = add(mul(x, y), x)
            [by theorem mulSuccRight]
          @mul-prev-right |
            forall x, y: Int; mul(x, prev(y)) = add(mul(x, y), neg(x))
            [by theorem mulPrevRight]
          @add-associative |
            forall x, y, z: Int; add(add(x, y), z) = add(x, add(y, z))
            [by theorem addIsAssociative]
          // base case: c = ZERO — both sides collapse to mul(a, b).
          @collapse-inner-add |
            add(b, ZERO) = b
            [by forall_elim(b) add-zero]
          @lhs-at-zero-refl |
            mul(a, add(b, ZERO)) = mul(a, add(b, ZERO))
            [by reflexivity]
          @lhs-at-zero |
            mul(a, add(b, ZERO)) = mul(a, b)
            [by rewrite collapse-inner-add lhs-at-zero-refl]
          @mul-a-zero |
            mul(a, ZERO) = ZERO
            [by forall_elim(a) mul-zero-right]
          @rhs-at-zero-refl |
            add(mul(a, b), mul(a, ZERO)) = add(mul(a, b), mul(a, ZERO))
            [by reflexivity]
          @rhs-with-mul-zero |
            add(mul(a, b), mul(a, ZERO)) = add(mul(a, b), ZERO)
            [by rewrite mul-a-zero rhs-at-zero-refl]
          @collapse-outer-add |
            add(mul(a, b), ZERO) = mul(a, b)
            [by forall_elim(mul(a, b)) add-zero]
          @rhs-at-zero |
            add(mul(a, b), mul(a, ZERO)) = mul(a, b)
            [by rewrite collapse-outer-add rhs-with-mul-zero]
          @rhs-at-zero-flipped |
            mul(a, b) = add(mul(a, b), mul(a, ZERO))
            [by symmetry rhs-at-zero]
          @base-case |
            mul(a, add(b, ZERO)) = add(mul(a, b), mul(a, ZERO))
            [by rewrite rhs-at-zero-flipped lhs-at-zero]
          // inductive step (successor):
          @induction-step-succ-proof |
            fix c: Int {
              @given-inductive-hypothesis |
                assume mul(a, add(b, c)) = add(mul(a, b), mul(a, c)) {
                  @inductive-hypothesis |
                    mul(a, add(b, c)) = add(mul(a, b), mul(a, c))
                    [by hypothesis given-inductive-hypothesis]
                  @inner-add-succ |
                    add(b, succ(c)) = succ(add(b, c))
                    [by forall_elim(b, c) add-succ]
                  @lhs-refl |
                    mul(a, add(b, succ(c))) = mul(a, add(b, succ(c)))
                    [by reflexivity]
                  @lhs-inner-unfolded |
                    mul(a, add(b, succ(c))) = mul(a, succ(add(b, c)))
                    [by rewrite inner-add-succ lhs-refl]
                  @lhs-mul-unfold |
                    mul(a, succ(add(b, c))) = add(mul(a, add(b, c)), a)
                    [by forall_elim(a, add(b, c)) mul-succ-right]
                  @lhs-mul-unfolded |
                    mul(a, add(b, succ(c))) = add(mul(a, add(b, c)), a)
                    [by rewrite lhs-mul-unfold lhs-inner-unfolded]
                  @lhs-with-ih |
                    mul(a, add(b, succ(c))) = add(add(mul(a, b), mul(a, c)), a)
                    [by rewrite inductive-hypothesis lhs-mul-unfolded]
                  @reassociate |
                    add(add(mul(a, b), mul(a, c)), a) = add(mul(a, b), add(mul(a, c), a))
                    [by forall_elim(mul(a, b), mul(a, c), a) add-associative]
                  @lhs-normal |
                    mul(a, add(b, succ(c))) = add(mul(a, b), add(mul(a, c), a))
                    [by rewrite reassociate lhs-with-ih]
                  @rhs-mul-unfold |
                    mul(a, succ(c)) = add(mul(a, c), a)
                    [by forall_elim(a, c) mul-succ-right]
                  @rhs-refl |
                    add(mul(a, b), mul(a, succ(c))) = add(mul(a, b), mul(a, succ(c)))
                    [by reflexivity]
                  @rhs-normal |
                    add(mul(a, b), mul(a, succ(c))) = add(mul(a, b), add(mul(a, c), a))
                    [by rewrite rhs-mul-unfold rhs-refl]
                  @rhs-normal-flipped |
                    add(mul(a, b), add(mul(a, c), a)) = add(mul(a, b), mul(a, succ(c)))
                    [by symmetry rhs-normal]
                  @succ-case |
                    mul(a, add(b, succ(c))) = add(mul(a, b), mul(a, succ(c)))
                    [by rewrite rhs-normal-flipped lhs-normal]
                }
              @induction-step-at-k |
                mul(a, add(b, c)) = add(mul(a, b), mul(a, c)) -> mul(a, add(b, succ(c))) = add(mul(a, b), mul(a, succ(c)))
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-succ |
            forall c: Int; mul(a, add(b, c)) = add(mul(a, b), mul(a, c)) -> mul(a, add(b, succ(c))) = add(mul(a, b), mul(a, succ(c)))
            [by forall_intro induction-step-succ-proof]
          // inductive step (predecessor): mirror with neg(a) as the extra summand.
          @induction-step-prev-proof |
            fix c: Int {
              @given-inductive-hypothesis |
                assume mul(a, add(b, c)) = add(mul(a, b), mul(a, c)) {
                  @inductive-hypothesis |
                    mul(a, add(b, c)) = add(mul(a, b), mul(a, c))
                    [by hypothesis given-inductive-hypothesis]
                  @inner-add-prev |
                    add(b, prev(c)) = prev(add(b, c))
                    [by forall_elim(b, c) add-prev]
                  @lhs-refl |
                    mul(a, add(b, prev(c))) = mul(a, add(b, prev(c)))
                    [by reflexivity]
                  @lhs-inner-unfolded |
                    mul(a, add(b, prev(c))) = mul(a, prev(add(b, c)))
                    [by rewrite inner-add-prev lhs-refl]
                  @lhs-mul-unfold |
                    mul(a, prev(add(b, c))) = add(mul(a, add(b, c)), neg(a))
                    [by forall_elim(a, add(b, c)) mul-prev-right]
                  @lhs-mul-unfolded |
                    mul(a, add(b, prev(c))) = add(mul(a, add(b, c)), neg(a))
                    [by rewrite lhs-mul-unfold lhs-inner-unfolded]
                  @lhs-with-ih |
                    mul(a, add(b, prev(c))) = add(add(mul(a, b), mul(a, c)), neg(a))
                    [by rewrite inductive-hypothesis lhs-mul-unfolded]
                  @reassociate |
                    add(add(mul(a, b), mul(a, c)), neg(a)) = add(mul(a, b), add(mul(a, c), neg(a)))
                    [by forall_elim(mul(a, b), mul(a, c), neg(a)) add-associative]
                  @lhs-normal |
                    mul(a, add(b, prev(c))) = add(mul(a, b), add(mul(a, c), neg(a)))
                    [by rewrite reassociate lhs-with-ih]
                  @rhs-mul-unfold |
                    mul(a, prev(c)) = add(mul(a, c), neg(a))
                    [by forall_elim(a, c) mul-prev-right]
                  @rhs-refl |
                    add(mul(a, b), mul(a, prev(c))) = add(mul(a, b), mul(a, prev(c)))
                    [by reflexivity]
                  @rhs-normal |
                    add(mul(a, b), mul(a, prev(c))) = add(mul(a, b), add(mul(a, c), neg(a)))
                    [by rewrite rhs-mul-unfold rhs-refl]
                  @rhs-normal-flipped |
                    add(mul(a, b), add(mul(a, c), neg(a))) = add(mul(a, b), mul(a, prev(c)))
                    [by symmetry rhs-normal]
                  @prev-case |
                    mul(a, add(b, prev(c))) = add(mul(a, b), mul(a, prev(c)))
                    [by rewrite rhs-normal-flipped lhs-normal]
                }
              @induction-step-at-k |
                mul(a, add(b, c)) = add(mul(a, b), mul(a, c)) -> mul(a, add(b, prev(c))) = add(mul(a, b), mul(a, prev(c)))
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-prev |
            forall c: Int; mul(a, add(b, c)) = add(mul(a, b), mul(a, c)) -> mul(a, add(b, prev(c))) = add(mul(a, b), mul(a, prev(c)))
            [by forall_intro induction-step-prev-proof]
          @conclusion-for-b |
            forall c: Int; mul(a, add(b, c)) = add(mul(a, b), mul(a, c))
            [by instantiate induction((fun m: Int => mul(a, add(b, m)) = add(mul(a, b), mul(a, m)))) base-case induction-step-succ induction-step-prev]
        }
      @conclusion-for-a |
        forall b, c: Int; mul(a, add(b, c)) = add(mul(a, b), mul(a, c))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: Int; mul(a, add(b, c)) = add(mul(a, b), mul(a, c))
    [by forall_intro generalize-a]
qed

// neg(add(u, v)) = add(neg(u), neg(v)) — negation distributes over addition, by
// bidirectional induction on v. A helper for mulNegRight: each step turns the
// recursion axiom on one side into negSucc/negPrev cancellation on the other.
theorem negAdd: forall u, v: Int; neg(add(u, v)) = add(neg(u), neg(v))
proof
  @generalize-u |
    fix u: Int {
      @add-zero |
        forall x: Int; add(x, ZERO) = x
        [by theorem addZeroRight]
      @add-succ |
        forall x, y: Int; add(x, succ(y)) = succ(add(x, y))
        [by theorem addSuccRight]
      @add-prev |
        forall x, y: Int; add(x, prev(y)) = prev(add(x, y))
        [by theorem addPrevRight]
      @neg-zero |
        neg(ZERO) = ZERO
        [by axiom negZero]
      @neg-succ |
        forall n: Int; neg(succ(n)) = prev(neg(n))
        [by axiom negSucc]
      @neg-prev |
        forall n: Int; neg(prev(n)) = succ(neg(n))
        [by axiom negPrev]
      // base case: v = ZERO — both sides collapse to neg(u).
      @collapse-inner |
        add(u, ZERO) = u
        [by forall_elim(u) add-zero]
      @lhs-at-zero-refl |
        neg(add(u, ZERO)) = neg(add(u, ZERO))
        [by reflexivity]
      @lhs-at-zero |
        neg(add(u, ZERO)) = neg(u)
        [by rewrite collapse-inner lhs-at-zero-refl]
      @rhs-at-zero-refl |
        add(neg(u), neg(ZERO)) = add(neg(u), neg(ZERO))
        [by reflexivity]
      @rhs-with-neg-zero |
        add(neg(u), neg(ZERO)) = add(neg(u), ZERO)
        [by rewrite neg-zero rhs-at-zero-refl]
      @collapse-outer |
        add(neg(u), ZERO) = neg(u)
        [by forall_elim(neg(u)) add-zero]
      @rhs-at-zero |
        add(neg(u), neg(ZERO)) = neg(u)
        [by rewrite collapse-outer rhs-with-neg-zero]
      @rhs-at-zero-flipped |
        neg(u) = add(neg(u), neg(ZERO))
        [by symmetry rhs-at-zero]
      @base-case |
        neg(add(u, ZERO)) = add(neg(u), neg(ZERO))
        [by rewrite rhs-at-zero-flipped lhs-at-zero]
      // inductive step (successor):
      @induction-step-succ-proof |
        fix v: Int {
          @given-inductive-hypothesis |
            assume neg(add(u, v)) = add(neg(u), neg(v)) {
              @inductive-hypothesis |
                neg(add(u, v)) = add(neg(u), neg(v))
                [by hypothesis given-inductive-hypothesis]
              @inner-succ |
                add(u, succ(v)) = succ(add(u, v))
                [by forall_elim(u, v) add-succ]
              @lhs-refl |
                neg(add(u, succ(v))) = neg(add(u, succ(v)))
                [by reflexivity]
              @lhs-inner-unfolded |
                neg(add(u, succ(v))) = neg(succ(add(u, v)))
                [by rewrite inner-succ lhs-refl]
              @open-neg-succ |
                neg(succ(add(u, v))) = prev(neg(add(u, v)))
                [by forall_elim(add(u, v)) neg-succ]
              @lhs-neg-opened |
                neg(add(u, succ(v))) = prev(neg(add(u, v)))
                [by rewrite open-neg-succ lhs-inner-unfolded]
              @lhs-normal |
                neg(add(u, succ(v))) = prev(add(neg(u), neg(v)))
                [by rewrite inductive-hypothesis lhs-neg-opened]
              @rhs-neg-succ |
                neg(succ(v)) = prev(neg(v))
                [by forall_elim(v) neg-succ]
              @rhs-refl |
                add(neg(u), neg(succ(v))) = add(neg(u), neg(succ(v)))
                [by reflexivity]
              @rhs-neg-opened |
                add(neg(u), neg(succ(v))) = add(neg(u), prev(neg(v)))
                [by rewrite rhs-neg-succ rhs-refl]
              @pull-prev-out |
                add(neg(u), prev(neg(v))) = prev(add(neg(u), neg(v)))
                [by forall_elim(neg(u), neg(v)) add-prev]
              @rhs-normal |
                add(neg(u), neg(succ(v))) = prev(add(neg(u), neg(v)))
                [by rewrite pull-prev-out rhs-neg-opened]
              @rhs-normal-flipped |
                prev(add(neg(u), neg(v))) = add(neg(u), neg(succ(v)))
                [by symmetry rhs-normal]
              @succ-case |
                neg(add(u, succ(v))) = add(neg(u), neg(succ(v)))
                [by rewrite rhs-normal-flipped lhs-normal]
            }
          @induction-step-at-k |
            neg(add(u, v)) = add(neg(u), neg(v)) -> neg(add(u, succ(v))) = add(neg(u), neg(succ(v)))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-succ |
        forall v: Int; neg(add(u, v)) = add(neg(u), neg(v)) -> neg(add(u, succ(v))) = add(neg(u), neg(succ(v)))
        [by forall_intro induction-step-succ-proof]
      // inductive step (predecessor):
      @induction-step-prev-proof |
        fix v: Int {
          @given-inductive-hypothesis |
            assume neg(add(u, v)) = add(neg(u), neg(v)) {
              @inductive-hypothesis |
                neg(add(u, v)) = add(neg(u), neg(v))
                [by hypothesis given-inductive-hypothesis]
              @inner-prev |
                add(u, prev(v)) = prev(add(u, v))
                [by forall_elim(u, v) add-prev]
              @lhs-refl |
                neg(add(u, prev(v))) = neg(add(u, prev(v)))
                [by reflexivity]
              @lhs-inner-unfolded |
                neg(add(u, prev(v))) = neg(prev(add(u, v)))
                [by rewrite inner-prev lhs-refl]
              @open-neg-prev |
                neg(prev(add(u, v))) = succ(neg(add(u, v)))
                [by forall_elim(add(u, v)) neg-prev]
              @lhs-neg-opened |
                neg(add(u, prev(v))) = succ(neg(add(u, v)))
                [by rewrite open-neg-prev lhs-inner-unfolded]
              @lhs-normal |
                neg(add(u, prev(v))) = succ(add(neg(u), neg(v)))
                [by rewrite inductive-hypothesis lhs-neg-opened]
              @rhs-neg-prev |
                neg(prev(v)) = succ(neg(v))
                [by forall_elim(v) neg-prev]
              @rhs-refl |
                add(neg(u), neg(prev(v))) = add(neg(u), neg(prev(v)))
                [by reflexivity]
              @rhs-neg-opened |
                add(neg(u), neg(prev(v))) = add(neg(u), succ(neg(v)))
                [by rewrite rhs-neg-prev rhs-refl]
              @pull-succ-out |
                add(neg(u), succ(neg(v))) = succ(add(neg(u), neg(v)))
                [by forall_elim(neg(u), neg(v)) add-succ]
              @rhs-normal |
                add(neg(u), neg(prev(v))) = succ(add(neg(u), neg(v)))
                [by rewrite pull-succ-out rhs-neg-opened]
              @rhs-normal-flipped |
                succ(add(neg(u), neg(v))) = add(neg(u), neg(prev(v)))
                [by symmetry rhs-normal]
              @prev-case |
                neg(add(u, prev(v))) = add(neg(u), neg(prev(v)))
                [by rewrite rhs-normal-flipped lhs-normal]
            }
          @induction-step-at-k |
            neg(add(u, v)) = add(neg(u), neg(v)) -> neg(add(u, prev(v))) = add(neg(u), neg(prev(v)))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-prev |
        forall v: Int; neg(add(u, v)) = add(neg(u), neg(v)) -> neg(add(u, prev(v))) = add(neg(u), neg(prev(v)))
        [by forall_intro induction-step-prev-proof]
      @conclusion-for-u |
        forall v: Int; neg(add(u, v)) = add(neg(u), neg(v))
        [by instantiate induction((fun m: Int => neg(add(u, m)) = add(neg(u), neg(m)))) base-case induction-step-succ induction-step-prev]
    }
  @conclusion |
    forall u, v: Int; neg(add(u, v)) = add(neg(u), neg(v))
    [by forall_intro generalize-u]
qed

// neg(neg(n)) = n — negation is an involution, by bidirectional induction on n.
// A helper for mulNegRight's predecessor step. Each step opens the outer neg via
// negSucc/negPrev and the inner one the opposite way, cancelling to the hypothesis.
theorem negNeg: forall n: Int; neg(neg(n)) = n
proof
  @neg-zero |
    neg(ZERO) = ZERO
    [by axiom negZero]
  @neg-succ |
    forall x: Int; neg(succ(x)) = prev(neg(x))
    [by axiom negSucc]
  @neg-prev |
    forall x: Int; neg(prev(x)) = succ(neg(x))
    [by axiom negPrev]
  // base case: neg(neg(ZERO)) = neg(ZERO) = ZERO.
  @base-refl |
    neg(neg(ZERO)) = neg(neg(ZERO))
    [by reflexivity]
  @base-inner |
    neg(neg(ZERO)) = neg(ZERO)
    [by rewrite neg-zero base-refl]
  @base-case |
    neg(neg(ZERO)) = ZERO
    [by rewrite neg-zero base-inner]
  // inductive step (successor):
  @induction-step-succ-proof |
    fix k: Int {
      @given-inductive-hypothesis |
        assume neg(neg(k)) = k {
          @inductive-hypothesis |
            neg(neg(k)) = k
            [by hypothesis given-inductive-hypothesis]
          @open-outer |
            neg(succ(k)) = prev(neg(k))
            [by forall_elim(k) neg-succ]
          @lhs-refl |
            neg(neg(succ(k))) = neg(neg(succ(k)))
            [by reflexivity]
          @lhs-outer-opened |
            neg(neg(succ(k))) = neg(prev(neg(k)))
            [by rewrite open-outer lhs-refl]
          @open-inner |
            neg(prev(neg(k))) = succ(neg(neg(k)))
            [by forall_elim(neg(k)) neg-prev]
          @lhs-inner-opened |
            neg(neg(succ(k))) = succ(neg(neg(k)))
            [by rewrite open-inner lhs-outer-opened]
          @succ-case |
            neg(neg(succ(k))) = succ(k)
            [by rewrite inductive-hypothesis lhs-inner-opened]
        }
      @induction-step-at-k |
        neg(neg(k)) = k -> neg(neg(succ(k))) = succ(k)
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-succ |
    forall k: Int; neg(neg(k)) = k -> neg(neg(succ(k))) = succ(k)
    [by forall_intro induction-step-succ-proof]
  // inductive step (predecessor):
  @induction-step-prev-proof |
    fix k: Int {
      @given-inductive-hypothesis |
        assume neg(neg(k)) = k {
          @inductive-hypothesis |
            neg(neg(k)) = k
            [by hypothesis given-inductive-hypothesis]
          @open-outer |
            neg(prev(k)) = succ(neg(k))
            [by forall_elim(k) neg-prev]
          @lhs-refl |
            neg(neg(prev(k))) = neg(neg(prev(k)))
            [by reflexivity]
          @lhs-outer-opened |
            neg(neg(prev(k))) = neg(succ(neg(k)))
            [by rewrite open-outer lhs-refl]
          @open-inner |
            neg(succ(neg(k))) = prev(neg(neg(k)))
            [by forall_elim(neg(k)) neg-succ]
          @lhs-inner-opened |
            neg(neg(prev(k))) = prev(neg(neg(k)))
            [by rewrite open-inner lhs-outer-opened]
          @prev-case |
            neg(neg(prev(k))) = prev(k)
            [by rewrite inductive-hypothesis lhs-inner-opened]
        }
      @induction-step-at-k |
        neg(neg(k)) = k -> neg(neg(prev(k))) = prev(k)
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-prev |
    forall k: Int; neg(neg(k)) = k -> neg(neg(prev(k))) = prev(k)
    [by forall_intro induction-step-prev-proof]
  @conclusion |
    forall n: Int; neg(neg(n)) = n
    [by instantiate induction((fun m: Int => neg(neg(m)) = m)) base-case induction-step-succ induction-step-prev]
qed

// mul(a, neg(b)) = neg(mul(a, b)) — pulling a negation out of the right factor,
// by bidirectional induction on b (with a fixed). Each step opens neg(succ/prev b)
// via negSucc/negPrev, unfolds the mul recursion, applies the IH, and reconciles
// with negAdd (distributing neg over the recursion's extra summand) — the
// predecessor case additionally cancels a double negation via negNeg.
theorem mulNegRight: forall a, b: Int; mul(a, neg(b)) = neg(mul(a, b))
proof
  @generalize-a |
    fix a: Int {
      @mul-zero-right |
        forall x: Int; mul(x, ZERO) = ZERO
        [by theorem mulZeroRight]
      @mul-succ-right |
        forall x, y: Int; mul(x, succ(y)) = add(mul(x, y), x)
        [by theorem mulSuccRight]
      @mul-prev-right |
        forall x, y: Int; mul(x, prev(y)) = add(mul(x, y), neg(x))
        [by theorem mulPrevRight]
      @neg-zero |
        neg(ZERO) = ZERO
        [by axiom negZero]
      @neg-succ |
        forall n: Int; neg(succ(n)) = prev(neg(n))
        [by axiom negSucc]
      @neg-prev |
        forall n: Int; neg(prev(n)) = succ(neg(n))
        [by axiom negPrev]
      @neg-add |
        forall x, y: Int; neg(add(x, y)) = add(neg(x), neg(y))
        [by theorem negAdd]
      @neg-neg |
        forall n: Int; neg(neg(n)) = n
        [by theorem negNeg]
      // base case: b = ZERO — both sides are ZERO.
      @neg-of-zero |
        neg(ZERO) = ZERO
        [by axiom negZero]
      @lhs-at-zero-refl |
        mul(a, neg(ZERO)) = mul(a, neg(ZERO))
        [by reflexivity]
      @lhs-at-zero-neg-opened |
        mul(a, neg(ZERO)) = mul(a, ZERO)
        [by rewrite neg-of-zero lhs-at-zero-refl]
      @mul-a-zero |
        mul(a, ZERO) = ZERO
        [by forall_elim(a) mul-zero-right]
      @lhs-at-zero |
        mul(a, neg(ZERO)) = ZERO
        [by rewrite mul-a-zero lhs-at-zero-neg-opened]
      @rhs-at-zero-refl |
        neg(mul(a, ZERO)) = neg(mul(a, ZERO))
        [by reflexivity]
      @rhs-mul-opened |
        neg(mul(a, ZERO)) = neg(ZERO)
        [by rewrite mul-a-zero rhs-at-zero-refl]
      @rhs-at-zero |
        neg(mul(a, ZERO)) = ZERO
        [by rewrite neg-zero rhs-mul-opened]
      @rhs-at-zero-flipped |
        ZERO = neg(mul(a, ZERO))
        [by symmetry rhs-at-zero]
      @base-case |
        mul(a, neg(ZERO)) = neg(mul(a, ZERO))
        [by rewrite rhs-at-zero-flipped lhs-at-zero]
      // inductive step (successor):
      @induction-step-succ-proof |
        fix b: Int {
          @given-inductive-hypothesis |
            assume mul(a, neg(b)) = neg(mul(a, b)) {
              @inductive-hypothesis |
                mul(a, neg(b)) = neg(mul(a, b))
                [by hypothesis given-inductive-hypothesis]
              @open-neg |
                neg(succ(b)) = prev(neg(b))
                [by forall_elim(b) neg-succ]
              @lhs-refl |
                mul(a, neg(succ(b))) = mul(a, neg(succ(b)))
                [by reflexivity]
              @lhs-neg-opened |
                mul(a, neg(succ(b))) = mul(a, prev(neg(b)))
                [by rewrite open-neg lhs-refl]
              @unfold-mul-prev |
                mul(a, prev(neg(b))) = add(mul(a, neg(b)), neg(a))
                [by forall_elim(a, neg(b)) mul-prev-right]
              @lhs-mul-unfolded |
                mul(a, neg(succ(b))) = add(mul(a, neg(b)), neg(a))
                [by rewrite unfold-mul-prev lhs-neg-opened]
              @lhs-normal |
                mul(a, neg(succ(b))) = add(neg(mul(a, b)), neg(a))
                [by rewrite inductive-hypothesis lhs-mul-unfolded]
              @unfold-mul-succ |
                mul(a, succ(b)) = add(mul(a, b), a)
                [by forall_elim(a, b) mul-succ-right]
              @rhs-refl |
                neg(mul(a, succ(b))) = neg(mul(a, succ(b)))
                [by reflexivity]
              @rhs-mul-unfolded |
                neg(mul(a, succ(b))) = neg(add(mul(a, b), a))
                [by rewrite unfold-mul-succ rhs-refl]
              @distribute-neg |
                neg(add(mul(a, b), a)) = add(neg(mul(a, b)), neg(a))
                [by forall_elim(mul(a, b), a) neg-add]
              @rhs-normal |
                neg(mul(a, succ(b))) = add(neg(mul(a, b)), neg(a))
                [by rewrite distribute-neg rhs-mul-unfolded]
              @rhs-normal-flipped |
                add(neg(mul(a, b)), neg(a)) = neg(mul(a, succ(b)))
                [by symmetry rhs-normal]
              @succ-case |
                mul(a, neg(succ(b))) = neg(mul(a, succ(b)))
                [by rewrite rhs-normal-flipped lhs-normal]
            }
          @induction-step-at-k |
            mul(a, neg(b)) = neg(mul(a, b)) -> mul(a, neg(succ(b))) = neg(mul(a, succ(b)))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-succ |
        forall b: Int; mul(a, neg(b)) = neg(mul(a, b)) -> mul(a, neg(succ(b))) = neg(mul(a, succ(b)))
        [by forall_intro induction-step-succ-proof]
      // inductive step (predecessor):
      @induction-step-prev-proof |
        fix b: Int {
          @given-inductive-hypothesis |
            assume mul(a, neg(b)) = neg(mul(a, b)) {
              @inductive-hypothesis |
                mul(a, neg(b)) = neg(mul(a, b))
                [by hypothesis given-inductive-hypothesis]
              @open-neg |
                neg(prev(b)) = succ(neg(b))
                [by forall_elim(b) neg-prev]
              @lhs-refl |
                mul(a, neg(prev(b))) = mul(a, neg(prev(b)))
                [by reflexivity]
              @lhs-neg-opened |
                mul(a, neg(prev(b))) = mul(a, succ(neg(b)))
                [by rewrite open-neg lhs-refl]
              @unfold-mul-succ |
                mul(a, succ(neg(b))) = add(mul(a, neg(b)), a)
                [by forall_elim(a, neg(b)) mul-succ-right]
              @lhs-mul-unfolded |
                mul(a, neg(prev(b))) = add(mul(a, neg(b)), a)
                [by rewrite unfold-mul-succ lhs-neg-opened]
              @lhs-normal |
                mul(a, neg(prev(b))) = add(neg(mul(a, b)), a)
                [by rewrite inductive-hypothesis lhs-mul-unfolded]
              @unfold-mul-prev |
                mul(a, prev(b)) = add(mul(a, b), neg(a))
                [by forall_elim(a, b) mul-prev-right]
              @rhs-refl |
                neg(mul(a, prev(b))) = neg(mul(a, prev(b)))
                [by reflexivity]
              @rhs-mul-unfolded |
                neg(mul(a, prev(b))) = neg(add(mul(a, b), neg(a)))
                [by rewrite unfold-mul-prev rhs-refl]
              @distribute-neg |
                neg(add(mul(a, b), neg(a))) = add(neg(mul(a, b)), neg(neg(a)))
                [by forall_elim(mul(a, b), neg(a)) neg-add]
              @rhs-distributed |
                neg(mul(a, prev(b))) = add(neg(mul(a, b)), neg(neg(a)))
                [by rewrite distribute-neg rhs-mul-unfolded]
              @cancel-double-neg |
                neg(neg(a)) = a
                [by forall_elim(a) neg-neg]
              @rhs-normal |
                neg(mul(a, prev(b))) = add(neg(mul(a, b)), a)
                [by rewrite cancel-double-neg rhs-distributed]
              @rhs-normal-flipped |
                add(neg(mul(a, b)), a) = neg(mul(a, prev(b)))
                [by symmetry rhs-normal]
              @prev-case |
                mul(a, neg(prev(b))) = neg(mul(a, prev(b)))
                [by rewrite rhs-normal-flipped lhs-normal]
            }
          @induction-step-at-k |
            mul(a, neg(b)) = neg(mul(a, b)) -> mul(a, neg(prev(b))) = neg(mul(a, prev(b)))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-prev |
        forall b: Int; mul(a, neg(b)) = neg(mul(a, b)) -> mul(a, neg(prev(b))) = neg(mul(a, prev(b)))
        [by forall_intro induction-step-prev-proof]
      @conclusion-for-a |
        forall b: Int; mul(a, neg(b)) = neg(mul(a, b))
        [by instantiate induction((fun m: Int => mul(a, neg(m)) = neg(mul(a, m)))) base-case induction-step-succ induction-step-prev]
    }
  @conclusion |
    forall a, b: Int; mul(a, neg(b)) = neg(mul(a, b))
    [by forall_intro generalize-a]
qed

// mul(mul(a, b), c) = mul(a, mul(b, c)) — associativity of multiplication, by
// bidirectional induction on c (with a and b fixed). Each step unfolds the mul
// recursion on the left and distributes it over the right via mulAddDistribLeft;
// the predecessor case pulls the resulting negation through with mulNegRight.
theorem mulIsAssociative: forall a, b, c: Int; mul(mul(a, b), c) = mul(a, mul(b, c))
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @mul-zero-right |
            forall x: Int; mul(x, ZERO) = ZERO
            [by theorem mulZeroRight]
          @mul-succ-right |
            forall x, y: Int; mul(x, succ(y)) = add(mul(x, y), x)
            [by theorem mulSuccRight]
          @mul-prev-right |
            forall x, y: Int; mul(x, prev(y)) = add(mul(x, y), neg(x))
            [by theorem mulPrevRight]
          @mul-add-distrib |
            forall x, y, z: Int; mul(x, add(y, z)) = add(mul(x, y), mul(x, z))
            [by theorem mulAddDistribLeft]
          @mul-neg-right |
            forall x, y: Int; mul(x, neg(y)) = neg(mul(x, y))
            [by theorem mulNegRight]
          // base case: c = ZERO — both sides are ZERO.
          @lhs-at-zero |
            mul(mul(a, b), ZERO) = ZERO
            [by forall_elim(mul(a, b)) mul-zero-right]
          @inner-at-zero |
            mul(b, ZERO) = ZERO
            [by forall_elim(b) mul-zero-right]
          @rhs-at-zero-refl |
            mul(a, mul(b, ZERO)) = mul(a, mul(b, ZERO))
            [by reflexivity]
          @rhs-inner-opened |
            mul(a, mul(b, ZERO)) = mul(a, ZERO)
            [by rewrite inner-at-zero rhs-at-zero-refl]
          @mul-a-zero |
            mul(a, ZERO) = ZERO
            [by forall_elim(a) mul-zero-right]
          @rhs-at-zero |
            mul(a, mul(b, ZERO)) = ZERO
            [by rewrite mul-a-zero rhs-inner-opened]
          @rhs-at-zero-flipped |
            ZERO = mul(a, mul(b, ZERO))
            [by symmetry rhs-at-zero]
          @base-case |
            mul(mul(a, b), ZERO) = mul(a, mul(b, ZERO))
            [by rewrite rhs-at-zero-flipped lhs-at-zero]
          // inductive step (successor):
          @induction-step-succ-proof |
            fix c: Int {
              @given-inductive-hypothesis |
                assume mul(mul(a, b), c) = mul(a, mul(b, c)) {
                  @inductive-hypothesis |
                    mul(mul(a, b), c) = mul(a, mul(b, c))
                    [by hypothesis given-inductive-hypothesis]
                  @lhs-unfold |
                    mul(mul(a, b), succ(c)) = add(mul(mul(a, b), c), mul(a, b))
                    [by forall_elim(mul(a, b), c) mul-succ-right]
                  @lhs-normal |
                    mul(mul(a, b), succ(c)) = add(mul(a, mul(b, c)), mul(a, b))
                    [by rewrite inductive-hypothesis lhs-unfold]
                  @inner-unfold |
                    mul(b, succ(c)) = add(mul(b, c), b)
                    [by forall_elim(b, c) mul-succ-right]
                  @rhs-refl |
                    mul(a, mul(b, succ(c))) = mul(a, mul(b, succ(c)))
                    [by reflexivity]
                  @rhs-inner-unfolded |
                    mul(a, mul(b, succ(c))) = mul(a, add(mul(b, c), b))
                    [by rewrite inner-unfold rhs-refl]
                  @distribute |
                    mul(a, add(mul(b, c), b)) = add(mul(a, mul(b, c)), mul(a, b))
                    [by forall_elim(a, mul(b, c), b) mul-add-distrib]
                  @rhs-normal |
                    mul(a, mul(b, succ(c))) = add(mul(a, mul(b, c)), mul(a, b))
                    [by rewrite distribute rhs-inner-unfolded]
                  @rhs-normal-flipped |
                    add(mul(a, mul(b, c)), mul(a, b)) = mul(a, mul(b, succ(c)))
                    [by symmetry rhs-normal]
                  @succ-case |
                    mul(mul(a, b), succ(c)) = mul(a, mul(b, succ(c)))
                    [by rewrite rhs-normal-flipped lhs-normal]
                }
              @induction-step-at-k |
                mul(mul(a, b), c) = mul(a, mul(b, c)) -> mul(mul(a, b), succ(c)) = mul(a, mul(b, succ(c)))
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-succ |
            forall c: Int; mul(mul(a, b), c) = mul(a, mul(b, c)) -> mul(mul(a, b), succ(c)) = mul(a, mul(b, succ(c)))
            [by forall_intro induction-step-succ-proof]
          // inductive step (predecessor):
          @induction-step-prev-proof |
            fix c: Int {
              @given-inductive-hypothesis |
                assume mul(mul(a, b), c) = mul(a, mul(b, c)) {
                  @inductive-hypothesis |
                    mul(mul(a, b), c) = mul(a, mul(b, c))
                    [by hypothesis given-inductive-hypothesis]
                  @lhs-unfold |
                    mul(mul(a, b), prev(c)) = add(mul(mul(a, b), c), neg(mul(a, b)))
                    [by forall_elim(mul(a, b), c) mul-prev-right]
                  @lhs-normal |
                    mul(mul(a, b), prev(c)) = add(mul(a, mul(b, c)), neg(mul(a, b)))
                    [by rewrite inductive-hypothesis lhs-unfold]
                  @inner-unfold |
                    mul(b, prev(c)) = add(mul(b, c), neg(b))
                    [by forall_elim(b, c) mul-prev-right]
                  @rhs-refl |
                    mul(a, mul(b, prev(c))) = mul(a, mul(b, prev(c)))
                    [by reflexivity]
                  @rhs-inner-unfolded |
                    mul(a, mul(b, prev(c))) = mul(a, add(mul(b, c), neg(b)))
                    [by rewrite inner-unfold rhs-refl]
                  @distribute |
                    mul(a, add(mul(b, c), neg(b))) = add(mul(a, mul(b, c)), mul(a, neg(b)))
                    [by forall_elim(a, mul(b, c), neg(b)) mul-add-distrib]
                  @rhs-distributed |
                    mul(a, mul(b, prev(c))) = add(mul(a, mul(b, c)), mul(a, neg(b)))
                    [by rewrite distribute rhs-inner-unfolded]
                  @pull-neg-out |
                    mul(a, neg(b)) = neg(mul(a, b))
                    [by forall_elim(a, b) mul-neg-right]
                  @rhs-normal |
                    mul(a, mul(b, prev(c))) = add(mul(a, mul(b, c)), neg(mul(a, b)))
                    [by rewrite pull-neg-out rhs-distributed]
                  @rhs-normal-flipped |
                    add(mul(a, mul(b, c)), neg(mul(a, b))) = mul(a, mul(b, prev(c)))
                    [by symmetry rhs-normal]
                  @prev-case |
                    mul(mul(a, b), prev(c)) = mul(a, mul(b, prev(c)))
                    [by rewrite rhs-normal-flipped lhs-normal]
                }
              @induction-step-at-k |
                mul(mul(a, b), c) = mul(a, mul(b, c)) -> mul(mul(a, b), prev(c)) = mul(a, mul(b, prev(c)))
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-prev |
            forall c: Int; mul(mul(a, b), c) = mul(a, mul(b, c)) -> mul(mul(a, b), prev(c)) = mul(a, mul(b, prev(c)))
            [by forall_intro induction-step-prev-proof]
          @conclusion-for-b |
            forall c: Int; mul(mul(a, b), c) = mul(a, mul(b, c))
            [by instantiate induction((fun m: Int => mul(mul(a, b), m) = mul(a, mul(b, m)))) base-case induction-step-succ induction-step-prev]
        }
      @conclusion-for-a |
        forall b, c: Int; mul(mul(a, b), c) = mul(a, mul(b, c))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: Int; mul(mul(a, b), c) = mul(a, mul(b, c))
    [by forall_intro generalize-a]
qed

// add(neg(n), n) = ZERO — the left additive inverse, by commuting to
// add(n, neg(n)) = ZERO (addNegRight). A discharge lemma for the ring model.
theorem addNegLeft: forall n: Int; add(neg(n), n) = ZERO
proof
  @generalize-n |
    fix n: Int {
      @commute |
        forall a, b: Int; add(a, b) = add(b, a)
        [by theorem addIsCommutative]
      @neg-plus-n-commutes |
        add(neg(n), n) = add(n, neg(n))
        [by forall_elim(neg(n), n) commute]
      @n-plus-neg |
        forall m: Int; add(m, neg(m)) = ZERO
        [by theorem addNegRight]
      @n-plus-neg-is-zero |
        add(n, neg(n)) = ZERO
        [by forall_elim(n) n-plus-neg]
      @conclusion-neg-left |
        add(neg(n), n) = ZERO
        [by rewrite n-plus-neg-is-zero neg-plus-n-commutes]
    }
  @conclusion |
    forall n: Int; add(neg(n), n) = ZERO
    [by forall_intro generalize-n]
qed

// mul(add(a, b), c) = add(mul(a, c), mul(b, c)) — right-distributivity of mul
// over add, by bidirectional induction on c (with a and b fixed). Mirrors
// mulAddDistribLeft, but the recursion peels on the left factor add(a, b): the
// extra summand is add(a, b) on succ (neg(add(a, b)) on prev), which must be
// reshuffled against the paired sums add(mul(a, c), mul(b, c)) using add-
// associative and add-commutative (a four-term AC rearrangement done by hand).
theorem mulAddDistribRight: forall a, b, c: Int; mul(add(a, b), c) = add(mul(a, c), mul(b, c))
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @add-zero |
            forall x: Int; add(x, ZERO) = x
            [by theorem addZeroRight]
          @mul-zero-right |
            forall x: Int; mul(x, ZERO) = ZERO
            [by theorem mulZeroRight]
          @mul-succ-right |
            forall x, y: Int; mul(x, succ(y)) = add(mul(x, y), x)
            [by theorem mulSuccRight]
          @mul-prev-right |
            forall x, y: Int; mul(x, prev(y)) = add(mul(x, y), neg(x))
            [by theorem mulPrevRight]
          @add-associative |
            forall x, y, z: Int; add(add(x, y), z) = add(x, add(y, z))
            [by theorem addIsAssociative]
          @add-commutative |
            forall x, y: Int; add(x, y) = add(y, x)
            [by theorem addIsCommutative]
          @neg-add |
            forall u, v: Int; neg(add(u, v)) = add(neg(u), neg(v))
            [by theorem negAdd]
          // base case: c = ZERO — both sides collapse to ZERO.
          @lhs-mul-zero |
            mul(add(a, b), ZERO) = ZERO
            [by forall_elim(add(a, b)) mul-zero-right]
          @mul-a-zero |
            mul(a, ZERO) = ZERO
            [by forall_elim(a) mul-zero-right]
          @mul-b-zero |
            mul(b, ZERO) = ZERO
            [by forall_elim(b) mul-zero-right]
          @rhs-zero-refl |
            add(mul(a, ZERO), mul(b, ZERO)) = add(mul(a, ZERO), mul(b, ZERO))
            [by reflexivity]
          @rhs-with-a-zero |
            add(mul(a, ZERO), mul(b, ZERO)) = add(ZERO, mul(b, ZERO))
            [by rewrite mul-a-zero rhs-zero-refl]
          @rhs-with-both-zero |
            add(mul(a, ZERO), mul(b, ZERO)) = add(ZERO, ZERO)
            [by rewrite mul-b-zero rhs-with-a-zero]
          @collapse-zero-zero |
            add(ZERO, ZERO) = ZERO
            [by forall_elim(ZERO) add-zero]
          @rhs-at-zero |
            add(mul(a, ZERO), mul(b, ZERO)) = ZERO
            [by rewrite collapse-zero-zero rhs-with-both-zero]
          @rhs-at-zero-flipped |
            ZERO = add(mul(a, ZERO), mul(b, ZERO))
            [by symmetry rhs-at-zero]
          @base-case |
            mul(add(a, b), ZERO) = add(mul(a, ZERO), mul(b, ZERO))
            [by rewrite rhs-at-zero-flipped lhs-mul-zero]
          // inductive step (successor): extra summand add(a, b) reshuffles into
          // add(mul(a, c), a) and add(mul(b, c), b) via an AC rearrangement.
          @induction-step-succ-proof |
            fix c: Int {
              @given-inductive-hypothesis |
                assume mul(add(a, b), c) = add(mul(a, c), mul(b, c)) {
                  @inductive-hypothesis |
                    mul(add(a, b), c) = add(mul(a, c), mul(b, c))
                    [by hypothesis given-inductive-hypothesis]
                  @lhs-mul-unfold |
                    mul(add(a, b), succ(c)) = add(mul(add(a, b), c), add(a, b))
                    [by forall_elim(add(a, b), c) mul-succ-right]
                  @lhs-with-ih |
                    mul(add(a, b), succ(c)) = add(add(mul(a, c), mul(b, c)), add(a, b))
                    [by rewrite inductive-hypothesis lhs-mul-unfold]
                  // reshuffle add(add(P, Q), add(a, b)) -> add(add(P, a), add(Q, b))
                  // with P = mul(a, c), Q = mul(b, c).
                  @reshuffle-1 |
                    add(add(mul(a, c), mul(b, c)), add(a, b)) = add(mul(a, c), add(mul(b, c), add(a, b)))
                    [by forall_elim(mul(a, c), mul(b, c), add(a, b)) add-associative]
                  @inner-assoc-back |
                    add(add(mul(b, c), a), b) = add(mul(b, c), add(a, b))
                    [by forall_elim(mul(b, c), a, b) add-associative]
                  @inner-assoc-fwd |
                    add(mul(b, c), add(a, b)) = add(add(mul(b, c), a), b)
                    [by symmetry inner-assoc-back]
                  @inner-comm |
                    add(mul(b, c), a) = add(a, mul(b, c))
                    [by forall_elim(mul(b, c), a) add-commutative]
                  @inner-step1 |
                    add(mul(b, c), add(a, b)) = add(add(a, mul(b, c)), b)
                    [by rewrite inner-comm inner-assoc-fwd]
                  @inner-reassoc |
                    add(add(a, mul(b, c)), b) = add(a, add(mul(b, c), b))
                    [by forall_elim(a, mul(b, c), b) add-associative]
                  @inner-normal |
                    add(mul(b, c), add(a, b)) = add(a, add(mul(b, c), b))
                    [by rewrite inner-reassoc inner-step1]
                  @reshuffle-2 |
                    add(add(mul(a, c), mul(b, c)), add(a, b)) = add(mul(a, c), add(a, add(mul(b, c), b)))
                    [by rewrite inner-normal reshuffle-1]
                  @outer-reassoc |
                    add(add(mul(a, c), a), add(mul(b, c), b)) = add(mul(a, c), add(a, add(mul(b, c), b)))
                    [by forall_elim(mul(a, c), a, add(mul(b, c), b)) add-associative]
                  @outer-reassoc-flipped |
                    add(mul(a, c), add(a, add(mul(b, c), b))) = add(add(mul(a, c), a), add(mul(b, c), b))
                    [by symmetry outer-reassoc]
                  @reshuffle-done |
                    add(add(mul(a, c), mul(b, c)), add(a, b)) = add(add(mul(a, c), a), add(mul(b, c), b))
                    [by rewrite outer-reassoc-flipped reshuffle-2]
                  @lhs-normal |
                    mul(add(a, b), succ(c)) = add(add(mul(a, c), a), add(mul(b, c), b))
                    [by rewrite reshuffle-done lhs-with-ih]
                  @mul-a-succ |
                    mul(a, succ(c)) = add(mul(a, c), a)
                    [by forall_elim(a, c) mul-succ-right]
                  @mul-b-succ |
                    mul(b, succ(c)) = add(mul(b, c), b)
                    [by forall_elim(b, c) mul-succ-right]
                  @rhs-refl |
                    add(mul(a, succ(c)), mul(b, succ(c))) = add(mul(a, succ(c)), mul(b, succ(c)))
                    [by reflexivity]
                  @rhs-with-a |
                    add(mul(a, succ(c)), mul(b, succ(c))) = add(add(mul(a, c), a), mul(b, succ(c)))
                    [by rewrite mul-a-succ rhs-refl]
                  @rhs-normal |
                    add(mul(a, succ(c)), mul(b, succ(c))) = add(add(mul(a, c), a), add(mul(b, c), b))
                    [by rewrite mul-b-succ rhs-with-a]
                  @rhs-normal-flipped |
                    add(add(mul(a, c), a), add(mul(b, c), b)) = add(mul(a, succ(c)), mul(b, succ(c)))
                    [by symmetry rhs-normal]
                  @succ-case |
                    mul(add(a, b), succ(c)) = add(mul(a, succ(c)), mul(b, succ(c)))
                    [by rewrite rhs-normal-flipped lhs-normal]
                }
              @induction-step-at-k |
                mul(add(a, b), c) = add(mul(a, c), mul(b, c)) -> mul(add(a, b), succ(c)) = add(mul(a, succ(c)), mul(b, succ(c)))
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-succ |
            forall c: Int; mul(add(a, b), c) = add(mul(a, c), mul(b, c)) -> mul(add(a, b), succ(c)) = add(mul(a, succ(c)), mul(b, succ(c)))
            [by forall_intro induction-step-succ-proof]
          // inductive step (predecessor): extra summand neg(add(a, b)) distributes
          // via neg-add into neg(a) and neg(b), then reshuffles as in the succ case.
          @induction-step-prev-proof |
            fix c: Int {
              @given-inductive-hypothesis |
                assume mul(add(a, b), c) = add(mul(a, c), mul(b, c)) {
                  @inductive-hypothesis |
                    mul(add(a, b), c) = add(mul(a, c), mul(b, c))
                    [by hypothesis given-inductive-hypothesis]
                  @lhs-mul-unfold |
                    mul(add(a, b), prev(c)) = add(mul(add(a, b), c), neg(add(a, b)))
                    [by forall_elim(add(a, b), c) mul-prev-right]
                  @lhs-with-ih |
                    mul(add(a, b), prev(c)) = add(add(mul(a, c), mul(b, c)), neg(add(a, b)))
                    [by rewrite inductive-hypothesis lhs-mul-unfold]
                  @neg-add-ab |
                    neg(add(a, b)) = add(neg(a), neg(b))
                    [by forall_elim(a, b) neg-add]
                  @lhs-neg-distributed |
                    mul(add(a, b), prev(c)) = add(add(mul(a, c), mul(b, c)), add(neg(a), neg(b)))
                    [by rewrite neg-add-ab lhs-with-ih]
                  // reshuffle add(add(P, Q), add(neg(a), neg(b))) ->
                  // add(add(P, neg(a)), add(Q, neg(b))) with P = mul(a, c), Q = mul(b, c).
                  @reshuffle-1 |
                    add(add(mul(a, c), mul(b, c)), add(neg(a), neg(b))) = add(mul(a, c), add(mul(b, c), add(neg(a), neg(b))))
                    [by forall_elim(mul(a, c), mul(b, c), add(neg(a), neg(b))) add-associative]
                  @inner-assoc-back |
                    add(add(mul(b, c), neg(a)), neg(b)) = add(mul(b, c), add(neg(a), neg(b)))
                    [by forall_elim(mul(b, c), neg(a), neg(b)) add-associative]
                  @inner-assoc-fwd |
                    add(mul(b, c), add(neg(a), neg(b))) = add(add(mul(b, c), neg(a)), neg(b))
                    [by symmetry inner-assoc-back]
                  @inner-comm |
                    add(mul(b, c), neg(a)) = add(neg(a), mul(b, c))
                    [by forall_elim(mul(b, c), neg(a)) add-commutative]
                  @inner-step1 |
                    add(mul(b, c), add(neg(a), neg(b))) = add(add(neg(a), mul(b, c)), neg(b))
                    [by rewrite inner-comm inner-assoc-fwd]
                  @inner-reassoc |
                    add(add(neg(a), mul(b, c)), neg(b)) = add(neg(a), add(mul(b, c), neg(b)))
                    [by forall_elim(neg(a), mul(b, c), neg(b)) add-associative]
                  @inner-normal |
                    add(mul(b, c), add(neg(a), neg(b))) = add(neg(a), add(mul(b, c), neg(b)))
                    [by rewrite inner-reassoc inner-step1]
                  @reshuffle-2 |
                    add(add(mul(a, c), mul(b, c)), add(neg(a), neg(b))) = add(mul(a, c), add(neg(a), add(mul(b, c), neg(b))))
                    [by rewrite inner-normal reshuffle-1]
                  @outer-reassoc |
                    add(add(mul(a, c), neg(a)), add(mul(b, c), neg(b))) = add(mul(a, c), add(neg(a), add(mul(b, c), neg(b))))
                    [by forall_elim(mul(a, c), neg(a), add(mul(b, c), neg(b))) add-associative]
                  @outer-reassoc-flipped |
                    add(mul(a, c), add(neg(a), add(mul(b, c), neg(b)))) = add(add(mul(a, c), neg(a)), add(mul(b, c), neg(b)))
                    [by symmetry outer-reassoc]
                  @reshuffle-done |
                    add(add(mul(a, c), mul(b, c)), add(neg(a), neg(b))) = add(add(mul(a, c), neg(a)), add(mul(b, c), neg(b)))
                    [by rewrite outer-reassoc-flipped reshuffle-2]
                  @lhs-normal |
                    mul(add(a, b), prev(c)) = add(add(mul(a, c), neg(a)), add(mul(b, c), neg(b)))
                    [by rewrite reshuffle-done lhs-neg-distributed]
                  @mul-a-prev |
                    mul(a, prev(c)) = add(mul(a, c), neg(a))
                    [by forall_elim(a, c) mul-prev-right]
                  @mul-b-prev |
                    mul(b, prev(c)) = add(mul(b, c), neg(b))
                    [by forall_elim(b, c) mul-prev-right]
                  @rhs-refl |
                    add(mul(a, prev(c)), mul(b, prev(c))) = add(mul(a, prev(c)), mul(b, prev(c)))
                    [by reflexivity]
                  @rhs-with-a |
                    add(mul(a, prev(c)), mul(b, prev(c))) = add(add(mul(a, c), neg(a)), mul(b, prev(c)))
                    [by rewrite mul-a-prev rhs-refl]
                  @rhs-normal |
                    add(mul(a, prev(c)), mul(b, prev(c))) = add(add(mul(a, c), neg(a)), add(mul(b, c), neg(b)))
                    [by rewrite mul-b-prev rhs-with-a]
                  @rhs-normal-flipped |
                    add(add(mul(a, c), neg(a)), add(mul(b, c), neg(b))) = add(mul(a, prev(c)), mul(b, prev(c)))
                    [by symmetry rhs-normal]
                  @prev-case |
                    mul(add(a, b), prev(c)) = add(mul(a, prev(c)), mul(b, prev(c)))
                    [by rewrite rhs-normal-flipped lhs-normal]
                }
              @induction-step-at-k |
                mul(add(a, b), c) = add(mul(a, c), mul(b, c)) -> mul(add(a, b), prev(c)) = add(mul(a, prev(c)), mul(b, prev(c)))
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-prev |
            forall c: Int; mul(add(a, b), c) = add(mul(a, c), mul(b, c)) -> mul(add(a, b), prev(c)) = add(mul(a, prev(c)), mul(b, prev(c)))
            [by forall_intro induction-step-prev-proof]
          @conclusion-for-b |
            forall c: Int; mul(add(a, b), c) = add(mul(a, c), mul(b, c))
            [by instantiate induction((fun m: Int => mul(add(a, b), m) = add(mul(a, m), mul(b, m)))) base-case induction-step-succ induction-step-prev]
        }
      @conclusion-for-a |
        forall b, c: Int; mul(add(a, b), c) = add(mul(a, c), mul(b, c))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: Int; mul(add(a, b), c) = add(mul(a, c), mul(b, c))
    [by forall_intro generalize-a]
qed
