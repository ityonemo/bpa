// std/integer-ring.bpa — the ring algebra of ℤ, PROVEN from std/integer.bpa's
// axioms (recursion on the right in both directions + bidirectional induction).
//
// The integer axioms recurse add/mul on the RIGHT argument; the LEFT-recursion
// mirror lemmas (addSuccLeft, addPrevLeft, ...) are the bootstrap, proved by
// bidirectional induction, and everything else (commutativity, associativity,
// the additive inverse law `n + (-n) = 0`, distributivity) follows. This is the
// ℤ analogue of the Peano algebra in std/peano.bpa.

import integer <<< "std/integer.bpa"

sort Int = integer.Int
const ZERO = integer.ZERO
const ONE = integer.ONE
func succ = integer.succ
func prev = integer.prev
func add = integer.add
func mul = integer.mul
func neg = integer.neg
axiom prevSucc = integer.prevSucc
axiom succPrev = integer.succPrev
axiom oneIsSuccZero = integer.oneIsSuccZero
axiom addZeroRight = integer.addZeroRight
axiom addSuccRight = integer.addSuccRight
axiom addPrevRight = integer.addPrevRight
axiom negZero = integer.negZero
axiom negSucc = integer.negSucc
axiom negPrev = integer.negPrev
axiom mulZeroRight = integer.mulZeroRight
axiom mulSuccRight = integer.mulSuccRight
axiom mulPrevRight = integer.mulPrevRight
axiom induction = integer.induction

// -- addition: left identity + left recursion (the bootstrap) ---------------

// add(ZERO, n) = n, by bidirectional induction on n.
theorem addZeroLeft: forall n: Int; add(ZERO, n) = n
proof
  @add-zero |
    forall a: Int; add(a, ZERO) = a
    [by axiom addZeroRight]
  @base |
    add(ZERO, ZERO) = ZERO
    [by forall_elim(ZERO) add-zero]
  @generalize-succ |
    fix k: Int {
      @given-inductive-hypothesis |
        assume add(ZERO, k) = k {
          @inductive-hypothesis |
            add(ZERO, k) = k
            [by hypothesis given-inductive-hypothesis]
          @add-succ |
            forall a, b: Int; add(a, succ(b)) = succ(add(a, b))
            [by axiom addSuccRight]
          @unfold |
            add(ZERO, succ(k)) = succ(add(ZERO, k))
            [by forall_elim(ZERO, k) add-succ]
          @succ-case |
            add(ZERO, succ(k)) = succ(k)
            [by rewrite inductive-hypothesis unfold]
        }
      @discharge-succ |
        add(ZERO, k) = k -> add(ZERO, succ(k)) = succ(k)
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-succ |
    forall k: Int; add(ZERO, k) = k -> add(ZERO, succ(k)) = succ(k)
    [by forall_intro generalize-succ]
  @generalize-prev |
    fix k: Int {
      @given-inductive-hypothesis |
        assume add(ZERO, k) = k {
          @inductive-hypothesis |
            add(ZERO, k) = k
            [by hypothesis given-inductive-hypothesis]
          @add-prev |
            forall a, b: Int; add(a, prev(b)) = prev(add(a, b))
            [by axiom addPrevRight]
          @unfold |
            add(ZERO, prev(k)) = prev(add(ZERO, k))
            [by forall_elim(ZERO, k) add-prev]
          @prev-case |
            add(ZERO, prev(k)) = prev(k)
            [by rewrite inductive-hypothesis unfold]
        }
      @discharge-prev |
        add(ZERO, k) = k -> add(ZERO, prev(k)) = prev(k)
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-prev |
    forall k: Int; add(ZERO, k) = k -> add(ZERO, prev(k)) = prev(k)
    [by forall_intro generalize-prev]
  @conclusion |
    forall n: Int; add(ZERO, n) = n
    [by instantiate induction((fun m: Int => add(ZERO, m) = m)) base induction-step-succ induction-step-prev]
qed

// add(succ(a), b) = succ(add(a, b)), by bidirectional induction on b — the
// left-successor recursion, bootstrapped from the right-recursion axioms.
theorem addSuccLeft: forall a, b: Int; add(succ(a), b) = succ(add(a, b))
proof
  @generalize-a |
    fix a: Int {
      @add-zero |
        forall x: Int; add(x, ZERO) = x
        [by axiom addZeroRight]
      @add-succ |
        forall x, y: Int; add(x, succ(y)) = succ(add(x, y))
        [by axiom addSuccRight]
      @add-prev |
        forall x, y: Int; add(x, prev(y)) = prev(add(x, y))
        [by axiom addPrevRight]
      @lhs-at-zero |
        add(succ(a), ZERO) = succ(a)
        [by forall_elim(succ(a)) add-zero]
      @rhs-at-zero |
        add(a, ZERO) = a
        [by forall_elim(a) add-zero]
      @rhs-at-zero-flipped |
        a = add(a, ZERO)
        [by symmetry rhs-at-zero]
      @base |
        add(succ(a), ZERO) = succ(add(a, ZERO))
        [by rewrite rhs-at-zero-flipped lhs-at-zero]
      @generalize-succ |
        fix b: Int {
          @given-inductive-hypothesis |
            assume add(succ(a), b) = succ(add(a, b)) {
              @inductive-hypothesis |
                add(succ(a), b) = succ(add(a, b))
                [by hypothesis given-inductive-hypothesis]
              @lhs-unfold |
                add(succ(a), succ(b)) = succ(add(succ(a), b))
                [by forall_elim(succ(a), b) add-succ]
              @lhs-with-ih |
                add(succ(a), succ(b)) = succ(succ(add(a, b)))
                [by rewrite inductive-hypothesis lhs-unfold]
              @rhs-unfold |
                add(a, succ(b)) = succ(add(a, b))
                [by forall_elim(a, b) add-succ]
              @rhs-refl |
                succ(add(a, succ(b))) = succ(add(a, succ(b)))
                [by reflexivity]
              @rhs-with-unfold |
                succ(add(a, succ(b))) = succ(succ(add(a, b)))
                [by rewrite rhs-unfold rhs-refl]
              @rhs-with-unfold-flipped |
                succ(succ(add(a, b))) = succ(add(a, succ(b)))
                [by symmetry rhs-with-unfold]
              @succ-case |
                add(succ(a), succ(b)) = succ(add(a, succ(b)))
                [by rewrite rhs-with-unfold-flipped lhs-with-ih]
            }
          @discharge-succ |
            add(succ(a), b) = succ(add(a, b)) -> add(succ(a), succ(b)) = succ(add(a, succ(b)))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-succ |
        forall b: Int; add(succ(a), b) = succ(add(a, b)) -> add(succ(a), succ(b)) = succ(add(a, succ(b)))
        [by forall_intro generalize-succ]
      @generalize-prev |
        fix b: Int {
          @given-inductive-hypothesis |
            assume add(succ(a), b) = succ(add(a, b)) {
              @inductive-hypothesis |
                add(succ(a), b) = succ(add(a, b))
                [by hypothesis given-inductive-hypothesis]
              @lhs-unfold |
                add(succ(a), prev(b)) = prev(add(succ(a), b))
                [by forall_elim(succ(a), b) add-prev]
              @lhs-with-ih |
                add(succ(a), prev(b)) = prev(succ(add(a, b)))
                [by rewrite inductive-hypothesis lhs-unfold]
              @prev-succ |
                forall n: Int; prev(succ(n)) = n
                [by axiom prevSucc]
              @collapse-lhs |
                prev(succ(add(a, b))) = add(a, b)
                [by forall_elim(add(a, b)) prev-succ]
              @lhs-is |
                add(succ(a), prev(b)) = add(a, b)
                [by rewrite collapse-lhs lhs-with-ih]
              @rhs-unfold |
                add(a, prev(b)) = prev(add(a, b))
                [by forall_elim(a, b) add-prev]
              @rhs-refl |
                succ(add(a, prev(b))) = succ(add(a, prev(b)))
                [by reflexivity]
              @rhs-with-unfold |
                succ(add(a, prev(b))) = succ(prev(add(a, b)))
                [by rewrite rhs-unfold rhs-refl]
              @succ-prev |
                forall n: Int; succ(prev(n)) = n
                [by axiom succPrev]
              @collapse-rhs |
                succ(prev(add(a, b))) = add(a, b)
                [by forall_elim(add(a, b)) succ-prev]
              @rhs-is |
                succ(add(a, prev(b))) = add(a, b)
                [by rewrite collapse-rhs rhs-with-unfold]
              @rhs-is-flipped |
                add(a, b) = succ(add(a, prev(b)))
                [by symmetry rhs-is]
              @prev-case |
                add(succ(a), prev(b)) = succ(add(a, prev(b)))
                [by rewrite rhs-is-flipped lhs-is]
            }
          @discharge-prev |
            add(succ(a), b) = succ(add(a, b)) -> add(succ(a), prev(b)) = succ(add(a, prev(b)))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-prev |
        forall b: Int; add(succ(a), b) = succ(add(a, b)) -> add(succ(a), prev(b)) = succ(add(a, prev(b)))
        [by forall_intro generalize-prev]
      @conclusion-for-a |
        forall b: Int; add(succ(a), b) = succ(add(a, b))
        [by instantiate induction((fun m: Int => add(succ(a), m) = succ(add(a, m)))) base induction-step-succ induction-step-prev]
    }
  @conclusion |
    forall a, b: Int; add(succ(a), b) = succ(add(a, b))
    [by forall_intro generalize-a]
qed

// add(prev(a), b) = prev(add(a, b)), by bidirectional induction on b — the
// mirror of addSuccLeft (left-predecessor recursion).
theorem addPrevLeft: forall a, b: Int; add(prev(a), b) = prev(add(a, b))
proof
  @generalize-a |
    fix a: Int {
      @add-zero |
        forall x: Int; add(x, ZERO) = x
        [by axiom addZeroRight]
      @add-succ |
        forall x, y: Int; add(x, succ(y)) = succ(add(x, y))
        [by axiom addSuccRight]
      @add-prev |
        forall x, y: Int; add(x, prev(y)) = prev(add(x, y))
        [by axiom addPrevRight]
      @lhs-at-zero |
        add(prev(a), ZERO) = prev(a)
        [by forall_elim(prev(a)) add-zero]
      @rhs-at-zero |
        add(a, ZERO) = a
        [by forall_elim(a) add-zero]
      @rhs-at-zero-flipped |
        a = add(a, ZERO)
        [by symmetry rhs-at-zero]
      @base |
        add(prev(a), ZERO) = prev(add(a, ZERO))
        [by rewrite rhs-at-zero-flipped lhs-at-zero]
      @generalize-succ |
        fix b: Int {
          @given-inductive-hypothesis |
            assume add(prev(a), b) = prev(add(a, b)) {
              @inductive-hypothesis |
                add(prev(a), b) = prev(add(a, b))
                [by hypothesis given-inductive-hypothesis]
              @lhs-unfold |
                add(prev(a), succ(b)) = succ(add(prev(a), b))
                [by forall_elim(prev(a), b) add-succ]
              @lhs-with-ih |
                add(prev(a), succ(b)) = succ(prev(add(a, b)))
                [by rewrite inductive-hypothesis lhs-unfold]
              @succ-prev |
                forall n: Int; succ(prev(n)) = n
                [by axiom succPrev]
              @collapse-lhs |
                succ(prev(add(a, b))) = add(a, b)
                [by forall_elim(add(a, b)) succ-prev]
              @lhs-is |
                add(prev(a), succ(b)) = add(a, b)
                [by rewrite collapse-lhs lhs-with-ih]
              @rhs-unfold |
                add(a, succ(b)) = succ(add(a, b))
                [by forall_elim(a, b) add-succ]
              @rhs-refl |
                prev(add(a, succ(b))) = prev(add(a, succ(b)))
                [by reflexivity]
              @rhs-with-unfold |
                prev(add(a, succ(b))) = prev(succ(add(a, b)))
                [by rewrite rhs-unfold rhs-refl]
              @prev-succ |
                forall n: Int; prev(succ(n)) = n
                [by axiom prevSucc]
              @collapse-rhs |
                prev(succ(add(a, b))) = add(a, b)
                [by forall_elim(add(a, b)) prev-succ]
              @rhs-is |
                prev(add(a, succ(b))) = add(a, b)
                [by rewrite collapse-rhs rhs-with-unfold]
              @rhs-is-flipped |
                add(a, b) = prev(add(a, succ(b)))
                [by symmetry rhs-is]
              @succ-case |
                add(prev(a), succ(b)) = prev(add(a, succ(b)))
                [by rewrite rhs-is-flipped lhs-is]
            }
          @discharge-succ |
            add(prev(a), b) = prev(add(a, b)) -> add(prev(a), succ(b)) = prev(add(a, succ(b)))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-succ |
        forall b: Int; add(prev(a), b) = prev(add(a, b)) -> add(prev(a), succ(b)) = prev(add(a, succ(b)))
        [by forall_intro generalize-succ]
      @generalize-prev |
        fix b: Int {
          @given-inductive-hypothesis |
            assume add(prev(a), b) = prev(add(a, b)) {
              @inductive-hypothesis |
                add(prev(a), b) = prev(add(a, b))
                [by hypothesis given-inductive-hypothesis]
              @lhs-unfold |
                add(prev(a), prev(b)) = prev(add(prev(a), b))
                [by forall_elim(prev(a), b) add-prev]
              @lhs-with-ih |
                add(prev(a), prev(b)) = prev(prev(add(a, b)))
                [by rewrite inductive-hypothesis lhs-unfold]
              @rhs-unfold |
                add(a, prev(b)) = prev(add(a, b))
                [by forall_elim(a, b) add-prev]
              @rhs-refl |
                prev(add(a, prev(b))) = prev(add(a, prev(b)))
                [by reflexivity]
              @rhs-with-unfold |
                prev(add(a, prev(b))) = prev(prev(add(a, b)))
                [by rewrite rhs-unfold rhs-refl]
              @rhs-with-unfold-flipped |
                prev(prev(add(a, b))) = prev(add(a, prev(b)))
                [by symmetry rhs-with-unfold]
              @prev-case |
                add(prev(a), prev(b)) = prev(add(a, prev(b)))
                [by rewrite rhs-with-unfold-flipped lhs-with-ih]
            }
          @discharge-prev |
            add(prev(a), b) = prev(add(a, b)) -> add(prev(a), prev(b)) = prev(add(a, prev(b)))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-prev |
        forall b: Int; add(prev(a), b) = prev(add(a, b)) -> add(prev(a), prev(b)) = prev(add(a, prev(b)))
        [by forall_intro generalize-prev]
      @conclusion-for-a |
        forall b: Int; add(prev(a), b) = prev(add(a, b))
        [by instantiate induction((fun m: Int => add(prev(a), m) = prev(add(a, m)))) base induction-step-succ induction-step-prev]
    }
  @conclusion |
    forall a, b: Int; add(prev(a), b) = prev(add(a, b))
    [by forall_intro generalize-a]
qed

// add(a, b) = add(b, a), by bidirectional induction on b (with a fixed): the
// base uses the two zero-identity laws, and each step turns the right-recursion
// axiom on one side into the left-recursion lemma on the other.
theorem addIsCommutative: forall a, b: Int; add(a, b) = add(b, a)
proof
  @generalize-a |
    fix a: Int {
      @add-zero-right |
        forall x: Int; add(x, ZERO) = x
        [by axiom addZeroRight]
      @add-zero-left |
        forall n: Int; add(ZERO, n) = n
        [by theorem addZeroLeft]
      @lhs-at-zero |
        add(a, ZERO) = a
        [by forall_elim(a) add-zero-right]
      @rhs-at-zero |
        add(ZERO, a) = a
        [by forall_elim(a) add-zero-left]
      @rhs-at-zero-flipped |
        a = add(ZERO, a)
        [by symmetry rhs-at-zero]
      @base |
        add(a, ZERO) = add(ZERO, a)
        [by rewrite rhs-at-zero-flipped lhs-at-zero]
      @add-succ-right |
        forall x, y: Int; add(x, succ(y)) = succ(add(x, y))
        [by axiom addSuccRight]
      @add-succ-left |
        forall x, y: Int; add(succ(x), y) = succ(add(x, y))
        [by theorem addSuccLeft]
      @add-prev-right |
        forall x, y: Int; add(x, prev(y)) = prev(add(x, y))
        [by axiom addPrevRight]
      @add-prev-left |
        forall x, y: Int; add(prev(x), y) = prev(add(x, y))
        [by theorem addPrevLeft]
      @generalize-succ |
        fix b: Int {
          @given-inductive-hypothesis |
            assume add(a, b) = add(b, a) {
              @inductive-hypothesis |
                add(a, b) = add(b, a)
                [by hypothesis given-inductive-hypothesis]
              @lhs-unfold |
                add(a, succ(b)) = succ(add(a, b))
                [by forall_elim(a, b) add-succ-right]
              @lhs-with-ih |
                add(a, succ(b)) = succ(add(b, a))
                [by rewrite inductive-hypothesis lhs-unfold]
              @rhs-unfold |
                add(succ(b), a) = succ(add(b, a))
                [by forall_elim(b, a) add-succ-left]
              @rhs-unfold-flipped |
                succ(add(b, a)) = add(succ(b), a)
                [by symmetry rhs-unfold]
              @succ-case |
                add(a, succ(b)) = add(succ(b), a)
                [by rewrite rhs-unfold-flipped lhs-with-ih]
            }
          @discharge-succ |
            add(a, b) = add(b, a) -> add(a, succ(b)) = add(succ(b), a)
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-succ |
        forall b: Int; add(a, b) = add(b, a) -> add(a, succ(b)) = add(succ(b), a)
        [by forall_intro generalize-succ]
      @generalize-prev |
        fix b: Int {
          @given-inductive-hypothesis |
            assume add(a, b) = add(b, a) {
              @inductive-hypothesis |
                add(a, b) = add(b, a)
                [by hypothesis given-inductive-hypothesis]
              @lhs-unfold |
                add(a, prev(b)) = prev(add(a, b))
                [by forall_elim(a, b) add-prev-right]
              @lhs-with-ih |
                add(a, prev(b)) = prev(add(b, a))
                [by rewrite inductive-hypothesis lhs-unfold]
              @rhs-unfold |
                add(prev(b), a) = prev(add(b, a))
                [by forall_elim(b, a) add-prev-left]
              @rhs-unfold-flipped |
                prev(add(b, a)) = add(prev(b), a)
                [by symmetry rhs-unfold]
              @prev-case |
                add(a, prev(b)) = add(prev(b), a)
                [by rewrite rhs-unfold-flipped lhs-with-ih]
            }
          @discharge-prev |
            add(a, b) = add(b, a) -> add(a, prev(b)) = add(prev(b), a)
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-prev |
        forall b: Int; add(a, b) = add(b, a) -> add(a, prev(b)) = add(prev(b), a)
        [by forall_intro generalize-prev]
      @conclusion-for-a |
        forall b: Int; add(a, b) = add(b, a)
        [by instantiate induction((fun m: Int => add(a, m) = add(m, a))) base induction-step-succ induction-step-prev]
    }
  @conclusion |
    forall a, b: Int; add(a, b) = add(b, a)
    [by forall_intro generalize-a]
qed

// add(add(a, b), c) = add(a, add(b, c)), by bidirectional induction on c (with
// a and b fixed): the recursion axioms peel the outermost succ/prev off both
// sides down to the inductive hypothesis.
theorem addIsAssociative: forall a, b, c: Int; add(add(a, b), c) = add(a, add(b, c))
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @add-zero |
            forall x: Int; add(x, ZERO) = x
            [by axiom addZeroRight]
          @add-succ |
            forall x, y: Int; add(x, succ(y)) = succ(add(x, y))
            [by axiom addSuccRight]
          @add-prev |
            forall x, y: Int; add(x, prev(y)) = prev(add(x, y))
            [by axiom addPrevRight]
          @lhs-at-zero |
            add(add(a, b), ZERO) = add(a, b)
            [by forall_elim(add(a, b)) add-zero]
          @inner-at-zero |
            add(b, ZERO) = b
            [by forall_elim(b) add-zero]
          @base-rhs-refl |
            add(a, add(b, ZERO)) = add(a, add(b, ZERO))
            [by reflexivity]
          @rhs-at-zero |
            add(a, b) = add(a, add(b, ZERO))
            [by rewrite inner-at-zero base-rhs-refl]
          @base |
            add(add(a, b), ZERO) = add(a, add(b, ZERO))
            [by rewrite rhs-at-zero lhs-at-zero]
          @generalize-succ |
            fix c: Int {
              @given-inductive-hypothesis |
                assume add(add(a, b), c) = add(a, add(b, c)) {
                  @inductive-hypothesis |
                    add(add(a, b), c) = add(a, add(b, c))
                    [by hypothesis given-inductive-hypothesis]
                  @lhs-unfold |
                    add(add(a, b), succ(c)) = succ(add(add(a, b), c))
                    [by forall_elim(add(a, b), c) add-succ]
                  @lhs-with-ih |
                    add(add(a, b), succ(c)) = succ(add(a, add(b, c)))
                    [by rewrite inductive-hypothesis lhs-unfold]
                  @inner-unfold |
                    add(b, succ(c)) = succ(add(b, c))
                    [by forall_elim(b, c) add-succ]
                  @rhs-refl |
                    add(a, add(b, succ(c))) = add(a, add(b, succ(c)))
                    [by reflexivity]
                  @rhs-inner |
                    add(a, add(b, succ(c))) = add(a, succ(add(b, c)))
                    [by rewrite inner-unfold rhs-refl]
                  @outer-unfold |
                    add(a, succ(add(b, c))) = succ(add(a, add(b, c)))
                    [by forall_elim(a, add(b, c)) add-succ]
                  @rhs-is |
                    add(a, add(b, succ(c))) = succ(add(a, add(b, c)))
                    [by rewrite outer-unfold rhs-inner]
                  @rhs-is-flipped |
                    succ(add(a, add(b, c))) = add(a, add(b, succ(c)))
                    [by symmetry rhs-is]
                  @succ-case |
                    add(add(a, b), succ(c)) = add(a, add(b, succ(c)))
                    [by rewrite rhs-is-flipped lhs-with-ih]
                }
              @discharge-succ |
                add(add(a, b), c) = add(a, add(b, c)) -> add(add(a, b), succ(c)) = add(a, add(b, succ(c)))
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-succ |
            forall c: Int; add(add(a, b), c) = add(a, add(b, c)) -> add(add(a, b), succ(c)) = add(a, add(b, succ(c)))
            [by forall_intro generalize-succ]
          @generalize-prev |
            fix c: Int {
              @given-inductive-hypothesis |
                assume add(add(a, b), c) = add(a, add(b, c)) {
                  @inductive-hypothesis |
                    add(add(a, b), c) = add(a, add(b, c))
                    [by hypothesis given-inductive-hypothesis]
                  @lhs-unfold |
                    add(add(a, b), prev(c)) = prev(add(add(a, b), c))
                    [by forall_elim(add(a, b), c) add-prev]
                  @lhs-with-ih |
                    add(add(a, b), prev(c)) = prev(add(a, add(b, c)))
                    [by rewrite inductive-hypothesis lhs-unfold]
                  @inner-unfold |
                    add(b, prev(c)) = prev(add(b, c))
                    [by forall_elim(b, c) add-prev]
                  @rhs-refl |
                    add(a, add(b, prev(c))) = add(a, add(b, prev(c)))
                    [by reflexivity]
                  @rhs-inner |
                    add(a, add(b, prev(c))) = add(a, prev(add(b, c)))
                    [by rewrite inner-unfold rhs-refl]
                  @outer-unfold |
                    add(a, prev(add(b, c))) = prev(add(a, add(b, c)))
                    [by forall_elim(a, add(b, c)) add-prev]
                  @rhs-is |
                    add(a, add(b, prev(c))) = prev(add(a, add(b, c)))
                    [by rewrite outer-unfold rhs-inner]
                  @rhs-is-flipped |
                    prev(add(a, add(b, c))) = add(a, add(b, prev(c)))
                    [by symmetry rhs-is]
                  @prev-case |
                    add(add(a, b), prev(c)) = add(a, add(b, prev(c)))
                    [by rewrite rhs-is-flipped lhs-with-ih]
                }
              @discharge-prev |
                add(add(a, b), c) = add(a, add(b, c)) -> add(add(a, b), prev(c)) = add(a, add(b, prev(c)))
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-prev |
            forall c: Int; add(add(a, b), c) = add(a, add(b, c)) -> add(add(a, b), prev(c)) = add(a, add(b, prev(c)))
            [by forall_intro generalize-prev]
          @conclusion-for-b |
            forall c: Int; add(add(a, b), c) = add(a, add(b, c))
            [by instantiate induction((fun m: Int => add(add(a, b), m) = add(a, add(b, m)))) base induction-step-succ induction-step-prev]
        }
      @conclusion-for-a |
        forall b, c: Int; add(add(a, b), c) = add(a, add(b, c))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: Int; add(add(a, b), c) = add(a, add(b, c))
    [by forall_intro generalize-a]
qed

// add(n, neg(n)) = ZERO — the additive inverse law, the defining property that
// makes ℤ a ring (not just a monoid). By bidirectional induction on n: each
// step opens neg on one side and cancels a succ against a prev to fall back on
// the inductive hypothesis.
theorem addNegRight: forall n: Int; add(n, neg(n)) = ZERO
proof
  @neg-zero |
    neg(ZERO) = ZERO
    [by axiom negZero]
  @add-zero |
    forall x: Int; add(x, ZERO) = x
    [by axiom addZeroRight]
  @add-at-zero |
    add(ZERO, ZERO) = ZERO
    [by forall_elim(ZERO) add-zero]
  @base-refl |
    add(ZERO, neg(ZERO)) = add(ZERO, neg(ZERO))
    [by reflexivity]
  @open-inner-neg |
    add(ZERO, ZERO) = add(ZERO, neg(ZERO))
    [by rewrite neg-zero base-refl]
  @collapse-inner |
    ZERO = add(ZERO, neg(ZERO))
    [by rewrite add-at-zero open-inner-neg]
  @base |
    add(ZERO, neg(ZERO)) = ZERO
    [by symmetry collapse-inner]
  @add-succ-right |
    forall x, y: Int; add(x, succ(y)) = succ(add(x, y))
    [by axiom addSuccRight]
  @add-prev-right |
    forall x, y: Int; add(x, prev(y)) = prev(add(x, y))
    [by axiom addPrevRight]
  @add-succ-left |
    forall x, y: Int; add(succ(x), y) = succ(add(x, y))
    [by theorem addSuccLeft]
  @add-prev-left |
    forall x, y: Int; add(prev(x), y) = prev(add(x, y))
    [by theorem addPrevLeft]
  @neg-succ |
    forall n: Int; neg(succ(n)) = prev(neg(n))
    [by axiom negSucc]
  @neg-prev |
    forall n: Int; neg(prev(n)) = succ(neg(n))
    [by axiom negPrev]
  @prev-succ |
    forall n: Int; prev(succ(n)) = n
    [by axiom prevSucc]
  @succ-prev |
    forall n: Int; succ(prev(n)) = n
    [by axiom succPrev]
  @generalize-succ |
    fix k: Int {
      @given-inductive-hypothesis |
        assume add(k, neg(k)) = ZERO {
          @inductive-hypothesis |
            add(k, neg(k)) = ZERO
            [by hypothesis given-inductive-hypothesis]
          @open-neg |
            neg(succ(k)) = prev(neg(k))
            [by forall_elim(k) neg-succ]
          @lhs-refl |
            add(succ(k), neg(succ(k))) = add(succ(k), neg(succ(k)))
            [by reflexivity]
          @lhs-with-neg |
            add(succ(k), neg(succ(k))) = add(succ(k), prev(neg(k)))
            [by rewrite open-neg lhs-refl]
          @pull-prev-out |
            add(succ(k), prev(neg(k))) = prev(add(succ(k), neg(k)))
            [by forall_elim(succ(k), neg(k)) add-prev-right]
          @lhs-prev-out |
            add(succ(k), neg(succ(k))) = prev(add(succ(k), neg(k)))
            [by rewrite pull-prev-out lhs-with-neg]
          @pull-succ-out |
            add(succ(k), neg(k)) = succ(add(k, neg(k)))
            [by forall_elim(k, neg(k)) add-succ-left]
          @prev-of-succ-refl |
            prev(add(succ(k), neg(k))) = prev(add(succ(k), neg(k)))
            [by reflexivity]
          @prev-of-succ |
            prev(add(succ(k), neg(k))) = prev(succ(add(k, neg(k))))
            [by rewrite pull-succ-out prev-of-succ-refl]
          @lhs-collapsible |
            add(succ(k), neg(succ(k))) = prev(succ(add(k, neg(k))))
            [by rewrite prev-of-succ lhs-prev-out]
          @cancel-prev-succ |
            prev(succ(add(k, neg(k)))) = add(k, neg(k))
            [by forall_elim(add(k, neg(k))) prev-succ]
          @lhs-cancelled |
            add(succ(k), neg(succ(k))) = add(k, neg(k))
            [by rewrite cancel-prev-succ lhs-collapsible]
          @succ-case |
            add(succ(k), neg(succ(k))) = ZERO
            [by rewrite inductive-hypothesis lhs-cancelled]
        }
      @discharge-succ |
        add(k, neg(k)) = ZERO -> add(succ(k), neg(succ(k))) = ZERO
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-succ |
    forall k: Int; add(k, neg(k)) = ZERO -> add(succ(k), neg(succ(k))) = ZERO
    [by forall_intro generalize-succ]
  @generalize-prev |
    fix k: Int {
      @given-inductive-hypothesis |
        assume add(k, neg(k)) = ZERO {
          @inductive-hypothesis |
            add(k, neg(k)) = ZERO
            [by hypothesis given-inductive-hypothesis]
          @open-neg |
            neg(prev(k)) = succ(neg(k))
            [by forall_elim(k) neg-prev]
          @lhs-refl |
            add(prev(k), neg(prev(k))) = add(prev(k), neg(prev(k)))
            [by reflexivity]
          @lhs-with-neg |
            add(prev(k), neg(prev(k))) = add(prev(k), succ(neg(k)))
            [by rewrite open-neg lhs-refl]
          @pull-succ-out |
            add(prev(k), succ(neg(k))) = succ(add(prev(k), neg(k)))
            [by forall_elim(prev(k), neg(k)) add-succ-right]
          @lhs-succ-out |
            add(prev(k), neg(prev(k))) = succ(add(prev(k), neg(k)))
            [by rewrite pull-succ-out lhs-with-neg]
          @pull-prev-out |
            add(prev(k), neg(k)) = prev(add(k, neg(k)))
            [by forall_elim(k, neg(k)) add-prev-left]
          @succ-of-prev-refl |
            succ(add(prev(k), neg(k))) = succ(add(prev(k), neg(k)))
            [by reflexivity]
          @succ-of-prev |
            succ(add(prev(k), neg(k))) = succ(prev(add(k, neg(k))))
            [by rewrite pull-prev-out succ-of-prev-refl]
          @lhs-collapsible |
            add(prev(k), neg(prev(k))) = succ(prev(add(k, neg(k))))
            [by rewrite succ-of-prev lhs-succ-out]
          @cancel-succ-prev |
            succ(prev(add(k, neg(k)))) = add(k, neg(k))
            [by forall_elim(add(k, neg(k))) succ-prev]
          @lhs-cancelled |
            add(prev(k), neg(prev(k))) = add(k, neg(k))
            [by rewrite cancel-succ-prev lhs-collapsible]
          @prev-case |
            add(prev(k), neg(prev(k))) = ZERO
            [by rewrite inductive-hypothesis lhs-cancelled]
        }
      @discharge-prev |
        add(k, neg(k)) = ZERO -> add(prev(k), neg(prev(k))) = ZERO
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-prev |
    forall k: Int; add(k, neg(k)) = ZERO -> add(prev(k), neg(prev(k))) = ZERO
    [by forall_intro generalize-prev]
  @conclusion |
    forall n: Int; add(n, neg(n)) = ZERO
    [by instantiate induction((fun m: Int => add(m, neg(m)) = ZERO)) base induction-step-succ induction-step-prev]
qed

// mul(ZERO, n) = ZERO, by bidirectional induction on n: multiplication
// recurses on the right, so this left-zero law needs its own induction (the
// mirror of the mulZeroRight axiom).
theorem mulZeroLeft: forall n: Int; mul(ZERO, n) = ZERO
proof
  @mul-zero-right |
    forall x: Int; mul(x, ZERO) = ZERO
    [by axiom mulZeroRight]
  @add-zero |
    forall x: Int; add(x, ZERO) = x
    [by axiom addZeroRight]
  @neg-zero |
    neg(ZERO) = ZERO
    [by axiom negZero]
  @mul-succ-right |
    forall x, y: Int; mul(x, succ(y)) = add(mul(x, y), x)
    [by axiom mulSuccRight]
  @mul-prev-right |
    forall x, y: Int; mul(x, prev(y)) = add(mul(x, y), neg(x))
    [by axiom mulPrevRight]
  @base |
    mul(ZERO, ZERO) = ZERO
    [by forall_elim(ZERO) mul-zero-right]
  @generalize-succ |
    fix k: Int {
      @given-inductive-hypothesis |
        assume mul(ZERO, k) = ZERO {
          @inductive-hypothesis |
            mul(ZERO, k) = ZERO
            [by hypothesis given-inductive-hypothesis]
          @unfold |
            mul(ZERO, succ(k)) = add(mul(ZERO, k), ZERO)
            [by forall_elim(ZERO, k) mul-succ-right]
          @with-ih |
            mul(ZERO, succ(k)) = add(ZERO, ZERO)
            [by rewrite inductive-hypothesis unfold]
          @collapse-add |
            add(ZERO, ZERO) = ZERO
            [by forall_elim(ZERO) add-zero]
          @succ-case |
            mul(ZERO, succ(k)) = ZERO
            [by rewrite collapse-add with-ih]
        }
      @discharge-succ |
        mul(ZERO, k) = ZERO -> mul(ZERO, succ(k)) = ZERO
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-succ |
    forall k: Int; mul(ZERO, k) = ZERO -> mul(ZERO, succ(k)) = ZERO
    [by forall_intro generalize-succ]
  @generalize-prev |
    fix k: Int {
      @given-inductive-hypothesis |
        assume mul(ZERO, k) = ZERO {
          @inductive-hypothesis |
            mul(ZERO, k) = ZERO
            [by hypothesis given-inductive-hypothesis]
          @unfold |
            mul(ZERO, prev(k)) = add(mul(ZERO, k), neg(ZERO))
            [by forall_elim(ZERO, k) mul-prev-right]
          @with-ih |
            mul(ZERO, prev(k)) = add(ZERO, neg(ZERO))
            [by rewrite inductive-hypothesis unfold]
          @with-neg-zero |
            mul(ZERO, prev(k)) = add(ZERO, ZERO)
            [by rewrite neg-zero with-ih]
          @collapse-add |
            add(ZERO, ZERO) = ZERO
            [by forall_elim(ZERO) add-zero]
          @prev-case |
            mul(ZERO, prev(k)) = ZERO
            [by rewrite collapse-add with-neg-zero]
        }
      @discharge-prev |
        mul(ZERO, k) = ZERO -> mul(ZERO, prev(k)) = ZERO
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-prev |
    forall k: Int; mul(ZERO, k) = ZERO -> mul(ZERO, prev(k)) = ZERO
    [by forall_intro generalize-prev]
  @conclusion |
    forall n: Int; mul(ZERO, n) = ZERO
    [by instantiate induction((fun m: Int => mul(ZERO, m) = ZERO)) base induction-step-succ induction-step-prev]
qed

// mul(n, ONE) = n — the right-identity law. No induction: unfold ONE to
// succ(ZERO), apply the mulSuccRight recursion once, and clean up with the two
// zero laws.
theorem mulOneRight: forall n: Int; mul(n, ONE) = n
proof
  @generalize-n |
    fix n: Int {
      @one-is-succ-zero |
        ONE = succ(ZERO)
        [by axiom oneIsSuccZero]
      @lhs-refl |
        mul(n, ONE) = mul(n, ONE)
        [by reflexivity]
      @unfold-one |
        mul(n, ONE) = mul(n, succ(ZERO))
        [by rewrite one-is-succ-zero lhs-refl]
      @mul-succ-right |
        forall x, y: Int; mul(x, succ(y)) = add(mul(x, y), x)
        [by axiom mulSuccRight]
      @apply-mul-succ |
        mul(n, succ(ZERO)) = add(mul(n, ZERO), n)
        [by forall_elim(n, ZERO) mul-succ-right]
      @with-recursion |
        mul(n, ONE) = add(mul(n, ZERO), n)
        [by rewrite apply-mul-succ unfold-one]
      @mul-zero-right |
        forall x: Int; mul(x, ZERO) = ZERO
        [by axiom mulZeroRight]
      @inner-is-zero |
        mul(n, ZERO) = ZERO
        [by forall_elim(n) mul-zero-right]
      @with-inner-zero |
        mul(n, ONE) = add(ZERO, n)
        [by rewrite inner-is-zero with-recursion]
      @add-zero-left |
        forall m: Int; add(ZERO, m) = m
        [by theorem addZeroLeft]
      @collapse-add |
        add(ZERO, n) = n
        [by forall_elim(n) add-zero-left]
      @conclusion-for-n |
        mul(n, ONE) = n
        [by rewrite collapse-add with-inner-zero]
    }
  @conclusion |
    forall n: Int; mul(n, ONE) = n
    [by forall_intro generalize-n]
qed

// mul(succ(a), b) = add(mul(a, b), b) — the left-successor recursion of
// multiplication (mirror of mulSuccRight), by bidirectional induction on b. The
// inductive steps reassociate/commute the two extra summands into agreement,
// so they lean on addIsAssociative and addIsCommutative.
theorem mulSuccLeft: forall a, b: Int; mul(succ(a), b) = add(mul(a, b), b)
proof
  @generalize-a |
    fix a: Int {
      @mul-zero-right |
        forall x: Int; mul(x, ZERO) = ZERO
        [by axiom mulZeroRight]
      @add-zero |
        forall x: Int; add(x, ZERO) = x
        [by axiom addZeroRight]
      @mul-succ-right |
        forall x, y: Int; mul(x, succ(y)) = add(mul(x, y), x)
        [by axiom mulSuccRight]
      @mul-prev-right |
        forall x, y: Int; mul(x, prev(y)) = add(mul(x, y), neg(x))
        [by axiom mulPrevRight]
      @add-succ-right |
        forall x, y: Int; add(x, succ(y)) = succ(add(x, y))
        [by axiom addSuccRight]
      @add-prev-right |
        forall x, y: Int; add(x, prev(y)) = prev(add(x, y))
        [by axiom addPrevRight]
      @add-associative |
        forall x, y, z: Int; add(add(x, y), z) = add(x, add(y, z))
        [by theorem addIsAssociative]
      @add-commutative |
        forall x, y: Int; add(x, y) = add(y, x)
        [by theorem addIsCommutative]
      @neg-succ |
        forall n: Int; neg(succ(n)) = prev(neg(n))
        [by axiom negSucc]
      // base case: both sides are ZERO.
      @lhs-at-zero |
        mul(succ(a), ZERO) = ZERO
        [by forall_elim(succ(a)) mul-zero-right]
      @inner-at-zero |
        mul(a, ZERO) = ZERO
        [by forall_elim(a) mul-zero-right]
      @base-rhs-refl |
        add(mul(a, ZERO), ZERO) = add(mul(a, ZERO), ZERO)
        [by reflexivity]
      @rhs-inner-zero |
        add(mul(a, ZERO), ZERO) = add(ZERO, ZERO)
        [by rewrite inner-at-zero base-rhs-refl]
      @add-zero-zero |
        add(ZERO, ZERO) = ZERO
        [by forall_elim(ZERO) add-zero]
      @rhs-at-zero |
        add(mul(a, ZERO), ZERO) = ZERO
        [by rewrite add-zero-zero rhs-inner-zero]
      @rhs-at-zero-flipped |
        ZERO = add(mul(a, ZERO), ZERO)
        [by symmetry rhs-at-zero]
      @base |
        mul(succ(a), ZERO) = add(mul(a, ZERO), ZERO)
        [by rewrite rhs-at-zero-flipped lhs-at-zero]
      // inductive step (successor):
      @generalize-succ |
        fix b: Int {
          @given-inductive-hypothesis |
            assume mul(succ(a), b) = add(mul(a, b), b) {
              @inductive-hypothesis |
                mul(succ(a), b) = add(mul(a, b), b)
                [by hypothesis given-inductive-hypothesis]
              @lhs-unfold |
                mul(succ(a), succ(b)) = add(mul(succ(a), b), succ(a))
                [by forall_elim(succ(a), b) mul-succ-right]
              @lhs-with-ih |
                mul(succ(a), succ(b)) = add(add(mul(a, b), b), succ(a))
                [by rewrite inductive-hypothesis lhs-unfold]
              @lhs-reassociated |
                add(add(mul(a, b), b), succ(a)) = add(mul(a, b), add(b, succ(a)))
                [by forall_elim(mul(a, b), b, succ(a)) add-associative]
              @lhs-assoc |
                mul(succ(a), succ(b)) = add(mul(a, b), add(b, succ(a)))
                [by rewrite lhs-reassociated lhs-with-ih]
              @b-succ-a |
                add(b, succ(a)) = succ(add(b, a))
                [by forall_elim(b, a) add-succ-right]
              @lhs-inner-succ |
                mul(succ(a), succ(b)) = add(mul(a, b), succ(add(b, a)))
                [by rewrite b-succ-a lhs-assoc]
              @b-a-comm |
                add(b, a) = add(a, b)
                [by forall_elim(b, a) add-commutative]
              @lhs-inner-refl |
                add(mul(a, b), succ(add(b, a))) = add(mul(a, b), succ(add(b, a)))
                [by reflexivity]
              @lhs-inner-commuted |
                add(mul(a, b), succ(add(b, a))) = add(mul(a, b), succ(add(a, b)))
                [by rewrite b-a-comm lhs-inner-refl]
              @lhs-normal |
                mul(succ(a), succ(b)) = add(mul(a, b), succ(add(a, b)))
                [by rewrite lhs-inner-commuted lhs-inner-succ]
              @rhs-unfold |
                mul(a, succ(b)) = add(mul(a, b), a)
                [by forall_elim(a, b) mul-succ-right]
              @rhs-refl |
                add(mul(a, succ(b)), succ(b)) = add(mul(a, succ(b)), succ(b))
                [by reflexivity]
              @rhs-with-mul |
                add(mul(a, succ(b)), succ(b)) = add(add(mul(a, b), a), succ(b))
                [by rewrite rhs-unfold rhs-refl]
              @rhs-reassociated |
                add(add(mul(a, b), a), succ(b)) = add(mul(a, b), add(a, succ(b)))
                [by forall_elim(mul(a, b), a, succ(b)) add-associative]
              @rhs-assoc |
                add(mul(a, succ(b)), succ(b)) = add(mul(a, b), add(a, succ(b)))
                [by rewrite rhs-reassociated rhs-with-mul]
              @a-succ-b |
                add(a, succ(b)) = succ(add(a, b))
                [by forall_elim(a, b) add-succ-right]
              @rhs-normal |
                add(mul(a, succ(b)), succ(b)) = add(mul(a, b), succ(add(a, b)))
                [by rewrite a-succ-b rhs-assoc]
              @rhs-normal-flipped |
                add(mul(a, b), succ(add(a, b))) = add(mul(a, succ(b)), succ(b))
                [by symmetry rhs-normal]
              @succ-case |
                mul(succ(a), succ(b)) = add(mul(a, succ(b)), succ(b))
                [by rewrite rhs-normal-flipped lhs-normal]
            }
          @discharge-succ |
            mul(succ(a), b) = add(mul(a, b), b) -> mul(succ(a), succ(b)) = add(mul(a, succ(b)), succ(b))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-succ |
        forall b: Int; mul(succ(a), b) = add(mul(a, b), b) -> mul(succ(a), succ(b)) = add(mul(a, succ(b)), succ(b))
        [by forall_intro generalize-succ]
      // inductive step (predecessor):
      @generalize-prev |
        fix b: Int {
          @given-inductive-hypothesis |
            assume mul(succ(a), b) = add(mul(a, b), b) {
              @inductive-hypothesis |
                mul(succ(a), b) = add(mul(a, b), b)
                [by hypothesis given-inductive-hypothesis]
              @lhs-unfold |
                mul(succ(a), prev(b)) = add(mul(succ(a), b), neg(succ(a)))
                [by forall_elim(succ(a), b) mul-prev-right]
              @lhs-with-ih |
                mul(succ(a), prev(b)) = add(add(mul(a, b), b), neg(succ(a)))
                [by rewrite inductive-hypothesis lhs-unfold]
              @open-neg-succ |
                neg(succ(a)) = prev(neg(a))
                [by forall_elim(a) neg-succ]
              @lhs-neg-opened |
                mul(succ(a), prev(b)) = add(add(mul(a, b), b), prev(neg(a)))
                [by rewrite open-neg-succ lhs-with-ih]
              @lhs-reassociated |
                add(add(mul(a, b), b), prev(neg(a))) = add(mul(a, b), add(b, prev(neg(a))))
                [by forall_elim(mul(a, b), b, prev(neg(a))) add-associative]
              @lhs-assoc |
                mul(succ(a), prev(b)) = add(mul(a, b), add(b, prev(neg(a))))
                [by rewrite lhs-reassociated lhs-neg-opened]
              @b-prev-neg-a |
                add(b, prev(neg(a))) = prev(add(b, neg(a)))
                [by forall_elim(b, neg(a)) add-prev-right]
              @lhs-inner-prev |
                mul(succ(a), prev(b)) = add(mul(a, b), prev(add(b, neg(a))))
                [by rewrite b-prev-neg-a lhs-assoc]
              @b-neg-a-comm |
                add(b, neg(a)) = add(neg(a), b)
                [by forall_elim(b, neg(a)) add-commutative]
              @lhs-inner-refl |
                add(mul(a, b), prev(add(b, neg(a)))) = add(mul(a, b), prev(add(b, neg(a))))
                [by reflexivity]
              @lhs-inner-commuted |
                add(mul(a, b), prev(add(b, neg(a)))) = add(mul(a, b), prev(add(neg(a), b)))
                [by rewrite b-neg-a-comm lhs-inner-refl]
              @lhs-normal |
                mul(succ(a), prev(b)) = add(mul(a, b), prev(add(neg(a), b)))
                [by rewrite lhs-inner-commuted lhs-inner-prev]
              @rhs-unfold |
                mul(a, prev(b)) = add(mul(a, b), neg(a))
                [by forall_elim(a, b) mul-prev-right]
              @rhs-refl |
                add(mul(a, prev(b)), prev(b)) = add(mul(a, prev(b)), prev(b))
                [by reflexivity]
              @rhs-with-mul |
                add(mul(a, prev(b)), prev(b)) = add(add(mul(a, b), neg(a)), prev(b))
                [by rewrite rhs-unfold rhs-refl]
              @rhs-reassociated |
                add(add(mul(a, b), neg(a)), prev(b)) = add(mul(a, b), add(neg(a), prev(b)))
                [by forall_elim(mul(a, b), neg(a), prev(b)) add-associative]
              @rhs-assoc |
                add(mul(a, prev(b)), prev(b)) = add(mul(a, b), add(neg(a), prev(b)))
                [by rewrite rhs-reassociated rhs-with-mul]
              @neg-a-prev-b |
                add(neg(a), prev(b)) = prev(add(neg(a), b))
                [by forall_elim(neg(a), b) add-prev-right]
              @rhs-normal |
                add(mul(a, prev(b)), prev(b)) = add(mul(a, b), prev(add(neg(a), b)))
                [by rewrite neg-a-prev-b rhs-assoc]
              @rhs-normal-flipped |
                add(mul(a, b), prev(add(neg(a), b))) = add(mul(a, prev(b)), prev(b))
                [by symmetry rhs-normal]
              @prev-case |
                mul(succ(a), prev(b)) = add(mul(a, prev(b)), prev(b))
                [by rewrite rhs-normal-flipped lhs-normal]
            }
          @discharge-prev |
            mul(succ(a), b) = add(mul(a, b), b) -> mul(succ(a), prev(b)) = add(mul(a, prev(b)), prev(b))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-prev |
        forall b: Int; mul(succ(a), b) = add(mul(a, b), b) -> mul(succ(a), prev(b)) = add(mul(a, prev(b)), prev(b))
        [by forall_intro generalize-prev]
      @conclusion-for-a |
        forall b: Int; mul(succ(a), b) = add(mul(a, b), b)
        [by instantiate induction((fun m: Int => mul(succ(a), m) = add(mul(a, m), m))) base induction-step-succ induction-step-prev]
    }
  @conclusion |
    forall a, b: Int; mul(succ(a), b) = add(mul(a, b), b)
    [by forall_intro generalize-a]
qed

// mul(a, add(b, c)) = add(mul(a, b), mul(a, c)) — left-distributivity of mul
// over add, by bidirectional induction on c (with a and b fixed). The base uses
// the two zero laws; each step peels the recursion off both sides and
// reassociates the extra summand (a on succ, neg(a) on prev) with add-associative.
theorem mulAddDistribLeft: forall a, b, c: Int; mul(a, add(b, c)) = add(mul(a, b), mul(a, c))
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @add-zero |
            forall x: Int; add(x, ZERO) = x
            [by axiom addZeroRight]
          @add-succ |
            forall x, y: Int; add(x, succ(y)) = succ(add(x, y))
            [by axiom addSuccRight]
          @add-prev |
            forall x, y: Int; add(x, prev(y)) = prev(add(x, y))
            [by axiom addPrevRight]
          @mul-zero-right |
            forall x: Int; mul(x, ZERO) = ZERO
            [by axiom mulZeroRight]
          @mul-succ-right |
            forall x, y: Int; mul(x, succ(y)) = add(mul(x, y), x)
            [by axiom mulSuccRight]
          @mul-prev-right |
            forall x, y: Int; mul(x, prev(y)) = add(mul(x, y), neg(x))
            [by axiom mulPrevRight]
          @add-associative |
            forall x, y, z: Int; add(add(x, y), z) = add(x, add(y, z))
            [by theorem addIsAssociative]
          // base case: c = ZERO — both sides collapse to mul(a, b).
          @collapse-inner-add |
            add(b, ZERO) = b
            [by forall_elim(b) add-zero]
          @lhs-at-zero-refl |
            mul(a, add(b, ZERO)) = mul(a, add(b, ZERO))
            [by reflexivity]
          @lhs-at-zero |
            mul(a, add(b, ZERO)) = mul(a, b)
            [by rewrite collapse-inner-add lhs-at-zero-refl]
          @mul-a-zero |
            mul(a, ZERO) = ZERO
            [by forall_elim(a) mul-zero-right]
          @rhs-at-zero-refl |
            add(mul(a, b), mul(a, ZERO)) = add(mul(a, b), mul(a, ZERO))
            [by reflexivity]
          @rhs-with-mul-zero |
            add(mul(a, b), mul(a, ZERO)) = add(mul(a, b), ZERO)
            [by rewrite mul-a-zero rhs-at-zero-refl]
          @collapse-outer-add |
            add(mul(a, b), ZERO) = mul(a, b)
            [by forall_elim(mul(a, b)) add-zero]
          @rhs-at-zero |
            add(mul(a, b), mul(a, ZERO)) = mul(a, b)
            [by rewrite collapse-outer-add rhs-with-mul-zero]
          @rhs-at-zero-flipped |
            mul(a, b) = add(mul(a, b), mul(a, ZERO))
            [by symmetry rhs-at-zero]
          @base-case |
            mul(a, add(b, ZERO)) = add(mul(a, b), mul(a, ZERO))
            [by rewrite rhs-at-zero-flipped lhs-at-zero]
          // inductive step (successor):
          @induction-step-succ-proof |
            fix c: Int {
              @given-inductive-hypothesis |
                assume mul(a, add(b, c)) = add(mul(a, b), mul(a, c)) {
                  @inductive-hypothesis |
                    mul(a, add(b, c)) = add(mul(a, b), mul(a, c))
                    [by hypothesis given-inductive-hypothesis]
                  @inner-add-succ |
                    add(b, succ(c)) = succ(add(b, c))
                    [by forall_elim(b, c) add-succ]
                  @lhs-refl |
                    mul(a, add(b, succ(c))) = mul(a, add(b, succ(c)))
                    [by reflexivity]
                  @lhs-inner-unfolded |
                    mul(a, add(b, succ(c))) = mul(a, succ(add(b, c)))
                    [by rewrite inner-add-succ lhs-refl]
                  @lhs-mul-unfold |
                    mul(a, succ(add(b, c))) = add(mul(a, add(b, c)), a)
                    [by forall_elim(a, add(b, c)) mul-succ-right]
                  @lhs-mul-unfolded |
                    mul(a, add(b, succ(c))) = add(mul(a, add(b, c)), a)
                    [by rewrite lhs-mul-unfold lhs-inner-unfolded]
                  @lhs-with-ih |
                    mul(a, add(b, succ(c))) = add(add(mul(a, b), mul(a, c)), a)
                    [by rewrite inductive-hypothesis lhs-mul-unfolded]
                  @reassociate |
                    add(add(mul(a, b), mul(a, c)), a) = add(mul(a, b), add(mul(a, c), a))
                    [by forall_elim(mul(a, b), mul(a, c), a) add-associative]
                  @lhs-normal |
                    mul(a, add(b, succ(c))) = add(mul(a, b), add(mul(a, c), a))
                    [by rewrite reassociate lhs-with-ih]
                  @rhs-mul-unfold |
                    mul(a, succ(c)) = add(mul(a, c), a)
                    [by forall_elim(a, c) mul-succ-right]
                  @rhs-refl |
                    add(mul(a, b), mul(a, succ(c))) = add(mul(a, b), mul(a, succ(c)))
                    [by reflexivity]
                  @rhs-normal |
                    add(mul(a, b), mul(a, succ(c))) = add(mul(a, b), add(mul(a, c), a))
                    [by rewrite rhs-mul-unfold rhs-refl]
                  @rhs-normal-flipped |
                    add(mul(a, b), add(mul(a, c), a)) = add(mul(a, b), mul(a, succ(c)))
                    [by symmetry rhs-normal]
                  @succ-case |
                    mul(a, add(b, succ(c))) = add(mul(a, b), mul(a, succ(c)))
                    [by rewrite rhs-normal-flipped lhs-normal]
                }
              @induction-step-at-k |
                mul(a, add(b, c)) = add(mul(a, b), mul(a, c)) -> mul(a, add(b, succ(c))) = add(mul(a, b), mul(a, succ(c)))
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-succ |
            forall c: Int; mul(a, add(b, c)) = add(mul(a, b), mul(a, c)) -> mul(a, add(b, succ(c))) = add(mul(a, b), mul(a, succ(c)))
            [by forall_intro induction-step-succ-proof]
          // inductive step (predecessor): mirror with neg(a) as the extra summand.
          @induction-step-prev-proof |
            fix c: Int {
              @given-inductive-hypothesis |
                assume mul(a, add(b, c)) = add(mul(a, b), mul(a, c)) {
                  @inductive-hypothesis |
                    mul(a, add(b, c)) = add(mul(a, b), mul(a, c))
                    [by hypothesis given-inductive-hypothesis]
                  @inner-add-prev |
                    add(b, prev(c)) = prev(add(b, c))
                    [by forall_elim(b, c) add-prev]
                  @lhs-refl |
                    mul(a, add(b, prev(c))) = mul(a, add(b, prev(c)))
                    [by reflexivity]
                  @lhs-inner-unfolded |
                    mul(a, add(b, prev(c))) = mul(a, prev(add(b, c)))
                    [by rewrite inner-add-prev lhs-refl]
                  @lhs-mul-unfold |
                    mul(a, prev(add(b, c))) = add(mul(a, add(b, c)), neg(a))
                    [by forall_elim(a, add(b, c)) mul-prev-right]
                  @lhs-mul-unfolded |
                    mul(a, add(b, prev(c))) = add(mul(a, add(b, c)), neg(a))
                    [by rewrite lhs-mul-unfold lhs-inner-unfolded]
                  @lhs-with-ih |
                    mul(a, add(b, prev(c))) = add(add(mul(a, b), mul(a, c)), neg(a))
                    [by rewrite inductive-hypothesis lhs-mul-unfolded]
                  @reassociate |
                    add(add(mul(a, b), mul(a, c)), neg(a)) = add(mul(a, b), add(mul(a, c), neg(a)))
                    [by forall_elim(mul(a, b), mul(a, c), neg(a)) add-associative]
                  @lhs-normal |
                    mul(a, add(b, prev(c))) = add(mul(a, b), add(mul(a, c), neg(a)))
                    [by rewrite reassociate lhs-with-ih]
                  @rhs-mul-unfold |
                    mul(a, prev(c)) = add(mul(a, c), neg(a))
                    [by forall_elim(a, c) mul-prev-right]
                  @rhs-refl |
                    add(mul(a, b), mul(a, prev(c))) = add(mul(a, b), mul(a, prev(c)))
                    [by reflexivity]
                  @rhs-normal |
                    add(mul(a, b), mul(a, prev(c))) = add(mul(a, b), add(mul(a, c), neg(a)))
                    [by rewrite rhs-mul-unfold rhs-refl]
                  @rhs-normal-flipped |
                    add(mul(a, b), add(mul(a, c), neg(a))) = add(mul(a, b), mul(a, prev(c)))
                    [by symmetry rhs-normal]
                  @prev-case |
                    mul(a, add(b, prev(c))) = add(mul(a, b), mul(a, prev(c)))
                    [by rewrite rhs-normal-flipped lhs-normal]
                }
              @induction-step-at-k |
                mul(a, add(b, c)) = add(mul(a, b), mul(a, c)) -> mul(a, add(b, prev(c))) = add(mul(a, b), mul(a, prev(c)))
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-prev |
            forall c: Int; mul(a, add(b, c)) = add(mul(a, b), mul(a, c)) -> mul(a, add(b, prev(c))) = add(mul(a, b), mul(a, prev(c)))
            [by forall_intro induction-step-prev-proof]
          @conclusion-for-b |
            forall c: Int; mul(a, add(b, c)) = add(mul(a, b), mul(a, c))
            [by instantiate induction((fun m: Int => mul(a, add(b, m)) = add(mul(a, b), mul(a, m)))) base-case induction-step-succ induction-step-prev]
        }
      @conclusion-for-a |
        forall b, c: Int; mul(a, add(b, c)) = add(mul(a, b), mul(a, c))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: Int; mul(a, add(b, c)) = add(mul(a, b), mul(a, c))
    [by forall_intro generalize-a]
qed

// neg(add(u, v)) = add(neg(u), neg(v)) — negation distributes over addition, by
// bidirectional induction on v. A helper for mulNegRight: each step turns the
// recursion axiom on one side into negSucc/negPrev cancellation on the other.
theorem negAdd: forall u, v: Int; neg(add(u, v)) = add(neg(u), neg(v))
proof
  @generalize-u |
    fix u: Int {
      @add-zero |
        forall x: Int; add(x, ZERO) = x
        [by axiom addZeroRight]
      @add-succ |
        forall x, y: Int; add(x, succ(y)) = succ(add(x, y))
        [by axiom addSuccRight]
      @add-prev |
        forall x, y: Int; add(x, prev(y)) = prev(add(x, y))
        [by axiom addPrevRight]
      @neg-zero |
        neg(ZERO) = ZERO
        [by axiom negZero]
      @neg-succ |
        forall n: Int; neg(succ(n)) = prev(neg(n))
        [by axiom negSucc]
      @neg-prev |
        forall n: Int; neg(prev(n)) = succ(neg(n))
        [by axiom negPrev]
      // base case: v = ZERO — both sides collapse to neg(u).
      @collapse-inner |
        add(u, ZERO) = u
        [by forall_elim(u) add-zero]
      @lhs-at-zero-refl |
        neg(add(u, ZERO)) = neg(add(u, ZERO))
        [by reflexivity]
      @lhs-at-zero |
        neg(add(u, ZERO)) = neg(u)
        [by rewrite collapse-inner lhs-at-zero-refl]
      @rhs-at-zero-refl |
        add(neg(u), neg(ZERO)) = add(neg(u), neg(ZERO))
        [by reflexivity]
      @rhs-with-neg-zero |
        add(neg(u), neg(ZERO)) = add(neg(u), ZERO)
        [by rewrite neg-zero rhs-at-zero-refl]
      @collapse-outer |
        add(neg(u), ZERO) = neg(u)
        [by forall_elim(neg(u)) add-zero]
      @rhs-at-zero |
        add(neg(u), neg(ZERO)) = neg(u)
        [by rewrite collapse-outer rhs-with-neg-zero]
      @rhs-at-zero-flipped |
        neg(u) = add(neg(u), neg(ZERO))
        [by symmetry rhs-at-zero]
      @base-case |
        neg(add(u, ZERO)) = add(neg(u), neg(ZERO))
        [by rewrite rhs-at-zero-flipped lhs-at-zero]
      // inductive step (successor):
      @induction-step-succ-proof |
        fix v: Int {
          @given-inductive-hypothesis |
            assume neg(add(u, v)) = add(neg(u), neg(v)) {
              @inductive-hypothesis |
                neg(add(u, v)) = add(neg(u), neg(v))
                [by hypothesis given-inductive-hypothesis]
              @inner-succ |
                add(u, succ(v)) = succ(add(u, v))
                [by forall_elim(u, v) add-succ]
              @lhs-refl |
                neg(add(u, succ(v))) = neg(add(u, succ(v)))
                [by reflexivity]
              @lhs-inner-unfolded |
                neg(add(u, succ(v))) = neg(succ(add(u, v)))
                [by rewrite inner-succ lhs-refl]
              @open-neg-succ |
                neg(succ(add(u, v))) = prev(neg(add(u, v)))
                [by forall_elim(add(u, v)) neg-succ]
              @lhs-neg-opened |
                neg(add(u, succ(v))) = prev(neg(add(u, v)))
                [by rewrite open-neg-succ lhs-inner-unfolded]
              @lhs-normal |
                neg(add(u, succ(v))) = prev(add(neg(u), neg(v)))
                [by rewrite inductive-hypothesis lhs-neg-opened]
              @rhs-neg-succ |
                neg(succ(v)) = prev(neg(v))
                [by forall_elim(v) neg-succ]
              @rhs-refl |
                add(neg(u), neg(succ(v))) = add(neg(u), neg(succ(v)))
                [by reflexivity]
              @rhs-neg-opened |
                add(neg(u), neg(succ(v))) = add(neg(u), prev(neg(v)))
                [by rewrite rhs-neg-succ rhs-refl]
              @pull-prev-out |
                add(neg(u), prev(neg(v))) = prev(add(neg(u), neg(v)))
                [by forall_elim(neg(u), neg(v)) add-prev]
              @rhs-normal |
                add(neg(u), neg(succ(v))) = prev(add(neg(u), neg(v)))
                [by rewrite pull-prev-out rhs-neg-opened]
              @rhs-normal-flipped |
                prev(add(neg(u), neg(v))) = add(neg(u), neg(succ(v)))
                [by symmetry rhs-normal]
              @succ-case |
                neg(add(u, succ(v))) = add(neg(u), neg(succ(v)))
                [by rewrite rhs-normal-flipped lhs-normal]
            }
          @induction-step-at-k |
            neg(add(u, v)) = add(neg(u), neg(v)) -> neg(add(u, succ(v))) = add(neg(u), neg(succ(v)))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-succ |
        forall v: Int; neg(add(u, v)) = add(neg(u), neg(v)) -> neg(add(u, succ(v))) = add(neg(u), neg(succ(v)))
        [by forall_intro induction-step-succ-proof]
      // inductive step (predecessor):
      @induction-step-prev-proof |
        fix v: Int {
          @given-inductive-hypothesis |
            assume neg(add(u, v)) = add(neg(u), neg(v)) {
              @inductive-hypothesis |
                neg(add(u, v)) = add(neg(u), neg(v))
                [by hypothesis given-inductive-hypothesis]
              @inner-prev |
                add(u, prev(v)) = prev(add(u, v))
                [by forall_elim(u, v) add-prev]
              @lhs-refl |
                neg(add(u, prev(v))) = neg(add(u, prev(v)))
                [by reflexivity]
              @lhs-inner-unfolded |
                neg(add(u, prev(v))) = neg(prev(add(u, v)))
                [by rewrite inner-prev lhs-refl]
              @open-neg-prev |
                neg(prev(add(u, v))) = succ(neg(add(u, v)))
                [by forall_elim(add(u, v)) neg-prev]
              @lhs-neg-opened |
                neg(add(u, prev(v))) = succ(neg(add(u, v)))
                [by rewrite open-neg-prev lhs-inner-unfolded]
              @lhs-normal |
                neg(add(u, prev(v))) = succ(add(neg(u), neg(v)))
                [by rewrite inductive-hypothesis lhs-neg-opened]
              @rhs-neg-prev |
                neg(prev(v)) = succ(neg(v))
                [by forall_elim(v) neg-prev]
              @rhs-refl |
                add(neg(u), neg(prev(v))) = add(neg(u), neg(prev(v)))
                [by reflexivity]
              @rhs-neg-opened |
                add(neg(u), neg(prev(v))) = add(neg(u), succ(neg(v)))
                [by rewrite rhs-neg-prev rhs-refl]
              @pull-succ-out |
                add(neg(u), succ(neg(v))) = succ(add(neg(u), neg(v)))
                [by forall_elim(neg(u), neg(v)) add-succ]
              @rhs-normal |
                add(neg(u), neg(prev(v))) = succ(add(neg(u), neg(v)))
                [by rewrite pull-succ-out rhs-neg-opened]
              @rhs-normal-flipped |
                succ(add(neg(u), neg(v))) = add(neg(u), neg(prev(v)))
                [by symmetry rhs-normal]
              @prev-case |
                neg(add(u, prev(v))) = add(neg(u), neg(prev(v)))
                [by rewrite rhs-normal-flipped lhs-normal]
            }
          @induction-step-at-k |
            neg(add(u, v)) = add(neg(u), neg(v)) -> neg(add(u, prev(v))) = add(neg(u), neg(prev(v)))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-prev |
        forall v: Int; neg(add(u, v)) = add(neg(u), neg(v)) -> neg(add(u, prev(v))) = add(neg(u), neg(prev(v)))
        [by forall_intro induction-step-prev-proof]
      @conclusion-for-u |
        forall v: Int; neg(add(u, v)) = add(neg(u), neg(v))
        [by instantiate induction((fun m: Int => neg(add(u, m)) = add(neg(u), neg(m)))) base-case induction-step-succ induction-step-prev]
    }
  @conclusion |
    forall u, v: Int; neg(add(u, v)) = add(neg(u), neg(v))
    [by forall_intro generalize-u]
qed

// neg(neg(n)) = n — negation is an involution, by bidirectional induction on n.
// A helper for mulNegRight's predecessor step. Each step opens the outer neg via
// negSucc/negPrev and the inner one the opposite way, cancelling to the hypothesis.
theorem negNeg: forall n: Int; neg(neg(n)) = n
proof
  @neg-zero |
    neg(ZERO) = ZERO
    [by axiom negZero]
  @neg-succ |
    forall x: Int; neg(succ(x)) = prev(neg(x))
    [by axiom negSucc]
  @neg-prev |
    forall x: Int; neg(prev(x)) = succ(neg(x))
    [by axiom negPrev]
  // base case: neg(neg(ZERO)) = neg(ZERO) = ZERO.
  @base-refl |
    neg(neg(ZERO)) = neg(neg(ZERO))
    [by reflexivity]
  @base-inner |
    neg(neg(ZERO)) = neg(ZERO)
    [by rewrite neg-zero base-refl]
  @base-case |
    neg(neg(ZERO)) = ZERO
    [by rewrite neg-zero base-inner]
  // inductive step (successor):
  @induction-step-succ-proof |
    fix k: Int {
      @given-inductive-hypothesis |
        assume neg(neg(k)) = k {
          @inductive-hypothesis |
            neg(neg(k)) = k
            [by hypothesis given-inductive-hypothesis]
          @open-outer |
            neg(succ(k)) = prev(neg(k))
            [by forall_elim(k) neg-succ]
          @lhs-refl |
            neg(neg(succ(k))) = neg(neg(succ(k)))
            [by reflexivity]
          @lhs-outer-opened |
            neg(neg(succ(k))) = neg(prev(neg(k)))
            [by rewrite open-outer lhs-refl]
          @open-inner |
            neg(prev(neg(k))) = succ(neg(neg(k)))
            [by forall_elim(neg(k)) neg-prev]
          @lhs-inner-opened |
            neg(neg(succ(k))) = succ(neg(neg(k)))
            [by rewrite open-inner lhs-outer-opened]
          @succ-case |
            neg(neg(succ(k))) = succ(k)
            [by rewrite inductive-hypothesis lhs-inner-opened]
        }
      @induction-step-at-k |
        neg(neg(k)) = k -> neg(neg(succ(k))) = succ(k)
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-succ |
    forall k: Int; neg(neg(k)) = k -> neg(neg(succ(k))) = succ(k)
    [by forall_intro induction-step-succ-proof]
  // inductive step (predecessor):
  @induction-step-prev-proof |
    fix k: Int {
      @given-inductive-hypothesis |
        assume neg(neg(k)) = k {
          @inductive-hypothesis |
            neg(neg(k)) = k
            [by hypothesis given-inductive-hypothesis]
          @open-outer |
            neg(prev(k)) = succ(neg(k))
            [by forall_elim(k) neg-prev]
          @lhs-refl |
            neg(neg(prev(k))) = neg(neg(prev(k)))
            [by reflexivity]
          @lhs-outer-opened |
            neg(neg(prev(k))) = neg(succ(neg(k)))
            [by rewrite open-outer lhs-refl]
          @open-inner |
            neg(succ(neg(k))) = prev(neg(neg(k)))
            [by forall_elim(neg(k)) neg-succ]
          @lhs-inner-opened |
            neg(neg(prev(k))) = prev(neg(neg(k)))
            [by rewrite open-inner lhs-outer-opened]
          @prev-case |
            neg(neg(prev(k))) = prev(k)
            [by rewrite inductive-hypothesis lhs-inner-opened]
        }
      @induction-step-at-k |
        neg(neg(k)) = k -> neg(neg(prev(k))) = prev(k)
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-prev |
    forall k: Int; neg(neg(k)) = k -> neg(neg(prev(k))) = prev(k)
    [by forall_intro induction-step-prev-proof]
  @conclusion |
    forall n: Int; neg(neg(n)) = n
    [by instantiate induction((fun m: Int => neg(neg(m)) = m)) base-case induction-step-succ induction-step-prev]
qed

// mul(a, neg(b)) = neg(mul(a, b)) — pulling a negation out of the right factor,
// by bidirectional induction on b (with a fixed). Each step opens neg(succ/prev b)
// via negSucc/negPrev, unfolds the mul recursion, applies the IH, and reconciles
// with negAdd (distributing neg over the recursion's extra summand) — the
// predecessor case additionally cancels a double negation via negNeg.
theorem mulNegRight: forall a, b: Int; mul(a, neg(b)) = neg(mul(a, b))
proof
  @generalize-a |
    fix a: Int {
      @mul-zero-right |
        forall x: Int; mul(x, ZERO) = ZERO
        [by axiom mulZeroRight]
      @mul-succ-right |
        forall x, y: Int; mul(x, succ(y)) = add(mul(x, y), x)
        [by axiom mulSuccRight]
      @mul-prev-right |
        forall x, y: Int; mul(x, prev(y)) = add(mul(x, y), neg(x))
        [by axiom mulPrevRight]
      @neg-zero |
        neg(ZERO) = ZERO
        [by axiom negZero]
      @neg-succ |
        forall n: Int; neg(succ(n)) = prev(neg(n))
        [by axiom negSucc]
      @neg-prev |
        forall n: Int; neg(prev(n)) = succ(neg(n))
        [by axiom negPrev]
      @neg-add |
        forall x, y: Int; neg(add(x, y)) = add(neg(x), neg(y))
        [by theorem negAdd]
      @neg-neg |
        forall n: Int; neg(neg(n)) = n
        [by theorem negNeg]
      // base case: b = ZERO — both sides are ZERO.
      @neg-of-zero |
        neg(ZERO) = ZERO
        [by axiom negZero]
      @lhs-at-zero-refl |
        mul(a, neg(ZERO)) = mul(a, neg(ZERO))
        [by reflexivity]
      @lhs-at-zero-neg-opened |
        mul(a, neg(ZERO)) = mul(a, ZERO)
        [by rewrite neg-of-zero lhs-at-zero-refl]
      @mul-a-zero |
        mul(a, ZERO) = ZERO
        [by forall_elim(a) mul-zero-right]
      @lhs-at-zero |
        mul(a, neg(ZERO)) = ZERO
        [by rewrite mul-a-zero lhs-at-zero-neg-opened]
      @rhs-at-zero-refl |
        neg(mul(a, ZERO)) = neg(mul(a, ZERO))
        [by reflexivity]
      @rhs-mul-opened |
        neg(mul(a, ZERO)) = neg(ZERO)
        [by rewrite mul-a-zero rhs-at-zero-refl]
      @rhs-at-zero |
        neg(mul(a, ZERO)) = ZERO
        [by rewrite neg-zero rhs-mul-opened]
      @rhs-at-zero-flipped |
        ZERO = neg(mul(a, ZERO))
        [by symmetry rhs-at-zero]
      @base-case |
        mul(a, neg(ZERO)) = neg(mul(a, ZERO))
        [by rewrite rhs-at-zero-flipped lhs-at-zero]
      // inductive step (successor):
      @induction-step-succ-proof |
        fix b: Int {
          @given-inductive-hypothesis |
            assume mul(a, neg(b)) = neg(mul(a, b)) {
              @inductive-hypothesis |
                mul(a, neg(b)) = neg(mul(a, b))
                [by hypothesis given-inductive-hypothesis]
              @open-neg |
                neg(succ(b)) = prev(neg(b))
                [by forall_elim(b) neg-succ]
              @lhs-refl |
                mul(a, neg(succ(b))) = mul(a, neg(succ(b)))
                [by reflexivity]
              @lhs-neg-opened |
                mul(a, neg(succ(b))) = mul(a, prev(neg(b)))
                [by rewrite open-neg lhs-refl]
              @unfold-mul-prev |
                mul(a, prev(neg(b))) = add(mul(a, neg(b)), neg(a))
                [by forall_elim(a, neg(b)) mul-prev-right]
              @lhs-mul-unfolded |
                mul(a, neg(succ(b))) = add(mul(a, neg(b)), neg(a))
                [by rewrite unfold-mul-prev lhs-neg-opened]
              @lhs-normal |
                mul(a, neg(succ(b))) = add(neg(mul(a, b)), neg(a))
                [by rewrite inductive-hypothesis lhs-mul-unfolded]
              @unfold-mul-succ |
                mul(a, succ(b)) = add(mul(a, b), a)
                [by forall_elim(a, b) mul-succ-right]
              @rhs-refl |
                neg(mul(a, succ(b))) = neg(mul(a, succ(b)))
                [by reflexivity]
              @rhs-mul-unfolded |
                neg(mul(a, succ(b))) = neg(add(mul(a, b), a))
                [by rewrite unfold-mul-succ rhs-refl]
              @distribute-neg |
                neg(add(mul(a, b), a)) = add(neg(mul(a, b)), neg(a))
                [by forall_elim(mul(a, b), a) neg-add]
              @rhs-normal |
                neg(mul(a, succ(b))) = add(neg(mul(a, b)), neg(a))
                [by rewrite distribute-neg rhs-mul-unfolded]
              @rhs-normal-flipped |
                add(neg(mul(a, b)), neg(a)) = neg(mul(a, succ(b)))
                [by symmetry rhs-normal]
              @succ-case |
                mul(a, neg(succ(b))) = neg(mul(a, succ(b)))
                [by rewrite rhs-normal-flipped lhs-normal]
            }
          @induction-step-at-k |
            mul(a, neg(b)) = neg(mul(a, b)) -> mul(a, neg(succ(b))) = neg(mul(a, succ(b)))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-succ |
        forall b: Int; mul(a, neg(b)) = neg(mul(a, b)) -> mul(a, neg(succ(b))) = neg(mul(a, succ(b)))
        [by forall_intro induction-step-succ-proof]
      // inductive step (predecessor):
      @induction-step-prev-proof |
        fix b: Int {
          @given-inductive-hypothesis |
            assume mul(a, neg(b)) = neg(mul(a, b)) {
              @inductive-hypothesis |
                mul(a, neg(b)) = neg(mul(a, b))
                [by hypothesis given-inductive-hypothesis]
              @open-neg |
                neg(prev(b)) = succ(neg(b))
                [by forall_elim(b) neg-prev]
              @lhs-refl |
                mul(a, neg(prev(b))) = mul(a, neg(prev(b)))
                [by reflexivity]
              @lhs-neg-opened |
                mul(a, neg(prev(b))) = mul(a, succ(neg(b)))
                [by rewrite open-neg lhs-refl]
              @unfold-mul-succ |
                mul(a, succ(neg(b))) = add(mul(a, neg(b)), a)
                [by forall_elim(a, neg(b)) mul-succ-right]
              @lhs-mul-unfolded |
                mul(a, neg(prev(b))) = add(mul(a, neg(b)), a)
                [by rewrite unfold-mul-succ lhs-neg-opened]
              @lhs-normal |
                mul(a, neg(prev(b))) = add(neg(mul(a, b)), a)
                [by rewrite inductive-hypothesis lhs-mul-unfolded]
              @unfold-mul-prev |
                mul(a, prev(b)) = add(mul(a, b), neg(a))
                [by forall_elim(a, b) mul-prev-right]
              @rhs-refl |
                neg(mul(a, prev(b))) = neg(mul(a, prev(b)))
                [by reflexivity]
              @rhs-mul-unfolded |
                neg(mul(a, prev(b))) = neg(add(mul(a, b), neg(a)))
                [by rewrite unfold-mul-prev rhs-refl]
              @distribute-neg |
                neg(add(mul(a, b), neg(a))) = add(neg(mul(a, b)), neg(neg(a)))
                [by forall_elim(mul(a, b), neg(a)) neg-add]
              @rhs-distributed |
                neg(mul(a, prev(b))) = add(neg(mul(a, b)), neg(neg(a)))
                [by rewrite distribute-neg rhs-mul-unfolded]
              @cancel-double-neg |
                neg(neg(a)) = a
                [by forall_elim(a) neg-neg]
              @rhs-normal |
                neg(mul(a, prev(b))) = add(neg(mul(a, b)), a)
                [by rewrite cancel-double-neg rhs-distributed]
              @rhs-normal-flipped |
                add(neg(mul(a, b)), a) = neg(mul(a, prev(b)))
                [by symmetry rhs-normal]
              @prev-case |
                mul(a, neg(prev(b))) = neg(mul(a, prev(b)))
                [by rewrite rhs-normal-flipped lhs-normal]
            }
          @induction-step-at-k |
            mul(a, neg(b)) = neg(mul(a, b)) -> mul(a, neg(prev(b))) = neg(mul(a, prev(b)))
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-prev |
        forall b: Int; mul(a, neg(b)) = neg(mul(a, b)) -> mul(a, neg(prev(b))) = neg(mul(a, prev(b)))
        [by forall_intro induction-step-prev-proof]
      @conclusion-for-a |
        forall b: Int; mul(a, neg(b)) = neg(mul(a, b))
        [by instantiate induction((fun m: Int => mul(a, neg(m)) = neg(mul(a, m)))) base-case induction-step-succ induction-step-prev]
    }
  @conclusion |
    forall a, b: Int; mul(a, neg(b)) = neg(mul(a, b))
    [by forall_intro generalize-a]
qed

// mul(mul(a, b), c) = mul(a, mul(b, c)) — associativity of multiplication, by
// bidirectional induction on c (with a and b fixed). Each step unfolds the mul
// recursion on the left and distributes it over the right via mulAddDistribLeft;
// the predecessor case pulls the resulting negation through with mulNegRight.
theorem mulIsAssociative: forall a, b, c: Int; mul(mul(a, b), c) = mul(a, mul(b, c))
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @mul-zero-right |
            forall x: Int; mul(x, ZERO) = ZERO
            [by axiom mulZeroRight]
          @mul-succ-right |
            forall x, y: Int; mul(x, succ(y)) = add(mul(x, y), x)
            [by axiom mulSuccRight]
          @mul-prev-right |
            forall x, y: Int; mul(x, prev(y)) = add(mul(x, y), neg(x))
            [by axiom mulPrevRight]
          @mul-add-distrib |
            forall x, y, z: Int; mul(x, add(y, z)) = add(mul(x, y), mul(x, z))
            [by theorem mulAddDistribLeft]
          @mul-neg-right |
            forall x, y: Int; mul(x, neg(y)) = neg(mul(x, y))
            [by theorem mulNegRight]
          // base case: c = ZERO — both sides are ZERO.
          @lhs-at-zero |
            mul(mul(a, b), ZERO) = ZERO
            [by forall_elim(mul(a, b)) mul-zero-right]
          @inner-at-zero |
            mul(b, ZERO) = ZERO
            [by forall_elim(b) mul-zero-right]
          @rhs-at-zero-refl |
            mul(a, mul(b, ZERO)) = mul(a, mul(b, ZERO))
            [by reflexivity]
          @rhs-inner-opened |
            mul(a, mul(b, ZERO)) = mul(a, ZERO)
            [by rewrite inner-at-zero rhs-at-zero-refl]
          @mul-a-zero |
            mul(a, ZERO) = ZERO
            [by forall_elim(a) mul-zero-right]
          @rhs-at-zero |
            mul(a, mul(b, ZERO)) = ZERO
            [by rewrite mul-a-zero rhs-inner-opened]
          @rhs-at-zero-flipped |
            ZERO = mul(a, mul(b, ZERO))
            [by symmetry rhs-at-zero]
          @base-case |
            mul(mul(a, b), ZERO) = mul(a, mul(b, ZERO))
            [by rewrite rhs-at-zero-flipped lhs-at-zero]
          // inductive step (successor):
          @induction-step-succ-proof |
            fix c: Int {
              @given-inductive-hypothesis |
                assume mul(mul(a, b), c) = mul(a, mul(b, c)) {
                  @inductive-hypothesis |
                    mul(mul(a, b), c) = mul(a, mul(b, c))
                    [by hypothesis given-inductive-hypothesis]
                  @lhs-unfold |
                    mul(mul(a, b), succ(c)) = add(mul(mul(a, b), c), mul(a, b))
                    [by forall_elim(mul(a, b), c) mul-succ-right]
                  @lhs-normal |
                    mul(mul(a, b), succ(c)) = add(mul(a, mul(b, c)), mul(a, b))
                    [by rewrite inductive-hypothesis lhs-unfold]
                  @inner-unfold |
                    mul(b, succ(c)) = add(mul(b, c), b)
                    [by forall_elim(b, c) mul-succ-right]
                  @rhs-refl |
                    mul(a, mul(b, succ(c))) = mul(a, mul(b, succ(c)))
                    [by reflexivity]
                  @rhs-inner-unfolded |
                    mul(a, mul(b, succ(c))) = mul(a, add(mul(b, c), b))
                    [by rewrite inner-unfold rhs-refl]
                  @distribute |
                    mul(a, add(mul(b, c), b)) = add(mul(a, mul(b, c)), mul(a, b))
                    [by forall_elim(a, mul(b, c), b) mul-add-distrib]
                  @rhs-normal |
                    mul(a, mul(b, succ(c))) = add(mul(a, mul(b, c)), mul(a, b))
                    [by rewrite distribute rhs-inner-unfolded]
                  @rhs-normal-flipped |
                    add(mul(a, mul(b, c)), mul(a, b)) = mul(a, mul(b, succ(c)))
                    [by symmetry rhs-normal]
                  @succ-case |
                    mul(mul(a, b), succ(c)) = mul(a, mul(b, succ(c)))
                    [by rewrite rhs-normal-flipped lhs-normal]
                }
              @induction-step-at-k |
                mul(mul(a, b), c) = mul(a, mul(b, c)) -> mul(mul(a, b), succ(c)) = mul(a, mul(b, succ(c)))
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-succ |
            forall c: Int; mul(mul(a, b), c) = mul(a, mul(b, c)) -> mul(mul(a, b), succ(c)) = mul(a, mul(b, succ(c)))
            [by forall_intro induction-step-succ-proof]
          // inductive step (predecessor):
          @induction-step-prev-proof |
            fix c: Int {
              @given-inductive-hypothesis |
                assume mul(mul(a, b), c) = mul(a, mul(b, c)) {
                  @inductive-hypothesis |
                    mul(mul(a, b), c) = mul(a, mul(b, c))
                    [by hypothesis given-inductive-hypothesis]
                  @lhs-unfold |
                    mul(mul(a, b), prev(c)) = add(mul(mul(a, b), c), neg(mul(a, b)))
                    [by forall_elim(mul(a, b), c) mul-prev-right]
                  @lhs-normal |
                    mul(mul(a, b), prev(c)) = add(mul(a, mul(b, c)), neg(mul(a, b)))
                    [by rewrite inductive-hypothesis lhs-unfold]
                  @inner-unfold |
                    mul(b, prev(c)) = add(mul(b, c), neg(b))
                    [by forall_elim(b, c) mul-prev-right]
                  @rhs-refl |
                    mul(a, mul(b, prev(c))) = mul(a, mul(b, prev(c)))
                    [by reflexivity]
                  @rhs-inner-unfolded |
                    mul(a, mul(b, prev(c))) = mul(a, add(mul(b, c), neg(b)))
                    [by rewrite inner-unfold rhs-refl]
                  @distribute |
                    mul(a, add(mul(b, c), neg(b))) = add(mul(a, mul(b, c)), mul(a, neg(b)))
                    [by forall_elim(a, mul(b, c), neg(b)) mul-add-distrib]
                  @rhs-distributed |
                    mul(a, mul(b, prev(c))) = add(mul(a, mul(b, c)), mul(a, neg(b)))
                    [by rewrite distribute rhs-inner-unfolded]
                  @pull-neg-out |
                    mul(a, neg(b)) = neg(mul(a, b))
                    [by forall_elim(a, b) mul-neg-right]
                  @rhs-normal |
                    mul(a, mul(b, prev(c))) = add(mul(a, mul(b, c)), neg(mul(a, b)))
                    [by rewrite pull-neg-out rhs-distributed]
                  @rhs-normal-flipped |
                    add(mul(a, mul(b, c)), neg(mul(a, b))) = mul(a, mul(b, prev(c)))
                    [by symmetry rhs-normal]
                  @prev-case |
                    mul(mul(a, b), prev(c)) = mul(a, mul(b, prev(c)))
                    [by rewrite rhs-normal-flipped lhs-normal]
                }
              @induction-step-at-k |
                mul(mul(a, b), c) = mul(a, mul(b, c)) -> mul(mul(a, b), prev(c)) = mul(a, mul(b, prev(c)))
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-prev |
            forall c: Int; mul(mul(a, b), c) = mul(a, mul(b, c)) -> mul(mul(a, b), prev(c)) = mul(a, mul(b, prev(c)))
            [by forall_intro induction-step-prev-proof]
          @conclusion-for-b |
            forall c: Int; mul(mul(a, b), c) = mul(a, mul(b, c))
            [by instantiate induction((fun m: Int => mul(mul(a, b), m) = mul(a, mul(b, m)))) base-case induction-step-succ induction-step-prev]
        }
      @conclusion-for-a |
        forall b, c: Int; mul(mul(a, b), c) = mul(a, mul(b, c))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: Int; mul(mul(a, b), c) = mul(a, mul(b, c))
    [by forall_intro generalize-a]
qed
