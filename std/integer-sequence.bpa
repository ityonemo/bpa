// std/integer-sequence.bpa — ℕ-indexed integer sequences and their finite
// products, over std/integer.bpa and the ℤ order/divisibility.
//
// bpa has no lists and a `func` cannot take a `Nat -> Int` parameter, so an
// integer sequence is REIFIED as an opaque sort `Seq` with an accessor `at`.
// The finite product `productUpTo(s, k)` = at(s,0) · at(s,1) · … · at(s,k-1)
// is defined by recursion on the (nonneg) upper bound k:
//   productUpTo(s, 0)      = 1
//   productUpTo(s, succ k) = productUpTo(s, k) · at(s, k)
// The headline reusable fact is `everyEntryDividesProduct`: every entry less_than
// the bound divides the product. This is what the infinitude-of-primes argument
// (aata/2.3-primes.md) needs — a prime dividing the product+1 cannot also
// divide the product.

import integer <<< "std/integer.bpa"
import order <<< "std/integer-order.bpa"
import divides <<< "std/integer-divides.bpa"
import division <<< "std/integer-division.bpa"
import wellordering <<< "std/integer-wellordering.bpa"

sort Int = integer.Int
const ZERO = integer.ZERO
const ONE = integer.ONE
func succ = integer.succ
func add = integer.add
func mul = integer.mul
func sub = order.sub
func neg = integer.neg

pred is_nonneg = order.nonneg
define less_than(a: Int, b: Int) = order.less_than(a, b)
define at_most(a: Int, b: Int) = order.less_or_equal(a, b)
define does_divide(d: Int, n: Int) = divides.divides(d, n)

theorem nonnegNotLessThanZero = wellordering.nonnegNotLessThanZero
theorem lessThanSuccSplit = wellordering.lessThanSuccSplit
theorem mulIsCommutative = order.mulIsCommutative
theorem mulIsAssociative = divides.mulIsAssociative
theorem mulOneRight = divides.mulOneRight
theorem mulZeroRight = order.mulZeroRight
theorem mulAddDistribLeft = divides.mulAddDistribLeft
theorem mulNegRight = order.mulNegRight
theorem negNeg = order.negNeg
theorem dividesRefl = divides.dividesRefl
theorem dividesMul = divides.dividesMul
theorem dividesAdd = divides.dividesAdd
axiom subDef = order.subDef
axiom lessThanIntro = order.lessThanIntro
axiom lessThanElim = order.lessThanElim
theorem lessOrEqualIsGapExistential = order.lessOrEqualIsGapExistential
theorem trichotomy = order.trichotomy
theorem signTrichotomy = order.signTrichotomy
theorem nonnegMul = order.nonnegMul
theorem negLessThanZero = order.negLessThanZero
theorem lessThanIrreflexive = order.lessThanIrreflexive
theorem lessThanTransitive = order.lessThanTransitive
theorem lessThanToLessOrEqual = order.lessThanToLessOrEqual
theorem lessOrEqualRefl = order.lessOrEqualRefl
theorem lessOrEqualSplit = order.lessOrEqualSplit
theorem lessOrEqualAntisymmetric = order.lessOrEqualAntisymmetric
theorem addDiffReaches = order.addDiffReaches
theorem addNegRight = order.addNegRight
theorem oneAtMostPositive = division.oneAtMostPositive
theorem atMostGivesNonnegDifference = division.atMostGivesNonnegDifference
axiom addZeroLeft = order.addZeroLeft
axiom oneIsSuccZero = integer.oneIsSuccZero
axiom nonnegZero = order.nonnegZero
axiom nonnegSucc = order.nonnegSucc
theorem nonnegAdd = order.nonnegAdd
axiom nonnegInduction = order.nonnegInduction
theorem nonnegWellOrdering = wellordering.nonnegWellOrdering

// -- the sequence sort and its finite product -------------------------------

sort Seq
func at(s: Seq, i: Int): Int
func productUpTo(s: Seq, k: Int): Int
axiom productUpToZero: forall s: Seq; productUpTo(s, ZERO) = ONE
axiom productUpToSucc: forall s: Seq; forall k: Int; productUpTo(s, succ(k)) = mul(productUpTo(s, k), at(s, k))

// -- reification-existence axioms: constructing sequences -------------------
//
// `Seq` is otherwise observe-only: `at`/`productUpTo` read a sequence but no
// rule produces one. The Fundamental Theorem of Arithmetic must BUILD the
// factorizing sequences (a singleton [p], a concatenation [p] ++ t, a list with
// one entry removed), so we disclose — exactly as `functionFromGraph` reifies a
// function from its graph — that a `Seq` with each stated graph/product EXISTS.
// Each axiom asserts the existence of a sequence whose relevant entries and
// finite product are pinned to the described values; nothing about entries
// outside the stated range is claimed. These are obviously-true facts about the
// intended model (finite integer sequences), taken as axioms because the sort
// carries no first-class sequence-builder.

// The singleton sequence [x]: its first entry is x and its length-one product
// is x.
axiom seqSingletonExists: forall x: Int;
  exists s: Seq; at(s, ZERO) = x and productUpTo(s, ONE) = x

// The concatenation s ++ t of the first j entries of s with the first k entries
// of t: the result agrees with s less_than j, agrees with (shifted) t on the next k
// slots, and its length-(j+k) product is the product of the two pieces.
axiom seqConcatExists: forall s: Seq; forall t: Seq; forall j: Int; forall k: Int;
  is_nonneg(j) -> is_nonneg(k) ->
  exists u: Seq;
  (forall i: Int; is_nonneg(i) -> less_than(i, j) -> at(u, i) = at(s, i))
  and (forall i: Int; is_nonneg(i) -> less_than(i, k) -> at(u, add(j, i)) = at(t, i))
  and productUpTo(u, add(j, k)) = mul(productUpTo(s, j), productUpTo(t, k))

// The prepend x :: s: a sequence whose head is x and whose tail (indices shifted
// up by one) is s. Unlike seqConcatExists this is a pure ENTRY-graph builder (no
// product clause): at(result, 0) = x, and at(result, succ i) = at(s, i) for i ≥ 0.
// The cons the FTA-uniqueness index map σ is built from — prepend the matched
// index, recurse on the shorter factorization.
axiom seqPrependExists: forall x: Int; forall s: Seq;
  exists u: Seq;
  at(u, ZERO) = x
  and (forall i: Int; is_nonneg(i) -> at(u, succ(i)) = at(s, i))

// The sequence g reindexed past a threshold m: every entry below m is copied,
// every entry ≥ m is bumped up by one (succ). This is the index-inverse of
// seqRemoveExists's deletion — "un-removing" the index m in an index map — and is
// what the FTA-uniqueness permutation σ threads its recursive witness through:
// after removing entry m from t, the sub-map's target indices (into the shortened
// t2) must be lifted back to indices into the original t, which is exactly this
// shift. Obviously true of finite integer sequences; no product constraint.
axiom seqShiftPastExists: forall g: Seq; forall k: Int; forall m: Int;
  is_nonneg(k) -> is_nonneg(m) ->
  exists r: Seq;
  (forall i: Int; is_nonneg(i) -> less_than(i, k) -> less_than(at(g, i), m) -> at(r, i) = at(g, i))
  and (forall i: Int; is_nonneg(i) -> less_than(i, k) -> at_most(m, at(g, i)) -> at(r, i) = succ(at(g, i)))

// The sequence s with the entry at index m (0 ≤ m ≤ k) deleted: its length-k
// product times the removed entry recovers s's length-(k+1) product, and its
// entries are those of s with index m skipped (unchanged less_than m, shifted up by
// one at and above m). The entry-agreement clauses let a primality hypothesis on
// s's first k+1 entries transfer to t's first k entries.
axiom seqRemoveExists: forall s: Seq; forall k: Int; forall m: Int;
  is_nonneg(k) -> is_nonneg(m) -> less_than(m, succ(k)) ->
  exists t: Seq;
  mul(productUpTo(t, k), at(s, m)) = productUpTo(s, succ(k))
  and (forall i: Int; is_nonneg(i) -> less_than(i, m) -> at(t, i) = at(s, i))
  and (forall i: Int; is_nonneg(i) -> at_most(m, i) -> less_than(i, k) -> at(t, i) = at(s, succ(i)))

// -- the entry a bound leaves out still divides the successor product -------

// at(s,k) divides productUpTo(s, succ k) = productUpTo(s, k) · at(s, k): the
// factor being the SECOND multiplicand, commute the product to expose it, then
// dividesRefl + dividesMul package at(s,k) | at(s,k) · productUpTo(s,k).
theorem lastEntryDividesProduct: forall s: Seq; forall k: Int; does_divide(at(s, k), productUpTo(s, succ(k)))
proof
  @generalize-s |
    fix s: Seq {
      @generalize-k |
        fix k: Int {
          @entry-k-divides-itself |
            does_divide(at(s, k), at(s, k))
            [by specialize dividesRefl(at(s, k))]
          @divides-entry-times-product |
            does_divide(at(s, k), mul(at(s, k), productUpTo(s, k)))
            [by specialize dividesMul(at(s, k), at(s, k), productUpTo(s, k)) entry-k-divides-itself]
          @entry-times-product-swaps |
            mul(at(s, k), productUpTo(s, k)) = mul(productUpTo(s, k), at(s, k))
            [by specialize mulIsCommutative(at(s, k), productUpTo(s, k))]
          @divides-product-times-entry |
            does_divide(at(s, k), mul(productUpTo(s, k), at(s, k)))
            [by rewrite entry-times-product-swaps divides-entry-times-product]
          @product-up-to-succ-k |
            productUpTo(s, succ(k)) = mul(productUpTo(s, k), at(s, k))
            [by specialize productUpToSucc(s, k)]
          @succ-product-is-product-times-entry |
            mul(productUpTo(s, k), at(s, k)) = productUpTo(s, succ(k))
            [by symmetry product-up-to-succ-k]
          @entry-divides-succ-product |
            does_divide(at(s, k), productUpTo(s, succ(k)))
            [by rewrite succ-product-is-product-times-entry divides-product-times-entry]
        }
      @discharge-k |
        forall k: Int; does_divide(at(s, k), productUpTo(s, succ(k)))
        [by forall_intro generalize-k]
    }
  @conclusion |
    forall s: Seq; forall k: Int; does_divide(at(s, k), productUpTo(s, succ(k)))
    [by forall_intro generalize-s]
qed

// -- every entry less_than the bound divides the product ------------------------

// For nonneg i < k, at(s,i) | productUpTo(s,k). Induction on the bound k:
//   base k=0:  nothing nonneg is less_than 0, so the claim is vacuous.
//   step k→succ k:  a nonneg i < succ k is either < k (inductive hypothesis:
//     at(s,i) | productUpTo(s,k), and productUpTo(s,k) | the succ product by
//     dividesMul) or = k (lastEntryDividesProduct directly).
theorem everyEntryDividesProduct: forall s: Seq; forall k: Int;
  is_nonneg(k) -> (forall i: Int; is_nonneg(i) -> less_than(i, k) -> does_divide(at(s, i), productUpTo(s, k)))
proof
  @generalize-s |
    fix s: Seq {
      // base: forall i; nonneg i -> i < 0 -> at(s,i) | productUpTo(s,0), vacuous.
      @base-case-proof |
        fix i: Int {
          @given-i-nonneg |
            assume is_nonneg(i) {
              @given-i-less_than-zero |
                assume less_than(i, ZERO) {
                  @i-less_than-zero |
                    less_than(i, ZERO)
                    [by hypothesis given-i-less_than-zero]
                  @i-nonneg |
                    is_nonneg(i)
                    [by hypothesis given-i-nonneg]
                  @i-not-less_than-zero |
                    not less_than(i, ZERO)
                    [by specialize nonnegNotLessThanZero(i) i-nonneg]
                  @entry-divides-empty-product |
                    does_divide(at(s, i), productUpTo(s, ZERO))
                    [by absurd i-less_than-zero i-not-less_than-zero]
                }
              @i-less_than-zero-implies-divides |
                less_than(i, ZERO) -> does_divide(at(s, i), productUpTo(s, ZERO))
                [by implies_intro given-i-less_than-zero]
            }
          @i-nonneg-implies-divides |
            is_nonneg(i) -> less_than(i, ZERO) -> does_divide(at(s, i), productUpTo(s, ZERO))
            [by implies_intro given-i-nonneg]
        }
      @base-case |
        forall i: Int; is_nonneg(i) -> less_than(i, ZERO) -> does_divide(at(s, i), productUpTo(s, ZERO))
        [by forall_intro base-case-proof]
      // step: from the claim at k, derive it at succ k.
      @induction-step |
        fix k: Int {
          @given-k-nonneg |
            assume is_nonneg(k) {
              @given-inductive-hypothesis |
                assume forall i: Int; is_nonneg(i) -> less_than(i, k) -> does_divide(at(s, i), productUpTo(s, k)) {
                  @inductive-hypothesis |
                    forall i: Int; is_nonneg(i) -> less_than(i, k) -> does_divide(at(s, i), productUpTo(s, k))
                    [by hypothesis given-inductive-hypothesis]
                  @k-nonneg |
                    is_nonneg(k)
                    [by hypothesis given-k-nonneg]
                  @entries-less_than-succ-k-divide |
                    fix i: Int {
                      @given-i-nonneg |
                        assume is_nonneg(i) {
                          @given-i-less_than-succ-k |
                            assume less_than(i, succ(k)) {
                              @i-nonneg |
                                is_nonneg(i)
                                [by hypothesis given-i-nonneg]
                              @i-less_than-succ-k |
                                less_than(i, succ(k))
                                [by hypothesis given-i-less_than-succ-k]
                              // i < succ k splits into i < k or i = k.
                              @i-less_than-k-or-equals-k |
                                less_than(i, k) or i = k
                                [by specialize lessThanSuccSplit(i, k) i-nonneg k-nonneg i-less_than-succ-k]
                              @product-up-to-succ-k |
                                productUpTo(s, succ(k)) = mul(productUpTo(s, k), at(s, k))
                                [by specialize productUpToSucc(s, k)]
                              @succ-product-is-product-times-entry |
                                mul(productUpTo(s, k), at(s, k)) = productUpTo(s, succ(k))
                                [by symmetry product-up-to-succ-k]
                              // i < k: inductive hypothesis, then dividesMul.
                              @when-i-less_than-k |
                                assume less_than(i, k) {
                                  @i-less_than-k |
                                    less_than(i, k)
                                    [by hypothesis when-i-less_than-k]
                                  @entry-divides-product |
                                    is_nonneg(i) -> less_than(i, k) -> does_divide(at(s, i), productUpTo(s, k))
                                    [by forall_elim(i) inductive-hypothesis]
                                  @entry-i-divides-product |
                                    does_divide(at(s, i), productUpTo(s, k))
                                    [by tautology entry-divides-product i-nonneg i-less_than-k]
                                  @entry-divides-succ-product-when-less_than |
                                    does_divide(at(s, i), mul(productUpTo(s, k), at(s, k)))
                                    [by specialize dividesMul(at(s, i), productUpTo(s, k), at(s, k)) entry-i-divides-product]
                                  @entry-divides-succ-product |
                                    does_divide(at(s, i), productUpTo(s, succ(k)))
                                    [by rewrite succ-product-is-product-times-entry entry-divides-succ-product-when-less_than]
                                }
                              // i = k: the last entry divides the succ product.
                              @when-i-equals-k |
                                assume i = k {
                                  @i-equals-k |
                                    i = k
                                    [by hypothesis when-i-equals-k]
                                  @k-equals-i |
                                    k = i
                                    [by symmetry i-equals-k]
                                  @entry-k-divides-succ-product |
                                    does_divide(at(s, k), productUpTo(s, succ(k)))
                                    [by specialize lastEntryDividesProduct(s, k)]
                                  @entry-divides-succ-product |
                                    does_divide(at(s, i), productUpTo(s, succ(k)))
                                    [by rewrite k-equals-i entry-k-divides-succ-product]
                                }
                              @entry-divides-succ-product |
                                does_divide(at(s, i), productUpTo(s, succ(k)))
                                [by or_elim i-less_than-k-or-equals-k when-i-less_than-k when-i-equals-k]
                            }
                          @i-less_than-succ-k-gives-divides |
                            less_than(i, succ(k)) -> does_divide(at(s, i), productUpTo(s, succ(k)))
                            [by implies_intro given-i-less_than-succ-k]
                        }
                      @i-nonneg-gives-divides |
                        is_nonneg(i) -> less_than(i, succ(k)) -> does_divide(at(s, i), productUpTo(s, succ(k)))
                        [by implies_intro given-i-nonneg]
                    }
                  @entries-less_than-succ-k-divide-for-all |
                    forall i: Int; is_nonneg(i) -> less_than(i, succ(k)) -> does_divide(at(s, i), productUpTo(s, succ(k)))
                    [by forall_intro entries-less_than-succ-k-divide]
                }
              @hypothesis-at-k-gives-claim-at-succ-k |
                (forall i: Int; is_nonneg(i) -> less_than(i, k) -> does_divide(at(s, i), productUpTo(s, k)))
                  -> (forall i: Int; is_nonneg(i) -> less_than(i, succ(k)) -> does_divide(at(s, i), productUpTo(s, succ(k))))
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-at-k |
            is_nonneg(k)
              -> (forall i: Int; is_nonneg(i) -> less_than(i, k) -> does_divide(at(s, i), productUpTo(s, k)))
              -> (forall i: Int; is_nonneg(i) -> less_than(i, succ(k)) -> does_divide(at(s, i), productUpTo(s, succ(k))))
            [by implies_intro given-k-nonneg]
        }
      @induction-step-for-all-k |
        forall k: Int; is_nonneg(k)
          -> (forall i: Int; is_nonneg(i) -> less_than(i, k) -> does_divide(at(s, i), productUpTo(s, k)))
          -> (forall i: Int; is_nonneg(i) -> less_than(i, succ(k)) -> does_divide(at(s, i), productUpTo(s, succ(k))))
        [by forall_intro induction-step]
      @every-entry-less_than-bound-divides |
        forall k: Int; is_nonneg(k) -> (forall i: Int; is_nonneg(i) -> less_than(i, k) -> does_divide(at(s, i), productUpTo(s, k)))
        [by instantiate nonnegInduction((fun k: Int => forall i: Int; is_nonneg(i) -> less_than(i, k) -> does_divide(at(s, i), productUpTo(s, k)))) base-case induction-step-for-all-k]
    }
  @conclusion |
    forall s: Seq; forall k: Int;
      is_nonneg(k) -> (forall i: Int; is_nonneg(i) -> less_than(i, k) -> does_divide(at(s, i), productUpTo(s, k)))
    [by forall_intro generalize-s]
qed

// -- membership: x occurs among the first k entries -------------------------

// inSeqBefore(x, s, k) holds when some nonneg index i less_than the bound k has
// at(s, i) = x. We give it an intro/elim pair over the defining existential so
// the infinitude-of-primes argument can produce a witness index (elim) and, in
// its completeness hypothesis, assert membership from one (intro).
// Transparent: inSeqBefore(x, s, k) IS the witness-index existential, produced
// with exists_intro (of the and_intro of nonneg/less_than/at) and consumed with unpack.
define inSeqBefore(x: Int, s: Seq, k: Int) = exists i: Int; is_nonneg(i) and less_than(i, k) and at(s, i) = x

// -- a member of the first k entries divides their product ------------------

// If x occurs among the first k entries, x divides productUpTo(s, k): unpack
// the witness index i (nonneg, less_than k, at(s,i) = x); everyEntryDividesProduct
// says at(s,i) | productUpTo(s,k), and at(s,i) = x rewrites it to x.
theorem memberDividesProduct: forall s: Seq; forall k: Int; forall x: Int;
  inSeqBefore(x, s, k) -> does_divide(x, productUpTo(s, k))
proof
  @generalize-s |
    fix s: Seq {
      @generalize-k |
        fix k: Int {
          @generalize-x |
            fix x: Int {
              @given-x-in-sequence |
                assume inSeqBefore(x, s, k) {
                  @x-in-sequence |
                    inSeqBefore(x, s, k)
                    [by hypothesis given-x-in-sequence]
                  @with-witness-index |
                    unpack i: Int from x-in-sequence {
                      @index-nonneg-less_than-and-hits-x |
                        is_nonneg(i) and less_than(i, k) and at(s, i) = x
                        [by hypothesis with-witness-index]
                      @index-nonneg |
                        is_nonneg(i)
                        [by tautology index-nonneg-less_than-and-hits-x]
                      @index-less_than-k |
                        less_than(i, k)
                        [by tautology index-nonneg-less_than-and-hits-x]
                      @entry-at-index-is-x |
                        at(s, i) = x
                        [by tautology index-nonneg-less_than-and-hits-x]
                      // this needs the bound k to be nonneg: i < k with i nonneg
                      // forces k nonneg (else i < k < 0 impossible for nonneg i).
                      // k is nonneg: a nonneg index less_than k means k exceeds a
                      // nonneg, so k is positive hence nonneg. We get it from the
                      // gap i < k directly: less_than(i, k) with is_nonneg(i).
                      @gap-to-k-exists |
                        exists d: Int; is_nonneg(d) and add(i, succ(d)) = k
                        [by specialize lessThanElim(i, k) index-less_than-k]
                      @with-gap-to-k |
                        unpack gap: Int from gap-to-k-exists {
                          @gap-nonneg-and-reaches-k |
                            is_nonneg(gap) and add(i, succ(gap)) = k
                            [by hypothesis with-gap-to-k]
                          @gap-nonneg |
                            is_nonneg(gap)
                            [by tautology gap-nonneg-and-reaches-k]
                          @gap-reaches-k |
                            add(i, succ(gap)) = k
                            [by tautology gap-nonneg-and-reaches-k]
                          @succ-gap-nonneg |
                            is_nonneg(succ(gap))
                            [by specialize nonnegSucc(gap) gap-nonneg]
                          @index-plus-gap-nonneg |
                            is_nonneg(add(i, succ(gap)))
                            [by specialize nonnegAdd(i, succ(gap)) index-nonneg succ-gap-nonneg]
                          @k-nonneg |
                            is_nonneg(k)
                            [by rewrite gap-reaches-k index-plus-gap-nonneg]
                          @entries-less_than-k-divide-unguarded |
                            forall e: Int; is_nonneg(e) -> less_than(e, k) -> does_divide(at(s, e), productUpTo(s, k))
                            [by specialize everyEntryDividesProduct(s, k) k-nonneg]
                          @entry-i-divides-if-less_than |
                            is_nonneg(i) -> less_than(i, k) -> does_divide(at(s, i), productUpTo(s, k))
                            [by forall_elim(i) entries-less_than-k-divide-unguarded]
                          @entry-i-divides-product |
                            does_divide(at(s, i), productUpTo(s, k))
                            [by tautology entry-i-divides-if-less_than index-nonneg index-less_than-k]
                          @x-divides-product |
                            does_divide(x, productUpTo(s, k))
                            [by rewrite entry-at-index-is-x entry-i-divides-product]
                        }
                      @x-divides-product |
                        does_divide(x, productUpTo(s, k))
                        [by exists_elim with-gap-to-k]
                    }
                  @x-divides-product |
                    does_divide(x, productUpTo(s, k))
                    [by exists_elim with-witness-index]
                }
              @in-sequence-implies-divides-product |
                inSeqBefore(x, s, k) -> does_divide(x, productUpTo(s, k))
                [by implies_intro given-x-in-sequence]
            }
          @discharge-x |
            forall x: Int; inSeqBefore(x, s, k) -> does_divide(x, productUpTo(s, k))
            [by forall_intro generalize-x]
        }
      @discharge-k |
        forall k: Int; forall x: Int; inSeqBefore(x, s, k) -> does_divide(x, productUpTo(s, k))
        [by forall_intro generalize-k]
    }
  @conclusion |
    forall s: Seq; forall k: Int; forall x: Int; inSeqBefore(x, s, k) -> does_divide(x, productUpTo(s, k))
    [by forall_intro generalize-s]
qed

// -- divisibility is transitive ---------------------------------------------

// a | b and b | c give a | c: unpack b = mul(a, j) and c = mul(b, k), so
// c = mul(mul(a, j), k) = mul(a, mul(j, k)) (mulIsAssociative), and exists_intro
// on the quotient mul(j, k) reads a | c off that.
theorem dividesTransitive: forall a, b, c: Int; does_divide(a, b) -> does_divide(b, c) -> does_divide(a, c)
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @generalize-c |
            fix c: Int {
              @given-a-divides-b |
                assume does_divide(a, b) {
                  @given-b-divides-c |
                    assume does_divide(b, c) {
                      @a-divides-b |
                        does_divide(a, b)
                        [by hypothesis given-a-divides-b]
                      @b-divides-c |
                        does_divide(b, c)
                        [by hypothesis given-b-divides-c]
                      @with-a-quotient |
                        unpack j: Int from a-divides-b {
                          @b-is-a-times-j |
                            b = mul(a, j)
                            [by hypothesis with-a-quotient]
                          @with-b-quotient |
                            unpack k: Int from b-divides-c {
                              @c-is-b-times-k |
                                c = mul(b, k)
                                [by hypothesis with-b-quotient]
                              @a-j-times-k-regroups |
                                mul(mul(a, j), k) = mul(a, mul(j, k))
                                [by specialize mulIsAssociative(a, j, k)]
                              // c = b·k = (a·j)·k = a·(j·k)
                              @c-is-a-times-jk |
                                c = mul(a, mul(j, k))
                                [by chain c-is-b-times-k b-is-a-times-j a-j-times-k-regroups]
                              @a-divides-c |
                                does_divide(a, c)
                                [by exists_intro(mul(j, k)) c-is-a-times-jk]
                            }
                          @a-divides-c |
                            does_divide(a, c)
                            [by exists_elim with-b-quotient]
                        }
                      @a-divides-c |
                        does_divide(a, c)
                        [by exists_elim with-a-quotient]
                    }
                  @b-divides-c-implies-a-divides-c |
                    does_divide(b, c) -> does_divide(a, c)
                    [by implies_intro given-b-divides-c]
                }
              @a-divides-b-implies-transitive |
                does_divide(a, b) -> does_divide(b, c) -> does_divide(a, c)
                [by implies_intro given-a-divides-b]
            }
          @discharge-c |
            forall c: Int; does_divide(a, b) -> does_divide(b, c) -> does_divide(a, c)
            [by forall_intro generalize-c]
        }
      @discharge-b |
        forall b, c: Int; does_divide(a, b) -> does_divide(b, c) -> does_divide(a, c)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, c: Int; does_divide(a, b) -> does_divide(b, c) -> does_divide(a, c)
    [by forall_intro generalize-a]
qed

// -- divisibility respects subtraction --------------------------------------

// d | a and d | b give d | (a − b): d | (−b) because −b = mul(b, −1) is a
// multiple of b's divisor d (dividesMul with −1), then dividesAdd on a and −b,
// with sub(a, b) = add(a, neg(b)) (subDef).
theorem dividesSubtracts: forall d, a, b: Int; does_divide(d, a) -> does_divide(d, b) -> does_divide(d, sub(a, b))
proof
  @generalize-d |
    fix d: Int {
      @generalize-a |
        fix a: Int {
          @generalize-b |
            fix b: Int {
              @given-d-divides-a |
                assume does_divide(d, a) {
                  @given-d-divides-b |
                    assume does_divide(d, b) {
                      @d-divides-a |
                        does_divide(d, a)
                        [by hypothesis given-d-divides-a]
                      @d-divides-b |
                        does_divide(d, b)
                        [by hypothesis given-d-divides-b]
                      // d | neg(b): neg(b) = mul(b, neg(ONE)) is a multiple of b.
                      @d-divides-b-times-neg-one-fact |
                        does_divide(d, mul(b, neg(ONE)))
                        [by specialize dividesMul(d, b, neg(ONE)) d-divides-b]
                      @b-times-neg-one-is-neg-b |
                        mul(b, neg(ONE)) = neg(b)
                        [by simplify mulNegRight mulOneRight]
                      @d-divides-neg-b |
                        does_divide(d, neg(b))
                        [by rewrite b-times-neg-one-is-neg-b d-divides-b-times-neg-one-fact]
                      // d | add(a, neg(b)) = a − b.
                      @d-divides-a-plus-neg-b |
                        does_divide(d, add(a, neg(b)))
                        [by specialize dividesAdd(d, a, neg(b)) d-divides-a d-divides-neg-b]
                      @a-minus-b-is-a-plus-neg-b |
                        sub(a, b) = add(a, neg(b))
                        [by specialize subDef(a, b)]
                      @a-plus-neg-b-is-a-minus-b |
                        add(a, neg(b)) = sub(a, b)
                        [by symmetry a-minus-b-is-a-plus-neg-b]
                      @d-divides-a-minus-b |
                        does_divide(d, sub(a, b))
                        [by rewrite a-plus-neg-b-is-a-minus-b d-divides-a-plus-neg-b]
                    }
                  @d-divides-b-implies-divides-difference |
                    does_divide(d, b) -> does_divide(d, sub(a, b))
                    [by implies_intro given-d-divides-b]
                }
              @d-divides-a-implies-rest |
                does_divide(d, a) -> does_divide(d, b) -> does_divide(d, sub(a, b))
                [by implies_intro given-d-divides-a]
            }
          @discharge-b |
            forall b: Int; does_divide(d, a) -> does_divide(d, b) -> does_divide(d, sub(a, b))
            [by forall_intro generalize-b]
        }
      @discharge-a |
        forall a, b: Int; does_divide(d, a) -> does_divide(d, b) -> does_divide(d, sub(a, b))
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall d, a, b: Int; does_divide(d, a) -> does_divide(d, b) -> does_divide(d, sub(a, b))
    [by forall_intro generalize-d]
qed

// -- small order facts the prime-factor argument names ----------------------

// 0 < 1: the gap succ(ZERO) = ONE witnesses it (add(ZERO, succ ZERO) = ONE).
theorem zeroLessThanOne: less_than(ZERO, ONE)
proof
  @one-is-succ-zero |
    ONE = succ(ZERO)
    [by axiom oneIsSuccZero]
  @succ-zero-is-one |
    succ(ZERO) = ONE
    [by symmetry one-is-succ-zero]
  @zero-nonneg |
    is_nonneg(ZERO)
    [by axiom nonnegZero]
  @zero-plus-succ-zero-is-succ-zero |
    add(ZERO, succ(ZERO)) = succ(ZERO)
    [by specialize addZeroLeft(succ(ZERO))]
  @zero-plus-succ-zero-is-one |
    add(ZERO, succ(ZERO)) = ONE
    [by rewrite succ-zero-is-one zero-plus-succ-zero-is-succ-zero]
  @conclusion |
    less_than(ZERO, ONE)
    [by specialize lessThanIntro(ZERO, ZERO, ONE) zero-nonneg zero-plus-succ-zero-is-one]
qed

// A positive integer is nonnegative: unfold less_than(ZERO, x) to a gap succ(d) = x
// with d nonneg (add(ZERO, succ d) = x collapses to succ d = x), and the
// successor of a nonneg is nonneg.
theorem positiveIsNonneg: forall x: Int; less_than(ZERO, x) -> is_nonneg(x)
proof
  @generalize-x |
    fix x: Int {
      @given-x-positive |
        assume less_than(ZERO, x) {
          @x-positive |
            less_than(ZERO, x)
            [by hypothesis given-x-positive]
          @gap-exists |
            exists d: Int; is_nonneg(d) and add(ZERO, succ(d)) = x
            [by specialize lessThanElim(ZERO, x) x-positive]
          @with-gap-d |
            unpack d: Int from gap-exists {
              @gap-nonneg-and-reaches-x |
                is_nonneg(d) and add(ZERO, succ(d)) = x
                [by hypothesis with-gap-d]
              @gap-nonneg |
                is_nonneg(d)
                [by tautology gap-nonneg-and-reaches-x]
              @gap-reaches-x |
                add(ZERO, succ(d)) = x
                [by tautology gap-nonneg-and-reaches-x]
              @zero-plus-succ-gap-is-succ-gap |
                add(ZERO, succ(d)) = succ(d)
                [by specialize addZeroLeft(succ(d))]
              @succ-gap-is-x |
                succ(d) = x
                [by rewrite zero-plus-succ-gap-is-succ-gap gap-reaches-x]
              @succ-gap-nonneg |
                is_nonneg(succ(d))
                [by specialize nonnegSucc(d) gap-nonneg]
              @x-nonneg |
                is_nonneg(x)
                [by rewrite succ-gap-is-x succ-gap-nonneg]
            }
          @x-nonneg |
            is_nonneg(x)
            [by exists_elim with-gap-d]
        }
      @positive-implies-nonneg |
        less_than(ZERO, x) -> is_nonneg(x)
        [by implies_intro given-x-positive]
    }
  @conclusion |
    forall x: Int; less_than(ZERO, x) -> is_nonneg(x)
    [by forall_intro generalize-x]
qed

// -- a positive divisor is at most its positive multiple --------------------

// If d | n with d, n positive, then d ≤ n. Write n = d·k. The quotient k is
// positive: k = 0 makes n = 0, and k < 0 makes n = −(d·|k|) negative, both
// against n > 0. With k ≥ 1, the difference k − 1 is nonneg, so the gap
// g = d·(k−1) is nonneg (nonnegMul), and add(d, g) = d·(1 + (k−1)) = d·k = n,
// so exists_intro on the gap g reads d ≤ n.
theorem divisorAtMost: forall d, n: Int; less_than(ZERO, d) -> less_than(ZERO, n) -> does_divide(d, n) -> at_most(d, n)
proof
  @generalize-d |
    fix d: Int {
      @generalize-n |
        fix n: Int {
          @given-d-positive |
            assume less_than(ZERO, d) {
              @given-n-positive |
                assume less_than(ZERO, n) {
                  @given-d-divides-n |
                    assume does_divide(d, n) {
                      @d-positive |
                        less_than(ZERO, d)
                        [by hypothesis given-d-positive]
                      @n-positive |
                        less_than(ZERO, n)
                        [by hypothesis given-n-positive]
                      @d-divides-n |
                        does_divide(d, n)
                        [by hypothesis given-d-divides-n]
                      @with-quotient-k |
                        unpack k: Int from d-divides-n {
                          @n-is-d-times-k |
                            n = mul(d, k)
                            [by hypothesis with-quotient-k]
                          @d-nonneg |
                            is_nonneg(d)
                            [by specialize positiveIsNonneg(d) d-positive]
                          // the quotient k is positive.
                          @k-sign |
                            less_than(ZERO, k) or k = ZERO or less_than(k, ZERO)
                            [by specialize signTrichotomy(k)]
                          @k-positive |
                            less_than(ZERO, k)
                            case k-sign {
                              @when-k-positive |
                                assume less_than(ZERO, k) {
                                  @conclusion-k-positive |
                                    less_than(ZERO, k)
                                    [by hypothesis when-k-positive]
                                }
                              @when-k-zero |
                                assume k = ZERO {
                                  @k-is-zero |
                                    k = ZERO
                                    [by hypothesis when-k-zero]
                                  @d-times-zero-is-zero |
                                    mul(d, ZERO) = ZERO
                                    [by specialize mulZeroRight(d)]
                                  // n = d·k = d·0 = 0
                                  @n-is-zero |
                                    n = ZERO
                                    [by chain n-is-d-times-k k-is-zero d-times-zero-is-zero]
                                  @zero-less_than-zero |
                                    less_than(ZERO, ZERO)
                                    [by rewrite n-is-zero n-positive]
                                  @zero-not-less_than-zero |
                                    not less_than(ZERO, ZERO)
                                    [by specialize lessThanIrreflexive(ZERO)]
                                  @conclusion-k-positive |
                                    less_than(ZERO, k)
                                    [by absurd zero-less_than-zero zero-not-less_than-zero]
                                }
                              @when-k-negative |
                                assume less_than(k, ZERO) {
                                  @k-negative |
                                    less_than(k, ZERO)
                                    [by hypothesis when-k-negative]
                                  // n = d·k = −(d·(−k)), and d·(−k) is nonneg, so n ≤ 0.
                                  @neg-k-nonneg |
                                    is_nonneg(neg(k))
                                    [by specialize negLessThanZero(k) k-negative]
                                  @d-times-neg-k-nonneg |
                                    is_nonneg(mul(d, neg(k)))
                                    [by specialize nonnegMul(d, neg(k)) d-nonneg neg-k-nonneg]
                                  @d-times-neg-k-is-neg-product |
                                    mul(d, neg(k)) = neg(mul(d, k))
                                    [by specialize mulNegRight(d, k)]
                                  // d·(−k) = −(d·k) = −n
                                  @d-times-neg-k-is-neg-n |
                                    mul(d, neg(k)) = neg(n)
                                    [by chain d-times-neg-k-is-neg-product n-is-d-times-k]
                                  @neg-n-nonneg |
                                    is_nonneg(neg(n))
                                    [by rewrite d-times-neg-k-is-neg-n d-times-neg-k-nonneg]
                                  @add-n-neg-n-is-zero |
                                    add(n, neg(n)) = ZERO
                                    [by specialize addNegRight(n)]
                                  @n-plus-neg-n-witnesses |
                                    is_nonneg(neg(n)) and add(n, neg(n)) = ZERO
                                    [by and_intro neg-n-nonneg add-n-neg-n-is-zero]
                                  @n-at-most-zero-iff-gap |
                                    at_most(n, ZERO) iff (exists g: Int; is_nonneg(g) and add(n, g) = ZERO)
                                    [by specialize lessOrEqualIsGapExistential(n, ZERO)]
                                  @gap-gives-n-at-most-zero |
                                    (exists g: Int; is_nonneg(g) and add(n, g) = ZERO) -> at_most(n, ZERO)
                                    [by iff_elim_backward n-at-most-zero-iff-gap]
                                  @n-reaches-zero-gap-exists |
                                    exists g: Int; is_nonneg(g) and add(n, g) = ZERO
                                    [by exists_intro(neg(n)) n-plus-neg-n-witnesses]
                                  @n-at-most-zero |
                                    at_most(n, ZERO)
                                    [by modus_ponens gap-gives-n-at-most-zero n-reaches-zero-gap-exists]
                                  @zero-at-most-n |
                                    at_most(ZERO, n)
                                    [by specialize lessThanToLessOrEqual(ZERO, n) n-positive]
                                  @n-is-zero |
                                    n = ZERO
                                    [by specialize lessOrEqualAntisymmetric(n, ZERO) n-at-most-zero zero-at-most-n]
                                  @zero-less_than-zero |
                                    less_than(ZERO, ZERO)
                                    [by rewrite n-is-zero n-positive]
                                  @zero-not-less_than-zero |
                                    not less_than(ZERO, ZERO)
                                    [by specialize lessThanIrreflexive(ZERO)]
                                  @conclusion-k-positive |
                                    less_than(ZERO, k)
                                    [by absurd zero-less_than-zero zero-not-less_than-zero]
                                }
                            }
                          // k ≥ 1, so k − 1 is nonneg and g = d·(k−1) is the gap.
                          @one-at-most-k |
                            at_most(ONE, k)
                            [by specialize oneAtMostPositive(k) k-positive]
                          @k-minus-one-nonneg |
                            is_nonneg(sub(k, ONE))
                            [by specialize atMostGivesNonnegDifference(ONE, k) one-at-most-k]
                          @gap-nonneg |
                            is_nonneg(mul(d, sub(k, ONE)))
                            [by specialize nonnegMul(d, sub(k, ONE)) d-nonneg k-minus-one-nonneg]
                          // add(d, d·(k−1)) = d·(1 + (k−1)) = d·k = n.
                          @one-plus-k-minus-one-is-k |
                            add(ONE, sub(k, ONE)) = k
                            [by specialize addDiffReaches(ONE, k)]
                          @d-times-one-plus-diff |
                            mul(d, add(ONE, sub(k, ONE))) = add(mul(d, ONE), mul(d, sub(k, ONE)))
                            [by specialize mulAddDistribLeft(d, ONE, sub(k, ONE))]
                          @d-times-one-is-d |
                            mul(d, ONE) = d
                            [by specialize mulOneRight(d)]
                          @d-times-one-plus-diff-collects |
                            mul(d, add(ONE, sub(k, ONE))) = add(d, mul(d, sub(k, ONE)))
                            [by rewrite d-times-one-is-d d-times-one-plus-diff]
                          @d-times-k-splits |
                            mul(d, k) = add(d, mul(d, sub(k, ONE)))
                            [by rewrite one-plus-k-minus-one-is-k d-times-one-plus-diff-collects]
                          @n-splits-into-d-plus-gap |
                            n = add(d, mul(d, sub(k, ONE)))
                            [by rewrite d-times-k-splits n-is-d-times-k]
                          @d-plus-gap-is-n |
                            add(d, mul(d, sub(k, ONE))) = n
                            [by symmetry n-splits-into-d-plus-gap]
                          @gap-witnesses-at-most |
                            is_nonneg(mul(d, sub(k, ONE))) and add(d, mul(d, sub(k, ONE))) = n
                            [by and_intro gap-nonneg d-plus-gap-is-n]
                          @d-at-most-n-iff-gap |
                            at_most(d, n) iff (exists g: Int; is_nonneg(g) and add(d, g) = n)
                            [by specialize lessOrEqualIsGapExistential(d, n)]
                          @gap-gives-d-at-most-n |
                            (exists g: Int; is_nonneg(g) and add(d, g) = n) -> at_most(d, n)
                            [by iff_elim_backward d-at-most-n-iff-gap]
                          @d-reaches-n-gap-exists |
                            exists g: Int; is_nonneg(g) and add(d, g) = n
                            [by exists_intro(mul(d, sub(k, ONE))) gap-witnesses-at-most]
                          @d-at-most-n |
                            at_most(d, n)
                            [by modus_ponens gap-gives-d-at-most-n d-reaches-n-gap-exists]
                        }
                      @d-at-most-n |
                        at_most(d, n)
                        [by exists_elim with-quotient-k]
                    }
                  @d-divides-n-implies-at-most |
                    does_divide(d, n) -> at_most(d, n)
                    [by implies_intro given-d-divides-n]
                }
              @n-positive-implies-at-most |
                less_than(ZERO, n) -> does_divide(d, n) -> at_most(d, n)
                [by implies_intro given-n-positive]
            }
          @d-positive-implies-at-most |
            less_than(ZERO, d) -> less_than(ZERO, n) -> does_divide(d, n) -> at_most(d, n)
            [by implies_intro given-d-positive]
        }
      @discharge-n |
        forall n: Int; less_than(ZERO, d) -> less_than(ZERO, n) -> does_divide(d, n) -> at_most(d, n)
        [by forall_intro generalize-n]
    }
  @conclusion |
    forall d, n: Int; less_than(ZERO, d) -> less_than(ZERO, n) -> does_divide(d, n) -> at_most(d, n)
    [by forall_intro generalize-d]
qed

// -- every integer > 1 has a prime divisor ----------------------------------

// Well-ordering on S = {x : 1 < x and x | n}. S is nonempty (n ∈ S, since
// 1 < n and n | n). Its least member p is prime: 1 < p by membership, and for a
// positive divisor d of p, d | p | n so d | n; if 1 < d then d ∈ S, and d ≤ p
// (divisorAtMost) with p ≤ d (p least) forces d = p; otherwise d = 1. And p | n.
theorem primeFactorExists: forall n: Int; less_than(ONE, n)
  -> exists p: Int; (less_than(ONE, p) and (forall d: Int; less_than(ZERO, d) -> does_divide(d, p) -> (d = ONE or d = p))) and does_divide(p, n)
proof
  @generalize-n |
    fix n: Int {
      @given-n-above-one |
        assume less_than(ONE, n) {
          @n-above-one |
            less_than(ONE, n)
            [by hypothesis given-n-above-one]
          // n itself is a member of S: 1 < n and n | n; and n is nonneg.
          @n-divides-n |
            does_divide(n, n)
            [by specialize dividesRefl(n)]
          @zero-less_than-one |
            less_than(ZERO, ONE)
            [by theorem zeroLessThanOne]
          @zero-less_than-n |
            less_than(ZERO, n)
            [by specialize lessThanTransitive(ZERO, ONE, n) zero-less_than-one n-above-one]
          @n-nonneg |
            is_nonneg(n)
            [by specialize positiveIsNonneg(n) zero-less_than-n]
          @n-is-member |
            less_than(ONE, n) and does_divide(n, n)
            [by and_intro n-above-one n-divides-n]
          @n-is-nonneg-member |
            is_nonneg(n) and (less_than(ONE, n) and does_divide(n, n))
            [by and_intro n-nonneg n-is-member]
          @set-is-nonempty |
            exists x: Int; is_nonneg(x) and (less_than(ONE, x) and does_divide(x, n))
            [by exists_intro(n) n-is-nonneg-member]
          // Well-Ordering: S has a least member p.
          @well-ordering-on-divisors |
            (exists x: Int; is_nonneg(x) and (less_than(ONE, x) and does_divide(x, n)))
              -> exists least: Int; is_nonneg(least) and (less_than(ONE, least) and does_divide(least, n)) and (forall m: Int; is_nonneg(m) -> (less_than(ONE, m) and does_divide(m, n)) -> at_most(least, m))
            [by instantiate nonnegWellOrdering((fun x: Int => less_than(ONE, x) and does_divide(x, n)))]
          @least-member-exists |
            exists least: Int; is_nonneg(least) and (less_than(ONE, least) and does_divide(least, n)) and (forall m: Int; is_nonneg(m) -> (less_than(ONE, m) and does_divide(m, n)) -> at_most(least, m))
            [by modus_ponens well-ordering-on-divisors set-is-nonempty]
          @with-least-divisor-p |
            unpack p: Int from least-member-exists {
              @p-is-least-member |
                is_nonneg(p) and (less_than(ONE, p) and does_divide(p, n)) and (forall m: Int; is_nonneg(m) -> (less_than(ONE, m) and does_divide(m, n)) -> at_most(p, m))
                [by hypothesis with-least-divisor-p]
              @p-above-one |
                less_than(ONE, p)
                [by tautology p-is-least-member]
              @p-divides-n |
                does_divide(p, n)
                [by tautology p-is-least-member]
              @p-is-least |
                forall m: Int; is_nonneg(m) -> (less_than(ONE, m) and does_divide(m, n)) -> at_most(p, m)
                [by tautology p-is-least-member]
              // p > 0, from 0 < 1 < p.
              @zero-less_than-p |
                less_than(ZERO, p)
                [by specialize lessThanTransitive(ZERO, ONE, p) zero-less_than-one p-above-one]
              // p is prime: its only positive divisors are 1 and p.
              @only-positive-divisors-are-one-and-p |
                fix d: Int {
                  @given-d-positive |
                    assume less_than(ZERO, d) {
                      @given-d-divides-p |
                        assume does_divide(d, p) {
                          @d-positive |
                            less_than(ZERO, d)
                            [by hypothesis given-d-positive]
                          @d-divides-p |
                            does_divide(d, p)
                            [by hypothesis given-d-divides-p]
                          // d | p | n gives d | n.
                          @d-divides-n |
                            does_divide(d, n)
                            [by specialize dividesTransitive(d, p, n) d-divides-p p-divides-n]
                          // 1 <= d, so d = 1 or 1 < d.
                          @one-at-most-d |
                            at_most(ONE, d)
                            [by specialize oneAtMostPositive(d) d-positive]
                          @one-less_than-d-or-equals-d |
                            less_than(ONE, d) or ONE = d
                            [by specialize lessOrEqualSplit(ONE, d) one-at-most-d]
                          @d-is-one-or-p |
                            d = ONE or d = p
                            case one-less_than-d-or-equals-d {
                              @when-one-less_than-d |
                                assume less_than(ONE, d) {
                                  @one-less_than-d |
                                    less_than(ONE, d)
                                    [by hypothesis when-one-less_than-d]
                                  // d ∈ S, so p ≤ d by minimality.
                                  @d-in-set |
                                    less_than(ONE, d) and does_divide(d, n)
                                    [by and_intro one-less_than-d d-divides-n]
                                  @d-nonneg |
                                    is_nonneg(d)
                                    [by specialize positiveIsNonneg(d) d-positive]
                                  @p-at-most-d-if-member |
                                    is_nonneg(d) -> (less_than(ONE, d) and does_divide(d, n)) -> at_most(p, d)
                                    [by forall_elim(d) p-is-least]
                                  @p-at-most-d |
                                    at_most(p, d)
                                    [by tautology p-at-most-d-if-member d-nonneg d-in-set]
                                  // d ≤ p, since d | p and p > 0; antisymmetry gives d = p.
                                  @d-at-most-p |
                                    at_most(d, p)
                                    [by specialize divisorAtMost(d, p) d-positive zero-less_than-p d-divides-p]
                                  @d-equals-p |
                                    d = p
                                    [by specialize lessOrEqualAntisymmetric(d, p) d-at-most-p p-at-most-d]
                                  @conclusion-d-is-one-or-p |
                                    d = ONE or d = p
                                    [by or_intro_right d-equals-p]
                                }
                              @when-one-equals-d |
                                assume ONE = d {
                                  @one-equals-d |
                                    ONE = d
                                    [by hypothesis when-one-equals-d]
                                  @d-equals-one |
                                    d = ONE
                                    [by symmetry one-equals-d]
                                  @conclusion-d-is-one-or-p |
                                    d = ONE or d = p
                                    [by or_intro_left d-equals-one]
                                }
                            }
                        }
                      @d-divides-p-implies-one-or-p |
                        does_divide(d, p) -> (d = ONE or d = p)
                        [by implies_intro given-d-divides-p]
                    }
                  @d-positive-implies-divisor-is-one-or-p |
                    less_than(ZERO, d) -> does_divide(d, p) -> (d = ONE or d = p)
                    [by implies_intro given-d-positive]
                }
              @p-only-divided-by-one-and-p |
                forall d: Int; less_than(ZERO, d) -> does_divide(d, p) -> (d = ONE or d = p)
                [by forall_intro only-positive-divisors-are-one-and-p]
              @p-is-prime |
                less_than(ONE, p) and (forall d: Int; less_than(ZERO, d) -> does_divide(d, p) -> (d = ONE or d = p))
                [by and_intro p-above-one p-only-divided-by-one-and-p]
              @p-is-prime-and-divides-n |
                (less_than(ONE, p) and (forall d: Int; less_than(ZERO, d) -> does_divide(d, p) -> (d = ONE or d = p))) and does_divide(p, n)
                [by and_intro p-is-prime p-divides-n]
              @prime-divisor-exists |
                exists q: Int; (less_than(ONE, q) and (forall d: Int; less_than(ZERO, d) -> does_divide(d, q) -> (d = ONE or d = q))) and does_divide(q, n)
                [by exists_intro(p) p-is-prime-and-divides-n]
            }
          @prime-divisor-exists |
            exists q: Int; (less_than(ONE, q) and (forall d: Int; less_than(ZERO, d) -> does_divide(d, q) -> (d = ONE or d = q))) and does_divide(q, n)
            [by exists_elim with-least-divisor-p]
        }
      @n-above-one-implies-prime-divisor |
        less_than(ONE, n) -> exists p: Int; (less_than(ONE, p) and (forall d: Int; less_than(ZERO, d) -> does_divide(d, p) -> (d = ONE or d = p))) and does_divide(p, n)
        [by implies_intro given-n-above-one]
    }
  @conclusion |
    forall n: Int; less_than(ONE, n) -> exists p: Int; (less_than(ONE, p) and (forall d: Int; less_than(ZERO, d) -> does_divide(d, p) -> (d = ONE or d = p))) and does_divide(p, n)
    [by forall_intro generalize-n]
qed
