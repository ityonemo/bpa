// std/integer-wellordering.bpa — STRONG (course-of-values) INDUCTION and the
// PRINCIPLE OF WELL-ORDERING over the nonnegative integers ℕ ⊂ ℤ.
//
// This file sits ABOVE the ℤ order (std/integer-order.bpa), which itself carves
// ℕ out of ℤ as the predicate `nonneg` and equips ℤ with `less_than` /
// `less_or_equal`. The order file cannot host these theorems: nonneg is defined
// BELOW it (std/integer-nonneg.bpa), and importing the order back into nonneg
// would be a cycle. So we layer strong induction and well-ordering here, one
// level above the whole order corpus, guarding EVERY carrier quantifier with
// `nonneg` (ℕ is a subclass of ℤ, so ranging over "all nonneg n" is the ℕ
// quantifier). The proofs mirror std/peano-ordering.bpa's `strongInduction` and
// `wellOrdering`, nonneg-guarded throughout.

import order <<< "std/integer-order.bpa"
import integer <<< "std/integer.bpa"

sort Int = order.Int
const ZERO = order.ZERO
func succ = order.succ
func add = order.add
func prev = integer.prev
pred less_than = order.less_than
pred less_or_equal = order.less_or_equal
pred nonneg = order.nonneg

axiom nonnegZero = order.nonnegZero
axiom nonnegSucc = order.nonnegSucc
axiom nonnegInduction = order.nonnegInduction
axiom nonnegSuccNotZero = order.nonnegSuccNotZero
axiom lessThanIntro = order.lessThanIntro
axiom lessThanElim = order.lessThanElim
theorem nonnegCases = order.nonnegCases
theorem nonnegAdd = order.nonnegAdd
theorem addSuccRight = order.addSuccRight
theorem addZeroRight = order.addZeroRight
theorem lessThanToLessOrEqual = order.lessThanToLessOrEqual
theorem lessOrEqualRefl = order.lessOrEqualRefl
theorem lessThanSuccRight = order.lessThanSuccRight
theorem trichotomy = order.trichotomy
axiom prevSucc = integer.prevSucc

// -- successor is injective -----------------------------------------------

// succ is injective on ℤ: it has a left inverse, prev (prevSucc). Needed to
// invert the gap equations in lessThanSuccSplit.
theorem succInjective: forall a, b: Int; succ(a) = succ(b) -> a = b
proof
  @generalize-a |
    fix a: Int {
      @generalize-b |
        fix b: Int {
          @given-succ-equal |
            assume succ(a) = succ(b) {
              @succ-equal |
                succ(a) = succ(b)
                [by hypothesis given-succ-equal]
              @prev-succ-a-refl |
                prev(succ(a)) = prev(succ(a))
                [by reflexivity]
              @prev-of-succ-equal |
                prev(succ(a)) = prev(succ(b))
                [by rewrite succ-equal prev-succ-a-refl]
              @prev-inverts-succ |
                forall n: Int; prev(succ(n)) = n
                [by axiom prevSucc]
              @prev-succ-a |
                prev(succ(a)) = a
                [by forall_elim(a) prev-inverts-succ]
              @prev-succ-b |
                prev(succ(b)) = b
                [by forall_elim(b) prev-inverts-succ]
              @a-equals-prev-succ-b |
                a = prev(succ(b))
                [by rewrite prev-succ-a prev-of-succ-equal]
              @a-equals-b |
                a = b
                [by rewrite prev-succ-b a-equals-prev-succ-b]
            }
          @succ-equal-implies-equal |
            succ(a) = succ(b) -> a = b
            [by implies_intro given-succ-equal]
        }
      @discharge-b |
        forall b: Int; succ(a) = succ(b) -> a = b
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b: Int; succ(a) = succ(b) -> a = b
    [by forall_intro generalize-a]
qed

// -- nothing nonneg is strictly less_than ZERO --------------------------------

// The nonnegatives have 0 as a least element: no nonneg m satisfies m < 0.
// If m < 0, lessThanElim gives a nonneg gap d with add(m, succ(d)) = ZERO. But
// add(m, succ(d)) = succ(add(m, d)), and add(m, d) is nonneg (nonnegAdd), so its
// successor is != ZERO by nonnegSuccNotZero — contradiction.
theorem nonnegNotLessThanZero: forall m: Int; nonneg(m) -> (not less_than(m, ZERO))
proof
  @generalize-m |
    fix m: Int {
      @given-m-nonneg |
        assume nonneg(m) {
          @m-nonneg |
            nonneg(m)
            [by hypothesis given-m-nonneg]
          @given-m-less_than-zero |
            assume less_than(m, ZERO) {
              @m-less_than-zero |
                less_than(m, ZERO)
                [by hypothesis given-m-less_than-zero]
              @less-than-elim |
                forall a, b: Int; less_than(a, b) -> exists d: Int; nonneg(d) and add(a, succ(d)) = b
                [by axiom lessThanElim]
              @gap-exists-if-less_than |
                less_than(m, ZERO) -> exists d: Int; nonneg(d) and add(m, succ(d)) = ZERO
                [by forall_elim(m, ZERO) less-than-elim]
              @gap-exists |
                exists d: Int; nonneg(d) and add(m, succ(d)) = ZERO
                [by modus_ponens gap-exists-if-less_than m-less_than-zero]
              @with-gap-d |
                unpack d0: Int from gap-exists {
                  @gap-nonneg-and-reaches |
                    nonneg(d0) and add(m, succ(d0)) = ZERO
                    [by hypothesis with-gap-d]
                  @gap-nonneg |
                    nonneg(d0)
                    [by and_elim_left gap-nonneg-and-reaches]
                  @gap-reaches-zero |
                    add(m, succ(d0)) = ZERO
                    [by and_elim_right gap-nonneg-and-reaches]
                  @nonneg-add |
                    forall a, b: Int; nonneg(a) -> nonneg(b) -> nonneg(add(a, b))
                    [by theorem nonnegAdd]
                  @sum-md-nonneg-if-parts |
                    nonneg(m) -> nonneg(d0) -> nonneg(add(m, d0))
                    [by forall_elim(m, d0) nonneg-add]
                  @sum-md-nonneg |
                    nonneg(add(m, d0))
                    [by tautology sum-md-nonneg-if-parts m-nonneg gap-nonneg]
                  @gap-unfolds |
                    add(m, succ(d0)) = succ(add(m, d0))
                    [by simplify addSuccRight]
                  @succ-md-is-zero |
                    succ(add(m, d0)) = ZERO
                    [by rewrite gap-unfolds gap-reaches-zero]
                  @successor-of-nonneg-not-zero |
                    forall n: Int; nonneg(n) -> succ(n) != ZERO
                    [by axiom nonnegSuccNotZero]
                  @succ-nonneg-not-zero |
                    nonneg(add(m, d0)) -> succ(add(m, d0)) != ZERO
                    [by forall_elim(add(m, d0)) successor-of-nonneg-not-zero]
                  @succ-md-not-zero |
                    succ(add(m, d0)) != ZERO
                    [by modus_ponens succ-nonneg-not-zero sum-md-nonneg]
                  @contradiction |
                    not less_than(m, ZERO)
                    [by absurd succ-md-is-zero succ-md-not-zero]
                }
              @not-less_than-zero |
                not less_than(m, ZERO)
                [by exists_elim with-gap-d]
            }
          @m-nonneg-not-less_than-zero |
            less_than(m, ZERO) -> (not less_than(m, ZERO))
            [by implies_intro given-m-less_than-zero]
          @conclusion-m |
            not less_than(m, ZERO)
            [by tautology m-nonneg-not-less_than-zero]
        }
      @discharge-m-nonneg |
        nonneg(m) -> (not less_than(m, ZERO))
        [by implies_intro given-m-nonneg]
    }
  @conclusion |
    forall m: Int; nonneg(m) -> (not less_than(m, ZERO))
    [by forall_intro generalize-m]
qed

// -- less_than-successor splits (nonneg-guarded) ------------------------------

// For nonneg m, k: m < succ(k) iff m < k or m = k. The gap d from
// lessThanElim (add(m, succ(d)) = succ(k)) is nonneg, so by nonnegCases it is
// ZERO — giving succ(m) = succ(k), hence m = k — or succ(e) for nonneg e —
// giving add(m, succ(e)) = k, hence m < k.
theorem lessThanSuccSplit: forall m, k: Int; nonneg(m) -> nonneg(k) -> less_than(m, succ(k)) -> (less_than(m, k) or m = k)
proof
  @generalize-m |
    fix m: Int {
      @generalize-k |
        fix k: Int {
          @given-m-nonneg |
            assume nonneg(m) {
              @given-k-nonneg |
                assume nonneg(k) {
                  @given-m-less_than-succ-k |
                    assume less_than(m, succ(k)) {
                      @m-less_than-succ-k |
                        less_than(m, succ(k))
                        [by hypothesis given-m-less_than-succ-k]
                      @less-than-elim |
                        forall a, b: Int; less_than(a, b) -> exists d: Int; nonneg(d) and add(a, succ(d)) = b
                        [by axiom lessThanElim]
                      @gap-exists-if-less_than |
                        less_than(m, succ(k)) -> exists d: Int; nonneg(d) and add(m, succ(d)) = succ(k)
                        [by forall_elim(m, succ(k)) less-than-elim]
                      @gap-exists |
                        exists d: Int; nonneg(d) and add(m, succ(d)) = succ(k)
                        [by modus_ponens gap-exists-if-less_than m-less_than-succ-k]
                      @with-gap-d |
                        unpack d0: Int from gap-exists {
                          @gap-nonneg-and-reaches |
                            nonneg(d0) and add(m, succ(d0)) = succ(k)
                            [by hypothesis with-gap-d]
                          @gap-nonneg |
                            nonneg(d0)
                            [by and_elim_left gap-nonneg-and-reaches]
                          @gap-reaches-succ-k |
                            add(m, succ(d0)) = succ(k)
                            [by and_elim_right gap-nonneg-and-reaches]
                          @nonneg-cases |
                            forall n: Int; nonneg(n) -> (n = ZERO or (exists mm: Int; nonneg(mm) and n = succ(mm)))
                            [by theorem nonnegCases]
                          @gap-is-zero-or-successor-if-nonneg |
                            nonneg(d0) -> (d0 = ZERO or (exists mm: Int; nonneg(mm) and d0 = succ(mm)))
                            [by forall_elim(d0) nonneg-cases]
                          @gap-is-zero-or-successor |
                            d0 = ZERO or (exists mm: Int; nonneg(mm) and d0 = succ(mm))
                            [by modus_ponens gap-is-zero-or-successor-if-nonneg gap-nonneg]
                          // d0 = ZERO: add(m, succ(ZERO)) = succ(k), so succ(m) = succ(k), m = k
                          @when-gap-is-zero |
                            assume d0 = ZERO {
                              @gap-is-zero |
                                d0 = ZERO
                                [by hypothesis when-gap-is-zero]
                              @unit-gap-reaches-succ-k |
                                add(m, succ(ZERO)) = succ(k)
                                [by rewrite gap-is-zero gap-reaches-succ-k]
                              @unit-gap-is-succ-m |
                                add(m, succ(ZERO)) = succ(m)
                                [by simplify addSuccRight addZeroRight]
                              @succ-m-equals-succ-k |
                                succ(m) = succ(k)
                                [by rewrite unit-gap-is-succ-m unit-gap-reaches-succ-k]
                              @successor-is-injective |
                                forall a, b: Int; succ(a) = succ(b) -> a = b
                                [by theorem succInjective]
                              @m-equals-k-if-succ-equal |
                                succ(m) = succ(k) -> m = k
                                [by forall_elim(m, k) successor-is-injective]
                              @m-equals-k |
                                m = k
                                [by modus_ponens m-equals-k-if-succ-equal succ-m-equals-succ-k]
                              @conclusion-less_than-or-equal |
                                less_than(m, k) or m = k
                                [by or_intro_right m-equals-k]
                            }
                          // d0 = succ(e0), e0 nonneg: add(m, succ(succ(e0))) = succ(k),
                          // so add(m, succ(e0)) = k, and e0 nonneg makes it m < k.
                          @when-gap-is-successor |
                            assume exists mm: Int; nonneg(mm) and d0 = succ(mm) {
                              @gap-is-some-successor |
                                exists mm: Int; nonneg(mm) and d0 = succ(mm)
                                [by hypothesis when-gap-is-successor]
                              @with-predecessor-e |
                                unpack e0: Int from gap-is-some-successor {
                                  @predecessor-nonneg-and-gap-is-succ |
                                    nonneg(e0) and d0 = succ(e0)
                                    [by hypothesis with-predecessor-e]
                                  @predecessor-nonneg |
                                    nonneg(e0)
                                    [by and_elim_left predecessor-nonneg-and-gap-is-succ]
                                  @gap-is-succ-e |
                                    d0 = succ(e0)
                                    [by and_elim_right predecessor-nonneg-and-gap-is-succ]
                                  @successor-gap-reaches-succ-k |
                                    add(m, succ(succ(e0))) = succ(k)
                                    [by rewrite gap-is-succ-e gap-reaches-succ-k]
                                  @successor-gap-unfolds |
                                    add(m, succ(succ(e0))) = succ(add(m, succ(e0)))
                                    [by simplify addSuccRight]
                                  @succ-of-inner-gap-is-succ-k |
                                    succ(add(m, succ(e0))) = succ(k)
                                    [by rewrite successor-gap-unfolds successor-gap-reaches-succ-k]
                                  @successor-is-injective |
                                    forall a, b: Int; succ(a) = succ(b) -> a = b
                                    [by theorem succInjective]
                                  @inner-gap-is-k-if-succ-equal |
                                    succ(add(m, succ(e0))) = succ(k) -> add(m, succ(e0)) = k
                                    [by forall_elim(add(m, succ(e0)), k) successor-is-injective]
                                  @inner-gap-reaches-k |
                                    add(m, succ(e0)) = k
                                    [by modus_ponens inner-gap-is-k-if-succ-equal succ-of-inner-gap-is-succ-k]
                                  @a-gap-witnesses-less-than |
                                    forall a, d, b: Int; nonneg(d) -> add(a, succ(d)) = b -> less_than(a, b)
                                    [by axiom lessThanIntro]
                                  @m-less_than-k-if-gap |
                                    nonneg(e0) -> add(m, succ(e0)) = k -> less_than(m, k)
                                    [by forall_elim(m, e0, k) a-gap-witnesses-less-than]
                                  @m-less_than-k |
                                    less_than(m, k)
                                    [by tautology m-less_than-k-if-gap predecessor-nonneg inner-gap-reaches-k]
                                  @conclusion-less_than-or-equal |
                                    less_than(m, k) or m = k
                                    [by or_intro_left m-less_than-k]
                                }
                              @conclusion-less_than-or-equal |
                                less_than(m, k) or m = k
                                [by exists_elim with-predecessor-e]
                            }
                          @conclusion-less_than-or-equal |
                            less_than(m, k) or m = k
                            [by or_elim gap-is-zero-or-successor when-gap-is-zero when-gap-is-successor]
                        }
                      @less_than-or-equal |
                        less_than(m, k) or m = k
                        [by exists_elim with-gap-d]
                    }
                  @less_than-succ-implies-less_than-or-equal |
                    less_than(m, succ(k)) -> (less_than(m, k) or m = k)
                    [by implies_intro given-m-less_than-succ-k]
                }
              @discharge-k-nonneg |
                nonneg(k) -> less_than(m, succ(k)) -> (less_than(m, k) or m = k)
                [by implies_intro given-k-nonneg]
            }
          @discharge-m-nonneg |
            nonneg(m) -> nonneg(k) -> less_than(m, succ(k)) -> (less_than(m, k) or m = k)
            [by implies_intro given-m-nonneg]
        }
      @discharge-k |
        forall k: Int; nonneg(m) -> nonneg(k) -> less_than(m, succ(k)) -> (less_than(m, k) or m = k)
        [by forall_intro generalize-k]
    }
  @conclusion |
    forall m, k: Int; nonneg(m) -> nonneg(k) -> less_than(m, succ(k)) -> (less_than(m, k) or m = k)
    [by forall_intro generalize-m]
qed

// -- every integer is less_than its successor ---------------------------------

// n < succ(n): the gap is ZERO (nonneg), and add(n, succ(ZERO)) = succ(n).
theorem lessThanSelf: forall n: Int; less_than(n, succ(n))
proof
  @generalize-n |
    fix n: Int {
      @zero-nonneg |
        nonneg(ZERO)
        [by axiom nonnegZero]
      @unit-gap-is-succ-n |
        add(n, succ(ZERO)) = succ(n)
        [by simplify addSuccRight addZeroRight]
      @gap-witnesses-less-than |
        forall a, d, b: Int; nonneg(d) -> add(a, succ(d)) = b -> less_than(a, b)
        [by axiom lessThanIntro]
      @n-less_than-succ-n-if-gap |
        nonneg(ZERO) -> add(n, succ(ZERO)) = succ(n) -> less_than(n, succ(n))
        [by forall_elim(n, ZERO, succ(n)) gap-witnesses-less-than]
      @n-less_than-succ-n |
        less_than(n, succ(n))
        [by tautology n-less_than-succ-n-if-gap zero-nonneg unit-gap-is-succ-n]
    }
  @conclusion |
    forall n: Int; less_than(n, succ(n))
    [by forall_intro generalize-n]
qed

// -- strong (course-of-values) induction over ℕ ---------------------------

// To prove prop(n) for all nonneg n, it suffices to prove prop(n) from the
// assumption that prop(m) holds for every nonneg m < n. Derived from ordinary
// nonneg induction on Q(j) := forall m; nonneg(m) -> m < j -> prop(m). Base
// Q(ZERO) is vacuous (nonnegNotLessThanZero); the step Q(k) -> Q(succ k) uses
// lessThanSuccSplit to reduce m < succ(k) to m < k (use Q(k)) or m = k (use the
// strong step at k). Then prop(n) follows from Q(succ n) at m = n via n < succ n.
theorem nonnegStrongInduction(prop: Int -> Prop):
  (forall n: Int; nonneg(n) -> (forall m: Int; nonneg(m) -> less_than(m, n) -> prop(m)) -> prop(n))
  -> forall n: Int; nonneg(n) -> prop(n)
proof
  @given-strong-step |
    assume forall n: Int; nonneg(n) -> (forall m: Int; nonneg(m) -> less_than(m, n) -> prop(m)) -> prop(n) {
      @strong-step |
        forall n: Int; nonneg(n) -> (forall m: Int; nonneg(m) -> less_than(m, n) -> prop(m)) -> prop(n)
        [by hypothesis given-strong-step]

      // base: Q(ZERO) = forall m; nonneg(m) -> m < ZERO -> prop(m), vacuously true
      @base-case-proof |
        fix m0: Int {
          @given-m-nonneg |
            assume nonneg(m0) {
              @given-m-less_than-zero |
                assume less_than(m0, ZERO) {
                  @m-less_than-zero |
                    less_than(m0, ZERO)
                    [by hypothesis given-m-less_than-zero]
                  @m-nonneg |
                    nonneg(m0)
                    [by hypothesis given-m-nonneg]
                  @nothing-nonneg-less_than-zero |
                    forall m: Int; nonneg(m) -> (not less_than(m, ZERO))
                    [by theorem nonnegNotLessThanZero]
                  @m-not-less_than-zero-if-nonneg |
                    nonneg(m0) -> (not less_than(m0, ZERO))
                    [by forall_elim(m0) nothing-nonneg-less_than-zero]
                  @m-not-less_than-zero |
                    not less_than(m0, ZERO)
                    [by modus_ponens m-not-less_than-zero-if-nonneg m-nonneg]
                  @prop-holds-vacuously |
                    prop(m0)
                    [by absurd m-less_than-zero m-not-less_than-zero]
                }
              @less_than-zero-implies-prop |
                less_than(m0, ZERO) -> prop(m0)
                [by implies_intro given-m-less_than-zero]
            }
          @nonneg-less_than-zero-implies-prop |
            nonneg(m0) -> less_than(m0, ZERO) -> prop(m0)
            [by implies_intro given-m-nonneg]
        }
      @base-case |
        forall m: Int; nonneg(m) -> less_than(m, ZERO) -> prop(m)
        [by forall_intro base-case-proof]

      // step: Q(k) -> Q(succ k), for nonneg k
      @induction-step |
        fix k: Int {
          @given-k-nonneg |
            assume nonneg(k) {
              @k-nonneg |
                nonneg(k)
                [by hypothesis given-k-nonneg]
              @given-inductive-hypothesis |
                assume forall m: Int; nonneg(m) -> less_than(m, k) -> prop(m) {
                  @inductive-hypothesis |
                    forall m: Int; nonneg(m) -> less_than(m, k) -> prop(m)
                    [by hypothesis given-inductive-hypothesis]
                  // prop(k), from the strong step applied to Q(k)
                  @strong-step-at-k |
                    nonneg(k) -> (forall m: Int; nonneg(m) -> less_than(m, k) -> prop(m)) -> prop(k)
                    [by forall_elim(k) strong-step]
                  @prop-k |
                    prop(k)
                    [by tautology strong-step-at-k k-nonneg inductive-hypothesis]
                  // Q(succ k): forall m; nonneg(m) -> m < succ k -> prop(m)
                  @generalize-m |
                    fix m1: Int {
                      @given-m1-nonneg |
                        assume nonneg(m1) {
                          @m1-nonneg |
                            nonneg(m1)
                            [by hypothesis given-m1-nonneg]
                          @given-m-less_than-succ-k |
                            assume less_than(m1, succ(k)) {
                              @m-less_than-succ-k |
                                less_than(m1, succ(k))
                                [by hypothesis given-m-less_than-succ-k]
                              @less_than-succ-splits |
                                forall mm, kk: Int; nonneg(mm) -> nonneg(kk) -> less_than(mm, succ(kk)) -> (less_than(mm, kk) or mm = kk)
                                [by theorem lessThanSuccSplit]
                              @m-less_than-k-or-equal-if-less_than-succ |
                                nonneg(m1) -> nonneg(k) -> less_than(m1, succ(k)) -> (less_than(m1, k) or m1 = k)
                                [by forall_elim(m1, k) less_than-succ-splits]
                              @m-less_than-k-or-equal |
                                less_than(m1, k) or m1 = k
                                [by tautology m-less_than-k-or-equal-if-less_than-succ m1-nonneg k-nonneg m-less_than-succ-k]
                              @when-m-less_than-k |
                                assume less_than(m1, k) {
                                  @m-less_than-k |
                                    less_than(m1, k)
                                    [by hypothesis when-m-less_than-k]
                                  @prop-m-if-nonneg-less_than-k |
                                    nonneg(m1) -> less_than(m1, k) -> prop(m1)
                                    [by forall_elim(m1) inductive-hypothesis]
                                  @prop-m |
                                    prop(m1)
                                    [by tautology prop-m-if-nonneg-less_than-k m1-nonneg m-less_than-k]
                                }
                              @when-m-equals-k |
                                assume m1 = k {
                                  @m-equals-k |
                                    m1 = k
                                    [by hypothesis when-m-equals-k]
                                  @k-equals-m |
                                    k = m1
                                    [by symmetry m-equals-k]
                                  @prop-m |
                                    prop(m1)
                                    [by rewrite k-equals-m prop-k]
                                }
                              @prop-m |
                                prop(m1)
                                [by or_elim m-less_than-k-or-equal when-m-less_than-k when-m-equals-k]
                            }
                          @less_than-succ-k-implies-prop |
                            less_than(m1, succ(k)) -> prop(m1)
                            [by implies_intro given-m-less_than-succ-k]
                        }
                      @nonneg-less_than-succ-k-implies-prop |
                        nonneg(m1) -> less_than(m1, succ(k)) -> prop(m1)
                        [by implies_intro given-m1-nonneg]
                    }
                  @prop-holds-less_than-succ-k |
                    forall m: Int; nonneg(m) -> less_than(m, succ(k)) -> prop(m)
                    [by forall_intro generalize-m]
                }
              @induction-step-at-k |
                (forall m: Int; nonneg(m) -> less_than(m, k) -> prop(m)) -> forall m: Int; nonneg(m) -> less_than(m, succ(k)) -> prop(m)
                [by implies_intro given-inductive-hypothesis]
            }
          @induction-step-for-nonneg-k |
            nonneg(k) -> (forall m: Int; nonneg(m) -> less_than(m, k) -> prop(m)) -> forall m: Int; nonneg(m) -> less_than(m, succ(k)) -> prop(m)
            [by implies_intro given-k-nonneg]
        }
      @induction-step-for-all-k |
        forall k: Int; nonneg(k) -> (forall m: Int; nonneg(m) -> less_than(m, k) -> prop(m)) -> forall m: Int; nonneg(m) -> less_than(m, succ(k)) -> prop(m)
        [by forall_intro induction-step]

      // forall nonneg n; Q(n), by ordinary nonneg induction on Q
      @prop-holds-less_than-every-n |
        forall n: Int; nonneg(n) -> forall m: Int; nonneg(m) -> less_than(m, n) -> prop(m)
        [by instantiate nonnegInduction((fun j: Int => forall m: Int; nonneg(m) -> less_than(m, j) -> prop(m))) base-case induction-step-for-all-k]

      // prop(n) from Q(succ n) applied at m = n (using n < succ n and nonneg succ n)
      @generalize-n |
        fix n1: Int {
          @given-n-nonneg |
            assume nonneg(n1) {
              @n-nonneg |
                nonneg(n1)
                [by hypothesis given-n-nonneg]
              @nonneg-succ |
                forall n: Int; nonneg(n) -> nonneg(succ(n))
                [by axiom nonnegSucc]
              @succ-n-nonneg-if-n |
                nonneg(n1) -> nonneg(succ(n1))
                [by forall_elim(n1) nonneg-succ]
              @succ-n-nonneg |
                nonneg(succ(n1))
                [by modus_ponens succ-n-nonneg-if-n n-nonneg]
              @prop-holds-less_than-succ-n-if-nonneg |
                nonneg(succ(n1)) -> forall m: Int; nonneg(m) -> less_than(m, succ(n1)) -> prop(m)
                [by forall_elim(succ(n1)) prop-holds-less_than-every-n]
              @prop-holds-less_than-succ-n |
                forall m: Int; nonneg(m) -> less_than(m, succ(n1)) -> prop(m)
                [by modus_ponens prop-holds-less_than-succ-n-if-nonneg succ-n-nonneg]
              @prop-n-if-nonneg-less_than-succ-n |
                nonneg(n1) -> less_than(n1, succ(n1)) -> prop(n1)
                [by forall_elim(n1) prop-holds-less_than-succ-n]
              @n-less_than-succ-n-lemma |
                forall n: Int; less_than(n, succ(n))
                [by theorem lessThanSelf]
              @n-less_than-succ-n |
                less_than(n1, succ(n1))
                [by forall_elim(n1) n-less_than-succ-n-lemma]
              @prop-n |
                prop(n1)
                [by tautology prop-n-if-nonneg-less_than-succ-n n-nonneg n-less_than-succ-n]
            }
          @nonneg-n-implies-prop |
            nonneg(n1) -> prop(n1)
            [by implies_intro given-n-nonneg]
        }
      @prop-holds-for-all-nonneg |
        forall n: Int; nonneg(n) -> prop(n)
        [by forall_intro generalize-n]
    }
  @conclusion |
    (forall n: Int; nonneg(n) -> (forall m: Int; nonneg(m) -> less_than(m, n) -> prop(m)) -> prop(n)) -> forall n: Int; nonneg(n) -> prop(n)
    [by implies_intro given-strong-step]
qed

// -- the Principle of Well-Ordering over ℕ --------------------------------

// Every nonempty subset of the nonnegatives — a `prop` satisfied by some nonneg
// witness — has a least element (a nonneg element satisfying prop that is
// less_or_equal to every nonneg element satisfying prop).
//
// Proof by strong induction on the negation. Let Q(n) := not prop(n). The strong
// step: if every nonneg m < n fails prop, then n fails prop too — for if prop(n)
// held (with n nonneg), n would BE a least element: for any nonneg m with
// prop(m), trichotomy gives n < m or n = m (so n ≤ m) or m < n (impossible, the
// IH says prop(m) fails), contradicting "no least element". Strong induction then
// makes prop empty on ℕ, contradicting the nonneg witness.
theorem nonnegWellOrdering(prop: Int -> Prop):
  (exists n: Int; nonneg(n) and prop(n))
  -> exists least: Int; nonneg(least) and prop(least) and (forall m: Int; nonneg(m) -> prop(m) -> less_or_equal(least, m))
proof
  @given-inhabited |
    assume exists n: Int; nonneg(n) and prop(n) {
      @some-nonneg-element-satisfies |
        exists n: Int; nonneg(n) and prop(n)
        [by hypothesis given-inhabited]
      // suppose, for contradiction, there is NO least element.
      @given-no-least |
        assume not (exists least: Int; nonneg(least) and prop(least) and (forall m: Int; nonneg(m) -> prop(m) -> less_or_equal(least, m))) {
          @no-least |
            not (exists least: Int; nonneg(least) and prop(least) and (forall m: Int; nonneg(m) -> prop(m) -> less_or_equal(least, m)))
            [by hypothesis given-no-least]
          // strong step: (forall nonneg m < n; not prop(m)) -> not prop(n), for nonneg n.
          @strong-step |
            fix n: Int {
              @given-n-nonneg |
                assume nonneg(n) {
                  @n-nonneg |
                    nonneg(n)
                    [by hypothesis given-n-nonneg]
                  @given-all-less_than-fail |
                    assume forall m: Int; nonneg(m) -> less_than(m, n) -> (not prop(m)) {
                      @all-less_than-fail |
                        forall m: Int; nonneg(m) -> less_than(m, n) -> (not prop(m))
                        [by hypothesis given-all-less_than-fail]
                      @given-n-satisfies |
                        assume prop(n) {
                          @n-satisfies |
                            prop(n)
                            [by hypothesis given-n-satisfies]
                          // n is a lower bound for prop on ℕ: for nonneg m with prop(m), n ≤ m.
                          @n-is-lower-bound |
                            fix m: Int {
                              @given-m-nonneg |
                                assume nonneg(m) {
                                  @m-nonneg |
                                    nonneg(m)
                                    [by hypothesis given-m-nonneg]
                                  @given-m-satisfies |
                                    assume prop(m) {
                                      @m-satisfies |
                                        prop(m)
                                        [by hypothesis given-m-satisfies]
                                      @trichotomy-n-m |
                                        forall a, b: Int; less_than(a, b) or a = b or less_than(b, a)
                                        [by theorem trichotomy]
                                      @order-n-m |
                                        less_than(n, m) or n = m or less_than(m, n)
                                        [by forall_elim(n, m) trichotomy-n-m]
                                      @less-than-to-le |
                                        forall a, b: Int; less_than(a, b) -> less_or_equal(a, b)
                                        [by theorem lessThanToLessOrEqual]
                                      @less-or-equal-refl |
                                        forall a: Int; less_or_equal(a, a)
                                        [by theorem lessOrEqualRefl]
                                      @n-le-m-in-all-cases |
                                        less_or_equal(n, m)
                                        case on order-n-m {
                                          @when-n-less_than-m |
                                            assume less_than(n, m) {
                                              @n-less_than-m |
                                                less_than(n, m)
                                                [by hypothesis when-n-less_than-m]
                                              @n-le-m-if-less_than |
                                                less_than(n, m) -> less_or_equal(n, m)
                                                [by forall_elim(n, m) less-than-to-le]
                                              @conclusion-n-le-m |
                                                less_or_equal(n, m)
                                                [by modus_ponens n-le-m-if-less_than n-less_than-m]
                                            }
                                          @when-n-equals-m |
                                            assume n = m {
                                              @n-equals-m |
                                                n = m
                                                [by hypothesis when-n-equals-m]
                                              @n-le-n |
                                                less_or_equal(n, n)
                                                [by forall_elim(n) less-or-equal-refl]
                                              @conclusion-n-le-m |
                                                less_or_equal(n, m)
                                                [by rewrite n-equals-m n-le-n]
                                            }
                                          @when-m-less_than-n |
                                            assume less_than(m, n) {
                                              @m-less_than-n |
                                                less_than(m, n)
                                                [by hypothesis when-m-less_than-n]
                                              @m-fails-if-nonneg-less_than-n |
                                                nonneg(m) -> less_than(m, n) -> (not prop(m))
                                                [by forall_elim(m) all-less_than-fail]
                                              @m-fails |
                                                not prop(m)
                                                [by tautology m-fails-if-nonneg-less_than-n m-nonneg m-less_than-n]
                                              @conclusion-n-le-m |
                                                less_or_equal(n, m)
                                                [by absurd m-satisfies m-fails]
                                            }
                                        }
                                    }
                                  @m-satisfies-implies-n-le-m |
                                    prop(m) -> less_or_equal(n, m)
                                    [by implies_intro given-m-satisfies]
                                }
                              @m-nonneg-implies-bound |
                                nonneg(m) -> prop(m) -> less_or_equal(n, m)
                                [by implies_intro given-m-nonneg]
                            }
                          @n-is-lower-bound-forall |
                            forall m: Int; nonneg(m) -> prop(m) -> less_or_equal(n, m)
                            [by forall_intro n-is-lower-bound]
                          @n-nonneg-and-satisfies |
                            nonneg(n) and prop(n)
                            [by and_intro n-nonneg n-satisfies]
                          @n-is-least |
                            nonneg(n) and prop(n) and (forall m: Int; nonneg(m) -> prop(m) -> less_or_equal(n, m))
                            [by and_intro n-nonneg-and-satisfies n-is-lower-bound-forall]
                          @least-exists |
                            exists least: Int; nonneg(least) and prop(least) and (forall m: Int; nonneg(m) -> prop(m) -> less_or_equal(least, m))
                            [by exists_intro(n) n-is-least]
                          @contradiction-from-n |
                            not prop(n)
                            [by absurd least-exists no-least]
                        }
                      // discharge: prop(n) leads to a least element, contradicting
                      // no-least; so not prop(n).
                      @n-satisfies-implies-not-prop |
                        prop(n) -> (not prop(n))
                        [by implies_intro given-n-satisfies]
                      @not-prop-n |
                        not prop(n)
                        [by tautology n-satisfies-implies-not-prop]
                    }
                  @all-less_than-fail-implies-n-fails |
                    (forall m: Int; nonneg(m) -> less_than(m, n) -> (not prop(m))) -> (not prop(n))
                    [by implies_intro given-all-less_than-fail]
                }
              @strong-step-at-n |
                nonneg(n) -> (forall m: Int; nonneg(m) -> less_than(m, n) -> (not prop(m))) -> (not prop(n))
                [by implies_intro given-n-nonneg]
            }
          @strong-step-forall |
            forall n: Int; nonneg(n) -> (forall m: Int; nonneg(m) -> less_than(m, n) -> (not prop(m))) -> (not prop(n))
            [by forall_intro strong-step]
          @nothing-nonneg-satisfies |
            forall n: Int; nonneg(n) -> (not prop(n))
            [by instantiate nonnegStrongInduction((fun k: Int => not prop(k))) strong-step-forall]
          // but some nonneg element DOES satisfy prop — contradiction.
          @with-witness-n |
            unpack w0: Int from some-nonneg-element-satisfies {
              @witness-nonneg-and-satisfies |
                nonneg(w0) and prop(w0)
                [by hypothesis with-witness-n]
              @witness-nonneg |
                nonneg(w0)
                [by and_elim_left witness-nonneg-and-satisfies]
              @witness-satisfies |
                prop(w0)
                [by and_elim_right witness-nonneg-and-satisfies]
              @witness-fails-if-nonneg |
                nonneg(w0) -> (not prop(w0))
                [by forall_elim(w0) nothing-nonneg-satisfies]
              @witness-fails |
                not prop(w0)
                [by modus_ponens witness-fails-if-nonneg witness-nonneg]
              @contradiction |
                exists least: Int; nonneg(least) and prop(least) and (forall m: Int; nonneg(m) -> prop(m) -> less_or_equal(least, m))
                [by absurd witness-satisfies witness-fails]
            }
          @least-exists-from-witness |
            exists least: Int; nonneg(least) and prop(least) and (forall m: Int; nonneg(m) -> prop(m) -> less_or_equal(least, m))
            [by exists_elim with-witness-n]
        }
      @least-exists-double-negated |
        not not (exists least: Int; nonneg(least) and prop(least) and (forall m: Int; nonneg(m) -> prop(m) -> less_or_equal(least, m)))
        [by not_intro given-no-least least-exists-from-witness no-least]
      @least-exists-by-contradiction |
        exists least: Int; nonneg(least) and prop(least) and (forall m: Int; nonneg(m) -> prop(m) -> less_or_equal(least, m))
        [by double_negation least-exists-double-negated]
    }
  @conclusion |
    (exists n: Int; nonneg(n) and prop(n))
      -> exists least: Int; nonneg(least) and prop(least) and (forall m: Int; nonneg(m) -> prop(m) -> less_or_equal(least, m))
    [by implies_intro given-inhabited]
qed
