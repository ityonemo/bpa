// std/integer.bpa — the integers ℤ, axiomatized in the style of std/peano.bpa
// but with a PREDECESSOR: every integer has both a successor and a predecessor,
// which is what distinguishes ℤ from ℕ. This is the number domain the ℤ number
// theory rests on — Bézout's `gcd(a,b) = ar + bs` genuinely needs negatives.
//
// This is a STANDALONE axiomatic theory (a fresh sort `Int`, not built from
// Peano ℕ): ZERO/ONE, succ/prev (mutual inverses), add/mul/neg, the LEFT
// recursion axioms, and a BIDIRECTIONAL induction schema (reach every integer from 0 by
// succ and pred). The ring algebra (commutativity, associativity, the additive
// inverse law `n + (-n) = 0`, ...) is PROVEN from these, not assumed — as with
// Peano, prefer raw induction for the core lemmas.

// -- signature --------------------------------------------------------------

sort Int
const ZERO: Int
const ONE: Int
func succ(n: Int): Int
func prev(n: Int): Int
func add(a: Int, b: Int): Int
func mul(a: Int, b: Int): Int
func neg(a: Int): Int

// -- successor / predecessor structure --------------------------------------

// succ and prev are mutual inverses — the defining property of ℤ over ℕ.
axiom prevSucc: forall n: Int; prev(succ(n)) = n
axiom succPrev: forall n: Int; succ(prev(n)) = n

// ONE is the successor of ZERO.
axiom oneIsSuccZero: ONE = succ(ZERO)

// -- addition (by recursion on the LEFT, in both directions) ----------------
// Left-axiomatic (see CONVENTIONS.md), matching std/peano.bpa: ZERO/succ/prev on
// the FIRST argument are primitive; the right-recursion mirror equations
// (addZeroRight, addSuccRight, addPrevRight) are theorems in std/integer-ring.bpa.

axiom addZeroLeft: forall b: Int; add(ZERO, b) = b
axiom addSuccLeft: forall a, b: Int; add(succ(a), b) = succ(add(a, b))
axiom addPrevLeft: forall a, b: Int; add(prev(a), b) = prev(add(a, b))

// -- negation ---------------------------------------------------------------

axiom negZero: neg(ZERO) = ZERO
axiom negSucc: forall n: Int; neg(succ(n)) = prev(neg(n))
axiom negPrev: forall n: Int; neg(prev(n)) = succ(neg(n))

// -- multiplication (by recursion on the LEFT, in both directions) ----------
// As with addition: recursion on the FIRST argument is primitive; the extra
// summand is the SECOND factor (b / neg(b)). The right-recursion mirrors
// (mulZeroRight, mulSuccRight, mulPrevRight) are theorems in std/integer-ring.bpa.

axiom mulZeroLeft: forall b: Int; mul(ZERO, b) = ZERO
axiom mulSuccLeft: forall a, b: Int; mul(succ(a), b) = add(mul(a, b), b)
axiom mulPrevLeft: forall a, b: Int; mul(prev(a), b) = add(mul(a, b), neg(b))

// -- induction (bidirectional) ----------------------------------------------

// Every integer is reachable from 0 by succ and prev, so a property holding at
// 0 and closed under BOTH succ and prev holds everywhere. (An axiom family,
// parameterized by the property; checked per instantiation.)
axiom induction(prop: Int -> Prop):
  prop(ZERO)
  -> (forall k: Int; prop(k) -> prop(succ(k)))
  -> (forall k: Int; prop(k) -> prop(prev(k)))
  -> forall n: Int; prop(n)
