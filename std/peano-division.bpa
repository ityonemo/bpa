// std/peano-division.bpa — divisibility, and guarded Euclidean div/mod.
//
// `divides(d, n)` is "d divides n" (n = d*k for some k), with the standard
// toolkit (reflexivity, transitivity, divides-a-sum, divides-a-difference,
// divides-a-multiple). `div`/`mod` are guarded functions (a nonzero divisor
// is a proof obligation) characterized by the Euclidean property; the
// bridging `dividesModStep` — a common divisor of b is a common divisor of a
// iff it divides a mod b — is the heart of gcd-preserves-common-divisors.
//
// `divides` and its lemmas are PURE. div/mod are axiomatized definitionally
// (like peano's own recursion axioms); their guards use the requires/TCC
// mechanism.

import peano <<< "std/peano.bpa"
import ordering <<< "std/peano-ordering.bpa"
import subtraction <<< "std/peano-subtraction.bpa"

// -- vocabulary -------------------------------------------------------------

sort Nat = peano.Nat
const ZERO = peano.ZERO
const ONE = peano.ONE
func succ = peano.succ
func add = peano.add
func mul = peano.mul
func sub = subtraction.sub
pred less_than = ordering.less_than
theorem mulOneRight = peano.mulOneRight
theorem mulZeroRight = peano.mulZeroRight
theorem mulIsAssociative = peano.mulIsAssociative
theorem mulAddDistribLeft = peano.mulAddDistribLeft
theorem subAddCancel = subtraction.subAddCancel
theorem mulSubDistribLeft = subtraction.mulSubDistribLeft
theorem mulSuccRight = peano.mulSuccRight
theorem addIsAssociative = peano.addIsAssociative
theorem addZeroRight = peano.addZeroRight
theorem addIsCommutative = peano.addIsCommutative
theorem addCancelLeft = peano.addCancelLeft
theorem trichotomy = ordering.trichotomy
theorem lessThanAddCancelLeft = ordering.lessThanAddCancelLeft
theorem notLessThanZero = ordering.notLessThanZero

// -- divisibility -----------------------------------------------------------

// divides(d, n) iff n = d * k for some k.
pred divides(d: Nat, n: Nat)
axiom dividesIntro: forall d, n, k: Nat; n = mul(d, k) -> divides(d, n)
axiom dividesElim: forall d, n: Nat; divides(d, n) -> exists k: Nat; n = mul(d, k)

// -- guarded Euclidean division ---------------------------------------------

func div(a: Nat, b: Nat): Nat requires b != ZERO
func mod(a: Nat, b: Nat): Nat requires b != ZERO
axiom divModProperty: forall a, b: Nat; b != ZERO -> add(mul(b, div(a, b)), mod(a, b)) = a
axiom modBound: forall a, b: Nat; b != ZERO -> less_than(mod(a, b), b)

// -- forwarded theorems -----------------------------------------------------

forward dividesRefl
forward dividesZero
forward dividesTransitive
forward dividesAdd
forward dividesSub
forward dividesMul
forward dividesModStep
forward quotientCannotBeLess
forward quotientUnique
forward modIntro

// -- theorems ---------------------------------------------------------------

// divides(d, d): witness k = ONE.
theorem dividesRefl: forall d: Nat; divides(d, d)
proof
  @generalize-d |
    fix d: Nat {
      @mul-by-one-is-identity-general |
        forall n: Nat; mul(n, ONE) = n
        [by theorem mulOneRight]
      @mul-by-one-is-identity |
        mul(d, ONE) = d
        [by forall_elim(d) mul-by-one-is-identity-general]
      @d-is-d-times-one |
        d = mul(d, ONE)
        [by symmetry mul-by-one-is-identity]
      @a-multiple-divides |
        forall dd, n, k: Nat; n = mul(dd, k) -> divides(dd, n)
        [by axiom dividesIntro]
      @d-times-one-witnesses-self-division |
        d = mul(d, ONE) -> divides(d, d)
        [by forall_elim(d, d, ONE) a-multiple-divides]
      @d-divides-itself |
        divides(d, d)
        [by modus_ponens d-times-one-witnesses-self-division d-is-d-times-one]
    }
  @conclusion |
    forall d: Nat; divides(d, d)
    [by forall_intro generalize-d]
qed

// divides(d, ZERO): witness k = ZERO.
theorem dividesZero: forall d: Nat; divides(d, ZERO)
proof
  @generalize-d |
    fix d: Nat {
      @d-times-zero-is-zero-general |
        forall n: Nat; mul(n, ZERO) = ZERO
        [by theorem mulZeroRight]
      @d-times-zero-is-zero |
        mul(d, ZERO) = ZERO
        [by forall_elim(d) d-times-zero-is-zero-general]
      @zero-is-d-times-zero |
        ZERO = mul(d, ZERO)
        [by symmetry d-times-zero-is-zero]
      @a-multiple-divides |
        forall dd, n, k: Nat; n = mul(dd, k) -> divides(dd, n)
        [by axiom dividesIntro]
      @zero-witnesses-d-divides-zero |
        ZERO = mul(d, ZERO) -> divides(d, ZERO)
        [by forall_elim(d, ZERO, ZERO) a-multiple-divides]
      @d-divides-zero |
        divides(d, ZERO)
        [by modus_ponens zero-witnesses-d-divides-zero zero-is-d-times-zero]
    }
  @conclusion |
    forall d: Nat; divides(d, ZERO)
    [by forall_intro generalize-d]
qed

// divides(a,b) -> divides(b,c) -> divides(a,c): b = a*j, c = b*k => c = a*(j*k).
theorem dividesTransitive: forall c, b, a: Nat; divides(a, b) -> divides(b, c) -> divides(a, c)
proof
  @generalize-c |
    fix c: Nat {
      @generalize-b |
        fix b: Nat {
          @generalize-a |
            fix a: Nat {
              @given-a-divides-b |
                assume divides(a, b) {
                  @given-b-divides-c |
                    assume divides(b, c) {
                      @a-divides-b |
                        divides(a, b)
                        [by hypothesis given-a-divides-b]
                      @b-divides-c |
                        divides(b, c)
                        [by hypothesis given-b-divides-c]
                      @a-divisor-yields-witness |
                        forall dd, n: Nat; divides(dd, n) -> exists k: Nat; n = mul(dd, k)
                        [by axiom dividesElim]
                      @b-is-a-multiple-if-a-divides |
                        divides(a, b) -> exists k: Nat; b = mul(a, k)
                        [by forall_elim(a, b) a-divisor-yields-witness]
                      @b-is-a-multiple |
                        exists k: Nat; b = mul(a, k)
                        [by modus_ponens b-is-a-multiple-if-a-divides a-divides-b]
                      @c-is-b-multiple-if-b-divides |
                        divides(b, c) -> exists k: Nat; c = mul(b, k)
                        [by forall_elim(b, c) a-divisor-yields-witness]
                      @c-is-b-multiple |
                        exists k: Nat; c = mul(b, k)
                        [by modus_ponens c-is-b-multiple-if-b-divides b-divides-c]
                      @with-b-quotient-j |
                        unpack j: Nat from b-is-a-multiple {
                          @b-equals-a-times-j |
                            b = mul(a, j)
                            [by hypothesis with-b-quotient-j]
                          @with-c-quotient-k |
                            unpack kk: Nat from c-is-b-multiple {
                              @c-equals-b-times-k |
                                c = mul(b, kk)
                                [by hypothesis with-c-quotient-k]
                              @c-as-nested-product |
                                c = mul(mul(a, j), kk)
                                [by rewrite b-equals-a-times-j c-equals-b-times-k]
                              @product-reassociates |
                                mul(mul(a, j), kk) = mul(a, mul(j, kk))
                                [by simplify mulIsAssociative]
                              @c-is-a-times-jk |
                                c = mul(a, mul(j, kk))
                                [by rewrite product-reassociates c-as-nested-product]
                              @a-multiple-divides |
                                forall dd, n, k: Nat; n = mul(dd, k) -> divides(dd, n)
                                [by axiom dividesIntro]
                              @jk-witnesses-a-divides-c |
                                c = mul(a, mul(j, kk)) -> divides(a, c)
                                [by forall_elim(a, c, mul(j, kk)) a-multiple-divides]
                              @a-divides-c-under-witnesses |
                                divides(a, c)
                                [by modus_ponens jk-witnesses-a-divides-c c-is-a-times-jk]
                            }
                          @a-divides-c-after-k |
                            divides(a, c)
                            [by exists_elim with-c-quotient-k]
                        }
                      @a-divides-c |
                        divides(a, c)
                        [by exists_elim with-b-quotient-j]
                    }
                  @b-divides-c-implies-a-divides-c |
                    divides(b, c) -> divides(a, c)
                    [by implies_intro given-b-divides-c]
                }
              @a-divides-b-implies-transitive |
                divides(a, b) -> divides(b, c) -> divides(a, c)
                [by implies_intro given-a-divides-b]
            }
          @discharge-a |
            forall a: Nat; divides(a, b) -> divides(b, c) -> divides(a, c)
            [by forall_intro generalize-a]
        }
      @discharge-b |
        forall b, a: Nat; divides(a, b) -> divides(b, c) -> divides(a, c)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall c, b, a: Nat; divides(a, b) -> divides(b, c) -> divides(a, c)
    [by forall_intro generalize-c]
qed

// divides(d,a) -> divides(d,b) -> divides(d, add(a,b)): a=d*j, b=d*k => a+b=d*(j+k).
theorem dividesAdd: forall d, a, b: Nat; divides(d, a) -> divides(d, b) -> divides(d, add(a, b))
proof
  @generalize-d |
    fix d: Nat {
      @generalize-a |
        fix a: Nat {
          @generalize-b |
            fix b: Nat {
              @given-d-divides-a |
                assume divides(d, a) {
                  @given-d-divides-b |
                    assume divides(d, b) {
                      @d-divides-a |
                        divides(d, a)
                        [by hypothesis given-d-divides-a]
                      @d-divides-b |
                        divides(d, b)
                        [by hypothesis given-d-divides-b]
                      @a-divisor-yields-witness |
                        forall dd, n: Nat; divides(dd, n) -> exists k: Nat; n = mul(dd, k)
                        [by axiom dividesElim]
                      @a-is-d-multiple-if-d-divides |
                        divides(d, a) -> exists k: Nat; a = mul(d, k)
                        [by forall_elim(d, a) a-divisor-yields-witness]
                      @a-is-d-multiple |
                        exists k: Nat; a = mul(d, k)
                        [by modus_ponens a-is-d-multiple-if-d-divides d-divides-a]
                      @b-is-d-multiple-if-d-divides |
                        divides(d, b) -> exists k: Nat; b = mul(d, k)
                        [by forall_elim(d, b) a-divisor-yields-witness]
                      @b-is-d-multiple |
                        exists k: Nat; b = mul(d, k)
                        [by modus_ponens b-is-d-multiple-if-d-divides d-divides-b]
                      @with-a-quotient-j |
                        unpack j: Nat from a-is-d-multiple {
                          @a-equals-d-times-j |
                            a = mul(d, j)
                            [by hypothesis with-a-quotient-j]
                          @with-b-quotient-k |
                            unpack kk: Nat from b-is-d-multiple {
                              @b-equals-d-times-k |
                                b = mul(d, kk)
                                [by hypothesis with-b-quotient-k]
                              @sum-of-multiples-distributes |
                                mul(d, add(j, kk)) = add(mul(d, j), mul(d, kk))
                                [by simplify mulAddDistribLeft]
                              @d-times-sum-collects-products |
                                add(mul(d, j), mul(d, kk)) = mul(d, add(j, kk))
                                [by symmetry sum-of-multiples-distributes]
                              @d-times-j-is-a |
                                mul(d, j) = a
                                [by symmetry a-equals-d-times-j]
                              @d-times-k-is-b |
                                mul(d, kk) = b
                                [by symmetry b-equals-d-times-k]
                              @a-plus-d-multiple-is-d-multiple |
                                add(a, mul(d, kk)) = mul(d, add(j, kk))
                                [by rewrite d-times-j-is-a d-times-sum-collects-products]
                              @sum-is-d-multiple |
                                add(a, b) = mul(d, add(j, kk))
                                [by rewrite d-times-k-is-b a-plus-d-multiple-is-d-multiple]
                              @a-multiple-divides |
                                forall dd, n, k: Nat; n = mul(dd, k) -> divides(dd, n)
                                [by axiom dividesIntro]
                              @sum-witness-yields-d-divides-sum |
                                add(a, b) = mul(d, add(j, kk)) -> divides(d, add(a, b))
                                [by forall_elim(d, add(a, b), add(j, kk)) a-multiple-divides]
                              @d-divides-sum-under-witness |
                                divides(d, add(a, b))
                                [by modus_ponens sum-witness-yields-d-divides-sum sum-is-d-multiple]
                            }
                          @d-divides-sum-after-k |
                            divides(d, add(a, b))
                            [by exists_elim with-b-quotient-k]
                        }
                      @d-divides-sum |
                        divides(d, add(a, b))
                        [by exists_elim with-a-quotient-j]
                    }
                  @d-divides-b-implies-d-divides-sum |
                    divides(d, b) -> divides(d, add(a, b))
                    [by implies_intro given-d-divides-b]
                }
              @common-divisor-divides-sum |
                divides(d, a) -> divides(d, b) -> divides(d, add(a, b))
                [by implies_intro given-d-divides-a]
            }
          @discharge-b |
            forall b: Nat; divides(d, a) -> divides(d, b) -> divides(d, add(a, b))
            [by forall_intro generalize-b]
        }
      @discharge-a |
        forall a, b: Nat; divides(d, a) -> divides(d, b) -> divides(d, add(a, b))
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall d, a, b: Nat; divides(d, a) -> divides(d, b) -> divides(d, add(a, b))
    [by forall_intro generalize-d]
qed

// divides(d,a) -> divides(d,b) -> divides(d, sub(a,b)): via mulSubDistribLeft.
theorem dividesSub: forall d, a, b: Nat; divides(d, a) -> divides(d, b) -> divides(d, sub(a, b))
proof
  @generalize-d |
    fix d: Nat {
      @generalize-a |
        fix a: Nat {
          @generalize-b |
            fix b: Nat {
              @given-d-divides-a |
                assume divides(d, a) {
                  @given-d-divides-b |
                    assume divides(d, b) {
                      @d-divides-a |
                        divides(d, a)
                        [by hypothesis given-d-divides-a]
                      @d-divides-b |
                        divides(d, b)
                        [by hypothesis given-d-divides-b]
                      @a-divisor-yields-witness |
                        forall dd, n: Nat; divides(dd, n) -> exists k: Nat; n = mul(dd, k)
                        [by axiom dividesElim]
                      @a-is-d-multiple-if-d-divides |
                        divides(d, a) -> exists k: Nat; a = mul(d, k)
                        [by forall_elim(d, a) a-divisor-yields-witness]
                      @a-is-d-multiple |
                        exists k: Nat; a = mul(d, k)
                        [by modus_ponens a-is-d-multiple-if-d-divides d-divides-a]
                      @b-is-d-multiple-if-d-divides |
                        divides(d, b) -> exists k: Nat; b = mul(d, k)
                        [by forall_elim(d, b) a-divisor-yields-witness]
                      @b-is-d-multiple |
                        exists k: Nat; b = mul(d, k)
                        [by modus_ponens b-is-d-multiple-if-d-divides d-divides-b]
                      @with-a-quotient-j |
                        unpack j: Nat from a-is-d-multiple {
                          @a-equals-d-times-j |
                            a = mul(d, j)
                            [by hypothesis with-a-quotient-j]
                          @with-b-quotient-k |
                            unpack kk: Nat from b-is-d-multiple {
                              @b-equals-d-times-k |
                                b = mul(d, kk)
                                [by hypothesis with-b-quotient-k]
                              @multiple-of-difference-distributes |
                                forall bb, aa, dd: Nat; mul(dd, sub(aa, bb)) = sub(mul(dd, aa), mul(dd, bb))
                                [by theorem mulSubDistribLeft]
                              @d-times-difference-splits |
                                mul(d, sub(j, kk)) = sub(mul(d, j), mul(d, kk))
                                [by forall_elim(kk, j, d) multiple-of-difference-distributes]
                              @difference-is-itself |
                                sub(a, b) = sub(a, b)
                                [by reflexivity]
                              @difference-with-d-multiple-numerator |
                                sub(mul(d, j), b) = sub(a, b)
                                [by rewrite a-equals-d-times-j difference-is-itself]
                              @difference-of-multiples-is-a-minus-b |
                                sub(mul(d, j), mul(d, kk)) = sub(a, b)
                                [by rewrite b-equals-d-times-k difference-with-d-multiple-numerator]
                              @a-minus-b-is-difference-of-multiples |
                                sub(a, b) = sub(mul(d, j), mul(d, kk))
                                [by symmetry difference-of-multiples-is-a-minus-b]
                              @difference-of-multiples-is-d-multiple |
                                sub(mul(d, j), mul(d, kk)) = mul(d, sub(j, kk))
                                [by symmetry d-times-difference-splits]
                              @difference-is-d-multiple |
                                sub(a, b) = mul(d, sub(j, kk))
                                [by rewrite difference-of-multiples-is-d-multiple a-minus-b-is-difference-of-multiples]
                              @a-multiple-divides |
                                forall dd, n, k: Nat; n = mul(dd, k) -> divides(dd, n)
                                [by axiom dividesIntro]
                              @difference-witness-yields-d-divides |
                                sub(a, b) = mul(d, sub(j, kk)) -> divides(d, sub(a, b))
                                [by forall_elim(d, sub(a, b), sub(j, kk)) a-multiple-divides]
                              @d-divides-difference-under-witness |
                                divides(d, sub(a, b))
                                [by modus_ponens difference-witness-yields-d-divides difference-is-d-multiple]
                            }
                          @d-divides-difference-after-k |
                            divides(d, sub(a, b))
                            [by exists_elim with-b-quotient-k]
                        }
                      @d-divides-difference |
                        divides(d, sub(a, b))
                        [by exists_elim with-a-quotient-j]
                    }
                  @d-divides-b-implies-d-divides-difference |
                    divides(d, b) -> divides(d, sub(a, b))
                    [by implies_intro given-d-divides-b]
                }
              @common-divisor-divides-difference |
                divides(d, a) -> divides(d, b) -> divides(d, sub(a, b))
                [by implies_intro given-d-divides-a]
            }
          @discharge-b |
            forall b: Nat; divides(d, a) -> divides(d, b) -> divides(d, sub(a, b))
            [by forall_intro generalize-b]
        }
      @discharge-a |
        forall a, b: Nat; divides(d, a) -> divides(d, b) -> divides(d, sub(a, b))
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall d, a, b: Nat; divides(d, a) -> divides(d, b) -> divides(d, sub(a, b))
    [by forall_intro generalize-d]
qed

// divides(d, a) -> divides(d, mul(a, k)): a = d*j => a*k = d*(j*k).
theorem dividesMul: forall k, a, d: Nat; divides(d, a) -> divides(d, mul(a, k))
proof
  @generalize-k |
    fix k: Nat {
      @generalize-a |
        fix a: Nat {
          @generalize-d |
            fix d: Nat {
              @given-d-divides-a |
                assume divides(d, a) {
                  @d-divides-a |
                    divides(d, a)
                    [by hypothesis given-d-divides-a]
                  @a-divisor-yields-witness |
                    forall dd, n: Nat; divides(dd, n) -> exists kk: Nat; n = mul(dd, kk)
                    [by axiom dividesElim]
                  @a-is-d-multiple-if-d-divides |
                    divides(d, a) -> exists kk: Nat; a = mul(d, kk)
                    [by forall_elim(d, a) a-divisor-yields-witness]
                  @a-is-d-multiple |
                    exists kk: Nat; a = mul(d, kk)
                    [by modus_ponens a-is-d-multiple-if-d-divides d-divides-a]
                  @with-a-quotient-j |
                    unpack j: Nat from a-is-d-multiple {
                      @a-equals-d-times-j |
                        a = mul(d, j)
                        [by hypothesis with-a-quotient-j]
                      @scaled-product-is-itself |
                        mul(a, k) = mul(a, k)
                        [by reflexivity]
                      @scaled-product-over-d-multiple |
                        mul(mul(d, j), k) = mul(a, k)
                        [by rewrite a-equals-d-times-j scaled-product-is-itself]
                      @scaled-product-reassociates |
                        mul(mul(d, j), k) = mul(d, mul(j, k))
                        [by simplify mulIsAssociative]
                      @scaled-product-as-nested |
                        mul(a, k) = mul(mul(d, j), k)
                        [by symmetry scaled-product-over-d-multiple]
                      @scaled-product-is-d-multiple |
                        mul(a, k) = mul(d, mul(j, k))
                        [by rewrite scaled-product-reassociates scaled-product-as-nested]
                      @a-multiple-divides |
                        forall dd, n, kk: Nat; n = mul(dd, kk) -> divides(dd, n)
                        [by axiom dividesIntro]
                      @scaled-witness-yields-d-divides |
                        mul(a, k) = mul(d, mul(j, k)) -> divides(d, mul(a, k))
                        [by forall_elim(d, mul(a, k), mul(j, k)) a-multiple-divides]
                      @d-divides-scaled-under-witness |
                        divides(d, mul(a, k))
                        [by modus_ponens scaled-witness-yields-d-divides scaled-product-is-d-multiple]
                    }
                  @d-divides-scaled |
                    divides(d, mul(a, k))
                    [by exists_elim with-a-quotient-j]
                }
              @d-divides-a-implies-d-divides-scaled |
                divides(d, a) -> divides(d, mul(a, k))
                [by implies_intro given-d-divides-a]
            }
          @discharge-d |
            forall d: Nat; divides(d, a) -> divides(d, mul(a, k))
            [by forall_intro generalize-d]
        }
      @discharge-a |
        forall a, d: Nat; divides(d, a) -> divides(d, mul(a, k))
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall k, a, d: Nat; divides(d, a) -> divides(d, mul(a, k))
    [by forall_intro generalize-k]
qed

// THE gcd BRIDGE: for b != ZERO with d | b, d | a  iff  d | mod(a, b).
// Writing q = div(a,b), r = mod(a,b): divModProperty gives mul(b,q) + r = a,
// so r = sub(a, mul(b,q)) [subAddCancel] and a = add(mul(b,q), r).
// d | b -> d | mul(b, q) [dividesMul].  Forward: d|a and d|mul(b,q) -> d|r
// [dividesSub on r = a - mul(b,q)].  Backward: d|mul(b,q) and d|r -> d|a
// [dividesAdd on a = mul(b,q) + r].
theorem dividesModStep: forall d, a, b: Nat; b != ZERO -> divides(d, b) ->
  ((divides(d, a) -> divides(d, mod(a, b))) and (divides(d, mod(a, b)) -> divides(d, a)))
proof
  @generalize-d |
    fix d: Nat {
      @generalize-a |
        fix a: Nat {
          @generalize-b |
            fix b: Nat {
              @given-b-nonzero |
                assume b != ZERO {
                  @given-d-divides-b |
                    assume divides(d, b) {
                      @b-nonzero |
                        b != ZERO
                        [by hypothesis given-b-nonzero]
                      @d-divides-b |
                        divides(d, b)
                        [by hypothesis given-d-divides-b]
            // mul(b, q) + r = a  where q = div(a,b), r = mod(a,b)
                      @quotient-remainder-decomposition |
                        forall aa, bb: Nat; bb != ZERO -> add(mul(bb, div(aa, bb)), mod(aa, bb)) = aa
                        [by axiom divModProperty]
                      @decomposition-holds-if-nonzero |
                        b != ZERO -> add(mul(b, div(a, b)), mod(a, b)) = a
                        [by forall_elim(a, b) quotient-remainder-decomposition]
                      @a-decomposes |
                        add(mul(b, div(a, b)), mod(a, b)) = a
                        [by modus_ponens decomposition-holds-if-nonzero b-nonzero]
            // d | mul(b, q)  [dividesMul: d|b -> d|mul(b, q)]
                      @divisor-divides-multiple |
                        forall kk, aa, dd: Nat; divides(dd, aa) -> divides(dd, mul(aa, kk))
                        [by theorem dividesMul]
                      @d-divides-b-times-quotient-if-divides-b |
                        divides(d, b) -> divides(d, mul(b, div(a, b)))
                        [by forall_elim(div(a, b), b, d) divisor-divides-multiple]
                      @d-divides-b-times-quotient |
                        divides(d, mul(b, div(a, b)))
                        [by modus_ponens d-divides-b-times-quotient-if-divides-b d-divides-b]
            // r = sub(a, mul(b, q)): commute divModProperty to add(r, mul(b,q)) = a
            // then subAddCancel gives sub(a, mul(b,q)) = r.
                      @add-is-commutative |
                        forall bb, aa: Nat; add(aa, bb) = add(bb, aa)
                        [by theorem peano.addIsCommutative]
                      @decomposition-commutes |
                        add(mul(b, div(a, b)), mod(a, b)) = add(mod(a, b), mul(b, div(a, b)))
                        [by forall_elim(mod(a, b), mul(b, div(a, b))) add-is-commutative]
                      @a-is-decomposition |
                        a = add(mul(b, div(a, b)), mod(a, b))
                        [by symmetry a-decomposes]
                      @a-is-remainder-plus-multiple |
                        a = add(mod(a, b), mul(b, div(a, b)))
                        [by rewrite decomposition-commutes a-is-decomposition]
            // sac: sub(add(r, x), x) = r  with x = mul(b,q)
                      @subtract-added-term-cancels |
                        forall bb, aa: Nat; sub(add(aa, bb), bb) = aa
                        [by theorem subAddCancel]
                      @remainder-recovered-by-subtraction |
                        sub(add(mod(a, b), mul(b, div(a, b))), mul(b, div(a, b))) = mod(a, b)
                        [by forall_elim(mul(b, div(a, b)), mod(a, b)) subtract-added-term-cancels]
            // rewrite add(r, x) -> a using a-is-remainder-plus-multiple (backwards)
                      @remainder-plus-multiple-is-a |
                        add(mod(a, b), mul(b, div(a, b))) = a
                        [by symmetry a-is-remainder-plus-multiple]
                      @remainder-is-a-minus-multiple |
                        sub(a, mul(b, div(a, b))) = mod(a, b)
                        [by rewrite remainder-plus-multiple-is-a remainder-recovered-by-subtraction]

            // FORWARD: d|a -> d|r.  d|a, d|mul(b,q) -> d|sub(a, mul(b,q)) = d|r.
                      @when-d-divides-a |
                        assume divides(d, a) {
                          @d-divides-a |
                            divides(d, a)
                            [by hypothesis when-d-divides-a]
                          @common-divisor-divides-difference |
                            forall dd, xa, xb: Nat; divides(dd, xa) -> divides(dd, xb) -> divides(dd, sub(xa, xb))
                            [by theorem dividesSub]
                          @d-divides-a-minus-multiple-under-both |
                            divides(d, a) -> divides(d, mul(b, div(a, b))) -> divides(d, sub(a, mul(b, div(a, b))))
                            [by forall_elim(d, a, mul(b, div(a, b))) common-divisor-divides-difference]
                          @d-divides-a-minus-multiple |
                            divides(d, sub(a, mul(b, div(a, b))))
                            [by tautology d-divides-a-minus-multiple-under-both d-divides-a d-divides-b-times-quotient]
                          @d-divides-remainder |
                            divides(d, mod(a, b))
                            [by rewrite remainder-is-a-minus-multiple d-divides-a-minus-multiple]
                        }
                      @dividing-a-implies-dividing-remainder |
                        divides(d, a) -> divides(d, mod(a, b))
                        [by implies_intro when-d-divides-a]

            // BACKWARD: d|r -> d|a.  d|mul(b,q), d|r -> d|add(mul(b,q), r) = d|a.
                      @when-d-divides-remainder |
                        assume divides(d, mod(a, b)) {
                          @d-divides-remainder |
                            divides(d, mod(a, b))
                            [by hypothesis when-d-divides-remainder]
                          @common-divisor-divides-sum |
                            forall dd, xa, xb: Nat; divides(dd, xa) -> divides(dd, xb) -> divides(dd, add(xa, xb))
                            [by theorem dividesAdd]
                          @d-divides-multiple-plus-remainder-under-both |
                            divides(d, mul(b, div(a, b))) -> divides(d, mod(a, b)) -> divides(d, add(mul(b, div(a, b)), mod(a, b)))
                            [by forall_elim(d, mul(b, div(a, b)), mod(a, b)) common-divisor-divides-sum]
                          @d-divides-multiple-plus-remainder |
                            divides(d, add(mul(b, div(a, b)), mod(a, b)))
                            [by tautology d-divides-multiple-plus-remainder-under-both d-divides-b-times-quotient d-divides-remainder]
                          @d-divides-a |
                            divides(d, a)
                            [by rewrite a-decomposes d-divides-multiple-plus-remainder]
                        }
                      @dividing-remainder-implies-dividing-a |
                        divides(d, mod(a, b)) -> divides(d, a)
                        [by implies_intro when-d-divides-remainder]

                      @divisibility-transfers-both-ways |
                        (divides(d, a) -> divides(d, mod(a, b))) and (divides(d, mod(a, b)) -> divides(d, a))
                        [by and_intro dividing-a-implies-dividing-remainder dividing-remainder-implies-dividing-a]
                    }
                  @dividing-b-implies-transfer |
                    divides(d, b) -> ((divides(d, a) -> divides(d, mod(a, b))) and (divides(d, mod(a, b)) -> divides(d, a)))
                    [by implies_intro given-d-divides-b]
                }
              @nonzero-implies-transfer |
                b != ZERO -> divides(d, b) -> ((divides(d, a) -> divides(d, mod(a, b))) and (divides(d, mod(a, b)) -> divides(d, a)))
                [by implies_intro given-b-nonzero]
            }
          @discharge-b |
            forall b: Nat; b != ZERO -> divides(d, b) -> ((divides(d, a) -> divides(d, mod(a, b))) and (divides(d, mod(a, b)) -> divides(d, a)))
            [by forall_intro generalize-b]
        }
      @discharge-a |
        forall a, b: Nat; b != ZERO -> divides(d, b) -> ((divides(d, a) -> divides(d, mod(a, b))) and (divides(d, mod(a, b)) -> divides(d, a)))
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall d, a, b: Nat; b != ZERO -> divides(d, b) -> ((divides(d, a) -> divides(d, mod(a, b))) and (divides(d, mod(a, b)) -> divides(d, a)))
    [by forall_intro generalize-d]
qed

// -- remainder uniqueness (modIntro) ----------------------------------------
//
// If you exhibit q, r with r < b and b*q + r = a, then mod(a, b) = r. The
// heart is quotientCannotBeLess: a strictly larger quotient overshoots the
// remainder bound. This turns each concrete mod fact into a one-line
// citation (see examples/euclid-compute.bpa).

theorem quotientCannotBeLess: forall b, q1, q2, r1, r2: Nat;
  b != ZERO -> less_than(r1, b) ->
  add(mul(b, q1), r1) = add(mul(b, q2), r2) ->
  (not less_than(q1, q2))
proof
  @generalize-b |
    fix b: Nat {
      @generalize-q1 |
        fix q1: Nat {
          @generalize-q2 |
            fix q2: Nat {
              @generalize-r1 |
                fix r1: Nat {
                  @generalize-r2 |
                    fix r2: Nat {
                      @given-b-nonzero |
                        assume b != ZERO {
                          @given-r1-below-b |
                            assume less_than(r1, b) {
                              @given-decompositions-equal |
                                assume add(mul(b, q1), r1) = add(mul(b, q2), r2) {
                                  @given-q1-below-q2 |
                                    assume less_than(q1, q2) {
                                      @decompositions-equal |
                                        add(mul(b, q1), r1) = add(mul(b, q2), r2)
                                        [by hypothesis given-decompositions-equal]
                                      @q1-below-q2 |
                                        less_than(q1, q2)
                                        [by hypothesis given-q1-below-q2]
                    // q1 < q2 -> exists k: add(q1, succ(k)) = q2
                                      @below-yields-gap |
                                        forall y, x: Nat; less_than(x, y) -> exists w: Nat; add(x, succ(w)) = y
                                        [by axiom ordering.lessThanElim]
                                      @q1-below-q2-yields-gap |
                                        less_than(q1, q2) -> exists w: Nat; add(q1, succ(w)) = q2
                                        [by forall_elim(q2, q1) below-yields-gap]
                                      @gap-exists |
                                        exists w: Nat; add(q1, succ(w)) = q2
                                        [by modus_ponens q1-below-q2-yields-gap q1-below-q2]
                                      @with-gap-k |
                                        unpack k: Nat from gap-exists {
                                          @q2-is-q1-plus-successor-gap |
                                            add(q1, succ(k)) = q2
                                            [by hypothesis with-gap-k]
                      // mul(b, q2) = mul(b, add(q1, succ(k)))
                      //            = add(mul(b, q1), mul(b, succ(k)))     [distrib left]
                      //            = add(mul(b, q1), add(mul(b, k), b))   [mulSuccRight]
                                          @q2-as-gap-sum |
                                            q2 = add(q1, succ(k))
                                            [by symmetry q2-is-q1-plus-successor-gap]
                                          @b-times-q2-is-itself |
                                            mul(b, q2) = mul(b, q2)
                                            [by reflexivity]
                                          @b-times-q2-over-gap-sum |
                                            mul(b, q2) = mul(b, add(q1, succ(k)))
                                            [by rewrite q2-as-gap-sum b-times-q2-is-itself]
                                          @multiple-of-sum-distributes |
                                            forall f, e, m: Nat; mul(m, add(e, f)) = add(mul(m, e), mul(m, f))
                                            [by theorem mulAddDistribLeft]
                                          @b-times-gap-sum-distributes |
                                            mul(b, add(q1, succ(k))) = add(mul(b, q1), mul(b, succ(k)))
                                            [by forall_elim(succ(k), q1, b) multiple-of-sum-distributes]
                                          @b-times-q2-is-split |
                                            mul(b, q2) = add(mul(b, q1), mul(b, succ(k)))
                                            [by rewrite b-times-gap-sum-distributes b-times-q2-over-gap-sum]
                      // mul(b, succ(k)) = add(mul(b, k), b)  [mulSuccRight]
                                          @multiple-of-successor-adds-base |
                                            forall e, m: Nat; mul(m, succ(e)) = add(mul(m, e), m)
                                            [by theorem mulSuccRight]
                                          @b-times-successor-gap-adds-b |
                                            mul(b, succ(k)) = add(mul(b, k), b)
                                            [by forall_elim(k, b) multiple-of-successor-adds-base]
                                          @b-times-q2-includes-a-full-b |
                                            mul(b, q2) = add(mul(b, q1), add(mul(b, k), b))
                                            [by rewrite b-times-successor-gap-adds-b b-times-q2-is-split]
                      // substitute into decompositions-equal
                                          @right-decomposition-is-itself |
                                            add(mul(b, q2), r2) = add(mul(b, q2), r2)
                                            [by reflexivity]
                                          @right-decomposition-expanded |
                                            add(mul(b, q2), r2) = add(add(mul(b, q1), add(mul(b, k), b)), r2)
                                            [by rewrite b-times-q2-includes-a-full-b right-decomposition-is-itself]
                                          @left-decomposition-expanded |
                                            add(mul(b, q1), r1) = add(add(mul(b, q1), add(mul(b, k), b)), r2)
                                            [by rewrite right-decomposition-expanded decompositions-equal]
                      // reassociate RHS: add(add(mul(b,q1), X), r2) = add(mul(b,q1), add(X, r2))
                                          @addition-reassociates |
                                            forall c, bb, aa: Nat; add(add(aa, bb), c) = add(aa, add(bb, c))
                                            [by theorem addIsAssociative]
                                          @right-side-reassociates |
                                            add(add(mul(b, q1), add(mul(b, k), b)), r2) = add(mul(b, q1), add(add(mul(b, k), b), r2))
                                            [by forall_elim(r2, add(mul(b, k), b), mul(b, q1)) addition-reassociates]
                                          @decomposition-over-common-prefix |
                                            add(mul(b, q1), r1) = add(mul(b, q1), add(add(mul(b, k), b), r2))
                                            [by rewrite right-side-reassociates left-decomposition-expanded]
                      // cancel mul(b, q1): r1 = add(add(mul(b,k), b), r2)
                                          @addition-cancels-on-left |
                                            forall c, aa, bb: Nat; add(c, aa) = add(c, bb) -> aa = bb
                                            [by theorem addCancelLeft]
                                          @cancel-common-prefix |
                                            add(mul(b, q1), r1) = add(mul(b, q1), add(add(mul(b, k), b), r2)) -> r1 = add(add(mul(b, k), b), r2)
                                            [by forall_elim(mul(b, q1), r1, add(add(mul(b, k), b), r2)) addition-cancels-on-left]
                                          @r1-contains-a-full-b |
                                            r1 = add(add(mul(b, k), b), r2)
                                            [by modus_ponens cancel-common-prefix decomposition-over-common-prefix]
                      // now r1 contains a full b as a summand; rearrange to the
                      // form add(b, Y) so the assumed less_than(r1, b) collapses.
                                          @addition-is-commutative |
                                            forall y, x: Nat; add(x, y) = add(y, x)
                                            [by theorem addIsCommutative]
                                          @base-moves-to-front |
                                            add(mul(b, k), b) = add(b, mul(b, k))
                                            [by forall_elim(b, mul(b, k)) addition-is-commutative]
                                          @r1-with-base-in-front |
                                            r1 = add(add(b, mul(b, k)), r2)
                                            [by rewrite base-moves-to-front r1-contains-a-full-b]
                                          @base-prefix-reassociates |
                                            add(add(b, mul(b, k)), r2) = add(b, add(mul(b, k), r2))
                                            [by forall_elim(r2, mul(b, k), b) addition-reassociates]
                                          @r1-is-b-plus-remainder |
                                            r1 = add(b, add(mul(b, k), r2))
                                            [by rewrite base-prefix-reassociates r1-with-base-in-front]
                      // less_than(r1, b) with r1 = add(b, Y): substitute, then cancel b.
                                          @r1-below-b-restated |
                                            less_than(r1, b)
                                            [by hypothesis given-r1-below-b]
                                          @b-plus-remainder-below-b |
                                            less_than(add(b, add(mul(b, k), r2)), b)
                                            [by rewrite r1-is-b-plus-remainder r1-below-b-restated]
                                          @adding-zero-is-identity |
                                            forall n: Nat; add(n, ZERO) = n
                                            [by theorem addZeroRight]
                                          @b-equals-b-plus-zero |
                                            add(b, ZERO) = b
                                            [by forall_elim(b) adding-zero-is-identity]
                                          @b-as-b-plus-zero |
                                            b = add(b, ZERO)
                                            [by symmetry b-equals-b-plus-zero]
                                          @b-plus-remainder-below-b-plus-zero |
                                            less_than(add(b, add(mul(b, k), r2)), add(b, ZERO))
                                            [by rewrite b-as-b-plus-zero b-plus-remainder-below-b]
                                          @common-prefix-cancels-order |
                                            forall c, aa, bb: Nat; less_than(add(c, aa), add(c, bb)) -> less_than(aa, bb)
                                            [by theorem lessThanAddCancelLeft]
                                          @remainder-below-zero-if-prefixed |
                                            less_than(add(b, add(mul(b, k), r2)), add(b, ZERO)) -> less_than(add(mul(b, k), r2), ZERO)
                                            [by forall_elim(b, add(mul(b, k), r2), ZERO) common-prefix-cancels-order]
                                          @remainder-below-zero |
                                            less_than(add(mul(b, k), r2), ZERO)
                                            [by modus_ponens remainder-below-zero-if-prefixed b-plus-remainder-below-b-plus-zero]
                                          @nothing-below-zero |
                                            forall a: Nat; not less_than(a, ZERO)
                                            [by theorem notLessThanZero]
                                          @remainder-not-below-zero |
                                            not less_than(add(mul(b, k), r2), ZERO)
                                            [by forall_elim(add(mul(b, k), r2)) nothing-below-zero]
                                          @q1-not-below-q2-under-gap |
                                            not less_than(q1, q2)
                                            [by absurd remainder-below-zero remainder-not-below-zero]
                                        }
                                      @q1-not-below-q2-discharged |
                                        not less_than(q1, q2)
                                        [by exists_elim with-gap-k]
                                      @q1-below-q2-restated |
                                        less_than(q1, q2)
                                        [by hypothesis given-q1-below-q2]
                                    }
                                  @q1-not-below-q2 |
                                    not less_than(q1, q2)
                                    [by not_intro given-q1-below-q2 q1-below-q2-restated q1-not-below-q2-discharged]
                                }
                              @equal-decompositions-force-not-below |
                                add(mul(b, q1), r1) = add(mul(b, q2), r2) -> (not less_than(q1, q2))
                                [by implies_intro given-decompositions-equal]
                            }
                          @bounded-remainder-forces-not-below |
                            less_than(r1, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> (not less_than(q1, q2))
                            [by implies_intro given-r1-below-b]
                        }
                      @nonzero-forces-not-below |
                        b != ZERO -> less_than(r1, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> (not less_than(q1, q2))
                        [by implies_intro given-b-nonzero]
                    }
                  @discharge-r2 |
                    forall r2: Nat; b != ZERO -> less_than(r1, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> (not less_than(q1, q2))
                    [by forall_intro generalize-r2]
                }
              @discharge-r1 |
                forall r1, r2: Nat; b != ZERO -> less_than(r1, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> (not less_than(q1, q2))
                [by forall_intro generalize-r1]
            }
          @discharge-q2 |
            forall q2, r1, r2: Nat; b != ZERO -> less_than(r1, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> (not less_than(q1, q2))
            [by forall_intro generalize-q2]
        }
      @discharge-q1 |
        forall q1, q2, r1, r2: Nat; b != ZERO -> less_than(r1, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> (not less_than(q1, q2))
        [by forall_intro generalize-q1]
    }
  @conclusion |
    forall b, q1, q2, r1, r2: Nat; b != ZERO -> less_than(r1, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> (not less_than(q1, q2))
    [by forall_intro generalize-b]
qed

// Symmetric contradiction packaged: with both r1<b and r2<b, neither quotient
// can be strictly less than the other -> quotients are equal.
theorem quotientUnique: forall b, q1, q2, r1, r2: Nat;
  b != ZERO -> less_than(r1, b) -> less_than(r2, b) ->
  add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
proof
  @generalize-b |
    fix b: Nat {
      @generalize-q1 |
        fix q1: Nat {
          @generalize-q2 |
            fix q2: Nat {
              @generalize-r1 |
                fix r1: Nat {
                  @generalize-r2 |
                    fix r2: Nat {
                      @given-b-nonzero |
                        assume b != ZERO {
                          @given-r1-below-b |
                            assume less_than(r1, b) {
                              @given-r2-below-b |
                                assume less_than(r2, b) {
                                  @given-decompositions-equal |
                                    assume add(mul(b, q1), r1) = add(mul(b, q2), r2) {
                                      @b-nonzero |
                                        b != ZERO
                                        [by hypothesis given-b-nonzero]
                                      @r1-below-b |
                                        less_than(r1, b)
                                        [by hypothesis given-r1-below-b]
                                      @r2-below-b |
                                        less_than(r2, b)
                                        [by hypothesis given-r2-below-b]
                                      @decompositions-equal |
                                        add(mul(b, q1), r1) = add(mul(b, q2), r2)
                                        [by hypothesis given-decompositions-equal]
                    // neither quotient can be strictly below the other
                                      @smaller-quotient-impossible |
                                        forall bb, p1, p2, s1, s2: Nat; bb != ZERO -> less_than(s1, bb) -> add(mul(bb, p1), s1) = add(mul(bb, p2), s2) -> (not less_than(p1, p2))
                                        [by theorem quotientCannotBeLess]
                                      @q1-not-below-q2-under-hypotheses |
                                        b != ZERO -> less_than(r1, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> (not less_than(q1, q2))
                                        [by forall_elim(b, q1, q2, r1, r2) smaller-quotient-impossible]
                                      @q1-not-below-q2 |
                                        not less_than(q1, q2)
                                        [by tautology q1-not-below-q2-under-hypotheses b-nonzero r1-below-b decompositions-equal]
                    // swapped roles, with the equation flipped
                                      @decompositions-equal-flipped |
                                        add(mul(b, q2), r2) = add(mul(b, q1), r1)
                                        [by symmetry decompositions-equal]
                                      @q2-not-below-q1-under-hypotheses |
                                        b != ZERO -> less_than(r2, b) -> add(mul(b, q2), r2) = add(mul(b, q1), r1) -> (not less_than(q2, q1))
                                        [by forall_elim(b, q2, q1, r2, r1) smaller-quotient-impossible]
                                      @q2-not-below-q1 |
                                        not less_than(q2, q1)
                                        [by tautology q2-not-below-q1-under-hypotheses b-nonzero r2-below-b decompositions-equal-flipped]
                    // trichotomy(q1, q2): q1<q2 or q1=q2 or q2<q1
                                      @quotients-are-trichotomous |
                                        forall x, y: Nat; less_than(x, y) or x = y or less_than(y, x)
                                        [by theorem trichotomy]
                                      @q1-q2-trichotomy |
                                        less_than(q1, q2) or q1 = q2 or less_than(q2, q1)
                                        [by forall_elim(q1, q2) quotients-are-trichotomous]
                    // three-way case-split on trichotomy; the < arms are
                    // impossible (they contradict the not-below facts).
                                      @quotients-are-equal |
                                        q1 = q2
                                        case on q1-q2-trichotomy {
                                          @when-q1-below-q2 |
                                            assume less_than(q1, q2) {
                                              @q1-below-q2 |
                                                less_than(q1, q2)
                                                [by hypothesis when-q1-below-q2]
                                              @equal-by-contradiction |
                                                q1 = q2
                                                [by absurd q1-below-q2 q1-not-below-q2]
                                            }
                                          @when-quotients-equal |
                                            assume q1 = q2 {
                                              @equal-directly |
                                                q1 = q2
                                                [by hypothesis when-quotients-equal]
                                            }
                                          @when-q2-below-q1 |
                                            assume less_than(q2, q1) {
                                              @q2-below-q1 |
                                                less_than(q2, q1)
                                                [by hypothesis when-q2-below-q1]
                                              @equal-by-reverse-contradiction |
                                                q1 = q2
                                                [by absurd q2-below-q1 q2-not-below-q1]
                                            }
                                        }
                                    }
                                  @equal-decompositions-force-equal-quotients |
                                    add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
                                    [by implies_intro given-decompositions-equal]
                                }
                              @bounded-r2-forces-equal-quotients |
                                less_than(r2, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
                                [by implies_intro given-r2-below-b]
                            }
                          @bounded-r1-forces-equal-quotients |
                            less_than(r1, b) -> less_than(r2, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
                            [by implies_intro given-r1-below-b]
                        }
                      @nonzero-forces-equal-quotients |
                        b != ZERO -> less_than(r1, b) -> less_than(r2, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
                        [by implies_intro given-b-nonzero]
                    }
                  @discharge-r2 |
                    forall r2: Nat; b != ZERO -> less_than(r1, b) -> less_than(r2, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
                    [by forall_intro generalize-r2]
                }
              @discharge-r1 |
                forall r1, r2: Nat; b != ZERO -> less_than(r1, b) -> less_than(r2, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
                [by forall_intro generalize-r1]
            }
          @discharge-q2 |
            forall q2, r1, r2: Nat; b != ZERO -> less_than(r1, b) -> less_than(r2, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
            [by forall_intro generalize-q2]
        }
      @discharge-q1 |
        forall q1, q2, r1, r2: Nat; b != ZERO -> less_than(r1, b) -> less_than(r2, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
        [by forall_intro generalize-q1]
    }
  @conclusion |
    forall b, q1, q2, r1, r2: Nat; b != ZERO -> less_than(r1, b) -> less_than(r2, b) -> add(mul(b, q1), r1) = add(mul(b, q2), r2) -> q1 = q2
    [by forall_intro generalize-b]
qed

// modIntro / remainder uniqueness: the payoff. If you exhibit a quotient q and
// remainder r < b with b*q + r = a, then mod(a, b) = r (and, en route, div = q).
// This turns each concrete mod fact into a one-line citation.
theorem modIntro: forall a, b, q, r: Nat;
  b != ZERO -> less_than(r, b) -> add(mul(b, q), r) = a -> mod(a, b) = r
proof
  @generalize-a |
    fix a: Nat {
      @generalize-b |
        fix b: Nat {
          @generalize-q |
            fix q: Nat {
              @generalize-r |
                fix r: Nat {
                  @given-b-nonzero |
                    assume b != ZERO {
                      @given-r-below-b |
                        assume less_than(r, b) {
                          @given-decomposition-equals-a |
                            assume add(mul(b, q), r) = a {
                              @b-nonzero |
                                b != ZERO
                                [by hypothesis given-b-nonzero]
                              @r-below-b |
                                less_than(r, b)
                                [by hypothesis given-r-below-b]
                              @decomposition-equals-a |
                                add(mul(b, q), r) = a
                                [by hypothesis given-decomposition-equals-a]
                // the canonical decomposition: b*div(a,b) + mod(a,b) = a
                              @canonical-decomposition |
                                forall aa, bb: Nat; bb != ZERO -> add(mul(bb, div(aa, bb)), mod(aa, bb)) = aa
                                [by axiom divModProperty]
                              @canonical-holds-if-nonzero |
                                b != ZERO -> add(mul(b, div(a, b)), mod(a, b)) = a
                                [by forall_elim(a, b) canonical-decomposition]
                              @a-canonically-decomposes |
                                add(mul(b, div(a, b)), mod(a, b)) = a
                                [by modus_ponens canonical-holds-if-nonzero b-nonzero]
                // mod(a, b) < b
                              @remainder-is-bounded |
                                forall aa, bb: Nat; bb != ZERO -> less_than(mod(aa, bb), bb)
                                [by axiom modBound]
                              @remainder-bounded-if-nonzero |
                                b != ZERO -> less_than(mod(a, b), b)
                                [by forall_elim(a, b) remainder-is-bounded]
                              @canonical-remainder-below-b |
                                less_than(mod(a, b), b)
                                [by modus_ponens remainder-bounded-if-nonzero b-nonzero]
                // equate the two decompositions: b*q + r = a = b*div(a,b) + mod(a,b)
                              @a-is-canonical-decomposition |
                                a = add(mul(b, div(a, b)), mod(a, b))
                                [by symmetry a-canonically-decomposes]
                              @decompositions-agree |
                                add(mul(b, q), r) = add(mul(b, div(a, b)), mod(a, b))
                                [by rewrite a-is-canonical-decomposition decomposition-equals-a]
                // quotientUnique gives q = div(a, b)
                              @quotients-are-unique |
                                forall bb, p1, p2, s1, s2: Nat; bb != ZERO -> less_than(s1, bb) -> less_than(s2, bb) -> add(mul(bb, p1), s1) = add(mul(bb, p2), s2) -> p1 = p2
                                [by theorem quotientUnique]
                              @quotient-equals-canonical-under-hypotheses |
                                b != ZERO -> less_than(r, b) -> less_than(mod(a, b), b) -> add(mul(b, q), r) = add(mul(b, div(a, b)), mod(a, b)) -> q = div(a, b)
                                [by forall_elim(b, q, div(a, b), r, mod(a, b)) quotients-are-unique]
                              @quotient-equals-canonical |
                                q = div(a, b)
                                [by tautology quotient-equals-canonical-under-hypotheses b-nonzero r-below-b canonical-remainder-below-b decompositions-agree]
                // now mul(b, q) = mul(b, div(a, b)), so add(mul(b,q), r) = add(mul(b,q), mod(a,b))
                // and cancel to get r = mod(a, b), then symmetry.
                              @b-times-quotient-is-itself |
                                mul(b, q) = mul(b, q)
                                [by reflexivity]
                              @b-times-quotient-equals-canonical |
                                mul(b, q) = mul(b, div(a, b))
                                [by rewrite quotient-equals-canonical b-times-quotient-is-itself]
                              @canonical-multiple-equals-b-times-quotient |
                                mul(b, div(a, b)) = mul(b, q)
                                [by symmetry b-times-quotient-equals-canonical]
                              @decompositions-share-multiple |
                                add(mul(b, q), r) = add(mul(b, q), mod(a, b))
                                [by rewrite canonical-multiple-equals-b-times-quotient decompositions-agree]
                              @addition-cancels-on-left |
                                forall c, aa, bb: Nat; add(c, aa) = add(c, bb) -> aa = bb
                                [by theorem addCancelLeft]
                              @cancel-shared-multiple |
                                add(mul(b, q), r) = add(mul(b, q), mod(a, b)) -> r = mod(a, b)
                                [by forall_elim(mul(b, q), r, mod(a, b)) addition-cancels-on-left]
                              @r-equals-remainder |
                                r = mod(a, b)
                                [by modus_ponens cancel-shared-multiple decompositions-share-multiple]
                              @remainder-equals-r |
                                mod(a, b) = r
                                [by symmetry r-equals-remainder]
                            }
                          @decomposition-determines-remainder |
                            add(mul(b, q), r) = a -> mod(a, b) = r
                            [by implies_intro given-decomposition-equals-a]
                        }
                      @bounded-remainder-determines-remainder |
                        less_than(r, b) -> add(mul(b, q), r) = a -> mod(a, b) = r
                        [by implies_intro given-r-below-b]
                    }
                  @nonzero-determines-remainder |
                    b != ZERO -> less_than(r, b) -> add(mul(b, q), r) = a -> mod(a, b) = r
                    [by implies_intro given-b-nonzero]
                }
              @discharge-r |
                forall r: Nat; b != ZERO -> less_than(r, b) -> add(mul(b, q), r) = a -> mod(a, b) = r
                [by forall_intro generalize-r]
            }
          @discharge-q |
            forall q, r: Nat; b != ZERO -> less_than(r, b) -> add(mul(b, q), r) = a -> mod(a, b) = r
            [by forall_intro generalize-q]
        }
      @discharge-b |
        forall b, q, r: Nat; b != ZERO -> less_than(r, b) -> add(mul(b, q), r) = a -> mod(a, b) = r
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall a, b, q, r: Nat; b != ZERO -> less_than(r, b) -> add(mul(b, q), r) = a -> mod(a, b) = r
    [by forall_intro generalize-a]
qed
