// std/peano-ordering.bpa — the strict order on Nat and everything built on
// it: the `less_than` intro/elim axioms, the order theory (monotonicity,
// transitivity, trichotomy, ...), and strong (course-of-values) induction.
//
// Split out of std/peano.bpa: peano is the arithmetic core (add/mul), and the
// order is a separate theory layered on top — order is *defined* via addition
// (a < b iff b = a + (d+1)), so it depends on arithmetic but arithmetic never
// depends on it. Everything here is PURE; strong induction is derived from
// peano's `induction` axiom, adding no trust surface.

import peano <<< "std/peano.bpa"

// -- vocabulary (aliased from std/peano; single-use names are qualified
//    inline at their call site) ---------------------------------------------

sort Nat = peano.Nat
const ZERO = peano.ZERO
const ONE = peano.ONE
func succ = peano.succ
func add = peano.add
func mul = peano.mul
axiom succInjective = peano.succInjective
axiom succNotZero = peano.succNotZero
axiom addZeroLeft = peano.addZeroLeft
axiom addSuccLeft = peano.addSuccLeft
axiom oneIsSuccZero = peano.oneIsSuccZero
axiom induction = peano.induction
theorem addZeroRight = peano.addZeroRight
theorem addSuccRight = peano.addSuccRight
theorem addIsAssociative = peano.addIsAssociative
theorem addIsCommutative = peano.addIsCommutative
theorem addSuccNeverSelf = peano.addSuccNeverSelf
theorem zeroOrSucc = peano.zeroOrSucc

pred less_than(a: Nat, b: Nat)
axiom lessThanIntro: forall b, a, d: Nat; add(a, succ(d)) = b -> less_than(a, b)
axiom lessThanElim: forall b, a: Nat; less_than(a, b) -> exists d: Nat; add(a, succ(d)) = b

// a <= b iff b is a plus SOME amount (the gap d may be ZERO, unlike
// less_than's succ(d)). Same intro/elim shape as less_than.
pred less_or_equal(a: Nat, b: Nat)
axiom lessOrEqualIntro: forall b, a, d: Nat; add(a, d) = b -> less_or_equal(a, b)
axiom lessOrEqualElim: forall b, a: Nat; less_or_equal(a, b) -> exists d: Nat; add(a, d) = b

// -- forwarded theorems -----------------------------------------------------

// addition
forward succPreservesOrder
forward succReflectsOrder
forward lessThanTransitive
forward lessThanIrreflexive
forward additionPreservesOrder
forward multiplicationPreservesOrder
forward oneCoversZero
forward trichotomy
forward notLessThanZero
forward lessThanSuccRight
forward lessThanAddCancelLeft
forward lessOrEqualToLessThanSucc
forward lessThanSuccToLessOrEqual
forward lessOrEqualRefl
forward lessThanToLessOrEqual
forward lessOrEqualTransitive
forward lessOrEqualSplit
forward lessOrEqualAntisymmetric
forward lessThanSelf
forward lessThanSuccSplit
forward strongInduction
forward mulCancelLeft

// -- order theory ----------------------------------------------------------

theorem succPreservesOrder: forall b, a: Nat; less_than(a, b) -> less_than(succ(a), succ(b))
proof
  @generalize-b |
    fix b: Nat {
      @generalize-a |
        fix a: Nat {
          @given-a-below-b |
            assume less_than(a, b) {
              @less-than-elim |
                forall y, x: Nat; less_than(x, y) -> exists w: Nat; add(x, succ(w)) = y
                [by axiom lessThanElim]
              @gap-exists-if-below |
                less_than(a, b) -> exists w: Nat; add(a, succ(w)) = b
                [by forall_elim(b, a) less-than-elim]
              @a-below-b |
                less_than(a, b)
                [by hypothesis given-a-below-b]
              @gap-exists |
                exists w: Nat; add(a, succ(w)) = b
                [by modus_ponens gap-exists-if-below a-below-b]
              @with-gap-u |
                unpack u: Nat from gap-exists {
                  @gap-witnesses-b |
                    add(a, succ(u)) = b
                    [by hypothesis with-gap-u]
                  @add-succ-left |
                    forall m, e: Nat; add(succ(m), e) = succ(add(m, e))
                    [by axiom addSuccLeft]
                  @successor-gap-unfolds |
                    add(succ(a), succ(u)) = succ(add(a, succ(u)))
                    [by forall_elim(a, succ(u)) add-succ-left]
                  @successor-gap-witnesses-succ-b |
                    add(succ(a), succ(u)) = succ(b)
                    [by rewrite gap-witnesses-b successor-gap-unfolds]
                  @a-gap-witnesses-less-than |
                    forall y, x, w: Nat; add(x, succ(w)) = y -> less_than(x, y)
                    [by axiom lessThanIntro]
                  @successors-below-if-gap |
                    add(succ(a), succ(u)) = succ(b) -> less_than(succ(a), succ(b))
                    [by forall_elim(succ(b), succ(a), u) a-gap-witnesses-less-than]
                  @successors-preserve-order |
                    less_than(succ(a), succ(b))
                    [by modus_ponens successors-below-if-gap successor-gap-witnesses-succ-b]
                }
              @successors-preserve-order |
                less_than(succ(a), succ(b))
                [by exists_elim with-gap-u]
            }
          @a-below-b-implies-successors-below |
            less_than(a, b) -> less_than(succ(a), succ(b))
            [by implies_intro given-a-below-b]
        }
      @discharge-a |
        forall a: Nat; less_than(a, b) -> less_than(succ(a), succ(b))
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall b, a: Nat; less_than(a, b) -> less_than(succ(a), succ(b))
    [by forall_intro generalize-b]
qed

// The inverse of succPreservesOrder: stripping a common successor preserves
// the strict order. (Needed to reason about measures under subtraction.)
theorem succReflectsOrder: forall b, a: Nat; less_than(succ(a), succ(b)) -> less_than(a, b)
proof
  @generalize-b |
    fix b: Nat {
      @generalize-a |
        fix a: Nat {
          @given-successors-below |
            assume less_than(succ(a), succ(b)) {
              @successors-below |
                less_than(succ(a), succ(b))
                [by hypothesis given-successors-below]
              @less-than-elim |
                forall y, x: Nat; less_than(x, y) -> exists d: Nat; add(x, succ(d)) = y
                [by axiom lessThanElim]
              @successor-gap-exists-if-below |
                less_than(succ(a), succ(b)) -> exists d: Nat; add(succ(a), succ(d)) = succ(b)
                [by forall_elim(succ(b), succ(a)) less-than-elim]
              @successor-gap-exists |
                exists d: Nat; add(succ(a), succ(d)) = succ(b)
                [by modus_ponens successor-gap-exists-if-below successors-below]
              @with-gap-d |
                unpack d0: Nat from successor-gap-exists {
                  @successor-gap-witnesses-succ-b |
                    add(succ(a), succ(d0)) = succ(b)
                    [by hypothesis with-gap-d]
                  @successor-gap-unfolds |
                    add(succ(a), succ(d0)) = succ(add(a, succ(d0)))
                    [by simplify addSuccLeft]
                  @succ-of-gap-is-succ-b |
                    succ(add(a, succ(d0))) = succ(b)
                    [by rewrite successor-gap-unfolds successor-gap-witnesses-succ-b]
                  @successor-is-injective |
                    forall x, y: Nat; succ(x) = succ(y) -> x = y
                    [by axiom succInjective]
                  @gap-is-b-if-succ-equal |
                    succ(add(a, succ(d0))) = succ(b) -> add(a, succ(d0)) = b
                    [by forall_elim(add(a, succ(d0)), b) successor-is-injective]
                  @gap-witnesses-b |
                    add(a, succ(d0)) = b
                    [by modus_ponens gap-is-b-if-succ-equal succ-of-gap-is-succ-b]
                  @a-gap-witnesses-less-than |
                    forall y, x, d: Nat; add(x, succ(d)) = y -> less_than(x, y)
                    [by axiom lessThanIntro]
                  @a-below-b-if-gap |
                    add(a, succ(d0)) = b -> less_than(a, b)
                    [by forall_elim(b, a, d0) a-gap-witnesses-less-than]
                  @a-below-b |
                    less_than(a, b)
                    [by modus_ponens a-below-b-if-gap gap-witnesses-b]
                }
              @a-below-b |
                less_than(a, b)
                [by exists_elim with-gap-d]
            }
          @successors-below-implies-a-below-b |
            less_than(succ(a), succ(b)) -> less_than(a, b)
            [by implies_intro given-successors-below]
        }
      @discharge-a |
        forall a: Nat; less_than(succ(a), succ(b)) -> less_than(a, b)
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall b, a: Nat; less_than(succ(a), succ(b)) -> less_than(a, b)
    [by forall_intro generalize-b]
qed

// Strategy: unpack both witnesses; the combined gap is add(u, succ(v)),
// assembled with associativity and one succ-pull.
theorem lessThanTransitive: forall c, b, a: Nat; less_than(a, b) -> less_than(b, c) -> less_than(a, c)
proof
  @generalize-c |
    fix c: Nat {
      @generalize-b |
        fix b: Nat {
          @generalize-a |
            fix a: Nat {
              @given-a-below-b |
                assume less_than(a, b) {
                  @given-b-below-c |
                    assume less_than(b, c) {
                      @less-than-elim |
                        forall y, x: Nat; less_than(x, y) -> exists w: Nat; add(x, succ(w)) = y
                        [by axiom lessThanElim]
                      @gap-ab-exists-if-below |
                        less_than(a, b) -> exists w: Nat; add(a, succ(w)) = b
                        [by forall_elim(b, a) less-than-elim]
                      @a-below-b |
                        less_than(a, b)
                        [by hypothesis given-a-below-b]
                      @gap-ab-exists |
                        exists w: Nat; add(a, succ(w)) = b
                        [by modus_ponens gap-ab-exists-if-below a-below-b]
                      @gap-bc-exists-if-below |
                        less_than(b, c) -> exists w: Nat; add(b, succ(w)) = c
                        [by forall_elim(c, b) less-than-elim]
                      @b-below-c |
                        less_than(b, c)
                        [by hypothesis given-b-below-c]
                      @gap-bc-exists |
                        exists w: Nat; add(b, succ(w)) = c
                        [by modus_ponens gap-bc-exists-if-below b-below-c]
                      @with-gap-u |
                        unpack u: Nat from gap-ab-exists {
                          @with-gap-v |
                            unpack v: Nat from gap-bc-exists {
                              @gap-u-witnesses-b |
                                add(a, succ(u)) = b
                                [by hypothesis with-gap-u]
                              @gap-v-witnesses-c |
                                add(b, succ(v)) = c
                                [by hypothesis with-gap-v]
                              @gap-u-refl |
                                add(a, succ(u)) = add(a, succ(u))
                                [by reflexivity]
                              @b-is-a-plus-gap-u |
                                b = add(a, succ(u))
                                [by rewrite gap-u-witnesses-b gap-u-refl]
                              @nested-gaps-reach-c |
                                add(add(a, succ(u)), succ(v)) = c
                                [by rewrite b-is-a-plus-gap-u gap-v-witnesses-c]
                              @add-assoc |
                                forall f, e, m: Nat; add(add(m, e), f) = add(m, add(e, f))
                                [by theorem addIsAssociative]
                              @nested-gaps-regroup |
                                add(add(a, succ(u)), succ(v)) = add(a, add(succ(u), succ(v)))
                                [by forall_elim(succ(v), succ(u), a) add-assoc]
                              @combined-gap-reaches-c |
                                add(a, add(succ(u), succ(v))) = c
                                [by rewrite nested-gaps-regroup nested-gaps-reach-c]
                              @add-succ-left |
                                forall m, e: Nat; add(succ(m), e) = succ(add(m, e))
                                [by axiom addSuccLeft]
                              @combined-gap-is-successor |
                                add(succ(u), succ(v)) = succ(add(u, succ(v)))
                                [by forall_elim(u, succ(v)) add-succ-left]
                              @successor-gap-reaches-c |
                                add(a, succ(add(u, succ(v)))) = c
                                [by rewrite combined-gap-is-successor combined-gap-reaches-c]
                              @a-gap-witnesses-less-than |
                                forall y, x, w: Nat; add(x, succ(w)) = y -> less_than(x, y)
                                [by axiom lessThanIntro]
                              @a-below-c-if-gap |
                                add(a, succ(add(u, succ(v)))) = c -> less_than(a, c)
                                [by forall_elim(c, a, add(u, succ(v))) a-gap-witnesses-less-than]
                              @a-below-c |
                                less_than(a, c)
                                [by modus_ponens a-below-c-if-gap successor-gap-reaches-c]
                            }
                          @a-below-c |
                            less_than(a, c)
                            [by exists_elim with-gap-v]
                        }
                      @a-below-c |
                        less_than(a, c)
                        [by exists_elim with-gap-u]
                    }
                  @b-below-c-implies-a-below-c |
                    less_than(b, c) -> less_than(a, c)
                    [by implies_intro given-b-below-c]
                }
              @a-below-b-implies-transitively-below-c |
                less_than(a, b) -> less_than(b, c) -> less_than(a, c)
                [by implies_intro given-a-below-b]
            }
          @discharge-a |
            forall a: Nat; less_than(a, b) -> less_than(b, c) -> less_than(a, c)
            [by forall_intro generalize-a]
        }
      @discharge-b |
        forall b, a: Nat; less_than(a, b) -> less_than(b, c) -> less_than(a, c)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall c, b, a: Nat; less_than(a, b) -> less_than(b, c) -> less_than(a, c)
    [by forall_intro generalize-c]
qed

// Strategy: a witness for n < n would make add(n, succ(w)) = n, contradicting
// addSuccNeverSelf.
theorem lessThanIrreflexive: forall n: Nat; not less_than(n, n)
proof
  @generalize-n |
    fix n: Nat {
      @given-n-below-n |
        assume less_than(n, n) {
          @less-than-elim |
            forall y, x: Nat; less_than(x, y) -> exists w: Nat; add(x, succ(w)) = y
            [by axiom lessThanElim]
          @self-gap-exists-if-below |
            less_than(n, n) -> exists w: Nat; add(n, succ(w)) = n
            [by forall_elim(n, n) less-than-elim]
          @n-below-n |
            less_than(n, n)
            [by hypothesis given-n-below-n]
          @self-gap-exists |
            exists w: Nat; add(n, succ(w)) = n
            [by modus_ponens self-gap-exists-if-below n-below-n]
          @with-gap-u |
            unpack u: Nat from self-gap-exists {
              @gap-witnesses-self |
                add(n, succ(u)) = n
                [by hypothesis with-gap-u]
              @successor-sum-never-self |
                forall e, m: Nat; add(m, succ(e)) != m
                [by theorem addSuccNeverSelf]
              @gap-cannot-witness-self |
                add(n, succ(u)) != n
                [by forall_elim(u, n) successor-sum-never-self]
              @not-n-below-n |
                not less_than(n, n)
                [by absurd gap-witnesses-self gap-cannot-witness-self]
            }
          @not-n-below-n |
            not less_than(n, n)
            [by exists_elim with-gap-u]
          @n-below-n-restated |
            less_than(n, n)
            [by hypothesis given-n-below-n]
        }
      @no-n-below-n |
        not less_than(n, n)
        [by not_intro given-n-below-n n-below-n-restated not-n-below-n]
    }
  @conclusion |
    forall n: Nat; not less_than(n, n)
    [by forall_intro generalize-n]
qed

// Strategy: the same witness works after adding c on the left, regrouped with
// associativity.
theorem additionPreservesOrder: forall c, b, a: Nat; less_than(a, b) -> less_than(add(c, a), add(c, b))
proof
  @generalize-c |
    fix c: Nat {
      @generalize-b |
        fix b: Nat {
          @generalize-a |
            fix a: Nat {
              @given-a-below-b |
                assume less_than(a, b) {
                  @less-than-elim |
                    forall y, x: Nat; less_than(x, y) -> exists w: Nat; add(x, succ(w)) = y
                    [by axiom lessThanElim]
                  @gap-exists-if-below |
                    less_than(a, b) -> exists w: Nat; add(a, succ(w)) = b
                    [by forall_elim(b, a) less-than-elim]
                  @a-below-b |
                    less_than(a, b)
                    [by hypothesis given-a-below-b]
                  @gap-exists |
                    exists w: Nat; add(a, succ(w)) = b
                    [by modus_ponens gap-exists-if-below a-below-b]
                  @with-gap-u |
                    unpack u: Nat from gap-exists {
                      @gap-witnesses-b |
                        add(a, succ(u)) = b
                        [by hypothesis with-gap-u]
                      @add-assoc |
                        forall f, e, m: Nat; add(add(m, e), f) = add(m, add(e, f))
                        [by theorem addIsAssociative]
                      @shifted-gap-regroups |
                        add(add(c, a), succ(u)) = add(c, add(a, succ(u)))
                        [by forall_elim(succ(u), a, c) add-assoc]
                      @shifted-gap-witnesses-c-plus-b |
                        add(add(c, a), succ(u)) = add(c, b)
                        [by rewrite gap-witnesses-b shifted-gap-regroups]
                      @a-gap-witnesses-less-than |
                        forall y, x, w: Nat; add(x, succ(w)) = y -> less_than(x, y)
                        [by axiom lessThanIntro]
                      @shifted-below-if-gap |
                        add(add(c, a), succ(u)) = add(c, b) -> less_than(add(c, a), add(c, b))
                        [by forall_elim(add(c, b), add(c, a), u) a-gap-witnesses-less-than]
                      @shifted-preserves-order |
                        less_than(add(c, a), add(c, b))
                        [by modus_ponens shifted-below-if-gap shifted-gap-witnesses-c-plus-b]
                    }
                  @shifted-preserves-order |
                    less_than(add(c, a), add(c, b))
                    [by exists_elim with-gap-u]
                }
              @a-below-b-implies-shifted-below |
                less_than(a, b) -> less_than(add(c, a), add(c, b))
                [by implies_intro given-a-below-b]
            }
          @discharge-a |
            forall a: Nat; less_than(a, b) -> less_than(add(c, a), add(c, b))
            [by forall_intro generalize-a]
        }
      @discharge-b |
        forall b, a: Nat; less_than(a, b) -> less_than(add(c, a), add(c, b))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall c, b, a: Nat; less_than(a, b) -> less_than(add(c, a), add(c, b))
    [by forall_intro generalize-c]
qed

// Strategy: induction; every natural is ZERO or a successor. The case-split
// helper for trichotomy.
theorem multiplicationPreservesOrder: forall c, b, a: Nat; less_than(a, b) -> less_than(mul(succ(c), a), mul(succ(c), b))
proof
  @generalize-c |
    fix c: Nat {
      @generalize-b |
        fix b: Nat {
          @generalize-a |
            fix a: Nat {
              @given-a-below-b |
                assume less_than(a, b) {
                  @less-than-elim |
                    forall y, x: Nat; less_than(x, y) -> exists w: Nat; add(x, succ(w)) = y
                    [by axiom lessThanElim]
                  @gap-exists-if-below |
                    less_than(a, b) -> exists w: Nat; add(a, succ(w)) = b
                    [by forall_elim(b, a) less-than-elim]
                  @a-below-b |
                    less_than(a, b)
                    [by hypothesis given-a-below-b]
                  @gap-exists |
                    exists w: Nat; add(a, succ(w)) = b
                    [by modus_ponens gap-exists-if-below a-below-b]
                  @with-gap-u |
                    unpack u: Nat from gap-exists {
                      @gap-witnesses-b |
                        add(a, succ(u)) = b
                        [by hypothesis with-gap-u]
                      @gap-refl |
                        add(a, succ(u)) = add(a, succ(u))
                        [by reflexivity]
                      @b-is-a-plus-gap |
                        b = add(a, succ(u))
                        [by rewrite gap-witnesses-b gap-refl]
                      @scaled-b-refl |
                        mul(succ(c), b) = mul(succ(c), b)
                        [by reflexivity]
                      @scaled-b-is-scaled-sum |
                        mul(succ(c), b) = mul(succ(c), add(a, succ(u)))
                        [by rewrite b-is-a-plus-gap scaled-b-refl]
                      @scaling-distributes-over-sum |
                        forall f, e, m: Nat; mul(m, add(e, f)) = add(mul(m, e), mul(m, f))
                        [by theorem peano.mulAddDistribLeft]
                      @scaled-sum-distributes |
                        mul(succ(c), add(a, succ(u))) = add(mul(succ(c), a), mul(succ(c), succ(u)))
                        [by forall_elim(succ(u), a, succ(c)) scaling-distributes-over-sum]
                      @scaled-b-distributed |
                        mul(succ(c), b) = add(mul(succ(c), a), mul(succ(c), succ(u)))
                        [by rewrite scaled-sum-distributes scaled-b-is-scaled-sum]
                      @mul-succ-left |
                        forall m, e: Nat; mul(succ(m), e) = add(mul(m, e), e)
                        [by axiom peano.mulSuccLeft]
                      @scaled-gap-unfolds |
                        mul(succ(c), succ(u)) = add(mul(c, succ(u)), succ(u))
                        [by forall_elim(c, succ(u)) mul-succ-left]
                      @add-succ-right |
                        forall e, m: Nat; add(m, succ(e)) = succ(add(m, e))
                        [by theorem addSuccRight]
                      @scaled-gap-is-successor |
                        add(mul(c, succ(u)), succ(u)) = succ(add(mul(c, succ(u)), u))
                        [by forall_elim(u, mul(c, succ(u))) add-succ-right]
                      @scaled-gap-total |
                        mul(succ(c), succ(u)) = succ(add(mul(c, succ(u)), u))
                        [by rewrite scaled-gap-is-successor scaled-gap-unfolds]
                      @scaled-b-has-successor-gap |
                        mul(succ(c), b) = add(mul(succ(c), a), succ(add(mul(c, succ(u)), u)))
                        [by rewrite scaled-gap-total scaled-b-distributed]
                      @a-gap-witnesses-less-than |
                        forall y, x, w: Nat; add(x, succ(w)) = y -> less_than(x, y)
                        [by axiom lessThanIntro]
                      @scaled-below-if-gap |
                        add(mul(succ(c), a), succ(add(mul(c, succ(u)), u))) = mul(succ(c), b) -> less_than(mul(succ(c), a), mul(succ(c), b))
                        [by forall_elim(mul(succ(c), b), mul(succ(c), a), add(mul(c, succ(u)), u)) a-gap-witnesses-less-than]
                      @scaled-b-has-gap-refl |
                        mul(succ(c), b) = mul(succ(c), b)
                        [by reflexivity]
                      @scaled-gap-witnesses-scaled-b |
                        add(mul(succ(c), a), succ(add(mul(c, succ(u)), u))) = mul(succ(c), b)
                        [by rewrite scaled-b-has-successor-gap scaled-b-has-gap-refl]
                      @scaling-preserves-order |
                        less_than(mul(succ(c), a), mul(succ(c), b))
                        [by modus_ponens scaled-below-if-gap scaled-gap-witnesses-scaled-b]
                    }
                  @scaling-preserves-order |
                    less_than(mul(succ(c), a), mul(succ(c), b))
                    [by exists_elim with-gap-u]
                }
              @a-below-b-implies-scaling-preserves-order |
                less_than(a, b) -> less_than(mul(succ(c), a), mul(succ(c), b))
                [by implies_intro given-a-below-b]
            }
          @discharge-a |
            forall a: Nat; less_than(a, b) -> less_than(mul(succ(c), a), mul(succ(c), b))
            [by forall_intro generalize-a]
        }
      @discharge-b |
        forall b, a: Nat; less_than(a, b) -> less_than(mul(succ(c), a), mul(succ(c), b))
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall c, b, a: Nat; less_than(a, b) -> less_than(mul(succ(c), a), mul(succ(c), b))
    [by forall_intro generalize-c]
qed

// Strategy: ONE covers ZERO — ZERO < ONE, and nothing sits strictly between:
// a middle n would be a successor whose combined gap makes succ(...) = ZERO.
theorem oneCoversZero: less_than(ZERO, ONE) and (forall n: Nat; not (less_than(ZERO, n) and less_than(n, ONE)))
proof
  // part 1: ZERO < ONE, witness ZERO
  @add-zero-left |
    forall m: Nat; add(ZERO, m) = m
    [by axiom addZeroLeft]
  @zero-gap-is-succ-zero |
    add(ZERO, succ(ZERO)) = succ(ZERO)
    [by forall_elim(succ(ZERO)) add-zero-left]
  @one-def |
    ONE = succ(ZERO)
    [by axiom oneIsSuccZero]
  @one-refl |
    ONE = ONE
    [by reflexivity]
  @succ-zero-is-one |
    succ(ZERO) = ONE
    [by rewrite one-def one-refl]
  @zero-gap-reaches-one |
    add(ZERO, succ(ZERO)) = ONE
    [by rewrite succ-zero-is-one zero-gap-is-succ-zero]
  @a-gap-witnesses-less-than |
    forall y, x, w: Nat; add(x, succ(w)) = y -> less_than(x, y)
    [by axiom lessThanIntro]
  @zero-below-one-if-gap |
    add(ZERO, succ(ZERO)) = ONE -> less_than(ZERO, ONE)
    [by forall_elim(ONE, ZERO, ZERO) a-gap-witnesses-less-than]
  @part-one |
    less_than(ZERO, ONE)
    [by modus_ponens zero-below-one-if-gap zero-gap-reaches-one]

  // part 2: no n strictly between ZERO and ONE
  @generalize-n |
    fix n: Nat {
      @given-n-between-zero-and-one |
        assume less_than(ZERO, n) and less_than(n, ONE) {
          @n-is-strictly-between |
            less_than(ZERO, n) and less_than(n, ONE)
            [by hypothesis given-n-between-zero-and-one]
          @zero-below-n |
            less_than(ZERO, n)
            [by and_elim_left n-is-strictly-between]
          @n-below-one |
            less_than(n, ONE)
            [by and_elim_right n-is-strictly-between]
          @less-than-elim |
            forall y, x: Nat; less_than(x, y) -> exists w: Nat; add(x, succ(w)) = y
            [by axiom lessThanElim]
          @lower-gap-exists-if-below |
            less_than(ZERO, n) -> exists w: Nat; add(ZERO, succ(w)) = n
            [by forall_elim(n, ZERO) less-than-elim]
          @lower-gap-exists |
            exists w: Nat; add(ZERO, succ(w)) = n
            [by modus_ponens lower-gap-exists-if-below zero-below-n]
          @upper-gap-exists-if-below |
            less_than(n, ONE) -> exists w: Nat; add(n, succ(w)) = ONE
            [by forall_elim(ONE, n) less-than-elim]
          @upper-gap-exists |
            exists w: Nat; add(n, succ(w)) = ONE
            [by modus_ponens upper-gap-exists-if-below n-below-one]
          @add-zero-left-in |
            forall m: Nat; add(ZERO, m) = m
            [by axiom addZeroLeft]
          @with-lower-gap-u |
            unpack u: Nat from lower-gap-exists {
              @lower-gap-witnesses-n |
                add(ZERO, succ(u)) = n
                [by hypothesis with-lower-gap-u]
              @lower-gap-is-succ-u |
                add(ZERO, succ(u)) = succ(u)
                [by forall_elim(succ(u)) add-zero-left-in]
              @lower-gap-refl |
                add(ZERO, succ(u)) = add(ZERO, succ(u))
                [by reflexivity]
              @n-is-lower-gap |
                n = add(ZERO, succ(u))
                [by rewrite lower-gap-witnesses-n lower-gap-refl]
              @n-is-succ-u |
                n = succ(u)
                [by rewrite lower-gap-is-succ-u n-is-lower-gap]
              @with-upper-gap-v |
                unpack v: Nat from upper-gap-exists {
                  @upper-gap-witnesses-one |
                    add(n, succ(v)) = ONE
                    [by hypothesis with-upper-gap-v]
                  @combined-gap-is-one |
                    add(succ(u), succ(v)) = ONE
                    [by rewrite n-is-succ-u upper-gap-witnesses-one]
                  @one-def-in |
                    ONE = succ(ZERO)
                    [by axiom oneIsSuccZero]
                  @combined-gap-is-succ-zero |
                    add(succ(u), succ(v)) = succ(ZERO)
                    [by rewrite one-def-in combined-gap-is-one]
                  @add-succ-left |
                    forall m, e: Nat; add(succ(m), e) = succ(add(m, e))
                    [by axiom addSuccLeft]
                  @combined-gap-unfolds |
                    add(succ(u), succ(v)) = succ(add(u, succ(v)))
                    [by forall_elim(u, succ(v)) add-succ-left]
                  @combined-gap-refl |
                    add(succ(u), succ(v)) = add(succ(u), succ(v))
                    [by reflexivity]
                  @succ-of-inner-gap-is-combined |
                    succ(add(u, succ(v))) = add(succ(u), succ(v))
                    [by rewrite combined-gap-unfolds combined-gap-refl]
                  @succ-of-inner-gap-is-succ-zero |
                    succ(add(u, succ(v))) = succ(ZERO)
                    [by rewrite combined-gap-is-succ-zero succ-of-inner-gap-is-combined]
                  @successor-is-injective |
                    forall m, e: Nat; succ(m) = succ(e) -> m = e
                    [by axiom succInjective]
                  @inner-gap-is-zero-if-succ-equal |
                    succ(add(u, succ(v))) = succ(ZERO) -> add(u, succ(v)) = ZERO
                    [by forall_elim(add(u, succ(v)), ZERO) successor-is-injective]
                  @inner-gap-is-zero |
                    add(u, succ(v)) = ZERO
                    [by modus_ponens inner-gap-is-zero-if-succ-equal succ-of-inner-gap-is-succ-zero]
                  @add-succ-right |
                    forall e, m: Nat; add(m, succ(e)) = succ(add(m, e))
                    [by theorem addSuccRight]
                  @inner-gap-unfolds |
                    add(u, succ(v)) = succ(add(u, v))
                    [by forall_elim(v, u) add-succ-right]
                  @inner-gap-refl |
                    add(u, succ(v)) = add(u, succ(v))
                    [by reflexivity]
                  @succ-of-sum-is-inner-gap |
                    succ(add(u, v)) = add(u, succ(v))
                    [by rewrite inner-gap-unfolds inner-gap-refl]
                  @succ-of-sum-is-zero |
                    succ(add(u, v)) = ZERO
                    [by rewrite inner-gap-is-zero succ-of-sum-is-inner-gap]
                  @succ-not-zero |
                    forall m: Nat; succ(m) != ZERO
                    [by axiom succNotZero]
                  @succ-of-sum-is-nonzero |
                    succ(add(u, v)) != ZERO
                    [by forall_elim(add(u, v)) succ-not-zero]
                  @nothing-lies-between |
                    not (less_than(ZERO, n) and less_than(n, ONE))
                    [by absurd succ-of-sum-is-zero succ-of-sum-is-nonzero]
                }
              @nothing-lies-between |
                not (less_than(ZERO, n) and less_than(n, ONE))
                [by exists_elim with-upper-gap-v]
            }
          @nothing-lies-between |
            not (less_than(ZERO, n) and less_than(n, ONE))
            [by exists_elim with-lower-gap-u]
        }
      @no-middle |
        not (less_than(ZERO, n) and less_than(n, ONE))
        [by not_intro given-n-between-zero-and-one n-is-strictly-between nothing-lies-between]
    }
  @part-two |
    forall n: Nat; not (less_than(ZERO, n) and less_than(n, ONE))
    [by forall_intro generalize-n]

  @conclusion |
    less_than(ZERO, ONE) and (forall n: Nat; not (less_than(ZERO, n) and less_than(n, ONE)))
    [by and_intro part-one part-two]
qed

// Strategy: induction on a with prop(k) := forall b; k < b or k = b or b < k.
// The base and the step both case-split b via zeroOrSucc; the step's successor
// case splits three ways on the inductive hypothesis — an or_elim tree with
// succPreservesOrder carrying the strict branches.
theorem trichotomy: forall a, b: Nat; less_than(a, b) or a = b or less_than(b, a)
proof
  // base: ZERO against any b
  @base-case-proof |
    fix bb: Nat {
      @zero-or-successor |
        forall n: Nat; n = ZERO or (exists m: Nat; n = succ(m))
        [by theorem zeroOrSucc]
      @b-is-zero-or-successor |
        bb = ZERO or (exists m: Nat; bb = succ(m))
        [by forall_elim(bb) zero-or-successor]
      @when-b-is-zero |
        assume bb = ZERO {
          @b-is-zero |
            bb = ZERO
            [by hypothesis when-b-is-zero]
          @b-refl |
            bb = bb
            [by reflexivity]
          @zero-equals-b |
            ZERO = bb
            [by rewrite b-is-zero b-refl]
          @below-or-equal |
            less_than(ZERO, bb) or ZERO = bb
            [by or_intro_right zero-equals-b]
          @trichotomy-at-zero |
            less_than(ZERO, bb) or ZERO = bb or less_than(bb, ZERO)
            [by or_intro_left below-or-equal]
        }
      @when-b-is-successor |
        assume exists m: Nat; bb = succ(m) {
          @b-is-some-successor |
            exists m: Nat; bb = succ(m)
            [by hypothesis when-b-is-successor]
          @with-predecessor-m |
            unpack m0: Nat from b-is-some-successor {
              @b-is-succ-m |
                bb = succ(m0)
                [by hypothesis with-predecessor-m]
              @add-zero-left |
                forall e: Nat; add(ZERO, e) = e
                [by axiom addZeroLeft]
              @zero-gap-reaches-succ-m |
                add(ZERO, succ(m0)) = succ(m0)
                [by forall_elim(succ(m0)) add-zero-left]
              @a-gap-witnesses-less-than |
                forall y, x, w: Nat; add(x, succ(w)) = y -> less_than(x, y)
                [by axiom lessThanIntro]
              @zero-below-succ-m-if-gap |
                add(ZERO, succ(m0)) = succ(m0) -> less_than(ZERO, succ(m0))
                [by forall_elim(succ(m0), ZERO, m0) a-gap-witnesses-less-than]
              @zero-below-succ-m |
                less_than(ZERO, succ(m0))
                [by modus_ponens zero-below-succ-m-if-gap zero-gap-reaches-succ-m]
              @b-refl |
                bb = bb
                [by reflexivity]
              @succ-m-equals-b |
                succ(m0) = bb
                [by rewrite b-is-succ-m b-refl]
              @zero-below-b |
                less_than(ZERO, bb)
                [by rewrite succ-m-equals-b zero-below-succ-m]
              @below-or-equal |
                less_than(ZERO, bb) or ZERO = bb
                [by or_intro_left zero-below-b]
              @trichotomy-at-zero |
                less_than(ZERO, bb) or ZERO = bb or less_than(bb, ZERO)
                [by or_intro_left below-or-equal]
            }
          @trichotomy-at-zero |
            less_than(ZERO, bb) or ZERO = bb or less_than(bb, ZERO)
            [by exists_elim with-predecessor-m]
        }
      @trichotomy-at-zero |
        less_than(ZERO, bb) or ZERO = bb or less_than(bb, ZERO)
        [by or_elim b-is-zero-or-successor when-b-is-zero when-b-is-successor]
    }
  @base-case |
    forall b: Nat; less_than(ZERO, b) or ZERO = b or less_than(b, ZERO)
    [by forall_intro base-case-proof]

  // step: succ(k) against any b, splitting b and then the inductive hypothesis
  @induction-step |
    fix k: Nat {
      @given-inductive-hypothesis |
        assume forall b: Nat; less_than(k, b) or k = b or less_than(b, k) {
          @pointwise |
            fix b2: Nat {
              @zero-or-successor |
                forall n: Nat; n = ZERO or (exists m: Nat; n = succ(m))
                [by theorem zeroOrSucc]
              @b-is-zero-or-successor |
                b2 = ZERO or (exists m: Nat; b2 = succ(m))
                [by forall_elim(b2) zero-or-successor]
              @when-b-is-zero |
                assume b2 = ZERO {
                  @add-zero-left |
                    forall e: Nat; add(ZERO, e) = e
                    [by axiom addZeroLeft]
                  @zero-gap-reaches-succ-k |
                    add(ZERO, succ(k)) = succ(k)
                    [by forall_elim(succ(k)) add-zero-left]
                  @a-gap-witnesses-less-than |
                    forall y, x, w: Nat; add(x, succ(w)) = y -> less_than(x, y)
                    [by axiom lessThanIntro]
                  @zero-below-succ-k-if-gap |
                    add(ZERO, succ(k)) = succ(k) -> less_than(ZERO, succ(k))
                    [by forall_elim(succ(k), ZERO, k) a-gap-witnesses-less-than]
                  @zero-below-succ-k |
                    less_than(ZERO, succ(k))
                    [by modus_ponens zero-below-succ-k-if-gap zero-gap-reaches-succ-k]
                  @b-is-zero |
                    b2 = ZERO
                    [by hypothesis when-b-is-zero]
                  @b-refl |
                    b2 = b2
                    [by reflexivity]
                  @zero-equals-b |
                    ZERO = b2
                    [by rewrite b-is-zero b-refl]
                  @b-below-succ-k |
                    less_than(b2, succ(k))
                    [by rewrite zero-equals-b zero-below-succ-k]
                  @trichotomy-at-succ-k |
                    less_than(succ(k), b2) or succ(k) = b2 or less_than(b2, succ(k))
                    [by or_intro_right b-below-succ-k]
                }
              @when-b-is-successor |
                assume exists m: Nat; b2 = succ(m) {
                  @b-is-some-successor |
                    exists m: Nat; b2 = succ(m)
                    [by hypothesis when-b-is-successor]
                  @with-predecessor-m |
                    unpack m1: Nat from b-is-some-successor {
                      @b-is-succ-m |
                        b2 = succ(m1)
                        [by hypothesis with-predecessor-m]
                      @inductive-hypothesis |
                        forall b: Nat; less_than(k, b) or k = b or less_than(b, k)
                        [by hypothesis given-inductive-hypothesis]
                      @trichotomy-k-against-m |
                        less_than(k, m1) or k = m1 or less_than(m1, k)
                        [by forall_elim(m1) inductive-hypothesis]
                      @when-k-below-or-equal-m |
                        assume less_than(k, m1) or k = m1 {
                          @k-below-or-equal-m |
                            less_than(k, m1) or k = m1
                            [by hypothesis when-k-below-or-equal-m]
                          @when-k-below-m |
                            assume less_than(k, m1) {
                              @k-below-m |
                                less_than(k, m1)
                                [by hypothesis when-k-below-m]
                              @successors-preserve-order |
                                forall y, x: Nat; less_than(x, y) -> less_than(succ(x), succ(y))
                                [by theorem succPreservesOrder]
                              @succ-k-below-succ-m-if-below |
                                less_than(k, m1) -> less_than(succ(k), succ(m1))
                                [by forall_elim(m1, k) successors-preserve-order]
                              @succ-k-below-succ-m |
                                less_than(succ(k), succ(m1))
                                [by modus_ponens succ-k-below-succ-m-if-below k-below-m]
                              @b-refl |
                                b2 = b2
                                [by reflexivity]
                              @succ-m-equals-b |
                                succ(m1) = b2
                                [by rewrite b-is-succ-m b-refl]
                              @succ-k-below-b |
                                less_than(succ(k), b2)
                                [by rewrite succ-m-equals-b succ-k-below-succ-m]
                              @below-or-equal |
                                less_than(succ(k), b2) or succ(k) = b2
                                [by or_intro_left succ-k-below-b]
                              @trichotomy-at-succ-k |
                                less_than(succ(k), b2) or succ(k) = b2 or less_than(b2, succ(k))
                                [by or_intro_left below-or-equal]
                            }
                          @when-k-equals-m |
                            assume k = m1 {
                              @k-equals-m |
                                k = m1
                                [by hypothesis when-k-equals-m]
                              @succ-k-refl |
                                succ(k) = succ(k)
                                [by reflexivity]
                              @succ-k-equals-succ-m |
                                succ(k) = succ(m1)
                                [by rewrite k-equals-m succ-k-refl]
                              @b-refl |
                                b2 = b2
                                [by reflexivity]
                              @succ-m-equals-b |
                                succ(m1) = b2
                                [by rewrite b-is-succ-m b-refl]
                              @succ-k-equals-b |
                                succ(k) = b2
                                [by rewrite succ-m-equals-b succ-k-equals-succ-m]
                              @below-or-equal |
                                less_than(succ(k), b2) or succ(k) = b2
                                [by or_intro_right succ-k-equals-b]
                              @trichotomy-at-succ-k |
                                less_than(succ(k), b2) or succ(k) = b2 or less_than(b2, succ(k))
                                [by or_intro_left below-or-equal]
                            }
                          @trichotomy-at-succ-k |
                            less_than(succ(k), b2) or succ(k) = b2 or less_than(b2, succ(k))
                            [by or_elim k-below-or-equal-m when-k-below-m when-k-equals-m]
                        }
                      @when-m-below-k |
                        assume less_than(m1, k) {
                          @m-below-k |
                            less_than(m1, k)
                            [by hypothesis when-m-below-k]
                          @successors-preserve-order |
                            forall y, x: Nat; less_than(x, y) -> less_than(succ(x), succ(y))
                            [by theorem succPreservesOrder]
                          @succ-m-below-succ-k-if-below |
                            less_than(m1, k) -> less_than(succ(m1), succ(k))
                            [by forall_elim(k, m1) successors-preserve-order]
                          @succ-m-below-succ-k |
                            less_than(succ(m1), succ(k))
                            [by modus_ponens succ-m-below-succ-k-if-below m-below-k]
                          @b-refl |
                            b2 = b2
                            [by reflexivity]
                          @succ-m-equals-b |
                            succ(m1) = b2
                            [by rewrite b-is-succ-m b-refl]
                          @b-below-succ-k |
                            less_than(b2, succ(k))
                            [by rewrite succ-m-equals-b succ-m-below-succ-k]
                          @trichotomy-at-succ-k |
                            less_than(succ(k), b2) or succ(k) = b2 or less_than(b2, succ(k))
                            [by or_intro_right b-below-succ-k]
                        }
                      @trichotomy-at-succ-k |
                        less_than(succ(k), b2) or succ(k) = b2 or less_than(b2, succ(k))
                        [by or_elim trichotomy-k-against-m when-k-below-or-equal-m when-m-below-k]
                    }
                  @trichotomy-at-succ-k |
                    less_than(succ(k), b2) or succ(k) = b2 or less_than(b2, succ(k))
                    [by exists_elim with-predecessor-m]
                }
              @trichotomy-at-succ-k |
                less_than(succ(k), b2) or succ(k) = b2 or less_than(b2, succ(k))
                [by or_elim b-is-zero-or-successor when-b-is-zero when-b-is-successor]
            }
          @discharge-b |
            forall b: Nat; less_than(succ(k), b) or succ(k) = b or less_than(b, succ(k))
            [by forall_intro pointwise]
        }
      @induction-step-at-k |
        (forall b: Nat; less_than(k, b) or k = b or less_than(b, k)) -> forall b: Nat; less_than(succ(k), b) or succ(k) = b or less_than(b, succ(k))
        [by implies_intro given-inductive-hypothesis]
    }
  @induction-step-for-all-k |
    forall k: Nat; (forall b: Nat; less_than(k, b) or k = b or less_than(b, k)) -> forall b: Nat; less_than(succ(k), b) or succ(k) = b or less_than(b, succ(k))
    [by forall_intro induction-step]

  @conclusion |
    forall a, b: Nat; less_than(a, b) or a = b or less_than(b, a)
    [by instantiate induction((fun k: Nat => forall b: Nat; less_than(k, b) or k = b or less_than(b, k))) base-case induction-step-for-all-k]
qed

// Nothing sits below ZERO: a witness would make succ(add(a, u)) = ZERO,
// contradicting succNotZero. (simplify handles the addSuccRight push.)
theorem notLessThanZero: forall a: Nat; not less_than(a, ZERO)
proof
  @generalize-a |
    fix a: Nat {
      @given-a-below-zero |
        assume less_than(a, ZERO) {
          @less-than-elim |
            forall y, x: Nat; less_than(x, y) -> exists w: Nat; add(x, succ(w)) = y
            [by axiom lessThanElim]
          @gap-to-zero-exists-if-below |
            less_than(a, ZERO) -> exists w: Nat; add(a, succ(w)) = ZERO
            [by forall_elim(ZERO, a) less-than-elim]
          @a-below-zero |
            less_than(a, ZERO)
            [by hypothesis given-a-below-zero]
          @gap-to-zero-exists |
            exists w: Nat; add(a, succ(w)) = ZERO
            [by modus_ponens gap-to-zero-exists-if-below a-below-zero]
          @with-gap-u |
            unpack u: Nat from gap-to-zero-exists {
              @gap-reaches-zero |
                add(a, succ(u)) = ZERO
                [by hypothesis with-gap-u]
              @gap-is-successor |
                add(a, succ(u)) = succ(add(a, u))
                [by simplify addSuccRight]
              @successor-is-zero |
                succ(add(a, u)) = ZERO
                [by rewrite gap-is-successor gap-reaches-zero]
              @succ-not-zero |
                forall m: Nat; succ(m) != ZERO
                [by axiom succNotZero]
              @successor-is-nonzero |
                succ(add(a, u)) != ZERO
                [by forall_elim(add(a, u)) succ-not-zero]
              @not-a-below-zero |
                not less_than(a, ZERO)
                [by absurd successor-is-zero successor-is-nonzero]
            }
          @not-a-below-zero |
            not less_than(a, ZERO)
            [by exists_elim with-gap-u]
          @a-below-zero-restated |
            less_than(a, ZERO)
            [by hypothesis given-a-below-zero]
        }
      @no-a-below-zero |
        not less_than(a, ZERO)
        [by not_intro given-a-below-zero a-below-zero-restated not-a-below-zero]
    }
  @conclusion |
    forall a: Nat; not less_than(a, ZERO)
    [by forall_intro generalize-a]
qed

// Growing the bound preserves order: the witness for a < b grows by one.
theorem lessThanSuccRight: forall b, a: Nat; less_than(a, b) -> less_than(a, succ(b))
proof
  @generalize-b |
    fix b: Nat {
      @generalize-a |
        fix a: Nat {
          @given-a-below-b |
            assume less_than(a, b) {
              @less-than-elim |
                forall y, x: Nat; less_than(x, y) -> exists w: Nat; add(x, succ(w)) = y
                [by axiom lessThanElim]
              @gap-exists-if-below |
                less_than(a, b) -> exists w: Nat; add(a, succ(w)) = b
                [by forall_elim(b, a) less-than-elim]
              @a-below-b |
                less_than(a, b)
                [by hypothesis given-a-below-b]
              @gap-exists |
                exists w: Nat; add(a, succ(w)) = b
                [by modus_ponens gap-exists-if-below a-below-b]
              @with-gap-u |
                unpack u: Nat from gap-exists {
                  @gap-witnesses-b |
                    add(a, succ(u)) = b
                    [by hypothesis with-gap-u]
                  @grown-gap-is-successor |
                    add(a, succ(succ(u))) = succ(add(a, succ(u)))
                    [by simplify addSuccRight]
                  @grown-gap-reaches-succ-b |
                    add(a, succ(succ(u))) = succ(b)
                    [by rewrite gap-witnesses-b grown-gap-is-successor]
                  @a-gap-witnesses-less-than |
                    forall y, x, w: Nat; add(x, succ(w)) = y -> less_than(x, y)
                    [by axiom lessThanIntro]
                  @a-below-succ-b-if-gap |
                    add(a, succ(succ(u))) = succ(b) -> less_than(a, succ(b))
                    [by forall_elim(succ(b), a, succ(u)) a-gap-witnesses-less-than]
                  @a-below-succ-b |
                    less_than(a, succ(b))
                    [by modus_ponens a-below-succ-b-if-gap grown-gap-reaches-succ-b]
                }
              @a-below-succ-b |
                less_than(a, succ(b))
                [by exists_elim with-gap-u]
            }
          @a-below-b-implies-a-below-succ-b |
            less_than(a, b) -> less_than(a, succ(b))
            [by implies_intro given-a-below-b]
        }
      @discharge-a |
        forall a: Nat; less_than(a, b) -> less_than(a, succ(b))
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall b, a: Nat; less_than(a, b) -> less_than(a, succ(b))
    [by forall_intro generalize-b]
qed

// Strategy: induction on c with
// prop(k) := forall a, b: Nat; add(k, a) = add(k, b) -> a = b.
// Base strips add(ZERO, _); the step peels one succ with succInjective.
theorem lessThanAddCancelLeft: forall c, a, b: Nat; less_than(add(c, a), add(c, b)) -> less_than(a, b)
proof
  @generalize-c |
    fix c: Nat {
      @generalize-a |
        fix a: Nat {
          @generalize-b |
            fix b: Nat {
              @given-shifted-below |
                assume less_than(add(c, a), add(c, b)) {
                  @less-than-elim |
                    forall y, x: Nat; less_than(x, y) -> exists w: Nat; add(x, succ(w)) = y
                    [by axiom lessThanElim]
                  @shifted-gap-exists-if-below |
                    less_than(add(c, a), add(c, b)) -> exists w: Nat; add(add(c, a), succ(w)) = add(c, b)
                    [by forall_elim(add(c, b), add(c, a)) less-than-elim]
                  @shifted-below |
                    less_than(add(c, a), add(c, b))
                    [by hypothesis given-shifted-below]
                  @shifted-gap-exists |
                    exists w: Nat; add(add(c, a), succ(w)) = add(c, b)
                    [by modus_ponens shifted-gap-exists-if-below shifted-below]
                  @with-gap-u |
                    unpack u: Nat from shifted-gap-exists {
                      @shifted-gap-witnesses-c-plus-b |
                        add(add(c, a), succ(u)) = add(c, b)
                        [by hypothesis with-gap-u]
                      @shifted-gap-regroups |
                        add(add(c, a), succ(u)) = add(c, add(a, succ(u)))
                        [by simplify addIsAssociative]
                      @c-plus-gap-is-c-plus-b |
                        add(c, add(a, succ(u))) = add(c, b)
                        [by rewrite shifted-gap-regroups shifted-gap-witnesses-c-plus-b]
                      @addition-cancels-on-left |
                        forall x, y, z: Nat; add(x, y) = add(x, z) -> y = z
                        [by theorem peano.addCancelLeft]
                      @gap-witnesses-b-if-cancelled |
                        add(c, add(a, succ(u))) = add(c, b) -> add(a, succ(u)) = b
                        [by forall_elim(c, add(a, succ(u)), b) addition-cancels-on-left]
                      @gap-witnesses-b |
                        add(a, succ(u)) = b
                        [by modus_ponens gap-witnesses-b-if-cancelled c-plus-gap-is-c-plus-b]
                      @a-gap-witnesses-less-than |
                        forall y, x, w: Nat; add(x, succ(w)) = y -> less_than(x, y)
                        [by axiom lessThanIntro]
                      @a-below-b-if-gap |
                        add(a, succ(u)) = b -> less_than(a, b)
                        [by forall_elim(b, a, u) a-gap-witnesses-less-than]
                      @a-below-b |
                        less_than(a, b)
                        [by modus_ponens a-below-b-if-gap gap-witnesses-b]
                    }
                  @a-below-b |
                    less_than(a, b)
                    [by exists_elim with-gap-u]
                }
              @shifted-below-implies-a-below-b |
                less_than(add(c, a), add(c, b)) -> less_than(a, b)
                [by implies_intro given-shifted-below]
            }
          @discharge-b |
            forall b: Nat; less_than(add(c, a), add(c, b)) -> less_than(a, b)
            [by forall_intro generalize-b]
        }
      @discharge-a |
        forall a, b: Nat; less_than(add(c, a), add(c, b)) -> less_than(a, b)
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall c, a, b: Nat; less_than(add(c, a), add(c, b)) -> less_than(a, b)
    [by forall_intro generalize-c]
qed

// Swap the two outermost addends of a right-nested sum: the primitive move
// for sorting sums under associativity (used by certificate emitters).

// -- order helpers + strong induction (course-of-values) -------------------

theorem lessThanSelf: forall n: Nat; less_than(n, succ(n))
proof
  @generalize-n |
    fix n: Nat {
    // add(n, succ(ZERO)) = succ(n), so lessThanIntro gives n < succ(n)
      @unit-gap-reaches-succ-n |
        add(n, succ(ZERO)) = succ(n)
        [by simplify addSuccRight addZeroRight]
      @a-gap-witnesses-less-than |
        forall b, a, d: Nat; add(a, succ(d)) = b -> less_than(a, b)
        [by axiom lessThanIntro]
      @n-below-succ-n-if-gap |
        add(n, succ(ZERO)) = succ(n) -> less_than(n, succ(n))
        [by forall_elim(succ(n), n, ZERO) a-gap-witnesses-less-than]
      @n-below-succ-n |
        less_than(n, succ(n))
        [by modus_ponens n-below-succ-n-if-gap unit-gap-reaches-succ-n]
    }
  @conclusion |
    forall n: Nat; less_than(n, succ(n))
    [by forall_intro generalize-n]
qed

// m < succ(k)  ->  (m < k or m = k). The "predecessor bound": splits a
// strict-below-successor into strictly-below-or-equal. (trichotomy gives the
// three-way split; this is the two-way form the induction step needs.)
theorem lessThanSuccSplit: forall k, m: Nat; less_than(m, succ(k)) -> (less_than(m, k) or m = k)
proof
  @generalize-k |
    fix k: Nat {
      @generalize-m |
        fix m: Nat {
          @given-m-below-succ-k |
            assume less_than(m, succ(k)) {
              @m-below-succ-k |
                less_than(m, succ(k))
                [by hypothesis given-m-below-succ-k]
              @less-than-elim |
                forall b, a: Nat; less_than(a, b) -> exists d: Nat; add(a, succ(d)) = b
                [by axiom lessThanElim]
              @gap-exists-if-below |
                less_than(m, succ(k)) -> exists d: Nat; add(m, succ(d)) = succ(k)
                [by forall_elim(succ(k), m) less-than-elim]
              @gap-exists |
                exists d: Nat; add(m, succ(d)) = succ(k)
                [by modus_ponens gap-exists-if-below m-below-succ-k]
              @with-gap-d |
                unpack d0: Nat from gap-exists {
                  @gap-reaches-succ-k |
                    add(m, succ(d0)) = succ(k)
                    [by hypothesis with-gap-d]
                  @zero-or-successor |
                    forall n: Nat; n = ZERO or (exists mm: Nat; n = succ(mm))
                    [by theorem zeroOrSucc]
                  @gap-is-zero-or-successor |
                    d0 = ZERO or (exists mm: Nat; d0 = succ(mm))
                    [by forall_elim(d0) zero-or-successor]
          // d0 = ZERO: add(m, succ(ZERO)) = succ(k), so succ(m) = succ(k), m = k
                  @when-gap-is-zero |
                    assume d0 = ZERO {
                      @gap-is-zero |
                        d0 = ZERO
                        [by hypothesis when-gap-is-zero]
                      @unit-gap-reaches-succ-k |
                        add(m, succ(ZERO)) = succ(k)
                        [by rewrite gap-is-zero gap-reaches-succ-k]
                      @unit-gap-unfolds |
                        add(m, succ(ZERO)) = succ(add(m, ZERO))
                        [by simplify addSuccRight]
                      @add-zero-right |
                        forall n: Nat; add(n, ZERO) = n
                        [by theorem addZeroRight]
                      @m-plus-zero-is-m |
                        add(m, ZERO) = m
                        [by forall_elim(m) add-zero-right]
                      @unit-gap-is-succ-m |
                        add(m, succ(ZERO)) = succ(m)
                        [by rewrite m-plus-zero-is-m unit-gap-unfolds]
                      @succ-m-equals-succ-k |
                        succ(m) = succ(k)
                        [by rewrite unit-gap-is-succ-m unit-gap-reaches-succ-k]
                      @successor-is-injective |
                        forall a, b: Nat; succ(a) = succ(b) -> a = b
                        [by axiom succInjective]
                      @m-equals-k-if-succ-equal |
                        succ(m) = succ(k) -> m = k
                        [by forall_elim(m, k) successor-is-injective]
                      @m-equals-k |
                        m = k
                        [by modus_ponens m-equals-k-if-succ-equal succ-m-equals-succ-k]
                      @below-or-equal |
                        less_than(m, k) or m = k
                        [by or_intro_right m-equals-k]
                    }
          // d0 = succ(e0): add(m, succ(succ(e0))) = succ(k), so add(m,succ(e0)) = k, m < k
                  @when-gap-is-successor |
                    assume exists mm: Nat; d0 = succ(mm) {
                      @gap-is-some-successor |
                        exists mm: Nat; d0 = succ(mm)
                        [by hypothesis when-gap-is-successor]
                      @with-predecessor-e |
                        unpack e0: Nat from gap-is-some-successor {
                          @gap-is-succ-e |
                            d0 = succ(e0)
                            [by hypothesis with-predecessor-e]
                          @successor-gap-reaches-succ-k |
                            add(m, succ(succ(e0))) = succ(k)
                            [by rewrite gap-is-succ-e gap-reaches-succ-k]
                          @successor-gap-unfolds |
                            add(m, succ(succ(e0))) = succ(add(m, succ(e0)))
                            [by simplify addSuccRight]
                          @succ-of-inner-gap-is-succ-k |
                            succ(add(m, succ(e0))) = succ(k)
                            [by rewrite successor-gap-unfolds successor-gap-reaches-succ-k]
                          @successor-is-injective |
                            forall a, b: Nat; succ(a) = succ(b) -> a = b
                            [by axiom succInjective]
                          @inner-gap-is-k-if-succ-equal |
                            succ(add(m, succ(e0))) = succ(k) -> add(m, succ(e0)) = k
                            [by forall_elim(add(m, succ(e0)), k) successor-is-injective]
                          @inner-gap-reaches-k |
                            add(m, succ(e0)) = k
                            [by modus_ponens inner-gap-is-k-if-succ-equal succ-of-inner-gap-is-succ-k]
                          @a-gap-witnesses-less-than |
                            forall b, a, d: Nat; add(a, succ(d)) = b -> less_than(a, b)
                            [by axiom lessThanIntro]
                          @m-below-k-if-gap |
                            add(m, succ(e0)) = k -> less_than(m, k)
                            [by forall_elim(k, m, e0) a-gap-witnesses-less-than]
                          @m-below-k |
                            less_than(m, k)
                            [by modus_ponens m-below-k-if-gap inner-gap-reaches-k]
                          @below-or-equal |
                            less_than(m, k) or m = k
                            [by or_intro_left m-below-k]
                        }
                      @below-or-equal |
                        less_than(m, k) or m = k
                        [by exists_elim with-predecessor-e]
                    }
                  @below-or-equal |
                    less_than(m, k) or m = k
                    [by or_elim gap-is-zero-or-successor when-gap-is-zero when-gap-is-successor]
                }
              @below-or-equal |
                less_than(m, k) or m = k
                [by exists_elim with-gap-d]
            }
          @m-below-succ-k-implies-below-or-equal |
            less_than(m, succ(k)) -> (less_than(m, k) or m = k)
            [by implies_intro given-m-below-succ-k]
        }
      @discharge-m |
        forall m: Nat; less_than(m, succ(k)) -> (less_than(m, k) or m = k)
        [by forall_intro generalize-m]
    }
  @conclusion |
    forall k, m: Nat; less_than(m, succ(k)) -> (less_than(m, k) or m = k)
    [by forall_intro generalize-k]
qed

// -- strong induction -------------------------------------------------------

// Course-of-values induction: to prove P(n) for all n, it suffices to prove
// P(n) from the assumption that P(m) holds for every m < n.
//
// Derived from plain `induction` on the auxiliary predicate
//   Q(n) := forall m; m < n -> prop(m).
// Base Q(ZERO) is vacuous (nothing is below ZERO); the step Q(k) -> Q(succ k)
// uses lessThanSuccSplit to reduce m < succ(k) to m < k (use Q(k)) or m = k
// (use the strong step at k). Then prop(n) follows from Q(succ n) at m = n.
theorem strongInduction(prop: Nat -> Prop):
  (forall n: Nat; (forall m: Nat; less_than(m, n) -> prop(m)) -> prop(n))
  -> forall n: Nat; prop(n)
proof
  @given-strong-step |
    assume forall n: Nat; (forall m: Nat; less_than(m, n) -> prop(m)) -> prop(n) {
    // base: Q(ZERO) = forall m; m < ZERO -> prop(m), vacuously true
      @base-case-proof |
        fix m0: Nat {
          @given-m-below-zero |
            assume less_than(m0, ZERO) {
              @m-below-zero |
                less_than(m0, ZERO)
                [by hypothesis given-m-below-zero]
              @nothing-below-zero |
                forall a: Nat; not less_than(a, ZERO)
                [by theorem notLessThanZero]
              @m-not-below-zero |
                not less_than(m0, ZERO)
                [by forall_elim(m0) nothing-below-zero]
              @prop-holds-vacuously |
                prop(m0)
                [by absurd m-below-zero m-not-below-zero]
            }
          @below-zero-implies-prop |
            less_than(m0, ZERO) -> prop(m0)
            [by implies_intro given-m-below-zero]
        }
      @base-case |
        forall m: Nat; less_than(m, ZERO) -> prop(m)
        [by forall_intro base-case-proof]

    // step: Q(k) -> Q(succ k)
      @induction-step |
        fix k: Nat {
          @given-inductive-hypothesis |
            assume forall m: Nat; less_than(m, k) -> prop(m) {
              @inductive-hypothesis |
                forall m: Nat; less_than(m, k) -> prop(m)
                [by hypothesis given-inductive-hypothesis]
        // prop(k), from the strong step applied to Q(k)
              @strong-step |
                forall n: Nat; (forall m: Nat; less_than(m, n) -> prop(m)) -> prop(n)
                [by hypothesis given-strong-step]
              @prop-below-k-implies-prop-k |
                (forall m: Nat; less_than(m, k) -> prop(m)) -> prop(k)
                [by forall_elim(k) strong-step]
              @prop-k |
                prop(k)
                [by modus_ponens prop-below-k-implies-prop-k inductive-hypothesis]
        // Q(succ k): forall m; m < succ k -> prop(m)
              @generalize-m |
                fix m1: Nat {
                  @given-m-below-succ-k |
                    assume less_than(m1, succ(k)) {
                      @m-below-succ-k |
                        less_than(m1, succ(k))
                        [by hypothesis given-m-below-succ-k]
                      @below-succ-splits |
                        forall kk, mm: Nat; less_than(mm, succ(kk)) -> (less_than(mm, kk) or mm = kk)
                        [by theorem lessThanSuccSplit]
                      @m-below-k-or-equal-if-below-succ |
                        less_than(m1, succ(k)) -> (less_than(m1, k) or m1 = k)
                        [by forall_elim(k, m1) below-succ-splits]
                      @m-below-k-or-equal |
                        less_than(m1, k) or m1 = k
                        [by modus_ponens m-below-k-or-equal-if-below-succ m-below-succ-k]
                      @when-m-below-k |
                        assume less_than(m1, k) {
                          @m-below-k |
                            less_than(m1, k)
                            [by hypothesis when-m-below-k]
                          @prop-m-if-below-k |
                            less_than(m1, k) -> prop(m1)
                            [by forall_elim(m1) inductive-hypothesis]
                          @prop-m |
                            prop(m1)
                            [by modus_ponens prop-m-if-below-k m-below-k]
                        }
                      @when-m-equals-k |
                        assume m1 = k {
                          @m-equals-k |
                            m1 = k
                            [by hypothesis when-m-equals-k]
                          @k-equals-m |
                            k = m1
                            [by symmetry m-equals-k]
                          @prop-m |
                            prop(m1)
                            [by rewrite k-equals-m prop-k]
                        }
                      @prop-m |
                        prop(m1)
                        [by or_elim m-below-k-or-equal when-m-below-k when-m-equals-k]
                    }
                  @below-succ-k-implies-prop |
                    less_than(m1, succ(k)) -> prop(m1)
                    [by implies_intro given-m-below-succ-k]
                }
              @prop-holds-below-succ-k |
                forall m: Nat; less_than(m, succ(k)) -> prop(m)
                [by forall_intro generalize-m]
            }
          @induction-step-at-k |
            (forall m: Nat; less_than(m, k) -> prop(m)) -> forall m: Nat; less_than(m, succ(k)) -> prop(m)
            [by implies_intro given-inductive-hypothesis]
        }
      @induction-step-for-all-k |
        forall k: Nat; (forall m: Nat; less_than(m, k) -> prop(m)) -> forall m: Nat; less_than(m, succ(k)) -> prop(m)
        [by forall_intro induction-step]

    // forall n; Q(n), by ordinary induction on the auxiliary predicate
      @prop-holds-below-every-n |
        forall n: Nat; forall m: Nat; less_than(m, n) -> prop(m)
        [by instantiate induction((fun j: Nat => forall m: Nat; less_than(m, j) -> prop(m))) base-case induction-step-for-all-k]

    // prop(n) from Q(succ n) applied at m = n (using n < succ n)
      @generalize-n |
        fix n1: Nat {
          @prop-holds-below-succ-n |
            forall m: Nat; less_than(m, succ(n1)) -> prop(m)
            [by forall_elim(succ(n1)) prop-holds-below-every-n]
          @prop-n-if-below-succ-n |
            less_than(n1, succ(n1)) -> prop(n1)
            [by forall_elim(n1) prop-holds-below-succ-n]
          @n-below-succ-n-lemma |
            forall n: Nat; less_than(n, succ(n))
            [by theorem lessThanSelf]
          @n-below-succ-n |
            less_than(n1, succ(n1))
            [by forall_elim(n1) n-below-succ-n-lemma]
          @prop-n |
            prop(n1)
            [by modus_ponens prop-n-if-below-succ-n n-below-succ-n]
        }
      @prop-holds-for-all |
        forall n: Nat; prop(n)
        [by forall_intro generalize-n]
    }
  @conclusion |
    (forall n: Nat; (forall m: Nat; less_than(m, n) -> prop(m)) -> prop(n)) -> forall n: Nat; prop(n)
    [by implies_intro given-strong-step]
qed

// -- the less_or_equal relation -------------------------------------------

theorem lessOrEqualToLessThanSucc: forall b, a: Nat; less_or_equal(a, b) -> less_than(a, succ(b))
proof
  @generalize-b |
    fix b: Nat {
      @generalize-a |
        fix a: Nat {
          @given-a-at-most-b |
            assume less_or_equal(a, b) {
              @a-at-most-b |
                less_or_equal(a, b)
                [by hypothesis given-a-at-most-b]
              @less-or-equal-elim |
                forall bb, aa: Nat; less_or_equal(aa, bb) -> exists d: Nat; add(aa, d) = bb
                [by axiom lessOrEqualElim]
              @gap-exists-if-at-most |
                less_or_equal(a, b) -> exists d: Nat; add(a, d) = b
                [by forall_elim(b, a) less-or-equal-elim]
              @gap-exists |
                exists d: Nat; add(a, d) = b
                [by modus_ponens gap-exists-if-at-most a-at-most-b]
              @with-gap-d |
                unpack d0: Nat from gap-exists {
                  @gap-witnesses-b |
                    add(a, d0) = b
                    [by hypothesis with-gap-d]
          // add(a, succ d0) = succ(add(a, d0)) = succ b
                  @grown-gap-is-successor |
                    add(a, succ(d0)) = succ(add(a, d0))
                    [by simplify addSuccRight]
                  @gap-successor-refl |
                    succ(add(a, d0)) = succ(add(a, d0))
                    [by reflexivity]
                  @gap-successor-is-succ-b |
                    succ(add(a, d0)) = succ(b)
                    [by rewrite gap-witnesses-b gap-successor-refl]
                  @grown-gap-reaches-succ-b |
                    add(a, succ(d0)) = succ(b)
                    [by rewrite gap-successor-is-succ-b grown-gap-is-successor]
                  @a-gap-witnesses-less-than |
                    forall y, x, d: Nat; add(x, succ(d)) = y -> less_than(x, y)
                    [by axiom lessThanIntro]
                  @a-below-succ-b-if-gap |
                    add(a, succ(d0)) = succ(b) -> less_than(a, succ(b))
                    [by forall_elim(succ(b), a, d0) a-gap-witnesses-less-than]
                  @a-below-succ-b |
                    less_than(a, succ(b))
                    [by modus_ponens a-below-succ-b-if-gap grown-gap-reaches-succ-b]
                }
              @a-below-succ-b |
                less_than(a, succ(b))
                [by exists_elim with-gap-d]
            }
          @at-most-b-implies-below-succ-b |
            less_or_equal(a, b) -> less_than(a, succ(b))
            [by implies_intro given-a-at-most-b]
        }
      @discharge-a |
        forall a: Nat; less_or_equal(a, b) -> less_than(a, succ(b))
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall b, a: Nat; less_or_equal(a, b) -> less_than(a, succ(b))
    [by forall_intro generalize-b]
qed

// Bridge 2 (reverse): less_than(a, succ b) -> le(a, b).
// From lessThanElim: add(a, succ d) = succ b; succInjective-ish? No: succ b so add(a,succ d)=succ b.
// add(a, succ d) = succ(add(a,d)) [addSuccRight]; = succ b; succInjective => add(a,d) = b; leIntro.
theorem lessThanSuccToLessOrEqual: forall b, a: Nat; less_than(a, succ(b)) -> less_or_equal(a, b)
proof
  @generalize-b |
    fix b: Nat {
      @generalize-a |
        fix a: Nat {
          @given-a-below-succ-b |
            assume less_than(a, succ(b)) {
              @a-below-succ-b |
                less_than(a, succ(b))
                [by hypothesis given-a-below-succ-b]
              @less-than-elim |
                forall y, x: Nat; less_than(x, y) -> exists d: Nat; add(x, succ(d)) = y
                [by axiom lessThanElim]
              @gap-exists-if-below |
                less_than(a, succ(b)) -> exists d: Nat; add(a, succ(d)) = succ(b)
                [by forall_elim(succ(b), a) less-than-elim]
              @gap-exists |
                exists d: Nat; add(a, succ(d)) = succ(b)
                [by modus_ponens gap-exists-if-below a-below-succ-b]
              @with-gap-d |
                unpack d0: Nat from gap-exists {
                  @gap-reaches-succ-b |
                    add(a, succ(d0)) = succ(b)
                    [by hypothesis with-gap-d]
                  @gap-is-successor |
                    add(a, succ(d0)) = succ(add(a, d0))
                    [by simplify addSuccRight]
                  @succ-of-lesser-gap-is-succ-b |
                    succ(add(a, d0)) = succ(b)
                    [by rewrite gap-is-successor gap-reaches-succ-b]
                  @successor-is-injective |
                    forall x, y: Nat; succ(x) = succ(y) -> x = y
                    [by axiom succInjective]
                  @lesser-gap-is-b-if-succ-equal |
                    succ(add(a, d0)) = succ(b) -> add(a, d0) = b
                    [by forall_elim(add(a, d0), b) successor-is-injective]
                  @lesser-gap-witnesses-b |
                    add(a, d0) = b
                    [by modus_ponens lesser-gap-is-b-if-succ-equal succ-of-lesser-gap-is-succ-b]
                  @a-gap-witnesses-at-most |
                    forall bb, aa, d: Nat; add(aa, d) = bb -> less_or_equal(aa, bb)
                    [by axiom lessOrEqualIntro]
                  @a-at-most-b-if-gap |
                    add(a, d0) = b -> less_or_equal(a, b)
                    [by forall_elim(b, a, d0) a-gap-witnesses-at-most]
                  @a-at-most-b |
                    less_or_equal(a, b)
                    [by modus_ponens a-at-most-b-if-gap lesser-gap-witnesses-b]
                }
              @a-at-most-b |
                less_or_equal(a, b)
                [by exists_elim with-gap-d]
            }
          @below-succ-b-implies-at-most-b |
            less_than(a, succ(b)) -> less_or_equal(a, b)
            [by implies_intro given-a-below-succ-b]
        }
      @discharge-a |
        forall a: Nat; less_than(a, succ(b)) -> less_or_equal(a, b)
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall b, a: Nat; less_than(a, succ(b)) -> less_or_equal(a, b)
    [by forall_intro generalize-b]
qed

// reflexivity: le(a, a). Witness d = ZERO: add(a, ZERO) = a.
theorem lessOrEqualRefl: forall a: Nat; less_or_equal(a, a)
proof
  @generalize-a |
    fix a: Nat {
      @add-zero-right |
        forall n: Nat; add(n, ZERO) = n
        [by theorem addZeroRight]
      @zero-gap-reaches-a |
        add(a, ZERO) = a
        [by forall_elim(a) add-zero-right]
      @a-gap-witnesses-at-most |
        forall bb, aa, d: Nat; add(aa, d) = bb -> less_or_equal(aa, bb)
        [by axiom lessOrEqualIntro]
      @a-at-most-a-if-gap |
        add(a, ZERO) = a -> less_or_equal(a, a)
        [by forall_elim(a, a, ZERO) a-gap-witnesses-at-most]
      @a-at-most-a |
        less_or_equal(a, a)
        [by modus_ponens a-at-most-a-if-gap zero-gap-reaches-a]
    }
  @conclusion |
    forall a: Nat; less_or_equal(a, a)
    [by forall_intro generalize-a]
qed

// less_than implies less_or_equal
theorem lessThanToLessOrEqual: forall b, a: Nat; less_than(a, b) -> less_or_equal(a, b)
proof
  @generalize-b |
    fix b: Nat {
      @generalize-a |
        fix a: Nat {
          @given-a-below-b |
            assume less_than(a, b) {
              @a-below-b |
                less_than(a, b)
                [by hypothesis given-a-below-b]
        // a < b gives a strict gap add(a, succ d) = b, which is also an at-most gap
              @less-than-elim |
                forall y, x: Nat; less_than(x, y) -> exists d: Nat; add(x, succ(d)) = y
                [by axiom lessThanElim]
              @gap-exists-if-below |
                less_than(a, b) -> exists d: Nat; add(a, succ(d)) = b
                [by forall_elim(b, a) less-than-elim]
              @gap-exists |
                exists d: Nat; add(a, succ(d)) = b
                [by modus_ponens gap-exists-if-below a-below-b]
              @with-gap-d |
                unpack d0: Nat from gap-exists {
                  @gap-witnesses-b |
                    add(a, succ(d0)) = b
                    [by hypothesis with-gap-d]
                  @a-gap-witnesses-at-most |
                    forall bb, aa, d: Nat; add(aa, d) = bb -> less_or_equal(aa, bb)
                    [by axiom lessOrEqualIntro]
                  @a-at-most-b-if-gap |
                    add(a, succ(d0)) = b -> less_or_equal(a, b)
                    [by forall_elim(b, a, succ(d0)) a-gap-witnesses-at-most]
                  @a-at-most-b |
                    less_or_equal(a, b)
                    [by modus_ponens a-at-most-b-if-gap gap-witnesses-b]
                }
              @a-at-most-b |
                less_or_equal(a, b)
                [by exists_elim with-gap-d]
            }
          @below-b-implies-at-most-b |
            less_than(a, b) -> less_or_equal(a, b)
            [by implies_intro given-a-below-b]
        }
      @discharge-a |
        forall a: Nat; less_than(a, b) -> less_or_equal(a, b)
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall b, a: Nat; less_than(a, b) -> less_or_equal(a, b)
    [by forall_intro generalize-b]
qed

// transitivity: le(a,b) -> le(b,c) -> le(a,c).
// witnesses: add(a,d1)=b, add(b,d2)=c; then add(a, add(d1,d2)) = c via assoc.
theorem lessOrEqualTransitive: forall c, b, a: Nat; less_or_equal(a, b) -> less_or_equal(b, c) -> less_or_equal(a, c)
proof
  @generalize-c |
    fix c: Nat {
      @generalize-b |
        fix b: Nat {
          @generalize-a |
            fix a: Nat {
              @given-a-at-most-b |
                assume less_or_equal(a, b) {
                  @given-b-at-most-c |
                    assume less_or_equal(b, c) {
                      @a-at-most-b |
                        less_or_equal(a, b)
                        [by hypothesis given-a-at-most-b]
                      @b-at-most-c |
                        less_or_equal(b, c)
                        [by hypothesis given-b-at-most-c]
                      @less-or-equal-elim |
                        forall bb, aa: Nat; less_or_equal(aa, bb) -> exists d: Nat; add(aa, d) = bb
                        [by axiom lessOrEqualElim]
                      @gap-ab-exists-if-at-most |
                        less_or_equal(a, b) -> exists d: Nat; add(a, d) = b
                        [by forall_elim(b, a) less-or-equal-elim]
                      @gap-ab-exists |
                        exists d: Nat; add(a, d) = b
                        [by modus_ponens gap-ab-exists-if-at-most a-at-most-b]
                      @gap-bc-exists-if-at-most |
                        less_or_equal(b, c) -> exists d: Nat; add(b, d) = c
                        [by forall_elim(c, b) less-or-equal-elim]
                      @gap-bc-exists |
                        exists d: Nat; add(b, d) = c
                        [by modus_ponens gap-bc-exists-if-at-most b-at-most-c]
                      @with-gap-d1 |
                        unpack d1: Nat from gap-ab-exists {
                          @gap-d1-witnesses-b |
                            add(a, d1) = b
                            [by hypothesis with-gap-d1]
                          @with-gap-d2 |
                            unpack d2: Nat from gap-bc-exists {
                              @gap-d2-witnesses-c |
                                add(b, d2) = c
                                [by hypothesis with-gap-d2]
                              @nested-gaps-regroup |
                                add(add(a, d1), d2) = add(a, add(d1, d2))
                                [by simplify addIsAssociative]
                // rewrite add(a,d1) -> b: from add(b,d2)=c get add(add(a,d1),d2)=c
                              @b-is-a-plus-gap-d1 |
                                b = add(a, d1)
                                [by symmetry gap-d1-witnesses-b]
                              @nested-gaps-reach-c |
                                add(add(a, d1), d2) = c
                                [by rewrite b-is-a-plus-gap-d1 gap-d2-witnesses-c]
                // regroup to a single gap add(d1, d2) reaching c
                              @combined-gap-reaches-c |
                                add(a, add(d1, d2)) = c
                                [by rewrite nested-gaps-regroup nested-gaps-reach-c]
                              @a-gap-witnesses-at-most |
                                forall bb, aa, d: Nat; add(aa, d) = bb -> less_or_equal(aa, bb)
                                [by axiom lessOrEqualIntro]
                              @a-at-most-c-if-gap |
                                add(a, add(d1, d2)) = c -> less_or_equal(a, c)
                                [by forall_elim(c, a, add(d1, d2)) a-gap-witnesses-at-most]
                              @a-at-most-c |
                                less_or_equal(a, c)
                                [by modus_ponens a-at-most-c-if-gap combined-gap-reaches-c]
                            }
                          @a-at-most-c |
                            less_or_equal(a, c)
                            [by exists_elim with-gap-d2]
                        }
                      @a-at-most-c |
                        less_or_equal(a, c)
                        [by exists_elim with-gap-d1]
                    }
                  @b-at-most-c-implies-a-at-most-c |
                    less_or_equal(b, c) -> less_or_equal(a, c)
                    [by implies_intro given-b-at-most-c]
                }
              @a-at-most-b-implies-transitively-at-most-c |
                less_or_equal(a, b) -> less_or_equal(b, c) -> less_or_equal(a, c)
                [by implies_intro given-a-at-most-b]
            }
          @discharge-a |
            forall a: Nat; less_or_equal(a, b) -> less_or_equal(b, c) -> less_or_equal(a, c)
            [by forall_intro generalize-a]
        }
      @discharge-b |
        forall b, a: Nat; less_or_equal(a, b) -> less_or_equal(b, c) -> less_or_equal(a, c)
        [by forall_intro generalize-b]
    }
  @conclusion |
    forall c, b, a: Nat; less_or_equal(a, b) -> less_or_equal(b, c) -> less_or_equal(a, c)
    [by forall_intro generalize-c]
qed

// disjunctive form: le(a,b) -> (a < b or a = b). Via bridge1 (a < succ b) + lessThanSuccSplit.
theorem lessOrEqualSplit: forall b, a: Nat; less_or_equal(a, b) -> (less_than(a, b) or a = b)
proof
  @generalize-b |
    fix b: Nat {
      @generalize-a |
        fix a: Nat {
          @given-a-at-most-b |
            assume less_or_equal(a, b) {
              @a-at-most-b |
                less_or_equal(a, b)
                [by hypothesis given-a-at-most-b]
        // le -> a < succ b
              @at-most-implies-below-succ |
                forall bb, aa: Nat; less_or_equal(aa, bb) -> less_than(aa, succ(bb))
                [by theorem lessOrEqualToLessThanSucc]
              @a-below-succ-b-if-at-most |
                less_or_equal(a, b) -> less_than(a, succ(b))
                [by forall_elim(b, a) at-most-implies-below-succ]
              @a-below-succ-b |
                less_than(a, succ(b))
                [by modus_ponens a-below-succ-b-if-at-most a-at-most-b]
        // a < succ b -> a < b or a = b [lessThanSuccSplit]
              @below-succ-splits |
                forall kk, mm: Nat; less_than(mm, succ(kk)) -> (less_than(mm, kk) or mm = kk)
                [by theorem lessThanSuccSplit]
              @a-below-b-or-equal-if-below-succ |
                less_than(a, succ(b)) -> (less_than(a, b) or a = b)
                [by forall_elim(b, a) below-succ-splits]
              @a-below-b-or-equal |
                less_than(a, b) or a = b
                [by modus_ponens a-below-b-or-equal-if-below-succ a-below-succ-b]
            }
          @at-most-b-implies-below-or-equal |
            less_or_equal(a, b) -> (less_than(a, b) or a = b)
            [by implies_intro given-a-at-most-b]
        }
      @discharge-a |
        forall a: Nat; less_or_equal(a, b) -> (less_than(a, b) or a = b)
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall b, a: Nat; less_or_equal(a, b) -> (less_than(a, b) or a = b)
    [by forall_intro generalize-b]
qed

// equal-or-less builds le the other way: a = b -> le(a,b) is refl+rewrite; a<b -> le is lessThanToLessOrEqual.
// antisymmetry: le(a,b) -> le(b,a) -> a = b. Use split: a<b or a=b; if a<b and b<=a then a<a (contra via transitive+irrefl).
theorem lessOrEqualAntisymmetric: forall b, a: Nat; less_or_equal(a, b) -> less_or_equal(b, a) -> a = b
proof
  @generalize-b |
    fix b: Nat {
      @generalize-a |
        fix a: Nat {
          @given-a-at-most-b |
            assume less_or_equal(a, b) {
              @given-b-at-most-a |
                assume less_or_equal(b, a) {
                  @a-at-most-b |
                    less_or_equal(a, b)
                    [by hypothesis given-a-at-most-b]
                  @b-at-most-a |
                    less_or_equal(b, a)
                    [by hypothesis given-b-at-most-a]
          // split le(a,b): a<b or a=b
                  @at-most-splits |
                    forall bb, aa: Nat; less_or_equal(aa, bb) -> (less_than(aa, bb) or aa = bb)
                    [by theorem lessOrEqualSplit]
                  @a-below-b-or-equal-if-at-most |
                    less_or_equal(a, b) -> (less_than(a, b) or a = b)
                    [by forall_elim(b, a) at-most-splits]
                  @a-below-b-or-equal |
                    less_than(a, b) or a = b
                    [by modus_ponens a-below-b-or-equal-if-at-most a-at-most-b]
                  @when-a-below-b |
                    assume less_than(a, b) {
                      @a-below-b |
                        less_than(a, b)
                        [by hypothesis when-a-below-b]
            // le(b,a) and a<b: split le(b,a) -> b<a or b=a
                      @b-below-a-or-equal-if-at-most |
                        less_or_equal(b, a) -> (less_than(b, a) or b = a)
                        [by forall_elim(a, b) at-most-splits]
                      @b-below-a-or-equal |
                        less_than(b, a) or b = a
                        [by modus_ponens b-below-a-or-equal-if-at-most b-at-most-a]
                      @when-b-below-a |
                        assume less_than(b, a) {
                          @b-below-a |
                            less_than(b, a)
                            [by hypothesis when-b-below-a]
              // a<b and b<a -> a<a via transitive, contradiction with irreflexive
                          @less-than-transitive |
                            forall cc, bb, aa: Nat; less_than(aa, bb) -> less_than(bb, cc) -> less_than(aa, cc)
                            [by theorem lessThanTransitive]
                          @a-below-a-if-below-both-ways |
                            less_than(a, b) -> less_than(b, a) -> less_than(a, a)
                            [by forall_elim(a, b, a) less-than-transitive]
                          @a-below-a-if-b-below-a |
                            less_than(b, a) -> less_than(a, a)
                            [by modus_ponens a-below-a-if-below-both-ways a-below-b]
                          @a-below-a |
                            less_than(a, a)
                            [by modus_ponens a-below-a-if-b-below-a b-below-a]
                          @less-than-irreflexive |
                            forall n: Nat; not less_than(n, n)
                            [by theorem lessThanIrreflexive]
                          @not-a-below-a |
                            not less_than(a, a)
                            [by forall_elim(a) less-than-irreflexive]
                          @a-equals-b-vacuously |
                            a = b
                            [by absurd a-below-a not-a-below-a]
                        }
                      @when-b-equals-a |
                        assume b = a {
                          @b-equals-a |
                            b = a
                            [by hypothesis when-b-equals-a]
                          @a-equals-b |
                            a = b
                            [by symmetry b-equals-a]
                        }
                      @a-equals-b |
                        a = b
                        [by or_elim b-below-a-or-equal when-b-below-a when-b-equals-a]
                    }
                  @when-a-equals-b |
                    assume a = b {
                      @a-equals-b |
                        a = b
                        [by hypothesis when-a-equals-b]
                    }
                  @a-equals-b |
                    a = b
                    [by or_elim a-below-b-or-equal when-a-below-b when-a-equals-b]
                }
              @b-at-most-a-implies-equal |
                less_or_equal(b, a) -> a = b
                [by implies_intro given-b-at-most-a]
            }
          @at-most-both-ways-implies-equal |
            less_or_equal(a, b) -> less_or_equal(b, a) -> a = b
            [by implies_intro given-a-at-most-b]
        }
      @discharge-a |
        forall a: Nat; less_or_equal(a, b) -> less_or_equal(b, a) -> a = b
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall b, a: Nat; less_or_equal(a, b) -> less_or_equal(b, a) -> a = b
    [by forall_intro generalize-b]
qed

// Left multiplicative cancellation: a nonzero common left factor cancels.
// Strategy: c = succ(c'); trichotomy on a, b; the two strict arms multiply
// through by succ(c') (multiplicationPreservesOrder) to contradict
// mul(c, a) = mul(c, b) via lessThanIrreflexive.
theorem mulCancelLeft: forall c, a, b: Nat; c != ZERO -> mul(c, a) = mul(c, b) -> a = b
proof
  @generalize-c |
    fix c: Nat {
      @generalize-a |
        fix a: Nat {
          @generalize-b |
            fix b: Nat {
              @given-c-nonzero |
                assume c != ZERO {
                  @given-products-equal |
                    assume mul(c, a) = mul(c, b) {
                      @products-equal |
                        mul(c, a) = mul(c, b)
                        [by hypothesis given-products-equal]
                      @c-nonzero |
                        c != ZERO
                        [by hypothesis given-c-nonzero]
                      @zero-or-succ |
                        forall n: Nat; n = ZERO or (exists m: Nat; n = succ(m))
                        [by theorem zeroOrSucc]
                      @c-is-zero-or-succ |
                        c = ZERO or (exists m: Nat; c = succ(m))
                        [by forall_elim(c) zero-or-succ]
                      @c-is-succ |
                        exists m: Nat; c = succ(m)
                        [by tautology c-is-zero-or-succ c-nonzero]
                      @with-c-pred |
                        unpack cp: Nat from c-is-succ {
                          @c-equals-succ-cp |
                            c = succ(cp)
                            [by hypothesis with-c-pred]
                          @trich |
                            forall aa, bb: Nat; less_than(aa, bb) or aa = bb or less_than(bb, aa)
                            [by theorem trichotomy]
                          @tri |
                            less_than(a, b) or a = b or less_than(b, a)
                            [by forall_elim(a, b) trich]
                          @equal-conclusion |
                            a = b
                            case on tri {
                              @a-below-b |
                                assume less_than(a, b) {
                                  @a-lt-b |
                                    less_than(a, b)
                                    [by hypothesis a-below-b]
                                  @mono |
                                    forall cc, bb, aa: Nat; less_than(aa, bb) -> less_than(mul(succ(cc), aa), mul(succ(cc), bb))
                                    [by theorem multiplicationPreservesOrder]
                                  @mono-at |
                                    less_than(a, b) -> less_than(mul(succ(cp), a), mul(succ(cp), b))
                                    [by forall_elim(cp, b, a) mono]
                                  @scaled |
                                    less_than(mul(succ(cp), a), mul(succ(cp), b))
                                    [by modus_ponens mono-at a-lt-b]
                                  @cp-back |
                                    succ(cp) = c
                                    [by symmetry c-equals-succ-cp]
                                  @scaled-c |
                                    less_than(mul(c, a), mul(c, b))
                                    [by rewrite cp-back scaled]
                                  @products-equal-sym |
                                    mul(c, b) = mul(c, a)
                                    [by symmetry products-equal]
                                  @self-lt |
                                    less_than(mul(c, a), mul(c, a))
                                    [by rewrite products-equal-sym scaled-c]
                                  @irrefl |
                                    forall n: Nat; not less_than(n, n)
                                    [by theorem lessThanIrreflexive]
                                  @not-self-lt |
                                    not less_than(mul(c, a), mul(c, a))
                                    [by forall_elim(mul(c, a)) irrefl]
                                  @absurd-a-below-b |
                                    a = b
                                    [by absurd self-lt not-self-lt]
                                }
                              @a-equals-b |
                                assume a = b {
                                  @eq |
                                    a = b
                                    [by hypothesis a-equals-b]
                                }
                              @b-below-a |
                                assume less_than(b, a) {
                                  @b-lt-a |
                                    less_than(b, a)
                                    [by hypothesis b-below-a]
                                  @mono |
                                    forall cc, bb, aa: Nat; less_than(aa, bb) -> less_than(mul(succ(cc), aa), mul(succ(cc), bb))
                                    [by theorem multiplicationPreservesOrder]
                                  @mono-at |
                                    less_than(b, a) -> less_than(mul(succ(cp), b), mul(succ(cp), a))
                                    [by forall_elim(cp, a, b) mono]
                                  @scaled |
                                    less_than(mul(succ(cp), b), mul(succ(cp), a))
                                    [by modus_ponens mono-at b-lt-a]
                                  @cp-back |
                                    succ(cp) = c
                                    [by symmetry c-equals-succ-cp]
                                  @scaled-c |
                                    less_than(mul(c, b), mul(c, a))
                                    [by rewrite cp-back scaled]
                                  @self-lt |
                                    less_than(mul(c, b), mul(c, b))
                                    [by rewrite products-equal scaled-c]
                                  @irrefl |
                                    forall n: Nat; not less_than(n, n)
                                    [by theorem lessThanIrreflexive]
                                  @not-self-lt |
                                    not less_than(mul(c, b), mul(c, b))
                                    [by forall_elim(mul(c, b)) irrefl]
                                  @absurd-b-below-a |
                                    a = b
                                    [by absurd self-lt not-self-lt]
                                }
                            }
                        }
                      @conclusion-inner |
                        a = b
                        [by exists_elim with-c-pred]
                    }
                  @discharge-products |
                    mul(c, a) = mul(c, b) -> a = b
                    [by implies_intro given-products-equal]
                }
              @discharge-nonzero |
                c != ZERO -> mul(c, a) = mul(c, b) -> a = b
                [by implies_intro given-c-nonzero]
            }
          @discharge-b |
            forall b: Nat; c != ZERO -> mul(c, a) = mul(c, b) -> a = b
            [by forall_intro generalize-b]
        }
      @discharge-a |
        forall a, b: Nat; c != ZERO -> mul(c, a) = mul(c, b) -> a = b
        [by forall_intro generalize-a]
    }
  @conclusion |
    forall c, a, b: Nat; c != ZERO -> mul(c, a) = mul(c, b) -> a = b
    [by forall_intro generalize-c]
qed
