// The anonymous inline `where` (a binder `x: G where D`) rejects a define'd guard
// too, until where-reification lands (task #125). Same rule as the named-sort
// case — a define produces a value, and a refinement needs a pred symbol.

sort Nat
const ZERO: Nat
func succ(n: Nat): Nat

define isBig(n: Nat) = exists m: Nat; n = succ(m)

theorem inlineGuardBad: forall x: Nat where isBig; x = x
proof
  @conclusion | forall x: Nat where isBig; x = x [by reflexivity]
qed
