// A `hole` is an aspirational placeholder — an axiom-shaped claim you intend to
// prove (scaffolding) or deliberately assume (conditional reasoning). Default
// mode rejects any proof that rests on one; --draft allows it.
sort Nat
const ZERO: Nat
func succ(n: Nat): Nat
pred even(n: Nat)

// aspirational: we haven't proved this yet, but we build on it.
  hole zeroIsEven: even(ZERO)

// a real theorem that rests on the hole.
theorem restsOnHole: even(ZERO)
proof
  @zero-even |
    even(ZERO)
    [by axiom zeroIsEven]
  @conclusion |
    even(ZERO)
    [by axiom zeroIsEven]
qed
