// ITERATED SUBGROUPS, K < H < G — a subgroup of a subgroup, END TO END.
//
// This is Level 2 of the model-parameters design: the subgroup-of-a-subgroup
// hierarchy composes on EXISTING machinery, because refined sorts carry their
// predicate, so the model stack for K plugs into the one for H with no new
// syntax. The flattened representation keeps each guard a SINGLE predicate: K's
// membership `inK` is a predicate over the base group Grp, `K = Grp where inK`,
// and `inK(g) -> inH(g)` records that K really lies inside the subgroup H.
//
// The stack, twice:
//   H:  HSubGroup (inH is a subgroup) -> HGroup (inH is a group)
//   K:  KSubGroup (inK is a subgroup) -> KGroup (inK is a group)
// Then three group theorems transfer onto K, the sub-subgroup — kernel-checked,
// no accelerated tactics. Exercises the DIRECT-MAPPED-axiom transfer: HGroup and
// KGroup discharge `group.opAssoc` (an AXIOM) through a `@`-projection mapping
// value, which materialization resolves by citing the mapped discharge directly.

import group <<< "std/group.bpa"
import subgroup <<< "std/subgroup.bpa"

// the ambient GROUP, reified into this file.
sort Grp = group.Grp
const E = group.E
func op = group.op
func inverse = group.inverse

// ── H < G: a subgroup inH of the group Grp. ───────────────────────────────────
pred inH(g: Grp)
sort H = Grp where inH

axiom hHasIdentity: inH(E)
axiom hClosedOp: forall a, b: Grp; inH(a) -> inH(b) -> inH(op(a, b))
axiom hClosedInverse: forall a: Grp; inH(a) -> inH(inverse(a))

// HSubGroup: inH IS a subgroup (models the standalone subgroup theory onto inH).
model HSubGroup {
  subgroup.Grp: Grp
  subgroup.Sub: H
  subgroup.op: op
  subgroup.inverse: inverse
  subgroup.E: E
  subgroup.inSubgroup: inH
  subgroup.subgroupHasIdentity: hHasIdentity
  subgroup.subgroupClosedOp: hClosedOp
  subgroup.subgroupClosedInverse: hClosedInverse
  subgroup.grpAssoc: group.opAssoc
  subgroup.grpIdentityLeft: group.opIdentityLeft
  subgroup.grpIdentityRight: group.opIdentityRight
  subgroup.grpInverseLeft: group.opInverseLeft
  subgroup.grpInverseRight: group.opInverseRight
}

// HGroup: inH IS a group, routing each group.X through HSubGroup.
model HGroup {
  group.Grp: H
  group.op: op
  group.inverse: inverse
  group.E: E
  group.opAssoc: HSubGroup @subgroup.opAssoc
  group.opIdentityLeft: HSubGroup @subgroup.opIdentityLeft
  group.opIdentityRight: HSubGroup @subgroup.opIdentityRight
  group.opInverseLeft: HSubGroup @subgroup.opInverseLeft
  group.opInverseRight: HSubGroup @subgroup.opInverseRight
}

// ── K < H < G: a subgroup inK of the subgroup H. ──────────────────────────────
// inK is a single predicate over Grp; `kInH` witnesses K ⊆ H.
pred inK(g: Grp)
sort K = Grp where inK

axiom kInH: forall g: Grp; inK(g) -> inH(g)
axiom kHasIdentity: inK(E)
axiom kClosedOp: forall a, b: Grp; inK(a) -> inK(b) -> inK(op(a, b))
axiom kClosedInverse: forall a: Grp; inK(a) -> inK(inverse(a))

// KSubGroup: inK IS a subgroup of Grp (single guard inK).
model KSubGroup {
  subgroup.Grp: Grp
  subgroup.Sub: K
  subgroup.op: op
  subgroup.inverse: inverse
  subgroup.E: E
  subgroup.inSubgroup: inK
  subgroup.subgroupHasIdentity: kHasIdentity
  subgroup.subgroupClosedOp: kClosedOp
  subgroup.subgroupClosedInverse: kClosedInverse
  subgroup.grpAssoc: group.opAssoc
  subgroup.grpIdentityLeft: group.opIdentityLeft
  subgroup.grpIdentityRight: group.opIdentityRight
  subgroup.grpInverseLeft: group.opInverseLeft
  subgroup.grpInverseRight: group.opInverseRight
}

// KGroup: inK IS a group, routing each group.X through KSubGroup.
model KGroup {
  group.Grp: K
  group.op: op
  group.inverse: inverse
  group.E: E
  group.opAssoc: KSubGroup @subgroup.opAssoc
  group.opIdentityLeft: KSubGroup @subgroup.opIdentityLeft
  group.opIdentityRight: KSubGroup @subgroup.opIdentityRight
  group.opInverseLeft: KSubGroup @subgroup.opInverseLeft
  group.opInverseRight: KSubGroup @subgroup.opInverseRight
}

// ── the payoff: three group theorems transferred onto the sub-subgroup K. ─────
theorem kIdentityUnique: forall x: K; (forall g: K; op(x, g) = g) -> x = E
proof
  @conclusion |
    forall x: K; (forall g: K; op(x, g) = g) -> x = E
    [by model(KGroup) group.identityUnique]
qed

theorem kInverseUnique: forall a, b: K; op(a, b) = E -> b = inverse(a)
proof
  @conclusion |
    forall a, b: K; op(a, b) = E -> b = inverse(a)
    [by model(KGroup) group.inverseUnique]
qed

theorem kInvInvolution: forall a: K; inverse(inverse(a)) = a
proof
  @conclusion |
    forall a: K; inverse(inverse(a)) = a
    [by model(KGroup) group.invInvolution]
qed
