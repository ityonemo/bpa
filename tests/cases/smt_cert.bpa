// D2: mixed goals replay as pure certificates — opaque atoms case-split
// with an inline excluded middle, and arithmetic dead ends close by
// deriving the conflicting literal from the branch's assumptions. No
// oracle, so --pure is satisfied.
import peano <<< "std/peano.bpa"
import ordering <<< "std/peano-ordering.bpa"
sort Nat = peano.Nat
const ZERO = peano.ZERO
const ONE = peano.ONE
func succ = peano.succ
func add = peano.add
func mul = peano.mul
pred less_than = ordering.less_than
axiom addZeroLeft = peano.addZeroLeft
axiom addSuccLeft = peano.addSuccLeft
axiom mulZeroLeft = peano.mulZeroLeft
axiom mulSuccLeft = peano.mulSuccLeft
axiom oneIsSuccZero = peano.oneIsSuccZero
axiom lessThanIntro = ordering.lessThanIntro
axiom lessThanElim = ordering.lessThanElim
theorem addZeroRight = peano.addZeroRight
theorem addSuccRight = peano.addSuccRight
theorem mulZeroRight = peano.mulZeroRight
theorem mulSuccRight = peano.mulSuccRight
theorem addIsAssociative = peano.addIsAssociative
theorem addIsCommutative = peano.addIsCommutative
theorem addLeftSwap = peano.addLeftSwap
pred p

theorem mixedStepUp: forall b, a: Nat; less_than(a, b) -> (p or less_than(a, succ(b)))
proof
  @conclusion |
    forall b, a: Nat; less_than(a, b) -> (p or less_than(a, succ(b)))
    [by arithmetic]
qed

theorem conflictPure: forall a: Nat; (p and less_than(a, succ(a))) or ((not p) and less_than(a, add(a, ONE)))
proof
  @conclusion |
    forall a: Nat; (p and less_than(a, succ(a))) or ((not p) and less_than(a, add(a, ONE)))
    [by arithmetic]
qed
