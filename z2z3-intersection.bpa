// Given two SPECIFIC subgroups (call them Z2 and Z3), their intersection is a
// subgroup — obtained for free by `model`-transferring std/subgroup.bpa's abstract
// intersection results onto the two concrete membership predicates.
//
// (Z2/Z3 as literal ℤ/2, ℤ/3 would need finite carriers bpa doesn't model; here
// they are two abstract subgroup predicates over an ambient group, each asserted
// to satisfy the three subgroup criteria. That's all the intersection result needs.)
import subgroup <<< "std/subgroup.bpa"

sort Grp = subgroup.Grp
const E = subgroup.E
func op = subgroup.op
func inverse = subgroup.inverse

// the two specified subgroups, as membership predicates over the group.
pred inZ2(g: Grp)
pred inZ3(g: Grp)

// each is a subgroup: it satisfies the three subgroup criteria.
axiom z2HasIdentity: inZ2(E)
axiom z2ClosedOp: forall a, b: Grp; inZ2(a) -> inZ2(b) -> inZ2(op(a, b))
axiom z2ClosedInverse: forall a: Grp; inZ2(a) -> inZ2(inverse(a))

axiom z3HasIdentity: inZ3(E)
axiom z3ClosedOp: forall a, b: Grp; inZ3(a) -> inZ3(b) -> inZ3(op(a, b))
axiom z3ClosedInverse: forall a: Grp; inZ3(a) -> inZ3(inverse(a))

// ONE model maps BOTH abstract subgroup predicates onto the two concrete ones,
// discharging all six criteria. (The intersection theorems mention both
// inSubgroup and inSubgroup2, so both must be mapped in the same interpretation.)
model IntersectZ2Z3 = Grp {
  subgroup.Grp: Grp
  subgroup.op: op
  subgroup.inverse: inverse
  subgroup.E: E
  subgroup.inSubgroup: inZ2
  subgroup.subgroupHasIdentity: z2HasIdentity
  subgroup.subgroupClosedOp: z2ClosedOp
  subgroup.subgroupClosedInverse: z2ClosedInverse
  subgroup.inSubgroup2: inZ3
  subgroup.subgroup2HasIdentity: z3HasIdentity
  subgroup.subgroup2ClosedOp: z3ClosedOp
  subgroup.subgroup2ClosedInverse: z3ClosedInverse
  }

// membership in the intersection Z2 ∩ Z3 is the conjunction. The three subgroup
// criteria for it transfer for free:

theorem intersectionHasIdentity: inZ2(E) and inZ3(E)
proof
  @conclusion |
    inZ2(E) and inZ3(E)
    [by model(IntersectZ2Z3) subgroup.intersectionHasIdentity]
qed

theorem intersectionClosedOp: forall a, b: Grp; (inZ2(a) and inZ3(a)) -> (inZ2(b) and inZ3(b)) -> (inZ2(op(a, b)) and inZ3(op(a, b)))
proof
  @conclusion |
    forall a, b: Grp; (inZ2(a) and inZ3(a)) -> (inZ2(b) and inZ3(b)) -> (inZ2(op(a, b)) and inZ3(op(a, b)))
    [by model(IntersectZ2Z3) subgroup.intersectionClosedOp]
qed

theorem intersectionClosedInverse: forall a: Grp; (inZ2(a) and inZ3(a)) -> (inZ2(inverse(a)) and inZ3(inverse(a)))
proof
  @conclusion |
    forall a: Grp; (inZ2(a) and inZ3(a)) -> (inZ2(inverse(a)) and inZ3(inverse(a)))
    [by model(IntersectZ2Z3) subgroup.intersectionClosedInverse]
qed
